<!doctype html>
<html lang="pt-BR">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Orion Peptides - Biotecnologia e Protocolos de Pesquisa" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{title}</title>
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">
	</head>
	<body class="bg-black text-white font-['Inter'] antialiased">
        <slot />

        <!-- Dismissible Footer Disclaimer Template (will be injected before copyright on each page) -->
        <template id="disclaimer-template">
            <div id="site-disclaimer" class="w-full bg-neutral-950 text-xs text-gray-500 text-center py-4 border-t border-gray-800 flex items-start justify-center gap-4 px-4">
                <div class="max-w-4xl">
                    ⚠️ <strong class="text-gray-300">AVISO LEGAL:</strong> As informações e produtos disponibilizados neste site destinam-se exclusivamente para fins de pesquisa laboratorial e desenvolvimento científico.
                    Estes compostos químicos não são medicamentos, não foram aprovados para tratamento, diagnóstico ou prevenção de doenças e não substituem aconselhamento médico profissional.
                    A Orion Peptides não incentiva a automedicação e não se responsabiliza pelo uso indevido destas substâncias fora de ambiente controlado. Consulte sempre seu especialista antes de iniciar qualquer protocolo.
                </div>
                <button id="dismiss-disclaimer" aria-label="Fechar aviso legal" class="text-gray-400 hover:text-gray-200 ml-2 px-2 py-1 rounded-md border border-gray-800">
                    ✕
                </button>
            </div>
        </template>

        <script>
            document.addEventListener('DOMContentLoaded', () => {
                try {
                    const dismissed = localStorage.getItem('disclaimerDismissed');
                    if (dismissed === '1') return;

                    const tpl = document.getElementById('disclaimer-template') as HTMLTemplateElement | null;
                    if (!tpl || !tpl.content.firstElementChild) return;
                    const node = tpl.content.firstElementChild.cloneNode(true) as HTMLElement;

                    // Find copyright paragraphs and insert disclaimer before the first one found
                    const copyrightCandidates = Array.from(document.querySelectorAll('p')) as HTMLParagraphElement[];
                    let inserted = false;
                    for (const p of copyrightCandidates) {
                        if (p.textContent && p.textContent.includes('© 2015')) {
                            if (p.parentNode) {
                                p.parentNode.insertBefore(node, p);
                                inserted = true;
                                break;
                            }
                        }
                    }

                    // Fallback: append to body end (before footer)
                    if (!inserted) {
                        document.body.appendChild(node);
                    }

                    const dismissBtn = document.getElementById('dismiss-disclaimer');
                    if (dismissBtn) {
                        dismissBtn.addEventListener('click', () => {
                            const el = document.getElementById('site-disclaimer');
                            if (el && el.parentNode) el.parentNode.removeChild(el);
                            try { localStorage.setItem('disclaimerDismissed', '1'); } catch (e) {}
                        });
                    }
                } catch (err) {
                    // silent
                }
            });
        </script>
        <script>
            // Show a small "Ver Aviso Legal" button in the footer when the user has dismissed the disclaimer.
            document.addEventListener('DOMContentLoaded', () => {
                try {
                    const dismissed = localStorage.getItem('disclaimerDismissed');

                    // create button
                    const btn = document.createElement('button');
                    btn.id = 'show-disclaimer-btn';
                    btn.type = 'button';
                    btn.textContent = 'Ver Aviso Legal';
                    btn.className = 'text-xs text-gray-400 border border-gray-800 rounded px-2 py-1 ml-2 hover:text-gray-200';
                    btn.style.display = 'none';

                    // find copyright paragraph
                    const pList = Array.from(document.querySelectorAll('p')) as HTMLParagraphElement[];
                    let anchor: HTMLElement | null = null;
                    for (const p of pList) {
                        if (p.textContent && p.textContent.includes('© 2015')) {
                            anchor = p;
                            break;
                        }
                    }

                    if (anchor && anchor.parentNode) {
                        anchor.parentNode.insertBefore(btn, anchor.nextSibling);
                    } else {
                        // fallback: append to body end
                        document.body.appendChild(btn);
                    }

                    if (dismissed === '1') {
                        btn.style.display = 'inline-block';
                    }

                    function injectDisclaimerAndHook() {
                        const tpl = document.getElementById('disclaimer-template') as HTMLTemplateElement | null;
                        if (!tpl) return;
                        if (!tpl.content.firstElementChild) return;
                        const node = tpl.content.firstElementChild.cloneNode(true) as HTMLElement;
                        if (anchor && anchor.parentNode) {
                            anchor.parentNode.insertBefore(node, anchor);
                        } else {
                            document.body.appendChild(node);
                        }
                        const dismissBtn = node.querySelector('#dismiss-disclaimer') as HTMLElement | null;
                        if (dismissBtn) {
                            dismissBtn.addEventListener('click', () => {
                                const el = document.getElementById('site-disclaimer');
                                if (el && el.parentNode) el.parentNode.removeChild(el);
                                try { localStorage.setItem('disclaimerDismissed', '1'); } catch (e) {}
                                btn.style.display = 'inline-block';
                            });
                        }
                    }

                    btn.addEventListener('click', () => {
                        try { localStorage.removeItem('disclaimerDismissed'); } catch (e) {}
                        injectDisclaimerAndHook();
                        btn.style.display = 'none';
                    });
                } catch (err) {
                    // silent
                }
            });
        </script>

        <!-- Inserir seção de Referências Científicas apenas em páginas técnicas (Guia Técnico) -->
        {referencesForPage && referencesForPage.length > 0 ? <References references={referencesForPage} /> : null}

        <!-- Affiliate tracking (capture ?ref= and expose helper functions) -->
        <script>
            document.addEventListener('DOMContentLoaded', () => {
                try {
                    const params = new URLSearchParams(window.location.search);
                    const refParam = params.get('ref');
                    if (refParam) {
                        const clean = String(refParam).trim();
                        if (clean) {
                            try { sessionStorage.setItem('affiliateRef', clean); } catch (e) {}
                            try { localStorage.setItem('affiliateRef', clean); } catch (e) {}
                        }
                    }

                    // Expose helper to read affiliate ref (prefers sessionStorage)
                    (window as any).getAffiliateRef = function() {
                        try {
                            return sessionStorage.getItem('affiliateRef') || localStorage.getItem('affiliateRef') || null;
                        } catch (e) { return null; }
                    };

                    // Build WhatsApp link helper: pass productName and phone (in international format, e.g. 5511999999999)
                    (window as any).buildWhatsappLink = function(productName, phone) {
                        const ref = (window as any).getAffiliateRef();
                        let message;
                        if (ref) {
                            // Persuasive commercial message with affiliate code in uppercase
                            const code = String(ref).toUpperCase().replace(/\s+/g, '');
                            message = `Olá! Quero ativar o código VIP-${code} para garantir minhas condições especiais no ${productName}.`;
                        } else {
                            message = `Olá, gostaria de saber mais sobre ${productName}.`;
                        }
                        const encoded = encodeURIComponent(message);
                        const p = String(phone || '').replace(/\D/g,'');
                        if (!p) return `https://wa.me/?text=${encoded}`;
                        return `https://wa.me/${p}?text=${encoded}`;
                    };

                    // Ensure anchors that should act as WhatsApp contact buttons have data attributes.
                    // Set global default WhatsApp phone if not already defined
                    try { (window as any).DEFAULT_WA_PHONE = (window as any).DEFAULT_WA_PHONE || '5518981522804'; } catch (e) {}
                    const defaultPhone = (window as any).DEFAULT_WA_PHONE || '';

                    function inferProductFromAnchor(a: HTMLElement) {
                        // 1) check explicit attributes
                        const explicit = (a.getAttribute('data-product') || a.getAttribute('data-name') || a.getAttribute('aria-label'));
                        if (explicit) return explicit.trim();

                        // 2) check nearest parent with data-nome (catalog cards)
                        const card = a.closest('[data-nome]') as HTMLElement | null;
                        if (card) {
                            const nome = card.getAttribute('data-nome') || card.dataset.nome;
                            if (nome) return String(nome).trim();
                        }

                        // 3) look for nearby headings
                        const ancestor = a.closest('section,article,div') as HTMLElement | null;
                        if (ancestor) {
                            const h = ancestor.querySelector('h1,h2,h3') as HTMLElement | null;
                            if (h && h.textContent) return h.textContent.trim();
                        }

                        // 4) fallback: page title
                        const h1 = document.querySelector('h1') as HTMLElement | null;
                        if (h1 && h1.textContent) return h1.textContent.trim();

                        return '';
                    }

                    // Auto-detect buttons that likely are 'Encontrar Fornecedor' or WhatsApp CTAs
                    document.querySelectorAll('a').forEach((el) => {
                        const a = el as HTMLAnchorElement;
                        if (a.dataset.waProduct) return; // already set
                        const text = (a.textContent || '').toLowerCase();
                        // targets: 'encontrar fornecedor', 'contato', 'whatsapp', 'comprar', 'comprar agora'
                        if (/\b(encontrar fornecedor|encontrar fornecedor|contato|whatsapp|comprar|comprar agora|fale conosco)\b/i.test(text)) {
                            const product = inferProductFromAnchor(a);
                            if (product) {
                                a.setAttribute('data-wa-product', product);
                                if (!a.getAttribute('data-wa-phone')) {
                                    a.setAttribute('data-wa-phone', (window as any).DEFAULT_WA_PHONE || defaultPhone);
                                }
                            }
                        }
                    });

                    // Auto-inject WhatsApp href for any anchor with data-wa-product and data-wa-phone
                    document.querySelectorAll('a[data-wa-product]').forEach((el) => {
                        const a = el as HTMLAnchorElement;
                        const product = a.getAttribute('data-wa-product') || a.dataset.waProduct || '';
                        const phone = a.getAttribute('data-wa-phone') || a.dataset.waPhone || '';
                        const href = (window as any).buildWhatsappLink(product, phone);
                        a.setAttribute('href', href);
                        a.setAttribute('target', '_blank');
                        a.setAttribute('rel', 'noopener noreferrer');
                    });
                } catch (err) {
                    // silent
                }
            });
        </script>
        <!-- Keyboard shortcut: navigate between product technical pages with Left / Right arrows -->
        <script>
            document.addEventListener('DOMContentLoaded', () => {
                try {
                    const productPaths = [
                        '/substancias/tirzepatide',
                        '/substancias/tirzepatide-40mg',
                        '/substancias/tirzepatide-60mg',
                        '/substancias/retatrutide',
                        '/substancias/retatrutide-20mg',
                        '/substancias/bpc-157',
                        '/substancias/blend-bpc-tb',
                        '/substancias/tb-500',
                        '/substancias/blend-cjc-ipamorelin',
                        '/substancias/ghk-cu',
                        '/substancias/tesamorelin',
                        '/substancias/nad-plus',
                        '/substancias/mots-c',
                        '/substancias/agua-esteril'
                    ];

                    const pathname = window.location.pathname.replace(/\/$/, '');
                    if (!pathname.startsWith('/substancias/')) return;

                    const currentIndex = productPaths.indexOf(pathname);
                    if (currentIndex === -1) return;

                    // Optional: small visual hint when user presses arrows (transient)
                    const hint = document.createElement('div');
                    hint.style.position = 'fixed';
                    hint.style.bottom = '18px';
                    hint.style.right = '18px';
                    hint.style.padding = '8px 10px';
                    hint.style.background = 'rgba(0,0,0,0.6)';
                    hint.style.color = '#cfeefe';
                    hint.style.fontSize = '12px';
                    hint.style.borderRadius = '8px';
                    hint.style.zIndex = '9999';
                    hint.style.backdropFilter = 'blur(6px)';
                    hint.style.display = 'none';
                    hint.textContent = 'Navegação: ← anterior · próximo →';
                    document.body.appendChild(hint);

                    function showHint() {
                        hint.style.display = 'block';
                        clearTimeout((hint as any)._timeout);
                        (hint as any)._timeout = setTimeout(() => { hint.style.display = 'none'; }, 1200);
                    }

                    document.addEventListener('keydown', (e) => {
                        const active = document.activeElement;
                        if (active && ['INPUT', 'TEXTAREA', 'SELECT'].includes(active.tagName)) return;

                        if (e.key === 'ArrowRight') {
                            const next = productPaths[currentIndex + 1];
                            if (next) {
                                showHint();
                                window.location.href = next;
                            }
                        } else if (e.key === 'ArrowLeft') {
                            const prev = productPaths[currentIndex - 1];
                            if (prev) {
                                showHint();
                                window.location.href = prev;
                            }
                        }
                    });
                } catch (err) {
                    // silent
                }
            });
        </script>

        <!-- VIP Toast: appear only when ?ref= present in URL -->
        <style is:global>
            /* Ultra-Premium VIP toast styling */
            @keyframes vip-pulse-glow {
                0% {
                    box-shadow: 0 0 20px rgba(212,175,55,0.36);
                }
                50% {
                    box-shadow: 0 0 38px rgba(212,175,55,0.65);
                }
                100% {
                    box-shadow: 0 0 20px rgba(212,175,55,0.36);
                }
            }
            @keyframes vip-slide-down {
                0% {
                    transform: translateX(-50%) translateY(-18px);
                    opacity: 0;
                }
                100% {
                    transform: translateX(-50%) translateY(0);
                    opacity: 1;
                }
            }
            @keyframes vip-shine {
                0% {
                    transform: translateX(-60%) skewX(-18deg);
                    opacity: 0;
                }
                10% {
                    opacity: 0.6;
                }
                50% {
                    transform: translateX(60%) skewX(-18deg);
                    opacity: 0.95;
                }
                90% {
                    opacity: 0.6;
                }
                100% {
                    transform: translateX(160%) skewX(-18deg);
                    opacity: 0;
                }
            }

            .vip-toast {
                position: fixed !important;
                left: 50% !important;
                /* start slightly above for slide-down effect */
                transform: translateX(-50%) translateY(-12px) !important;
                top: 20px !important;
                z-index: 99999 !important;
                background: #0a0a0a !important;
                color: #fff !important;
                border: 2px solid #d4af37 !important;
                padding: 12px 30px !important;
                border-radius: 50px !important;
                overflow: hidden !important;
                box-shadow: 0 0 15px rgba(212,175,55,0.6) !important;
                font-weight: 700 !important;
                display: flex !important;
                gap: 14px !important;
                align-items: center !important;
                min-width: 320px !important;
                max-width: calc(100% - 24px) !important;
                opacity: 0 !important;
                pointer-events: none !important;
                transition: opacity 220ms ease, transform 320ms ease !important;
                animation: vip-pulse-glow 2s infinite ease-in-out !important;
            }

            .vip-toast.show {
                opacity: 1 !important;
                transform: translateX(-50%) translateY(0) !important;
                pointer-events: auto !important;
                /* play a slide-down entry animation once when shown */
                animation: vip-pulse-glow 2s infinite ease-in-out, vip-slide-down 360ms ease 1;
            }

            .vip-toast .gold {
                color: #d4af37 !important;
                font-weight: 900 !important;
            }

            /* Gift icon glow and subtle pulse */
            .vip-gift {
                font-size: 18px;
                filter: drop-shadow(0 0 10px rgba(212,175,55,0.85));
                transform-origin: center;
                animation: vip-pulse-glow 2s infinite ease-in-out;
            }
            /* moving shine overlay */
            .vip-toast::after {
                content: "";
                position: absolute;
                left: 0;
                top: 0;
                width: 200%;
                height: 100%;
                pointer-events: none;
                background: linear-gradient(90deg, rgba(255,255,255,0) 0%, rgba(255,255,255,0.18) 35%, rgba(255,255,255,0.38) 50%, rgba(255,255,255,0.18) 65%, rgba(255,255,255,0) 100%);
                transform: translateX(-60%) skewX(-18deg);
                mix-blend-mode: screen;
                opacity: 0;
                /* slower and run twice for added emphasis */
                animation: vip-shine 3.5s ease-in-out 0s 2;
            }
            /* replay shine each time toast is shown */
            .vip-toast.show::after {
                animation: vip-shine 3.5s ease-in-out 0s 2;
            }

            /* Force visibility even if parent uses overflow hidden */
            html, body {
                overflow: visible !important;
            }

            #vip-toast-element {
                display: block !important;
                visibility: visible !important;
            }

            @media (min-width: 768px) {
                /* elevar mais na versão desktop para evitar sobreposição com o rodapé/ícones */
                .vip-toast { bottom: 140px !important; }
            }
        </style>

        <script is:inline>
            (function () {
                // debug alert removed

                function createAndShowVipToast(ref) {
                    try {
                        if (!ref) return;
                        const code = String(ref).toUpperCase().replace(/\s+/g, '');
                        // avoid duplicate toasts
                        if (document.getElementById('vip-toast-element')) return;

                        const toast = document.createElement('div');
                        toast.id = 'vip-toast-element';
                        toast.className = 'vip-toast';
                        toast.setAttribute('role', 'status');
                        toast.setAttribute('aria-live', 'polite');
                        toast.innerHTML = `<span class="vip-gift" aria-hidden="true">🎁</span><span> <span class="gold">Código VIP-${code}</span> ativado com sucesso!</span>`;

                        // ensure we append to body (or fallback to documentElement)
                        const targetRoot = document.body || document.documentElement;
                        targetRoot.appendChild(toast);

                        // small defer to ensure CSS is available and browser paints
                        requestAnimationFrame(() => {
                            // extra micro-delay for robustness
                            setTimeout(() => {
                                toast.classList.add('show');
                            }, 16);
                        });

                        // auto-hide after 5s
                        setTimeout(() => {
                            try { toast.classList.remove('show'); } catch (e) {}
                            setTimeout(() => {
                                try { if (toast.parentNode) toast.parentNode.removeChild(toast); } catch (e) {}
                            }, 420);
                        }, 5000);
                    } catch (e) {
                        // silent
                    }
                }

                function initVipToastIfRef() {
                    try {
                        if (!window.location.search || !window.location.search.includes('ref=')) return;
                        const params = new URLSearchParams(window.location.search);
                        const ref = params.get('ref');
                        if (!ref) return;
                        createAndShowVipToast(ref);
                    } catch (e) {
                        // silent
                    }
                }

                if (document.readyState === 'loading') {
                    document.addEventListener('DOMContentLoaded', initVipToastIfRef);
                } else {
                    // already ready
                    initVipToastIfRef();
                }
            })();
        </script>

	</body>
</html>

<style is:global>
    /* Rolagem suave com offset para header fixo */
    html {
        scroll-behavior: smooth;
        scroll-padding-top: 5rem;
    }

    /* Transições suaves para todos os links */
    a {
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    /* Animações de fade-in para elementos */
    @keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @keyframes fadeInScale {
        from {
            opacity: 0;
            transform: scale(0.95);
        }
        to {
            opacity: 1;
            transform: scale(1);
        }
    }

    /* Aplicar animação de entrada suave */
    main {
        animation: fadeIn 0.6s ease-out;
    }

    /* Animações para seções */
    section {
        animation: fadeInUp 0.8s ease-out;
    }

    /* Suavizar transições de hover */
    * {
        transition-property: color, background-color, border-color, text-decoration-color, fill, stroke, opacity, box-shadow, transform, filter, backdrop-filter;
        transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
        transition-duration: 300ms;
    }

    /* Melhorar performance de animações */
    * {
        will-change: auto;
    }

    /* Scrollbar personalizada (opcional) */
    ::-webkit-scrollbar {
        width: 10px;
    }

    ::-webkit-scrollbar-track {
        background: #000;
    }

    ::-webkit-scrollbar-thumb {
        background: #333;
        border-radius: 5px;
    }

    ::-webkit-scrollbar-thumb:hover {
        background: #555;
    }

    /* Footer USA Technology Badge */
    .flag-icon-footer {
        display: inline-block;
        vertical-align: middle;
        width: 1.5rem;
        height: auto;
    }

    .flag-icon-footer .svg-flag-footer {
        width: 100%;
        height: auto;
        display: block;
    }
</style>

        <script>
    // Adicionar animações de entrada suave para elementos
    document.addEventListener('DOMContentLoaded', () => {
        // Animar elementos com classe 'animate-on-scroll'
        const observerOptions = {
            threshold: 0.1,
            rootMargin: '0px 0px -50px 0px'
        };

        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    const target = entry.target as HTMLElement;
                    target.style.opacity = '1';
                    target.style.transform = 'translateY(0)';
                    observer.unobserve(entry.target);
                }
            });
        }, observerOptions);

        // Observar elementos com animação
        document.querySelectorAll('.animate-on-scroll').forEach(el => {
            const he = el as HTMLElement;
            he.style.opacity = '0';
            he.style.transform = 'translateY(20px)';
            he.style.transition = 'opacity 0.6s ease-out, transform 0.6s ease-out';
            observer.observe(he);
        });

        // Suavizar navegação entre links internos
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (this: HTMLAnchorElement, e: Event) {
                const href = this.getAttribute('href');
                if (href !== '#' && href && href.length > 1) {
                    e.preventDefault();
                    const target = document.querySelector(href) as HTMLElement | null;
                    if (target) {
                        const headerOffset = 80;
                        const elementPosition = target.getBoundingClientRect().top;
                        const offsetPosition = elementPosition + window.pageYOffset - headerOffset;

                        window.scrollTo({
                            top: offsetPosition,
                            behavior: 'smooth'
                        });
                    }
                }
            });
        });
    });
</script>