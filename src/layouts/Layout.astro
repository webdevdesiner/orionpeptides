---
// src/layouts/Layout.astro
interface Props {
	title: string;
}

import References from '../components/References.astro';

const { title } = Astro.props;

// Mapa de referências por produto (substrings detectadas no title)
const referenceMap: Record<string, { title: string; href?: string }[]> = {
	'Tirzepatide': [
		{ title: "Jastreboff AM, et al. 'Tirzepatide Once Weekly for the Treatment of Obesity.' New England Journal of Medicine (NEJM), 2022.", href: "https://pubmed.ncbi.nlm.nih.gov/35658024/" }
	],
	'Retatrutide': [
		{ title: "Jastreboff AM, et al. 'Triple-Hormone-Receptor Agonist Retatrutide for Obesity.' NEJM, 2023.", href: "https://pubmed.ncbi.nlm.nih.gov/37366315/" }
	],
	'BPC-157': [
		{ title: "Seiwerth S, et al. 'BPC 157 and Standard Angiogenic Factors.' Current Pharmaceutical Design, 2018.", href: "https://pubmed.ncbi.nlm.nih.gov/29898649/" }
	],
	'TB-500': [
		{ title: "Goldstein AL, et al. 'Thymosin beta4: a multi-functional regenerative peptide.' Ann N Y Acad Sci, 2010.", href: "https://pubmed.ncbi.nlm.nih.gov/20420578/" }
	],
	'GHK-Cu': [
		{ title: "Pickart L, et al. 'Regenerative and Protective Actions of the GHK-Cu Peptide.' International Journal of Molecular Sciences, 2018.", href: "https://pubmed.ncbi.nlm.nih.gov/29986520/" }
	],
	'Tesamorelin': [
		{ title: "Falutz J, et al. 'Effects of Tesamorelin on Visceral Fat.' New England Journal of Medicine, 2010.", href: "https://pubmed.ncbi.nlm.nih.gov/20554980/" }
	],
	'NAD+': [
		{ title: "Yoshino J, et al. 'NAD+ Intermediates and Metabolic Homeostasis.' Cell Metabolism, 2018.", href: "https://pubmed.ncbi.nlm.nih.gov/29514064/" }
	],
	'MOTS-C': [
		{ title: "Lee C, et al. 'The Mitochondrial-Derived Peptide MOTS-c.' Cell Metabolism, 2015.", href: "https://pubmed.ncbi.nlm.nih.gov/25738459/" }
	],
	'Água Estéril': [
		{ title: "U.S. Pharmacopeia - Bacteriostatic Water for Injection Standards.", href: "https://www.usp.org/" }
	],
	'CJC-1295': [
		{ title: "Teichman SL, et al. 'Prolonged Stimulation of Growth Hormone Release.' Journal of Clinical Endocrinology & Metabolism, 2006.", href: "https://pubmed.ncbi.nlm.nih.gov/16330454/" }
	],
	'Ipamorelin': [
		{ title: "Raun K, et al. 'Ipamorelin, the first selective growth hormone secretagogue.' European Journal of Endocrinology, 1998.", href: "https://pubmed.ncbi.nlm.nih.gov/9859861/" }
	],
	'AOD-9604': [
		{ title: "Heffernan M, et al. 'The Effects of Human GH and Its Lipolytic Fragment (AOD9604).' Journal of Endocrinology & Metabolism, 2001.", href: "https://pubmed.ncbi.nlm.nih.gov/11739037/" }
	]
};

let referencesForPage: { title: string; href?: string }[] = [];
if (title) {
	for (const key in referenceMap) {
		if (title.includes(key)) {
			referencesForPage = referencesForPage.concat(referenceMap[key]);
		}
	}
}
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Orion Peptides - Biotecnologia e Protocolos de Pesquisa" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{title}</title>
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">
	</head>
	<body class="bg-black text-white font-['Inter'] antialiased">
        <slot />

        <!-- Dismissible Footer Disclaimer Template (will be injected before copyright on each page) -->
        <template id="disclaimer-template">
            <div id="site-disclaimer" class="w-full bg-neutral-950 text-xs text-gray-500 text-center py-4 border-t border-gray-800 flex items-start justify-center gap-4 px-4">
                <div class="max-w-4xl">
                    ⚠️ <strong class="text-gray-300">AVISO LEGAL:</strong> As informações e produtos disponibilizados neste site destinam-se exclusivamente para fins de pesquisa laboratorial e desenvolvimento científico.
                    Estes compostos químicos não são medicamentos, não foram aprovados para tratamento, diagnóstico ou prevenção de doenças e não substituem aconselhamento médico profissional.
                    A Orion Peptides não incentiva a automedicação e não se responsabiliza pelo uso indevido destas substâncias fora de ambiente controlado. Consulte sempre seu especialista antes de iniciar qualquer protocolo.
                </div>
                <button id="dismiss-disclaimer" aria-label="Fechar aviso legal" class="text-gray-400 hover:text-gray-200 ml-2 px-2 py-1 rounded-md border border-gray-800">
                    ✕
                </button>
            </div>
        </template>

        <script>
            document.addEventListener('DOMContentLoaded', () => {
                try {
                    const dismissed = localStorage.getItem('disclaimerDismissed');
                    if (dismissed === '1') return;

                    const tpl = document.getElementById('disclaimer-template') as HTMLTemplateElement | null;
                    if (!tpl || !tpl.content.firstElementChild) return;
                    const node = tpl.content.firstElementChild.cloneNode(true) as HTMLElement;

                    // Find copyright paragraphs and insert disclaimer before the first one found
                    const copyrightCandidates = Array.from(document.querySelectorAll('p')) as HTMLParagraphElement[];
                    let inserted = false;
                    for (const p of copyrightCandidates) {
                        if (p.textContent && p.textContent.includes('© 2015')) {
                            if (p.parentNode) {
                                p.parentNode.insertBefore(node, p);
                                inserted = true;
                                break;
                            }
                        }
                    }

                    // Fallback: append to body end (before footer)
                    if (!inserted) {
                        document.body.appendChild(node);
                    }

                    const dismissBtn = document.getElementById('dismiss-disclaimer');
                    if (dismissBtn) {
                        dismissBtn.addEventListener('click', () => {
                            const el = document.getElementById('site-disclaimer');
                            if (el && el.parentNode) el.parentNode.removeChild(el);
                            try { localStorage.setItem('disclaimerDismissed', '1'); } catch (e) {}
                        });
                    }
                } catch (err) {
                    // silent
                }
            });
        </script>
        <script>
            // Show a small "Ver Aviso Legal" button in the footer when the user has dismissed the disclaimer.
            document.addEventListener('DOMContentLoaded', () => {
                try {
                    const dismissed = localStorage.getItem('disclaimerDismissed');

                    // create button
                    const btn = document.createElement('button');
                    btn.id = 'show-disclaimer-btn';
                    btn.type = 'button';
                    btn.textContent = 'Ver Aviso Legal';
                    btn.className = 'text-xs text-gray-400 border border-gray-800 rounded px-2 py-1 ml-2 hover:text-gray-200';
                    btn.style.display = 'none';

                    // find copyright paragraph
                    const pList = Array.from(document.querySelectorAll('p')) as HTMLParagraphElement[];
                    let anchor: HTMLElement | null = null;
                    for (const p of pList) {
                        if (p.textContent && p.textContent.includes('© 2015')) {
                            anchor = p;
                            break;
                        }
                    }

                    if (anchor && anchor.parentNode) {
                        anchor.parentNode.insertBefore(btn, anchor.nextSibling);
                    } else {
                        // fallback: append to body end
                        document.body.appendChild(btn);
                    }

                    if (dismissed === '1') {
                        btn.style.display = 'inline-block';
                    }

                    function injectDisclaimerAndHook() {
                        const tpl = document.getElementById('disclaimer-template') as HTMLTemplateElement | null;
                        if (!tpl) return;
                        if (!tpl.content.firstElementChild) return;
                        const node = tpl.content.firstElementChild.cloneNode(true) as HTMLElement;
                        if (anchor && anchor.parentNode) {
                            anchor.parentNode.insertBefore(node, anchor);
                        } else {
                            document.body.appendChild(node);
                        }
                        const dismissBtn = node.querySelector('#dismiss-disclaimer') as HTMLElement | null;
                        if (dismissBtn) {
                            dismissBtn.addEventListener('click', () => {
                                const el = document.getElementById('site-disclaimer');
                                if (el && el.parentNode) el.parentNode.removeChild(el);
                                try { localStorage.setItem('disclaimerDismissed', '1'); } catch (e) {}
                                btn.style.display = 'inline-block';
                            });
                        }
                    }

                    btn.addEventListener('click', () => {
                        try { localStorage.removeItem('disclaimerDismissed'); } catch (e) {}
                        injectDisclaimerAndHook();
                        btn.style.display = 'none';
                    });
                } catch (err) {
                    // silent
                }
            });
        </script>

        <!-- Inserir seção de Referências Científicas apenas em páginas técnicas (Guia Técnico) -->
        {referencesForPage && referencesForPage.length > 0 ? <References references={referencesForPage} /> : null}

	</body>
</html>

<style is:global>
    /* Rolagem suave com offset para header fixo */
    html {
        scroll-behavior: smooth;
        scroll-padding-top: 5rem;
    }

    /* Transições suaves para todos os links */
    a {
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    /* Animações de fade-in para elementos */
    @keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @keyframes fadeInScale {
        from {
            opacity: 0;
            transform: scale(0.95);
        }
        to {
            opacity: 1;
            transform: scale(1);
        }
    }

    /* Aplicar animação de entrada suave */
    main {
        animation: fadeIn 0.6s ease-out;
    }

    /* Animações para seções */
    section {
        animation: fadeInUp 0.8s ease-out;
    }

    /* Suavizar transições de hover */
    * {
        transition-property: color, background-color, border-color, text-decoration-color, fill, stroke, opacity, box-shadow, transform, filter, backdrop-filter;
        transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
        transition-duration: 300ms;
    }

    /* Melhorar performance de animações */
    * {
        will-change: auto;
    }

    /* Scrollbar personalizada (opcional) */
    ::-webkit-scrollbar {
        width: 10px;
    }

    ::-webkit-scrollbar-track {
        background: #000;
    }

    ::-webkit-scrollbar-thumb {
        background: #333;
        border-radius: 5px;
    }

    ::-webkit-scrollbar-thumb:hover {
        background: #555;
    }

    /* Footer USA Technology Badge */
    .flag-icon-footer {
        display: inline-block;
        vertical-align: middle;
        width: 1.5rem;
        height: auto;
    }

    .flag-icon-footer .svg-flag-footer {
        width: 100%;
        height: auto;
        display: block;
    }
</style>

        <script>
    // Adicionar animações de entrada suave para elementos
    document.addEventListener('DOMContentLoaded', () => {
        // Animar elementos com classe 'animate-on-scroll'
        const observerOptions = {
            threshold: 0.1,
            rootMargin: '0px 0px -50px 0px'
        };

        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    const target = entry.target as HTMLElement;
                    target.style.opacity = '1';
                    target.style.transform = 'translateY(0)';
                    observer.unobserve(entry.target);
                }
            });
        }, observerOptions);

        // Observar elementos com animação
        document.querySelectorAll('.animate-on-scroll').forEach(el => {
            const he = el as HTMLElement;
            he.style.opacity = '0';
            he.style.transform = 'translateY(20px)';
            he.style.transition = 'opacity 0.6s ease-out, transform 0.6s ease-out';
            observer.observe(he);
        });

        // Suavizar navegação entre links internos
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (this: HTMLAnchorElement, e: Event) {
                const href = this.getAttribute('href');
                if (href !== '#' && href && href.length > 1) {
                    e.preventDefault();
                    const target = document.querySelector(href) as HTMLElement | null;
                    if (target) {
                        const headerOffset = 80;
                        const elementPosition = target.getBoundingClientRect().top;
                        const offsetPosition = elementPosition + window.pageYOffset - headerOffset;

                        window.scrollTo({
                            top: offsetPosition,
                            behavior: 'smooth'
                        });
                    }
                }
            });
        });
    });
</script>