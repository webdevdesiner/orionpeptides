---
interface Props {
	title: string;
	id?: string;
}

const { title, id = `accordion-${Math.random().toString(36).substr(2, 9)}` } = Astro.props;
---

<div class="accordion-item border border-white/10 rounded-lg overflow-hidden mb-4">
	<button
		class="accordion-header w-full bg-gray-900 px-6 py-4 flex items-center justify-between text-left hover:bg-gray-800 transition-colors duration-200"
		data-accordion-id={id}
		aria-expanded="false"
		aria-controls={`${id}-content`}
	>
		<span class="text-white font-semibold text-lg">{title}</span>
		<div class="flex items-center gap-1 relative">
			<!-- Ícone Seta para Cima (mostra quando aberto) -->
			<svg
				class="accordion-icon-up h-5 w-5 transition-opacity duration-300 flex-shrink-0 absolute"
				style="color: #937039; opacity: 0;"
				fill="none"
				viewBox="0 0 24 24"
				stroke="currentColor"
			>
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7" />
			</svg>
			<!-- Ícone Seta para Baixo (mostra quando fechado) -->
			<svg
				class="accordion-icon-down h-5 w-5 transition-opacity duration-300 flex-shrink-0"
				style="color: #937039; opacity: 1;"
				fill="none"
				viewBox="0 0 24 24"
				stroke="currentColor"
			>
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
			</svg>
		</div>
	</button>
	
	<div
		id={`${id}-content`}
		class="accordion-content bg-gray-900/50 backdrop-blur-sm max-h-0 overflow-hidden transition-all duration-300 ease-in-out"
		data-accordion-content={id}
	>
		<div class="px-6 py-4">
			<slot />
		</div>
	</div>
</div>

<script>
	document.addEventListener('DOMContentLoaded', () => {
		const buttons = document.querySelectorAll('[data-accordion-id]');
		
		buttons.forEach((button) => {
			button.addEventListener('click', () => {
				const accordionId = button.getAttribute('data-accordion-id');
				const content = document.querySelector(`[data-accordion-content="${accordionId}"]`);
				const iconUp = button.querySelector('.accordion-icon-up');
				const iconDown = button.querySelector('.accordion-icon-down');
				const isExpanded = button.getAttribute('aria-expanded') === 'true';
				
				if (content && iconUp && iconDown) {
					if (isExpanded) {
						// Fechar - mostra seta para baixo
						content.style.maxHeight = '0';
						iconUp.style.opacity = '0';
						iconDown.style.opacity = '1';
						button.setAttribute('aria-expanded', 'false');
						button.classList.remove('bg-gray-800');
					} else {
						// Abrir - mostra seta para cima
						content.style.maxHeight = content.scrollHeight + 'px';
						iconUp.style.opacity = '1';
						iconDown.style.opacity = '0';
						button.setAttribute('aria-expanded', 'true');
						button.classList.add('bg-gray-800');
					}
				}
			});
		});
	});
</script>

<style>
	.accordion-content {
		transition: max-height 0.3s ease-in-out, padding 0.3s ease-in-out;
	}
</style>

