---
// src/components/Header.astro
const currentPath = Astro.url.pathname;

// Função para verificar se o link está ativo
function isActive(href: string): boolean {
    if (href === '/') {
        return currentPath === '/';
    }
    return currentPath.startsWith(href);
}

// Função para obter a classe do link baseado no estado ativo
function getLinkClass(href: string): string {
    const baseClass = "text-sm font-medium transition-all duration-300 relative group";
    if (isActive(href)) {
        return `${baseClass} text-[#94723A]`;
    }
    return `${baseClass} text-gray-300 hover:text-white`;
}

// Função para obter a classe da linha de destaque
function getUnderlineClass(href: string): string {
    const baseClass = "absolute bottom-0 left-0 h-0.5 transition-all duration-300";
    if (isActive(href)) {
        return `${baseClass} w-full bg-[#94723A]`;
    }
    return `${baseClass} w-0 bg-blue-400 group-hover:w-full`;
}
---
<header class="fixed w-full top-0 z-50 bg-black/80 backdrop-blur-md border-b border-white/10 transition-all duration-300">
    <div class="container mx-auto px-6 h-20 flex items-center justify-between">
        <a href="/" class="block group">
            <img src="/logo.png" alt="Orion Peptides" class="h-10 w-auto transition-all duration-300 group-hover:opacity-80 group-hover:scale-105">
        </a>

        <nav class="hidden md:flex gap-8">
            <a href="/" class={getLinkClass('/')}>
                HOME
                <span class={getUnderlineClass('/')}></span>
            </a>
            <a href="/ciencia" class={getLinkClass('/ciencia')}>
                CIÊNCIA & LAUDOS
                <span class={getUnderlineClass('/ciencia')}></span>
            </a>
            <a href="/catalogo" class={getLinkClass('/catalogo')}>
                CATÁLOGO
                <span class={getUnderlineClass('/catalogo')}></span>
            </a>
            <a href="/calculadora" class={getLinkClass('/calculadora')}>
                CALCULADORA
                <span class={getUnderlineClass('/calculadora')}></span>
            </a>
            <a href="/contato" class={getLinkClass('/contato')}>
                CONTATO
                <span class={getUnderlineClass('/contato')}></span>
            </a>
        </nav>
        <!-- Mobile: hamburger -->
        <div class="md:hidden">
            <button id="mobile-menu-button" aria-controls="mobile-menu" aria-expanded="false" class="p-2 rounded-md text-gray-300 hover:text-white focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-offset-black focus:ring-white/20">
                <svg id="icon-open" xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                </svg>
                <svg id="icon-close" xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        </div>
    </div>
    <!-- Mobile nav panel (hidden by default) -->
    <nav id="mobile-menu" class="md:hidden hidden bg-black/95 border-b border-white/10">
        <div class="px-4 py-4 space-y-2">
            <a href="/" class="block text-sm font-medium text-gray-300 hover:text-white py-2">HOME</a>
            <a href="/ciencia" class="block text-sm font-medium text-gray-300 hover:text-white py-2">CIÊNCIA & LAUDOS</a>
            <a href="/catalogo" class="block text-sm font-medium text-gray-300 hover:text-white py-2">CATÁLOGO</a>
            <a href="/calculadora" class="block text-sm font-medium text-gray-300 hover:text-white py-2">CALCULADORA</a>
            <a href="/contato" class="block text-sm font-medium text-gray-300 hover:text-white py-2">CONTATO</a>
        </div>
    </nav>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            try {
                const btn = document.getElementById('mobile-menu-button');
                const panel = document.getElementById('mobile-menu');
                const iconOpen = document.getElementById('icon-open');
                const iconClose = document.getElementById('icon-close');
                if (!btn || !panel) return;
                btn.addEventListener('click', () => {
                    const expanded = btn.getAttribute('aria-expanded') === 'true';
                    btn.setAttribute('aria-expanded', String(!expanded));
                    panel.classList.toggle('hidden');
                    if (iconOpen && iconClose) {
                        iconOpen.classList.toggle('hidden');
                        iconClose.classList.toggle('hidden');
                    }
                });
            } catch (e) { /* silent */ }
        });
    </script>
</header>
<div class="h-20"></div>