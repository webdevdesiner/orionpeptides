// src/components/Header.astro
---
<header class="fixed w-full top-0 z-50 bg-black/80 backdrop-blur-md border-b border-white/10">
    <div class="container mx-auto px-6 h-20 flex items-center justify-between">
        <a href="/" class="block">
            <img src="/logo.png" alt="Orion Peptides" class="h-10 w-auto hover:opacity-80 transition-opacity">
        </a>

        <nav class="hidden md:flex gap-8">
            <a href="/" class="text-sm font-medium text-gray-300 hover:text-white transition-colors">HOME</a>
            <a href="/calculadora" class="text-sm font-medium text-gray-300 hover:text-white transition-colors">CALCULADORA</a>
            <a href="/ciencia" class="text-sm font-medium text-gray-300 hover:text-white transition-colors">CIÊNCIA & LAUDOS</a>
        </nav>

        <a href="#" class="hidden md:block px-5 py-2 bg-white text-black text-sm font-bold rounded hover:bg-gray-200 transition-colors">
            CONTATO
        </a>
    </div>
</header>
<div class="h-20"></div>