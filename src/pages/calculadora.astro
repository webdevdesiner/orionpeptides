---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
---

<Layout title="Calculadora de Reconstituição | Orion Peptides">
    <Header />
    <main class="container mx-auto px-4 py-12">
        <!-- Título com Gradiente -->
        <div class="text-center mb-12">
            <h1 class="text-5xl md:text-6xl font-bold mb-4 bg-clip-text text-transparent bg-gradient-to-r from-white via-gray-300 to-gray-400">
                Calculadora de Reconstituição
            </h1>
            <p class="text-gray-400 text-lg">Ferramenta precisa para pesquisadores e protocolos científicos</p>
        </div>

        <!-- Card da Calculadora -->
        <div class="bg-gray-900/50 backdrop-blur-md border border-white/10 rounded-2xl p-8 md:p-12 max-w-3xl mx-auto shadow-2xl">
            <form id="calculadoraForm" class="space-y-6">
                <!-- Input: Tamanho do Frasco -->
                <div>
                    <label for="tamanhoFrasco" class="block text-sm font-medium text-gray-300 mb-2">
                        Tamanho do Frasco (mg)
                    </label>
                    <input
                        type="number"
                        id="tamanhoFrasco"
                        name="tamanhoFrasco"
                        step="0.1"
                        min="0"
                        placeholder="Ex: 5"
                        required
                        class="w-full px-4 py-3 bg-black/50 border border-white/10 rounded-lg text-white placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all"
                    />
                </div>

                <!-- Input: Quantidade de Água Bacteriostática -->
                <div>
                    <label for="quantidadeAgua" class="block text-sm font-medium text-gray-300 mb-2">
                        Quantidade de Água Bacteriostática (ml)
                    </label>
                    <input
                        type="number"
                        id="quantidadeAgua"
                        name="quantidadeAgua"
                        step="0.1"
                        min="0"
                        placeholder="Ex: 2"
                        required
                        class="w-full px-4 py-3 bg-black/50 border border-white/10 rounded-lg text-white placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all"
                    />
                </div>

                <!-- Input: Dose Desejada -->
                <div>
                    <label for="doseDesejada" class="block text-sm font-medium text-gray-300 mb-2">
                        Dose Desejada (mcg)
                    </label>
                    <input
                        type="number"
                        id="doseDesejada"
                        name="doseDesejada"
                        step="0.1"
                        min="0"
                        placeholder="Ex: 250"
                        required
                        class="w-full px-4 py-3 bg-black/50 border border-white/10 rounded-lg text-white placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all"
                    />
                </div>

                <!-- Botão Calcular -->
                <button
                    type="submit"
                    class="w-full py-4 bg-white text-black font-bold text-lg rounded-lg hover:bg-gray-200 transition-all duration-300 shadow-lg hover:shadow-xl active:scale-[0.98]"
                >
                    CALCULAR RECONSTITUIÇÃO
                </button>
            </form>

            <!-- Área de Resultado (inicialmente oculta) -->
            <div id="resultadoArea" class="hidden mt-8 pt-8 border-t border-white/10">
                <div class="text-center space-y-4">
                    <p class="text-gray-400 text-sm uppercase tracking-wider">Resultado</p>
                    
                    <!-- Resultado Principal: UI (Unidades) -->
                    <div class="bg-gradient-to-r from-blue-500/20 to-blue-600/20 border border-blue-500/30 rounded-xl p-6">
                        <p class="text-gray-300 text-sm mb-2">Unidades da Seringa de Insulina</p>
                        <p id="resultadoUI" class="text-5xl md:text-6xl font-bold text-white mb-1">
                            0
                        </p>
                        <p class="text-blue-400 text-sm font-medium">UI</p>
                    </div>

                    <!-- Informações Adicionais -->
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-6">
                        <div class="bg-black/30 border border-white/5 rounded-lg p-4">
                            <p class="text-gray-400 text-xs mb-1">Concentração</p>
                            <p id="resultadoConcentracao" class="text-white font-semibold text-lg">0 mcg/ml</p>
                        </div>
                        <div class="bg-black/30 border border-white/5 rounded-lg p-4">
                            <p class="text-gray-400 text-xs mb-1">Volume da Dose</p>
                            <p id="resultadoVolume" class="text-white font-semibold text-lg">0 ml</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Call to Action: Água Bacteriostática -->
            <div class="mt-8 pt-8 border-t border-white/10 text-center">
                <a
                    href="#"
                    class="inline-flex items-center gap-2 text-gray-400 hover:text-white transition-colors text-sm"
                >
                    <span>Precisa de Água Bacteriostática?</span>
                    <span class="font-semibold underline">Compre aqui</span>
                </a>
            </div>
        </div>
    </main>
</Layout>

<script>
    const form = document.getElementById('calculadoraForm');
    const resultadoArea = document.getElementById('resultadoArea');
    const resultadoUI = document.getElementById('resultadoUI');
    const resultadoConcentracao = document.getElementById('resultadoConcentracao');
    const resultadoVolume = document.getElementById('resultadoVolume');

    form.addEventListener('submit', (e) => {
        e.preventDefault();

        // Capturar valores dos inputs
        const tamanhoFrasco = parseFloat(document.getElementById('tamanhoFrasco').value);
        const quantidadeAgua = parseFloat(document.getElementById('quantidadeAgua').value);
        const doseDesejada = parseFloat(document.getElementById('doseDesejada').value);

        // Validação básica
        if (tamanhoFrasco <= 0 || quantidadeAgua <= 0 || doseDesejada <= 0) {
            alert('Por favor, preencha todos os campos com valores válidos maiores que zero.');
            return;
        }

        // Passo 1: Converter mg do frasco para mcg (mg * 1000)
        const totalMcg = tamanhoFrasco * 1000;

        // Passo 2: Calcular concentração (Total mcg / ml de água)
        const concentracao = totalMcg / quantidadeAgua;

        // Passo 3: Calcular volume da dose (Dose Desejada / Concentração)
        const volumeDose = doseDesejada / concentracao;

        // Passo 4: Converter para "Ticks" (Unidades) de Seringa de Insulina (Volume * 100)
        const unidadesUI = volumeDose * 100;

        // Exibir resultados
        resultadoUI.textContent = unidadesUI.toFixed(1);
        resultadoConcentracao.textContent = `${concentracao.toFixed(2)} mcg/ml`;
        resultadoVolume.textContent = `${volumeDose.toFixed(3)} ml`;

        // Mostrar área de resultado
        resultadoArea.classList.remove('hidden');
        
        // Scroll suave para o resultado
        resultadoArea.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    });
</script>

    <!-- Footer -->
    <footer class="bg-black border-t border-white/10 py-8">
        <div class="container mx-auto px-4">
            <div class="text-center">
                <p class="text-gray-400 text-sm">
                    © 2026 <span class="text-white font-semibold">Orion Peptides</span>. Todos os direitos reservados.
                </p>
            </div>
        </div>
    </footer>
</Layout>