---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
---

<Layout title="Calculadora de Reconstituição | Orion Peptides">
    <Header />
    <main class="min-h-[calc(100vh-10rem)] flex flex-col justify-center bg-black dark:bg-black py-4 md:py-6">
        <div class="container mx-auto px-4">
            <!-- Título com Efeito Neon -->
            <div class="text-center mb-6 md:mb-8 group">
                <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold mb-3 bg-clip-text text-transparent bg-gradient-to-r from-white via-blue-200 to-gray-400 group-hover:from-blue-300 group-hover:via-blue-400 group-hover:to-blue-500 transition-all duration-500 drop-shadow-[0_0_20px_rgba(59,130,246,0.3)] group-hover:drop-shadow-[0_0_30px_rgba(59,130,246,0.5)]">
                    Calculadora de Reconstituição
                </h1>
                <p class="text-gray-400 dark:text-gray-400 text-sm md:text-base group-hover:text-gray-300 transition-colors duration-500">
                    Ferramenta precisa para pesquisadores e protocolos científicos
                </p>
            </div>

            <!-- Card da Calculadora com Efeitos Neon -->
            <div class="bg-gray-900/50 dark:bg-gray-900/50 backdrop-blur-md border border-white/10 dark:border-white/10 rounded-2xl p-5 md:p-8 lg:p-10 max-w-3xl mx-auto shadow-2xl shadow-blue-500/10 dark:shadow-blue-500/10 hover:shadow-[0_0_30px_rgba(59,130,246,0.2)] dark:hover:shadow-[0_0_30px_rgba(59,130,246,0.2)] transition-all duration-500">
                <form id="calculadoraForm" class="space-y-4 md:space-y-5">
                    <!-- Input: Tamanho do Frasco -->
                    <div>
                        <label for="tamanhoFrasco" class="block text-sm font-medium text-gray-300 dark:text-gray-300 mb-2">
                            Tamanho do Frasco (mg)
                        </label>
                        <input
                            type="number"
                            id="tamanhoFrasco"
                            name="tamanhoFrasco"
                            step="0.1"
                            min="0"
                            placeholder="Ex: 5"
                            required
                            class="w-full px-4 py-3 bg-black/50 dark:bg-black/50 border border-white/10 dark:border-white/10 rounded-lg text-white dark:text-white placeholder-gray-500 dark:placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:focus:ring-blue-500 focus:border-blue-500/50 dark:focus:border-blue-500/50 focus:shadow-[0_0_15px_rgba(59,130,246,0.3)] dark:focus:shadow-[0_0_15px_rgba(59,130,246,0.3)] transition-all duration-300"
                        />
                    </div>

                    <!-- Input: Quantidade de Água Bacteriostática -->
                    <div>
                        <label for="quantidadeAgua" class="block text-sm font-medium text-gray-300 dark:text-gray-300 mb-2">
                            Quantidade de Água Bacteriostática (ml)
                        </label>
                        <input
                            type="number"
                            id="quantidadeAgua"
                            name="quantidadeAgua"
                            step="0.1"
                            min="0"
                            placeholder="Ex: 3"
                            required
                            class="w-full px-4 py-3 bg-black/50 dark:bg-black/50 border border-white/10 dark:border-white/10 rounded-lg text-white dark:text-white placeholder-gray-500 dark:placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:focus:ring-blue-500 focus:border-blue-500/50 dark:focus:border-blue-500/50 focus:shadow-[0_0_15px_rgba(59,130,246,0.3)] dark:focus:shadow-[0_0_15px_rgba(59,130,246,0.3)] transition-all duration-300"
                        />
                    </div>

                    <!-- Input: Dose Desejada + Unidade (mcg/mg) -->
                    <div>
                        <label for="doseDesejada" class="block text-sm font-medium text-gray-300 dark:text-gray-300 mb-2">
                            Dose Desejada
                        </label>
                        <div class="flex gap-2">
                            <input
                                type="number"
                                id="doseDesejada"
                                name="doseDesejada"
                                step="0.1"
                                min="0"
                                placeholder="Ex: 250 ou 5"
                                required
                                class="flex-1 px-4 py-3 bg-black/50 dark:bg-black/50 border border-white/10 dark:border-white/10 rounded-lg text-white dark:text-white placeholder-gray-500 dark:placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:focus:ring-blue-500 focus:border-blue-500/50 dark:focus:border-blue-500/50 focus:shadow-[0_0_15px_rgba(59,130,246,0.3)] dark:focus:shadow-[0_0_15px_rgba(59,130,246,0.3)] transition-all duration-300"
                            />
                            <select
                                id="unidadeDose"
                                name="unidadeDose"
                                aria-label="Unidade da dose"
                                class="min-w-[6rem] px-4 py-3 bg-black/50 dark:bg-black/50 border border-white/10 dark:border-white/10 rounded-lg text-white dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500 dark:focus:ring-blue-500 focus:border-blue-500/50 dark:focus:border-blue-500/50 focus:shadow-[0_0_15px_rgba(59,130,246,0.3)] dark:focus:shadow-[0_0_15px_rgba(59,130,246,0.3)] transition-all duration-300 cursor-pointer"
                            >
                                <option value="mcg">mcg</option>
                                <option value="mg">mg</option>
                            </select>
                        </div>
                        <p class="mt-1.5 text-xs text-gray-500 dark:text-gray-500">Ex.: BPC-157 250 mcg · Tirzepatide 5 mg</p>
                    </div>

                    <!-- Botão Calcular com Efeito Neon -->
                    <button
                        type="submit"
                        class="w-full py-4 bg-gradient-to-r from-blue-600 to-blue-500 dark:from-blue-600 dark:to-blue-500 text-white font-bold text-lg rounded-lg hover:from-blue-500 hover:to-blue-400 dark:hover:from-blue-500 dark:hover:to-blue-400 transition-all duration-300 shadow-lg shadow-blue-500/30 dark:shadow-blue-500/30 hover:shadow-xl hover:shadow-blue-500/50 dark:hover:shadow-blue-500/50 active:scale-[0.98] border border-blue-400/30 dark:border-blue-400/30 hover:border-blue-400/50 dark:hover:border-blue-400/50"
                    >
                        CALCULAR RECONSTITUIÇÃO
                    </button>
                </form>

                <!-- Área de Resultado (inicialmente oculta) -->
                <div id="resultadoArea" class="hidden mt-6 md:mt-8 pt-6 md:pt-8 border-t border-white/10 dark:border-white/10">
                    <div class="text-center space-y-4">
                        <p class="text-gray-400 dark:text-gray-400 text-sm uppercase tracking-wider">Resultado</p>
                        
                        <!-- Resultado Principal: UI (Unidades) com Efeito Neon -->
                        <div class="bg-gradient-to-r from-blue-500/20 to-blue-600/20 dark:from-blue-500/20 dark:to-blue-600/20 border border-blue-500/30 dark:border-blue-500/30 rounded-xl p-6 shadow-[0_0_20px_rgba(59,130,246,0.2)] dark:shadow-[0_0_20px_rgba(59,130,246,0.2)]">
                            <p class="text-gray-300 dark:text-gray-300 text-sm mb-2">Unidades da Seringa de Insulina</p>
                            <p id="resultadoUI" class="text-4xl md:text-5xl lg:text-6xl font-bold text-white dark:text-white mb-1 drop-shadow-[0_0_10px_rgba(59,130,246,0.5)] dark:drop-shadow-[0_0_10px_rgba(59,130,246,0.5)]">
                                0
                            </p>
                            <p class="text-blue-400 dark:text-blue-400 text-sm font-medium">UI</p>
                        </div>

                        <!-- Informações Adicionais com Efeitos Neon -->
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-6">
                            <div class="bg-black/30 dark:bg-black/30 border border-white/5 dark:border-white/5 rounded-lg p-4 hover:border-blue-500/30 dark:hover:border-blue-500/30 hover:shadow-[0_0_10px_rgba(59,130,246,0.2)] dark:hover:shadow-[0_0_10px_rgba(59,130,246,0.2)] transition-all duration-300">
                                <p class="text-gray-400 dark:text-gray-400 text-xs mb-1">Concentração</p>
                                <p id="resultadoConcentracao" class="text-white dark:text-white font-semibold text-lg">0 mcg/ml</p>
                            </div>
                            <div class="bg-black/30 dark:bg-black/30 border border-white/5 dark:border-white/5 rounded-lg p-4 hover:border-blue-500/30 dark:hover:border-blue-500/30 hover:shadow-[0_0_10px_rgba(59,130,246,0.2)] dark:hover:shadow-[0_0_10px_rgba(59,130,246,0.2)] transition-all duration-300">
                                <p class="text-gray-400 dark:text-gray-400 text-xs mb-1">Volume da Dose</p>
                                <p id="resultadoVolume" class="text-white dark:text-white font-semibold text-lg">0 ml</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Call to Action: Água Bacteriostática -->
                <div class="mt-6 md:mt-8 pt-6 md:pt-8 border-t border-white/10 dark:border-white/10 text-center">
                    <a
                        href="/substancias/agua-esteril"
                        class="inline-flex items-center gap-2 text-gray-400 dark:text-gray-400 hover:text-blue-400 dark:hover:text-blue-400 transition-colors text-sm hover:drop-shadow-[0_0_8px_rgba(59,130,246,0.5)] dark:hover:drop-shadow-[0_0_8px_rgba(59,130,246,0.5)]"
                    >
                        <span>Precisa de Água Bacteriostática?</span>
                        <span class="font-semibold underline">Compre aqui</span>
                    </a>
                </div>
            </div>
        </div>
    </main>

    <!-- Footer -->
    <footer class="bg-black dark:bg-black border-t border-white/10 dark:border-white/10 py-4 md:py-6">
        <div class="container mx-auto px-4">
            <div class="text-center">
                <!-- USA Technology Badge -->
                <div class="flex items-center justify-center gap-2 mb-4">
                    <span class="flag-icon-footer">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" class="svg-flag-footer">
                            <g fill="none">
                                <path fill="#B22234" d="M0 0h512v512H0z"/>
                                <path fill="#FFF" d="M0 45.9h512v45.9H0zM0 137.6h512v45.9H0zM0 229.3h512v45.9H0zM0 321h512v45.9H0zM0 412.7h512v45.9H0z"/>
                                <path fill="#3C3B6E" d="M0 0h233v275.2H0z"/>
                                <g fill="#FFF">
                                    <circle cx="25" cy="25" r="10"/><circle cx="71" cy="25" r="10"/><circle cx="117" cy="25" r="10"/><circle cx="163" cy="25" r="10"/><circle cx="209" cy="25" r="10"/>
                                    <circle cx="48" cy="63" r="10"/><circle cx="94" cy="63" r="10"/><circle cx="140" cy="63" r="10"/><circle cx="186" cy="63" r="10"/>
                                    <circle cx="25" cy="101" r="10"/><circle cx="71" cy="101" r="10"/><circle cx="117" cy="101" r="10"/><circle cx="163" cy="101" r="10"/><circle cx="209" cy="101" r="10"/>
                                    <circle cx="48" cy="139" r="10"/><circle cx="94" cy="139" r="10"/><circle cx="140" cy="139" r="10"/><circle cx="186" cy="139" r="10"/>
                                    <circle cx="25" cy="177" r="10"/><circle cx="71" cy="177" r="10"/><circle cx="117" cy="177" r="10"/><circle cx="163" cy="177" r="10"/><circle cx="209" cy="177" r="10"/>
                                    <circle cx="48" cy="215" r="10"/><circle cx="94" cy="215" r="10"/><circle cx="140" cy="215" r="10"/><circle cx="186" cy="215" r="10"/>
                                    <circle cx="25" cy="253" r="10"/><circle cx="71" cy="253" r="10"/><circle cx="117" cy="253" r="10"/><circle cx="163" cy="253" r="10"/><circle cx="209" cy="253" r="10"/>
                                </g>
                            </g>
                        </svg>
                    </span>
                    <span class="text-white dark:text-white font-medium text-sm md:text-base">USA Technology</span>
                </div>
                
                <p class="text-gray-400 dark:text-gray-400 text-sm">
                    © 2015 <span class="text-white dark:text-white font-semibold">Orion Peptides</span>. Todos os direitos reservados.
                </p>
            </div>
        </div>
    </footer>
</Layout>

<script>
    const form = document.getElementById('calculadoraForm');
    const resultadoArea = document.getElementById('resultadoArea');
    const resultadoUI = document.getElementById('resultadoUI');
    const resultadoConcentracao = document.getElementById('resultadoConcentracao');
    const resultadoVolume = document.getElementById('resultadoVolume');

    form.addEventListener('submit', (e) => {
        e.preventDefault();

        // Capturar valores dos inputs
        const tamanhoFrasco = parseFloat(document.getElementById('tamanhoFrasco').value);
        const quantidadeAgua = parseFloat(document.getElementById('quantidadeAgua').value);
        let dose = parseFloat((document.getElementById('doseDesejada') as HTMLInputElement)?.value ?? '0');
        const unidade = (document.getElementById('unidadeDose') as HTMLSelectElement | null)?.value ?? 'mcg';

        // Converter mg → mcg internamente (cálculo sempre em mcg)
        if (unidade === 'mg') {
            dose = dose * 1000;
        }

        // Validação básica
        if (tamanhoFrasco <= 0 || quantidadeAgua <= 0 || dose <= 0) {
            alert('Por favor, preencha todos os campos com valores válidos maiores que zero.');
            return;
        }

        // Passo 1: Converter mg do frasco para mcg (mg * 1000)
        const totalMcg = tamanhoFrasco * 1000;

        // Passo 2: Calcular concentração (Total mcg / ml de água)
        const concentracao = totalMcg / quantidadeAgua;

        // Passo 3: Calcular volume da dose (Dose em mcg / Concentração)
        const volumeDose = dose / concentracao;

        // Passo 4: Converter para "Ticks" (Unidades) de Seringa de Insulina (Volume * 100)
        const unidadesUI = volumeDose * 100;

        // Exibir resultados
        resultadoUI.textContent = unidadesUI.toFixed(1);
        resultadoConcentracao.textContent = `${concentracao.toFixed(2)} mcg/ml`;
        resultadoVolume.textContent = `${volumeDose.toFixed(3)} ml`;

        // Mostrar área de resultado
        resultadoArea.classList.remove('hidden');
        
        // Scroll suave para o resultado (removido para não precisar rolar)
        // resultadoArea.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    });
</script>

<style>
    /* Suporte a tema do sistema */
    @media (prefers-color-scheme: light) {
        :root {
            color-scheme: light dark;
        }
    }
    
    @media (prefers-color-scheme: dark) {
        :root {
            color-scheme: dark;
        }
    }
</style>
  