<script>
    // Calculadora Rápida para Retatrutide 20mg (20mg em 0,8ml)
    document.addEventListener('DOMContentLoaded', () => {
        const form = document.getElementById('calculadoraRetatrutide20') as HTMLFormElement | null;
        const resultado = document.getElementById('resultadoRetatrutide20');
        const resultadoUI = document.getElementById('resultadoUIRetatrutide20');
        const resultadoVolume = document.getElementById('resultadoVolumeRetatrutide20');

        if (!form || !resultado || !resultadoUI || !resultadoVolume) {
            return;
        }

        form.addEventListener('submit', (e) => {
            e.preventDefault();

            const inputDose = document.getElementById('doseRetatrutide20') as HTMLInputElement | null;
            if (!inputDose) return;

            // Valores fixos para Retatrutide Orion (20mg em 0,8ml)
            const tamanhoFrasco = 20; // mg
            const quantidadeAgua = 0.8; // ml
            const doseDesejada = parseFloat(inputDose.value); // mg

            // ValidaÃ§Ã£o
            if (isNaN(doseDesejada) || doseDesejada <= 0 || doseDesejada > tamanhoFrasco) {
                alert('Por favor, insira uma dose vÃ¡lida entre 0 e 20mg.');
                return;
            }

            const mgPorMl = tamanhoFrasco / quantidadeAgua;
            const unidadesUI = (doseDesejada / mgPorMl) * 100;
            const volumeMl = doseDesejada / mgPorMl;

            // Exibir resultados
            resultadoUI.textContent = unidadesUI.toFixed(0);
            resultadoVolume.textContent = `${volumeMl.toFixed(2)} ml`;

            // Mostrar Ã¡rea de resultado
            resultado.classList.remove('hidden');
        });
    });
</script>


