---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Accordion from '../../components/Accordion.astro';
---

<Layout title="GHK-Cu 50mg (Copper Peptide) | Guia Técnico | Orion Peptides" description="GHK-Cu 50mg: copper peptide para pesquisa. Regeneração, colágeno e antioxidante. Pureza HPLC. Guia técnico Orion Peptides." ogImage="/image/produtos/GHK-CU.png">
    <Header />
    
    <main class="container mx-auto px-4 py-12 md:py-16">
        <!-- Topo - Resumo do Produto -->
        <section class="mb-16">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12 items-start">
                <!-- Coluna 1: Imagem do Produto -->
                <div class="space-y-6">
                    <!-- Mobile-only: título acima da imagem com ícone -->
                    <div class="md:hidden flex items-center justify-center gap-3 mb-3">
                        <div class="w-10 h-10 rounded-full bg-white/5 border border-emerald-500/20 flex items-center justify-center flex-shrink-0 shadow-[0_0_8px_rgba(16,185,129,0.15)]">
                            <img src="/image/catalogo/ghk-cu.png" alt="Ícone GHK-Cu" class="w-8 h-8 object-contain" />
                        </div>
                        <h1 class="text-2xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-white via-emerald-200 to-emerald-400">
                            GHK-Cu 50mg (Copper Peptide)
                        </h1>
                    </div>
                    <figure class="w-full max-w-md bg-gray-900/50 border border-white/10 rounded-2xl overflow-hidden">
                        <div class="px-4 py-2.5 border-b border-white/10 bg-black/20">
                            <figcaption class="text-xs text-gray-400 uppercase tracking-wider font-medium">GHK-Cu 50mg (Copper Peptide) — Imagem do produto</figcaption>
                        </div>
                        <div class="relative p-6 flex items-center justify-center">
                            <a
                                href="/contato"
                                data-wa-product="GHK-Cu 50mg (Copper Peptide)"
                                data-wa-phone="5511911387063"
                                class="absolute top-4 left-4 z-30 inline-flex flex-col items-center justify-center px-2.5 py-1.5 rounded bg-gradient-to-br from-amber-400 via-yellow-500 to-amber-600 hover:from-amber-300 hover:via-yellow-400 hover:to-amber-500 text-amber-950 text-[10px] font-bold uppercase tracking-wide shadow-md shadow-amber-500/30 hover:shadow-amber-400/50 border border-amber-300/50 hover:scale-105 active:scale-95 transition-all duration-300 leading-tight text-center"
                            >
                                <span>Encontrar</span>
                                <span>fornecedor</span>
                            </a>
                            <img 
                                src="/image/produtos/GHK-CU.png" 
                                alt="GHK-Cu - Copper Tripeptide-1" 
                                class="w-full h-auto object-contain rounded-lg"
                            />
                        </div>
                    </figure>
					<!-- Mobile: subtítulo e descrição abaixo da imagem -->
					<div class="md:hidden">
						<p class="text-xl text-gray-400 font-medium mb-3">Copper Tripeptide-1 (Alta Concentração)</p>
						<p class="text-gray-500 text-sm leading-relaxed mb-6">O Peptídeo de Cobre é o <strong class="text-emerald-400">"padrão ouro"</strong> da estética regenerativa. É capaz de remodelar a pele, estimular crescimento capilar e acelerar cicatrização.</p>
					</div>

                    <!-- Especificações Técnicas Rápidas -->
                    <div class="flex flex-col gap-4">
                        <!-- Card 1: Potência -->
                        <div class="bg-gray-900/50 backdrop-blur-md border border-emerald-500/20 rounded-xl p-4 hover:border-emerald-500/40 transition-all duration-300">
                            <div class="flex flex-col items-center text-center space-y-2">
                                <!-- Ícone Frasco -->
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
                                </svg>
                                <p class="text-xs text-gray-400 uppercase tracking-wider">Potência</p>
                                <p class="text-sm text-white font-semibold">50mg Liofilizado</p>
                            </div>
                        </div>

                        <!-- Card 2: Diluente -->
                        <div class="bg-gray-900/50 backdrop-blur-md border border-emerald-500/20 rounded-xl p-4 hover:border-emerald-500/40 transition-all duration-300">
                            <div class="flex flex-col items-center text-center space-y-2">
                                <!-- Ícone Gota -->
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-emerald-400" fill="currentColor" viewBox="0 0 24 24">
                                    <path d="M12 2.69c-3.5 0-6.31 2.81-6.31 6.31 0 3.5 6.31 10.31 6.31 10.31S18.31 12.5 18.31 9c0-3.5-2.81-6.31-6.31-6.31z"/>
                                </svg>
                                <p class="text-xs text-gray-400 uppercase tracking-wider">Inclui</p>
                                <p class="text-sm text-white font-semibold">🎁 Água Bacteriostática</p>
                            </div>
                        </div>

                        <!-- Card 3: Armazenamento -->
                        <div class="bg-gray-900/50 backdrop-blur-md border border-emerald-500/20 rounded-xl p-4 hover:border-emerald-500/40 transition-all duration-300">
                            <div class="flex flex-col items-center text-center space-y-2">
                                <!-- Ícone Floco de Neve -->
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
                                </svg>
                                <p class="text-xs text-gray-400 uppercase tracking-wider">Temperatura</p>
                                <p class="text-sm text-white font-semibold">2°C a 8°C (Geladeira)</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Coluna 2: Informações -->
                <div class="space-y-6">
                    <div>
                        <div class="hidden md:flex items-center gap-4 mb-2">
                            <div class="w-14 h-14 rounded-full bg-white/5 border border-emerald-500/20 flex items-center justify-center flex-shrink-0 shadow-[0_0_12px_rgba(16,185,129,0.25)]">
                                <img src="/image/catalogo/ghk-cu.png" alt="" class="w-10 h-10 object-contain" />
                            </div>
                            <h1 class="text-4xl md:text-5xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-white via-emerald-200 to-emerald-400">
                                GHK-Cu 50mg (Copper Peptide)
                            </h1>
                        </div>
                        <p class="text-xl text-gray-400 font-medium mb-3 hidden md:block">Copper Tripeptide-1 (Alta Concentração)</p>
                        <p class="text-gray-500 text-sm leading-relaxed mb-6 hidden md:block">
                            O Peptídeo de Cobre é o <strong class="text-emerald-400">"padrão ouro"</strong> da estética regenerativa. É capaz de remodelar a pele, estimular crescimento capilar e acelerar cicatrização.
                        </p>
                        <div class="bg-emerald-900/20 border border-emerald-500/30 rounded-lg p-3 mb-2">
                            <p class="text-sm text-emerald-200">
                                <strong class="text-emerald-300">A Cor:</strong> Quando misturado, o líquido torna-se <strong class="text-blue-400">Azul Royal</strong> intenso, característica natural dos íons de cobre.
                            </p>
                        </div>
                        <div class="bg-emerald-900/20 border border-emerald-500/30 rounded-lg p-3 mb-4">
                            <p class="text-sm text-emerald-200">
                                <strong class="text-emerald-300">Diferencial Orion:</strong> Frasco de <strong>50mg</strong> (Padrão Orion).
                            </p>
                        </div>
                    </div>

                    <!-- Seção Benefícios Pesquisados -->
                    <div class="mb-8">
                        <h3 class="text-2xl md:text-3xl font-bold mb-6 text-white">
                            Benefícios Pesquisados
                        </h3>
                        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6">
                            <!-- Benefício 1: Colágeno -->
                            <div class="flex flex-col items-center text-center space-y-3 p-4 hover:-translate-y-2 transition-all duration-300 cursor-default">
                                <!-- Ícone Colágeno -->
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 md:w-10 md:h-10 text-emerald-400 drop-shadow-[0_0_8px_rgba(16,185,129,0.5)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                                </svg>
                                <h4 class="text-white font-bold text-sm md:text-base">Colágeno</h4>
                                <p class="text-gray-400 text-xs md:text-sm">Até 70% mais produção</p>
                            </div>

                            <!-- Benefício 2: Elasticidade -->
                            <div class="flex flex-col items-center text-center space-y-3 p-4 hover:-translate-y-2 transition-all duration-300 cursor-default">
                                <!-- Ícone Elasticidade -->
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 md:w-10 md:h-10 text-emerald-400 drop-shadow-[0_0_8px_rgba(16,185,129,0.5)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                                </svg>
                                <h4 class="text-white font-bold text-sm md:text-base">Elasticidade</h4>
                                <p class="text-gray-400 text-xs md:text-sm">Melhora da elasticidade da pele</p>
                            </div>

                            <!-- Benefício 3: Anti-Envelhecimento -->
                            <div class="flex flex-col items-center text-center space-y-3 p-4 hover:-translate-y-2 transition-all duration-300 cursor-default">
                                <!-- Ícone Anti-Envelhecimento -->
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 md:w-10 md:h-10 text-emerald-400 drop-shadow-[0_0_8px_rgba(16,185,129,0.5)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                                </svg>
                                <h4 class="text-white font-bold text-sm md:text-base">Anti-Envelhecimento</h4>
                                <p class="text-gray-400 text-xs md:text-sm">Redução de linhas finas</p>
                            </div>

                            <!-- Benefício 4: Crescimento Capilar -->
                            <div class="flex flex-col items-center text-center space-y-3 p-4 hover:-translate-y-2 transition-all duration-300 cursor-default">
                                <!-- Ícone Cabelo -->
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 md:w-10 md:h-10 text-emerald-400 drop-shadow-[0_0_8px_rgba(16,185,129,0.5)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01" />
                                </svg>
                                <h4 class="text-white font-bold text-sm md:text-base">Crescimento</h4>
                                <p class="text-gray-400 text-xs md:text-sm">Crescimento capilar</p>
                            </div>
                        </div>
                    </div>

                    <div class="space-y-4">
                        <!-- Protocolo de Pesquisa Sugerido (50mg) -->
                        <div class="mt-8 border-t border-white/10 pt-6">
                            <h4 class="text-white font-bold mb-4 flex items-center gap-2">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-emerald-400" viewBox="0 0 20 20" fill="currentColor">
                                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd" />
                                </svg>
                                Protocolo Cosmético / Sistêmico (GHK-Cu 50mg)
                            </h4>

                            <div class="space-y-4">
                                <!-- Nova Tabela de Dosagem (Regra: 4 Unidades = 1mg) -->
                            <div class="overflow-hidden rounded-xl border border-white/10 shadow-lg">
                                    <div class="bg-emerald-900/20 px-4 py-3 border-b border-white/10">
                                        <h5 class="text-emerald-200 font-bold text-sm uppercase">Tabela de Dosagem (U-100)</h5>
                                    </div>
                                    <div class="bg-gray-900/40 p-4">
                                        <div class="overflow-x-auto">
                                            <table class="w-full text-left text-sm">
                                            <thead class="bg-emerald-900/20 text-emerald-200 uppercase text-xs font-bold tracking-wider">
                                                <tr>
                                                    <th class="px-4 py-3">Protocolo</th>
                                                    <th class="px-4 py-3">Dose (mg)</th>
                                                    <th class="px-4 py-3">Unidades (U-100)</th>
                                                    <th class="px-4 py-3">Frequência</th>
                                                </tr>
                                            </thead>
                                            <tbody class="divide-y divide-white/5 bg-gray-900/40">
                                                <tr class="hover:bg-white/5 transition-colors">
                                                    <td class="px-4 py-3 font-medium text-white">Iniciante</td>
                                                    <td class="px-4 py-3 text-gray-300">1.0 mg</td>
                                                    <td class="px-4 py-3 font-bold text-emerald-400">4 Unidades</td>
                                                    <td class="px-4 py-3 text-gray-300">Aplicação diária</td>
                                                </tr>
                                                <tr class="hover:bg-white/5 transition-colors">
                                                    <td class="px-4 py-3 font-medium text-white">Padrão</td>
                                                    <td class="px-4 py-3 text-gray-300">2.0 mg</td>
                                                    <td class="px-4 py-3 font-bold text-emerald-400">8 Unidades</td>
                                                    <td class="px-4 py-3 text-gray-300">Dose comum (pele/cabelo)</td>
                                                </tr>
                                                <tr class="hover:bg-white/5 transition-colors">
                                                    <td class="px-4 py-3 font-medium text-white">Intensivo</td>
                                                    <td class="px-4 py-3 text-gray-300">5.0 mg</td>
                                                    <td class="px-4 py-3 font-bold text-emerald-400">20 Unidades</td>
                                                    <td class="px-4 py-3 text-gray-300">Fase de ataque (curta)</td>
                                                </tr>
                                                <tr class="hover:bg-white/5 transition-colors">
                                                    <td class="px-4 py-3 font-medium text-white">Cicatrização</td>
                                                    <td class="px-4 py-3 text-gray-300">3.0 mg</td>
                                                    <td class="px-4 py-3 font-bold text-emerald-400">12 Unidades</td>
                                                    <td class="px-4 py-3 text-gray-300">Pós-cirúrgico</td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>

                                <!-- Protocolo Cicatriz -->
                                <div class="overflow-hidden rounded-xl border border-emerald-500/30 shadow-lg">
                                    <div class="bg-emerald-900/30 px-4 py-3 border-b border-emerald-500/20">
                                        <h5 class="text-emerald-200 font-bold text-sm uppercase">Protocolo de Cicatriz/Lesão</h5>
                                    </div>
                                    <div class="bg-gray-900/40 p-4">
                                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm">
                                            <div>
                                                <p class="text-gray-400 mb-1">Dose</p>
                                                <p class="text-white font-semibold">5mg</p>
                                                <p class="text-gray-500 text-xs mt-1">(10 unidades)</p>
                                            </div>
                                            <div>
                                                <p class="text-gray-400 mb-1">Frequência</p>
                                                <p class="text-white font-semibold">Diariamente por 2 semanas</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="bg-emerald-900/10 p-3 text-xs text-emerald-300 flex items-start gap-2 border-t border-white/5 mt-4 rounded-b-xl">
                                <span class="text-emerald-500 font-bold">⚠️</span>
                                <div>
                                    <p class="mb-1"><strong>Nota:</strong> GHK-Cu pode causar leve desconforto no local. Aplique lentamente.</p>
                                    <p><strong>Como mitigar:</strong></p>
                                    <ol class="list-decimal list-inside ml-2 mt-1 space-y-1">
                                        <li>Injete muito lentamente.</li>
                                        <li>Evite misturar com compostos incompatíveis.</li>
                                        <li>Massageie o local após aplicar se necessário.</li>
                                    </ol>
                                </div>
                            </div>
                        </div>

                        <div class="bg-gray-900/50 border border-white/10 rounded-lg p-4">
                            <p class="text-sm text-gray-400 mb-1">Pureza Certificada</p>
                            <p class="text-emerald-400 font-bold text-2xl">>99.4% (Cosmetic/Research Grade)</p>
                        </div>

                        <div class="bg-gray-900/50 border border-white/10 rounded-lg p-4">
                            <p class="text-sm text-gray-400 mb-1">Aplicação</p>
                            <p class="text-white">Pesquisa em estética regenerativa, reparo cutâneo e crescimento capilar</p>
                        </div>
                    </div>

                    <a
                        href="/contato"
                        data-wa-product="GHK-Cu 50mg (Copper Peptide)"
                        data-wa-phone="5511911387063"
                        class="block w-full md:w-auto px-8 py-4 bg-gradient-to-r from-emerald-500 to-emerald-600 text-white font-bold rounded-lg hover:from-emerald-400 hover:to-emerald-500 transition-all duration-300 text-center shadow-lg shadow-emerald-500/30 hover:shadow-xl hover:shadow-emerald-500/50 active:scale-[0.98] border border-emerald-400/30 hover:border-emerald-400/50"
                    >
                        Encontrar Fornecedor
                    </a>
                </div>
            </div>
        </section>

        <!-- Área Técnica - Accordions -->
        <section class="max-w-4xl mx-auto">
            <h2 class="text-3xl md:text-4xl font-bold mb-8 text-center bg-clip-text text-transparent bg-gradient-to-r from-emerald-400 to-emerald-600">
                Informações Técnicas
            </h2>

            <div class="space-y-4">
                <!-- Accordion 1: O que é GHK-Cu? -->
                <Accordion title="O que é GHK-Cu?">
                    <div class="prose prose-invert max-w-none">
                        <p class="text-gray-300 mb-4">
                            O Peptídeo de Cobre é o <strong class="text-white">"Santo Graal"</strong> da estética regenerativa. É o único capaz de <strong class="text-white">remodelar a pele</strong> de dentro para fora, aumentando a produção de colágeno em até 70% e reduzindo linhas finas.
                        </p>
                        <p class="text-gray-300 mb-4">
                            <strong class="text-white">A Cor:</strong> Quando misturado, o líquido torna-se <strong class="text-blue-400">Azul Royal</strong> intenso, característica natural dos íons de cobre.
                        </p>
                        <div class="bg-emerald-900/20 border border-emerald-500/30 rounded-lg p-3 mb-4">
                                <p class="text-sm text-emerald-200">
                                <strong class="text-emerald-300">Diferencial Orion:</strong> Frasco Puro de <strong>50mg</strong>. Concentração Final: <strong>25 mg/ml</strong>.
                            </p>
                        </div>
                        <div class="bg-red-900/20 border border-red-500/30 p-4 rounded text-sm text-red-200">
                            <strong>Nota de Pesquisa:</strong> Este composto é destinado exclusivamente para fins de pesquisa científica e não deve ser utilizado para consumo humano ou veterinário sem aprovação regulatória adequada.
                        </div>
                    </div>
                </Accordion>

                <!-- Accordion 2: Mecanismo de Ação -->
                <Accordion title="Mecanismo de Ação (Ciência)">
                    <div class="prose prose-invert max-w-none">
                        <p class="text-gray-300 mb-6">O mecanismo de ação demonstra uma atividade regenerativa cutânea em modelos de pesquisa:</p>
                        
                        <ul class="space-y-4 list-none">
                            <li class="flex gap-3">
                                <span class="text-emerald-500 font-bold">Síntese de Colágeno:</span>
                                <span class="text-gray-400">Aumenta a produção de colágeno tipo I e III em até 70%, essencial para a estrutura e elasticidade da pele.</span>
                            </li>
                            <li class="flex gap-3">
                                <span class="text-emerald-500 font-bold">Ativação de Células-Tronco:</span>
                                <span class="text-gray-400">Promove a diferenciação de células-tronco em fibroblastos, aumentando a renovação celular da pele.</span>
                            </li>
                            <li class="flex gap-3">
                                <span class="text-emerald-500 font-bold">Antioxidante:</span>
                                <span class="text-gray-400">O cobre atua como cofator enzimático para superóxido dismutase (SOD), protegendo contra danos oxidativos.</span>
                            </li>
                            <li class="flex gap-3">
                                <span class="text-emerald-500 font-bold">Crescimento Capilar:</span>
                                <span class="text-gray-400">Estimula a proliferação de células do folículo piloso e aumenta a fase anágena do ciclo capilar.</span>
                            </li>
                        </ul>

                        <p class="text-xs text-gray-600 mt-6 italic">Referência: Os mecanismos descritos são baseados em estudos pré-clínicos e clínicos (in vivo/in vitro).</p>
                    </div>
                </Accordion>

                <!-- Accordion 3: Protocolo de Reconstituição -->
                <Accordion title="Protocolo de Reconstituição">
                    <div class="prose prose-invert max-w-none">
                        <div class="mb-8">
                            <h4 class="text-white font-bold mb-4">Guia de Mistura (Frasco 50mg)</h4>
                            <p class="text-gray-300 mb-4 text-emerald-300"><strong>Aviso: Solução Concentrada.</strong></p>
                            <p class="text-gray-300 mb-4">Devido à concentração (50mg), a mistura resulta em uma solução concentrada — manuseie com cuidado.</p>
                            <ol class="list-decimal list-inside space-y-3 text-gray-300">
                                <li><strong class="text-white">Diluente:</strong> Utilize <strong>2ml</strong> (200 unidades) de Água Bacteriostática. (Se possível, use 3ml se tiver seringa maior, mas o cálculo abaixo é para 2ml).</li>
                                <li><strong class="text-white">Processo:</strong> Injete a água e aguarde pacientemente. Pode levar <strong>15 minutos</strong> para dissolver completamente todo o pó.</li>
