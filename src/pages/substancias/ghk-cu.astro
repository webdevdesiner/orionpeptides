<script>
    // Calculadora Rápida para GHK-Cu (50mg em 2ml)
    document.addEventListener('DOMContentLoaded', () => {
        const formGHKCu = document.getElementById('calculadoraGHKCu') as HTMLFormElement | null;
        const resultadoGHKCu = document.getElementById('resultadoGHKCu');
        const resultadoUIGHKCu = document.getElementById('resultadoUIGHKCu');
        const resultadoVolumeGHKCu = document.getElementById('resultadoVolumeGHKCu');
        const avisoVolumePequeno = document.getElementById('avisoVolumePequeno');

        if (!formGHKCu || !resultadoGHKCu || !resultadoUIGHKCu || !resultadoVolumeGHKCu || !avisoVolumePequeno) {
            return;
        }

        formGHKCu.addEventListener('submit', (e) => {
            e.preventDefault();

            const inputDose = document.getElementById('doseGHKCu') as HTMLInputElement | null;
            if (!inputDose) return;

            // Valores fixos para GHK-Cu Orion (50mg em 2ml)
            const tamanhoFrasco = 50; // mg
            const quantidadeAgua = 2; // ml
            const doseDesejada = parseFloat(inputDose.value); // mg

            // Validação
            if (isNaN(doseDesejada) || doseDesejada <= 0 || doseDesejada > tamanhoFrasco) {
                alert('Por favor, insira uma dose válida entre 0 e 50mg.');
                return;
            }

            // Cálculo: 50mg em 2ml = 25mg/ml
            // Regra: Cada 4 unidades = 1mg (U-100 -> 100 unidades/ml)
            const unidadesPorMg = 4;
            const unidadesUI = Math.round(doseDesejada * unidadesPorMg);
            const volumeMl = doseDesejada / 25; // ml (1mg = 0.04ml)

            // Exibir resultados
            resultadoUIGHKCu.textContent = unidadesUI.toFixed(0);
            resultadoVolumeGHKCu.textContent = `${volumeMl.toFixed(3)} ml`;

            // Mostrar aviso se volume for menor que 5 unidades
            if (unidadesUI < 5) {
                avisoVolumePequeno.classList.remove('hidden');
            } else {
                avisoVolumePequeno.classList.add('hidden');
            }

            // Mostrar área de resultado
            resultadoGHKCu.classList.remove('hidden');
            // Garantir que a seção de Administração fique visível (se estiver abaixo)
            try {
                const adminSection = document.getElementById('administracaoGHKSection') as HTMLElement | null;
                if (adminSection) {
                    // se estiver dentro de um accordion, abrir o accordion primeiro
                    const accordionContent = adminSection.closest('[data-accordion-content]') as HTMLElement | null;
                    if (accordionContent) {
                        const accId = accordionContent.getAttribute('data-accordion-content');
                        if (accId) {
                            const headerButton = document.querySelector(`[data-accordion-id="${accId}"]`) as HTMLElement | null;
                            if (headerButton && headerButton.getAttribute('aria-expanded') !== 'true') {
                                headerButton.click();
                            }
                        }
                    }

                    // dar prioridade visual e centralizar a seção na viewport
                    adminSection.style.position = adminSection.style.position || 'relative';
                    adminSection.style.zIndex = '60';
                    adminSection.scrollIntoView({ behavior: 'smooth', block: 'center' });
                }
            } catch (err) { /* ignore */ }
        });
    });
</script>

