<script>
	document.addEventListener('DOMContentLoaded', () => {
		const form = document.getElementById('calculadoraProduto') as HTMLFormElement | null;
		const resultado = document.getElementById('resultadoProduto');
		const resultadoUI = document.getElementById('resultadoUIProduto');
		const resultadoVolume = document.getElementById('resultadoVolumeProduto');
		if (!form || !resultado || !resultadoUI || !resultadoVolume) return;

		form.addEventListener('submit', (e) => {
			e.preventDefault();
			const inputDose = document.getElementById('doseProduto') as HTMLInputElement | null;
			if (!inputDose) return;

			const tamanhoFrasco = 11;
			const quantidadeAgua = 2;
			const doseDesejada = parseFloat(inputDose.value);

			if (isNaN(doseDesejada) || doseDesejada <= 0 || doseDesejada > tamanhoFrasco) {
				alert(`Por favor, insira uma dose válida entre 0 e ${tamanhoFrasco}mg.`);
				return;
			}

			const mgPorMl = tamanhoFrasco / quantidadeAgua;
			const unidadesUI = (doseDesejada / mgPorMl) * 100;
			const volumeMl = doseDesejada / mgPorMl;

			resultadoUI.textContent = unidadesUI.toFixed(1);
			resultadoVolume.textContent = `${volumeMl.toFixed(2)} ml`;
			resultado.classList.remove('hidden');
		});
	});
</script>

