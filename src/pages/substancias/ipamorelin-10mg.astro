---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Accordion from '../../components/Accordion.astro';

const produtoNome = 'Ipamorelin 10mg (Standard Dose)';
const concentracao = '10mg Liofilizado';
const imagemCatalogo = '/image/catalogo/tesamorelin.png';
const imagemProduto = '/image/produtos/ipamorelin.png';
const imagemAlt = 'Frasco de Ipamorelin 10mg Orion Peptides para pesquisa laboratorial de longevidade e regeneração.';
const subtitulo = 'O Secretagogo de GH Mais Seletivo para Recuperação, Longevidade e Anti-Aging.';
const descricao =
	'O Ipamorelin é um pentapeptídeo sintético de terceira geração da classe dos secretagogos de hormônio do crescimento (GHRP). Reconhecido por sua precisão e alta seletividade, ele estimula pulsos fisiológicos de GH sem causar picos indesejados de cortisol (hormônio do estresse) ou prolactina. É amplamente pesquisado em protocolos de longevidade, otimização do sono, queima de gordura e regeneração celular.';
const diferencialOrion =
	'Sintetizado sob rigoroso padrão ouro (pureza superior a 99%), garantindo máxima estabilidade molecular e afinidade perfeita aos receptores GHS-R1a.';

const tamanhoFrascoMg = 10;
const quantidadeAguaMl = 2;

const layoutTitle = `${produtoNome} | Guia Técnico | Orion Peptides`;
const layoutDescription =
	'Ipamorelin 10mg Orion Peptides. O secretagogo de GH mais seletivo para protocolos de longevidade, hipertrofia e queima de gordura. Grau laboratorial puro.';
const layoutOgImage = '/image/produtos/ipamorelin.png';
---

<Layout title={layoutTitle} description={layoutDescription} ogImage={layoutOgImage}>
	<Header />
	<main class="container mx-auto px-4 py-12 md:py-16">
		<section class="mb-16">
			<div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12 items-start">
				<div class="space-y-6">
					<div class="md:hidden flex items-center justify-center gap-3 mb-3">
						<div
							class="w-10 h-10 rounded-full bg-white/5 border border-blue-500/20 flex items-center justify-center flex-shrink-0 shadow-[0_0_8px_rgba(59,130,246,0.15)]"
						>
							<img src={imagemCatalogo} alt={`Ícone ${produtoNome}`} class="w-8 h-8 object-contain" />
						</div>
						<h1 class="text-2xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-white via-blue-200 to-blue-400">
							{produtoNome}
						</h1>
					</div>

					<figure class="w-full max-w-md bg-gray-900/50 border border-white/10 rounded-2xl overflow-hidden">
						<div class="px-4 py-2.5 border-b border-white/10 bg-black/20">
							<figcaption class="text-xs text-gray-400 uppercase tracking-wider font-medium">
								{produtoNome} — Imagem do produto
							</figcaption>
						</div>
						<div class="relative p-6 flex items-center justify-center">
							<a
								href="/contato"
								data-wa-product={produtoNome}
								data-wa-phone="5511911387063"
								class="absolute top-4 left-4 z-30 inline-flex flex-col items-center justify-center px-2.5 py-1.5 rounded bg-gradient-to-br from-blue-400 via-blue-500 to-blue-600 hover:from-blue-300 hover:via-blue-400 hover:to-blue-500 text-white text-[10px] font-bold uppercase tracking-wide shadow-md shadow-blue-500/30 hover:shadow-blue-400/50 border border-blue-300/50 hover:scale-105 active:scale-95 transition-all duration-300 leading-tight text-center"
							>
								<span>Encontrar</span><span>fornecedor</span>
							</a>
							<img src={imagemProduto} alt={imagemAlt} class="w-full h-auto object-contain rounded-lg" />
						</div>
					</figure>

					<!-- Mobile: subtítulo e descrição abaixo da imagem -->
					<div class="md:hidden">
						<p class="text-xl text-gray-400 font-medium mb-3">{subtitulo}</p>
						<p class="text-gray-500 text-sm leading-relaxed mb-6">{descricao}</p>
					</div>



					<div class="flex flex-col gap-4">
						<div
							class="bg-gray-900/50 backdrop-blur-md border border-blue-500/20 rounded-xl p-4 hover:border-blue-500/40 transition-all duration-300"
						>
							<div class="flex flex-col items-center text-center space-y-2">
								<svg
									xmlns="http://www.w3.org/2000/svg"
									class="w-5 h-5 text-blue-400"
									fill="none"
									viewBox="0 0 24 24"
									stroke="currentColor"
								>
									<path
										stroke-linecap="round"
										stroke-linejoin="round"
										stroke-width="2"
										d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"
									/>
								</svg>
								<p class="text-xs text-gray-400 uppercase tracking-wider">Potência Total</p>
								<p class="text-sm text-white font-semibold">{concentracao}</p>
							</div>
						</div>

						<div
							class="bg-gray-900/50 backdrop-blur-md border border-blue-500/20 rounded-xl p-4 hover:border-blue-500/40 transition-all duration-300"
						>
							<div class="flex flex-col items-center text-center space-y-2">
								<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-blue-400" fill="currentColor" viewBox="0 0 24 24">
									<path d="M12 2.69c-3.5 0-6.31 2.81-6.31 6.31 0 3.5 6.31 10.31 6.31 10.31S18.31 12.5 18.31 9c0-3.5-2.81-6.31-6.31-6.31z" />
								</svg>
								<p class="text-xs text-gray-400 uppercase tracking-wider">Inclui</p>
								<p class="text-sm text-white font-semibold">🎁 Inclui 10ml de Água Bacteriostática</p>
							</div>
						</div>

						<div
							class="bg-gray-900/50 backdrop-blur-md border border-blue-500/20 rounded-xl p-4 hover:border-blue-500/40 transition-all duration-300"
						>
							<div class="flex flex-col items-center text-center space-y-2">
								<svg
									xmlns="http://www.w3.org/2000/svg"
									class="w-5 h-5 text-blue-400"
									fill="none"
									viewBox="0 0 24 24"
									stroke="currentColor"
								>
									<path
										stroke-linecap="round"
										stroke-linejoin="round"
										stroke-width="2"
										d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"
									/>
								</svg>
								<p class="text-xs text-gray-400 uppercase tracking-wider">Temperatura</p>
								<p class="text-sm text-white font-semibold">2°C a 8°C (Geladeira) após a reconstituição</p>
							</div>
						</div>

						<div
							class="bg-gray-900/50 backdrop-blur-md border border-blue-500/20 rounded-xl p-4 hover:border-blue-500/40 transition-all duration-300"
						>
							<div class="flex flex-col items-center text-center space-y-2">
								<svg
									xmlns="http://www.w3.org/2000/svg"
									class="w-5 h-5 text-blue-400"
									fill="none"
									viewBox="0 0 24 24"
									stroke="currentColor"
								>
									<path
										stroke-linecap="round"
										stroke-linejoin="round"
										stroke-width="2"
										d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"
									/>
								</svg>
								<p class="text-xs text-gray-400 uppercase tracking-wider">Diluição Recomendada</p>
								<p class="text-sm text-white font-semibold">
									Requer {quantidadeAguaMl}ml de Água Bacteriostática (10 UI = 500mcg)
								</p>
							</div>
						</div>
					</div>
				</div>

				<div class="space-y-6">
					<div>
						<div class="hidden md:flex items-center gap-4 mb-2">
							<div
								class="w-14 h-14 rounded-full bg-white/5 border border-blue-500/20 flex items-center justify-center flex-shrink-0 shadow-[0_0_12px_rgba(59,130,246,0.25)]"
							>
								<img src={imagemCatalogo} alt="" class="w-10 h-10 object-contain" />
							</div>
							<h1 class="text-3xl md:text-5xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-white via-blue-200 to-blue-400">
								{produtoNome}
							</h1>
						</div>
						<p class="text-xl text-gray-400 font-medium mb-3 hidden md:block">{subtitulo}</p>
						<p class="text-gray-500 text-sm leading-relaxed mb-6 hidden md:block">{descricao}</p>
						<div class="bg-blue-900/20 border border-blue-500/30 rounded-lg p-3 mb-4">
							<p class="text-sm text-blue-200">
								<strong class="text-blue-300">Diferencial Orion:</strong> {diferencialOrion}
							</p>
						</div>
					</div>

					<div class="mb-8">
						<h3 class="text-2xl md:text-3xl font-bold mb-6 text-white">Benefícios Pesquisados</h3>
						<div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6">
							<div class="flex flex-col items-center text-center space-y-3 p-4 hover:-translate-y-2 transition-all duration-300 cursor-default">
								<svg
									xmlns="http://www.w3.org/2000/svg"
									class="w-8 h-8 md:w-10 md:h-10 text-blue-400 drop-shadow-[0_0_8px_rgba(59,130,246,0.5)]"
									fill="none"
									viewBox="0 0 24 24"
									stroke="currentColor"
								>
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
								</svg>
								<h4 class="text-white font-bold text-sm md:text-base">Liberação Seletiva de GH</h4>
								<p class="text-gray-400 text-xs md:text-sm">Estimula pulsos de GH sem elevar cortisol ou prolactina</p>
							</div>

							<div class="flex flex-col items-center text-center space-y-3 p-4 hover:-translate-y-2 transition-all duration-300 cursor-default">
								<svg
									xmlns="http://www.w3.org/2000/svg"
									class="w-8 h-8 md:w-10 md:h-10 text-blue-400 drop-shadow-[0_0_8px_rgba(59,130,246,0.5)]"
									fill="none"
									viewBox="0 0 24 24"
									stroke="currentColor"
								>
									<path
										stroke-linecap="round"
										stroke-linejoin="round"
										stroke-width="2"
										d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"
									/>
								</svg>
								<h4 class="text-white font-bold text-sm md:text-base">Anti-Aging e Sono</h4>
								<p class="text-gray-400 text-xs md:text-sm">Suporte ao sono reparador e composição corporal</p>
							</div>

							<div class="flex flex-col items-center text-center space-y-3 p-4 hover:-translate-y-2 transition-all duration-300 cursor-default">
								<svg
									xmlns="http://www.w3.org/2000/svg"
									class="w-8 h-8 md:w-10 md:h-10 text-blue-400 drop-shadow-[0_0_8px_rgba(59,130,246,0.5)]"
									fill="none"
									viewBox="0 0 24 24"
									stroke="currentColor"
								>
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3v18h18M7 15l3-3 3 3 7-7" />
								</svg>
								<h4 class="text-white font-bold text-sm md:text-base">Queima de Gordura</h4>
								<p class="text-gray-400 text-xs md:text-sm">Otimiza metabolismo lipídico e oxidação de gordura</p>
							</div>

							<div class="flex flex-col items-center text-center space-y-3 p-4 hover:-translate-y-2 transition-all duration-300 cursor-default">
								<svg
									xmlns="http://www.w3.org/2000/svg"
									class="w-8 h-8 md:w-10 md:h-10 text-blue-400 drop-shadow-[0_0_8px_rgba(59,130,246,0.5)]"
									fill="none"
									viewBox="0 0 24 24"
									stroke="currentColor"
								>
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
								</svg>
								<h4 class="text-white font-bold text-sm md:text-base">Preservação Muscular</h4>
								<p class="text-gray-400 text-xs md:text-sm">Suporte à recuperação e síntese proteica</p>
							</div>
						</div>
					</div>

					<div class="space-y-4">
						<div class="mt-8 border-t border-white/10 pt-6">
							<h4 class="text-white font-bold mb-4 flex items-center gap-2">
								<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-blue-400" viewBox="0 0 20 20" fill="currentColor">
									<path
										fill-rule="evenodd"
										d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z"
										clip-rule="evenodd"
									/>
								</svg>
								Protocolo de Pesquisa Sugerido
							</h4>

							<div class="overflow-hidden rounded-xl border border-white/10 shadow-lg">
								<div class="overflow-x-auto">
									<table class="w-full text-left text-sm">
										<thead class="bg-blue-900/20 text-blue-200 uppercase text-xs font-bold tracking-wider">
											<tr>
												<th class="px-4 py-3">Fase de Estudo</th>
												<th class="px-4 py-3">Dose Diária</th>
												<th class="px-4 py-3 text-white bg-blue-600/20 border-l border-blue-500/30">
													Volume na Seringa (Ref: {quantidadeAguaMl}ml água)
												</th>
												<th class="px-4 py-3">Frequência</th>
											</tr>
										</thead>
										<tbody class="divide-y divide-white/5 bg-gray-900/40">
											<tr class="hover:bg-white/5 transition-colors">
												<td class="px-4 py-3 font-medium text-white">Adaptação (Semanas 1 a 2)</td>
												<td class="px-4 py-3 text-gray-300">0,2mg (200mcg)</td>
												<td class="px-4 py-3 font-bold text-blue-400 border-l border-white/5">4 unidades (0,04 ml)</td>
												<td class="px-4 py-3 text-gray-300">1x ao dia (antes de dormir)</td>
											</tr>
											<tr class="hover:bg-white/5 transition-colors">
												<td class="px-4 py-3 font-medium text-white">Manutenção (Semanas 3 a 12)</td>
												<td class="px-4 py-3 text-gray-300">0,3mg a 0,4mg</td>
												<td class="px-4 py-3 font-bold text-blue-400 border-l border-white/5">6 a 8 unidades (0,06 a 0,08 ml)</td>
												<td class="px-4 py-3 text-gray-300">1 a 2x ao dia (jejum e/ou antes de dormir)</td>
											</tr>
										</tbody>
									</table>
									<div class="bg-blue-900/10 p-3 text-xs text-blue-300 flex items-start gap-2 border-t border-white/5">
										<span class="text-blue-500 font-bold">💡</span>
										<p>
											<strong>Nota:</strong> Em estudos, ciclos duram 12 a 16 semanas; recomenda-se pausa (off) de metade do tempo. Jejum
											de ~2h antes da aplicação pode otimizar os pulsos de GH.
										</p>
									</div>
								</div>
							</div>
						</div>

						<div class="bg-gray-900/50 border border-white/10 rounded-lg p-4">
							<p class="text-sm text-gray-400 mb-1">Pureza Certificada</p>
							<p class="text-blue-400 font-bold text-2xl">&gt;99.2% (HPLC) - High Purity</p>
						</div>
						<div class="bg-gray-900/50 border border-white/10 rounded-lg p-4">
							<p class="text-sm text-gray-400 mb-1">Aplicação</p>
							<p class="text-white">Pesquisa em longevidade, composição corporal, sono e recuperação</p>
						</div>
					</div>

					<a
						href="/contato"
						data-wa-product={produtoNome}
						data-wa-phone="5511911387063"
						class="block w-full md:w-auto px-8 py-4 bg-gradient-to-r from-blue-600 to-blue-500 text-white font-bold rounded-lg hover:from-blue-500 hover:to-blue-400 transition-all duration-300 text-center shadow-lg shadow-blue-500/30 hover:shadow-xl hover:shadow-blue-500/50 active:scale-[0.98] border border-blue-400/30 hover:border-blue-400/50"
					>
						Encontrar Fornecedor
					</a>
				</div>
			</div>
		</section>

		<section class="max-w-4xl mx-auto">
			<h2 class="text-3xl md:text-4xl font-bold mb-8 text-center bg-clip-text text-transparent bg-gradient-to-r from-blue-400 to-blue-600">
				Informações Técnicas
			</h2>

			<div class="space-y-4">
				<Accordion title="O que é o Ipamorelin?">
					<div class="prose prose-invert max-w-none">
						<p class="text-gray-300 mb-4">
							O Ipamorelin (Aib-His-D-2-Nal-D-Phe-Lys-NH2) é um peptídeo sintético projetado para imitar a ação da grelina no organismo.
							Diferente de outros peptídeos da família GHRP (como o GHRP-6 ou GHRP-2), o Ipamorelin é extremamente seletivo.
						</p>
						<p class="text-gray-300 mb-4">
							Isso significa que ele fornece elevação do hormônio do crescimento (GH) com um perfil mais refinado, com impacto mínimo em cortisol e
							prolactina em comparação a outros secretagogos, o que o torna um candidato frequente para pesquisas de longo prazo.
						</p>
						<div class="bg-blue-900/20 border border-blue-500/30 rounded-lg p-3 mb-4">
							<p class="text-sm text-blue-200"><strong class="text-blue-300">Diferencial Orion:</strong> {diferencialOrion}</p>
						</div>
						<div class="bg-red-900/20 border border-red-500/30 p-4 rounded text-sm text-red-200">
							<strong>Nota de Pesquisa:</strong> Este composto é destinado exclusivamente para fins de pesquisa científica e não deve ser utilizado para
							consumo humano ou veterinário sem aprovação regulatória adequada.
						</div>
					</div>
				</Accordion>

				<Accordion title="Mecanismo de Ação (Seletividade e Pulsos de GH)">
					<div class="prose prose-invert max-w-none">
						<ul class="space-y-4 list-none">
							<li class="flex gap-3">
								<span class="text-blue-500 font-bold">GHS-R1a:</span>
								<span class="text-gray-400">Ligação seletiva ao receptor GHS-R1a na hipófise, promovendo liberação de GH.</span>
							</li>
							<li class="flex gap-3">
								<span class="text-blue-500 font-bold">Pulso fisiológico:</span>
								<span class="text-gray-400">Gera pulso mais lento e prolongado de GH, imitando o ritmo natural do corpo.</span>
							</li>
							<li class="flex gap-3">
								<span class="text-blue-500 font-bold">Somatostatina:</span>
								<span class="text-gray-400">Reduz o “freio” fisiológico (somatostatina), facilitando a liberação de GH.</span>
							</li>
							<li class="flex gap-3">
								<span class="text-blue-500 font-bold">Perfil hormonal:</span>
								<span class="text-gray-400">Baixo impacto em ACTH/cortisol e prolactina quando comparado a outros GHRPs.</span>
							</li>
						</ul>
					</div>
				</Accordion>

				<Accordion title="Protocolo de Reconstituição (Ipamorelin 10mg)">
					<div class="prose prose-invert max-w-none">
						<div class="mb-8">
							<h4 class="text-white font-bold mb-4">Guia de Mistura (Frasco 10mg)</h4>
							<ol class="list-decimal list-inside space-y-3 text-gray-300">
								<li><strong class="text-white">Higienização:</strong> Limpe o septo com álcool 70%.</li>
								<li>
									<strong class="text-white">Diluente:</strong> Extraia <strong>{quantidadeAguaMl}ml</strong> de água estéril/bacteriostática.
								</li>
								<li><strong class="text-white">Processo:</strong> Injete lentamente pela parede do frasco.</li>
								<li><strong class="text-white">Dissolução:</strong> Gire suavemente (não agite) até dissolver.</li>
								<li><strong class="text-white">Armazenamento:</strong> Refrigere (2–8°C) após reconstituído.</li>
							</ol>
							<div class="bg-gray-800/50 border border-blue-500/20 rounded-lg p-4 mt-6 text-sm text-gray-300">
								<strong class="text-white">Observação:</strong> a solução deve ficar cristalina. Evite calor excessivo e luz direta para reduzir
								degradação.
							</div>
						</div>

						<div class="bg-gray-800/50 border border-blue-500/20 rounded-lg p-6 mt-4">
							<h4 class="text-white font-bold mb-4 flex items-center gap-2">
								<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
								</svg>
