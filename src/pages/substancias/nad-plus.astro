<script>
    // Calculadora Rápida para NAD+ (500mg em 2ml)
    document.addEventListener('DOMContentLoaded', () => {
        const formNAD = document.getElementById('calculadoraNAD') as HTMLFormElement | null;
        const resultadoNAD = document.getElementById('resultadoNAD');
        const resultadoUINAD = document.getElementById('resultadoUINAD');
        const resultadoVolumeNAD = document.getElementById('resultadoVolumeNAD');

        if (!formNAD || !resultadoNAD || !resultadoUINAD || !resultadoVolumeNAD) {
            return;
        }

        formNAD.addEventListener('submit', (e) => {
            e.preventDefault();

            const inputDose = document.getElementById('doseNAD') as HTMLInputElement | null;
            if (!inputDose) return;

            // Valores fixos para NAD+ Orion (500mg em 2ml)
            const tamanhoFrasco = 500; // mg
            const quantidadeAgua = 2; // ml
            const doseDesejada = parseFloat(inputDose.value); // mg

            // Validação
            if (isNaN(doseDesejada) || doseDesejada <= 0 || doseDesejada > tamanhoFrasco) {
                alert('Por favor, insira uma dose válida entre 0 e 500mg.');
                return;
            }

            // Cálculo: 500mg em 2ml = 250mg/ml
            // Cada 10 unidades = 25mg
            // Para calcular unidades: doseDesejada (mg) / 25mg por 10 unidades * 10
            // Simplificando: doseDesejada / 2.5 unidades por mg = doseDesejada * 0.4 unidades por mg
            // Ou: (doseDesejada / 25) * 10 = doseDesejada * 0.4
            const unidadesUI = (doseDesejada / 25) * 10;
            const volumeMl = doseDesejada / 250; // 1mg = 0.004ml (250mg/ml)

            // Exibir resultados
            resultadoUINAD.textContent = unidadesUI.toFixed(0);
            resultadoVolumeNAD.textContent = `${volumeMl.toFixed(3)} ml`;

            // Mostrar área de resultado
            resultadoNAD.classList.remove('hidden');
        });
    });
</script>
