---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Accordion from '../../components/Accordion.astro';
---

<Layout title="NAD+ | Guia Técnico | Orion Peptides">
    <Header />
    
    <main class="container mx-auto px-4 py-12 md:py-16">
        <!-- Topo - Resumo do Produto -->
        <section class="mb-16">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12 items-start">
                <!-- Coluna 1: Imagem do Produto -->
                <div class="space-y-6">
                    <!-- Mobile-only: título acima da imagem com ícone -->
                    <div class="md:hidden flex items-center justify-center gap-3 mb-3">
                        <div class="w-10 h-10 rounded-full bg-white/5 border border-cyan-500/20 flex items-center justify-center flex-shrink-0 shadow-[0_0_8px_rgba(6,182,212,0.12)]">
                            <img src="/image/catalogo/nad-plus.png" alt="Ícone NAD+" class="w-8 h-8 object-contain" />
                        </div>
                        <h1 class="text-2xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-white via-cyan-200 to-cyan-400">
                            NAD+
                        </h1>
                    </div>
                    <figure class="w-full max-w-md bg-gray-900/50 border border-white/10 rounded-2xl overflow-hidden">
                        <div class="px-4 py-2.5 border-b border-white/10 bg-black/20">
                            <figcaption class="text-xs text-gray-400 uppercase tracking-wider font-medium">NAD+ — Imagem do produto</figcaption>
                        </div>
                        <div class="relative p-6 flex items-center justify-center">
                            <a
                                href="/contato"
                                class="absolute top-4 left-4 z-30 inline-flex flex-col items-center justify-center px-2.5 py-1.5 rounded bg-gradient-to-br from-amber-400 via-yellow-500 to-amber-600 hover:from-amber-300 hover:via-yellow-400 hover:to-amber-500 text-amber-950 text-[10px] font-bold uppercase tracking-wide shadow-md shadow-amber-500/30 hover:shadow-amber-400/50 border border-amber-300/50 hover:scale-105 active:scale-95 transition-all duration-300 leading-tight text-center"
                            >
                                <span>Encontrar</span>
                                <span>fornecedor</span>
                            </a>
                            <img 
                                src="/image/produtos/NAD+.png" 
                                alt="NAD+ - Nicotinamide Adenine Dinucleotide" 
                                class="w-full h-auto object-contain rounded-lg"
                            />
                        </div>
                    </figure>

                    <!-- Especificações Técnicas Rápidas -->
                    <div class="flex flex-col gap-4">
                        <!-- Card 1: Potência -->
                        <div class="bg-gray-900/50 backdrop-blur-md border border-cyan-500/20 rounded-xl p-4 hover:border-cyan-500/40 transition-all duration-300">
                            <div class="flex flex-col items-center text-center space-y-2">
                                <!-- Ícone Frasco -->
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
                                </svg>
                                <p class="text-xs text-gray-400 uppercase tracking-wider">Potência</p>
                                <p class="text-sm text-white font-semibold">500mg Liofilizado</p>
                            </div>
                        </div>

                        <!-- Card 2: Diluente -->
                        <div class="bg-gray-900/50 backdrop-blur-md border border-cyan-500/20 rounded-xl p-4 hover:border-cyan-500/40 transition-all duration-300">
                            <div class="flex flex-col items-center text-center space-y-2">
                                <!-- Ícone Gota -->
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-cyan-400" fill="currentColor" viewBox="0 0 24 24">
                                    <path d="M12 2.69c-3.5 0-6.31 2.81-6.31 6.31 0 3.5 6.31 10.31 6.31 10.31S18.31 12.5 18.31 9c0-3.5-2.81-6.31-6.31-6.31z"/>
                                </svg>
                                <p class="text-xs text-gray-400 uppercase tracking-wider">Requer</p>
                                <p class="text-sm text-white font-semibold">Água Bac. (Não incluso)</p>
                            </div>
                        </div>

                        <!-- Card 3: Armazenamento -->
                        <div class="bg-gray-900/50 backdrop-blur-md border border-cyan-500/20 rounded-xl p-4 hover:border-cyan-500/40 transition-all duration-300">
                            <div class="flex flex-col items-center text-center space-y-2">
                                <!-- Ícone Floco de Neve -->
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
                                </svg>
                                <p class="text-xs text-gray-400 uppercase tracking-wider">Temperatura</p>
                                <p class="text-sm text-white font-semibold">2°C a 8°C (Geladeira)</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Coluna 2: Informações -->
                <div class="space-y-6">
                    <div>
                        <div class="hidden md:flex items-center gap-4 mb-2">
                            <div class="w-14 h-14 rounded-full bg-white/5 border border-cyan-500/20 flex items-center justify-center flex-shrink-0 shadow-[0_0_12px_rgba(6,182,212,0.25)]">
                                <img src="/image/catalogo/nad-plus.png" alt="" class="w-10 h-10 object-contain" />
                            </div>
                            <h1 class="text-3xl md:text-5xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-white via-cyan-200 to-cyan-400">
                                NAD+
                            </h1>
                        </div>
                        <p class="text-xl text-gray-400 font-medium mb-3 hidden md:block">Nicotinamide Adenine Dinucleotide (Coenzima)</p>
                        <p class="text-gray-500 text-sm leading-relaxed mb-6 hidden md:block">
                            Conhecido como a <strong class="text-cyan-400">"Molécula da Juventude"</strong>, o NAD+ é uma coenzima encontrada em todas as células vivas, essencial para converter nutrientes em energia (ATP). Nossos níveis de NAD+ caem 50% conforme envelhecemos, causando fadiga e envelhecimento celular.
                        </p>
                        <div class="bg-cyan-900/20 border border-cyan-500/30 rounded-lg p-3 mb-4">
                            <p class="text-sm text-cyan-200">
                                <strong class="text-cyan-300">A Solução Orion:</strong> A reposição direta via injeção subcutânea é a única forma de garantir <strong>100% de biodisponibilidade</strong> (cápsulas orais são quase totalmente degradadas na digestão).
                            </p>
                        </div>
                    </div>

                    <!-- Seção Benefícios Pesquisados -->
                    <div class="mb-8">
                        <h3 class="text-2xl md:text-3xl font-bold mb-6 text-white">
                            Benefícios Pesquisados
                        </h3>
                        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6">
                            <!-- Benefício 1: Energia -->
                            <div class="flex flex-col items-center text-center space-y-3 p-4 hover:-translate-y-2 transition-all duration-300 cursor-default">
                                <!-- Ícone Energia -->
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 md:w-10 md:h-10 text-cyan-400 drop-shadow-[0_0_8px_rgba(6,182,212,0.5)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                                </svg>
                                <h4 class="text-white font-bold text-sm md:text-base">Energia</h4>
                                <p class="text-gray-400 text-xs md:text-sm">Energia mitocondrial</p>
                            </div>

                            <!-- Benefício 2: Clareza Mental -->
                            <div class="flex flex-col items-center text-center space-y-3 p-4 hover:-translate-y-2 transition-all duration-300 cursor-default">
                                <!-- Ícone Cérebro -->
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 md:w-10 md:h-10 text-cyan-400 drop-shadow-[0_0_8px_rgba(6,182,212,0.5)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
                                </svg>
                                <h4 class="text-white font-bold text-sm md:text-base">Clareza Mental</h4>
                                <p class="text-gray-400 text-xs md:text-sm">Elimina Brain Fog</p>
                            </div>

                            <!-- Benefício 3: Reparo de DNA -->
                            <div class="flex flex-col items-center text-center space-y-3 p-4 hover:-translate-y-2 transition-all duration-300 cursor-default">
                                <!-- Ícone DNA -->
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 md:w-10 md:h-10 text-cyan-400 drop-shadow-[0_0_8px_rgba(6,182,212,0.5)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                                </svg>
                                <h4 class="text-white font-bold text-sm md:text-base">Reparo de DNA</h4>
                                <p class="text-gray-400 text-xs md:text-sm">Ativação de sirtuínas</p>
                            </div>

                            <!-- Benefício 4: Longevidade -->
                            <div class="flex flex-col items-center text-center space-y-3 p-4 hover:-translate-y-2 transition-all duration-300 cursor-default">
                                <!-- Ícone Longevidade -->
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 md:w-10 md:h-10 text-cyan-400 drop-shadow-[0_0_8px_rgba(6,182,212,0.5)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                                </svg>
                                <h4 class="text-white font-bold text-sm md:text-base">Longevidade</h4>
                                <p class="text-gray-400 text-xs md:text-sm">Reversão do envelhecimento</p>
                            </div>
                        </div>
                    </div>

                    <div class="space-y-4">
                        <!-- Protocolo de Pesquisa Sugerido -->
                        <div class="mt-8 border-t border-white/10 pt-6">
                            <h4 class="text-white font-bold mb-4 flex items-center gap-2">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-cyan-400" viewBox="0 0 20 20" fill="currentColor">
                                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd" />
                                </svg>
                                Tabela de Dosagem (Titulação Obrigatória)
                            </h4>

                            <div class="overflow-hidden rounded-xl border border-white/10 shadow-lg">
                                <div class="overflow-x-auto">
                                    <table class="w-full text-left text-sm">
                                    <thead class="bg-cyan-900/20 text-cyan-200 uppercase text-xs font-bold tracking-wider">
                                        <tr>
                                            <th class="px-4 py-3">Fase</th>
                                            <th class="px-4 py-3">Dose Recomendada</th>
                                            <th class="px-4 py-3 text-white bg-cyan-600/20 border-l border-cyan-500/30">
                                                Volume na Seringa (Ref: 2ml água)
                                            </th>
                                            <th class="px-4 py-3">Frequência</th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-white/5 bg-gray-900/40">
                                        <tr class="hover:bg-white/5 transition-colors">
                                            <td class="px-4 py-3 font-medium text-white">Iniciante<br/><span class="text-xs text-cyan-300">(Semana 1)</span></td>
                                            <td class="px-4 py-3 text-gray-300">25 mg</td>
                                            <td class="px-4 py-3 font-bold text-cyan-400 border-l border-white/5">
                                                10 unidades (0.10 ml)
                                            </td>
                                            <td class="px-4 py-3 text-gray-300">3x na semana<br/><span class="text-xs">(Seg/Qua/Sex)</span></td>
                                        </tr>
                                        <tr class="hover:bg-white/5 transition-colors">
                                            <td class="px-4 py-3 font-medium text-white">Intermediário</td>
                                            <td class="px-4 py-3 text-gray-300">50 mg</td>
                                            <td class="px-4 py-3 font-bold text-cyan-400 border-l border-white/5">
                                                20 unidades (0.20 ml)
                                            </td>
                                            <td class="px-4 py-3 text-gray-300">3x na semana</td>
                                        </tr>
                                        <tr class="hover:bg-white/5 transition-colors">
                                            <td class="px-4 py-3 font-medium text-white">Avançado<br/><span class="text-xs text-cyan-300">(Biohacker)</span></td>
                                            <td class="px-4 py-3 text-gray-300">100 mg</td>
                                            <td class="px-4 py-3 font-bold text-cyan-400 border-l border-white/5">
                                                40 unidades (0.40 ml)
                                            </td>
                                            <td class="px-4 py-3 text-gray-300">3x na semana</td>
                                        </tr>
                                    </tbody>
                                </table>
                                
                                <div class="bg-cyan-900/10 p-3 text-xs text-cyan-300 flex items-start gap-2 border-t border-white/5">
                                    <span class="text-cyan-500 font-bold">⚠️</span>
                                    <div>
                                        <p class="mb-1"><strong>Dica de Ouro (O "NAD+ Burn"):</strong> O NAD+ concentrado pode causar uma leve ardência no local da aplicação.</p>
                                        <p><strong>Como evitar:</strong> Retire o frasco da geladeira 10 minutos antes para atingir temperatura ambiente e injete <strong>muito lentamente</strong>.</p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="bg-gray-900/50 border border-white/10 rounded-lg p-4">
                            <p class="text-sm text-gray-400 mb-1">Pureza Certificada</p>
                            <p class="text-cyan-400 font-bold text-2xl">>99.5% (Pharmaceutical Grade)</p>
                        </div>

                        <div class="bg-gray-900/50 border border-white/10 rounded-lg p-4">
                            <p class="text-sm text-gray-400 mb-1">Aplicação</p>
                            <p class="text-white">Pesquisa em cognição, energia celular e longevidade</p>
                        </div>
                    </div>

                    <a
                        href="#"
                        class="block w-full md:w-auto px-8 py-4 bg-gradient-to-r from-cyan-500 to-cyan-600 text-white font-bold rounded-lg hover:from-cyan-400 hover:to-cyan-500 transition-all duration-300 text-center shadow-lg shadow-cyan-500/30 hover:shadow-xl hover:shadow-cyan-500/50 active:scale-[0.98] border border-cyan-400/30 hover:border-cyan-400/50"
                    >
                        Encontrar Fornecedor
                    </a>
                </div>
            </div>
        </section>

        <!-- Área Técnica - Accordions -->
        <section class="max-w-4xl mx-auto">
            <h2 class="text-3xl md:text-4xl font-bold mb-8 text-center bg-clip-text text-transparent bg-gradient-to-r from-cyan-400 to-cyan-600">
                Informações Técnicas
            </h2>

            <div class="space-y-4">
                <!-- Accordion 1: O que é NAD+? -->
                <Accordion title="O que é NAD+?">
                    <div class="prose prose-invert max-w-none">
                        <p class="text-gray-300 mb-4">
                            Conhecido como a <strong class="text-white">"Molécula da Juventude"</strong>, o <strong class="text-white">NAD+ (Nicotinamide Adenine Dinucleotide)</strong> é uma coenzima encontrada em todas as células vivas, essencial para converter nutrientes em energia (ATP).
                        </p>
                        <p class="text-gray-300 mb-4">
                            <strong class="text-white">O Problema:</strong> Nossos níveis de NAD+ caem <strong class="text-cyan-400">50%</strong> conforme envelhecemos, causando fadiga e envelhecimento celular.
                        </p>
                        <p class="text-gray-300 mb-4">
                            <strong class="text-white">A Solução Orion:</strong> A reposição direta via injeção subcutânea é a única forma de garantir <strong class="text-cyan-400">100% de biodisponibilidade</strong> (cápsulas orais são quase totalmente degradadas na digestão).
                        </p>
                        <p class="text-gray-300 mb-4">
                            <strong class="text-white">Efeitos:</strong> Clareza mental instantânea (Brain Fog), energia mitocondrial e reparo de DNA.
                        </p>
                        <div class="bg-red-900/20 border border-red-500/30 p-4 rounded text-sm text-red-200">
                            <strong>Nota de Pesquisa:</strong> Este composto é destinado exclusivamente para fins de pesquisa científica e não deve ser utilizado para consumo humano ou veterinário sem aprovação regulatória adequada.
                        </div>
                    </div>
                </Accordion>

                <!-- Accordion 2: Mecanismo de Ação -->
                <Accordion title="Mecanismo de Ação (Ciência)">
                    <div class="prose prose-invert max-w-none">
                        <p class="text-gray-300 mb-6">O mecanismo de ação demonstra uma atividade essencial em modelos de pesquisa:</p>
                        
                        <ul class="space-y-4 list-none">
                            <li class="flex gap-3">
                                <span class="text-cyan-500 font-bold">Produção de ATP:</span>
                                <span class="text-gray-400">O NAD+ é essencial no ciclo de Krebs e na cadeia de transporte de elétrons mitocondrial, convertendo nutrientes em energia celular utilizável.</span>
                            </li>
                            <li class="flex gap-3">
                                <span class="text-cyan-500 font-bold">Ativação de Sirtuínas:</span>
                                <span class="text-gray-400">O NAD+ ativa as sirtuínas (SIRT1-SIRT7), proteínas que regulam o reparo de DNA, longevidade celular e resposta ao estresse.</span>
                            </li>
                            <li class="flex gap-3">
                                <span class="text-cyan-500 font-bold">Reparo de DNA:</span>
                                <span class="text-gray-400">Através da ativação da PARP (Poly ADP-ribose polymerase), o NAD+ facilita o reparo de danos ao DNA causados por estresse oxidativo e radiação.</span>
                            </li>
                            <li class="flex gap-3">
                                <span class="text-cyan-500 font-bold">Função Cognitiva:</span>
                                <span class="text-gray-400">O NAD+ melhora a função mitocondrial em neurônios, aumentando a produção de energia e reduzindo o "brain fog" associado ao envelhecimento.</span>
                            </li>
                        </ul>

                        <p class="text-xs text-gray-600 mt-6 italic">Referência: Os mecanismos descritos são baseados em estudos pré-clínicos e clínicos (in vivo/in vitro).</p>
                    </div>
                </Accordion>

                <!-- Accordion 3: Protocolo de Reconstituição -->
                <Accordion title="Protocolo de Reconstituição">
                    <div class="prose prose-invert max-w-none">
                        <div class="mb-8">
                            <h4 class="text-white font-bold mb-4">Guia de Mistura (Frasco 500mg)</h4>
                            <p class="text-gray-300 mb-4 text-cyan-300"><strong>Atenção: Este é um frasco de alta concentração.</strong></p>
                            <ol class="list-decimal list-inside space-y-3 text-gray-300">
                                <li><strong class="text-white">Diluente:</strong> Utilize <strong>2ml</strong> (200 unidades) de Água Bacteriostática.</li>
                                <li><strong class="text-white">Processo:</strong> O pó é denso. Injete a água e faça movimentos circulares até total transparência.</li>
                                <li><strong class="text-white">Matemática da Alta Concentração:</strong>
                                    <ul class="list-disc list-inside ml-4 mt-2 space-y-1">
                                        <li>500mg em 2ml = <strong>250mg por ml</strong></li>
                                        <li>Cada <strong>10 unidades</strong> na seringa de insulina contém <strong>25mg</strong> de NAD+</li>
                                        <li><em class="text-gray-400">Nota: As doses são pequenas em volume, mas potentes em mg.</em></li>
                                    </ul>
                                </li>
                                <li>Armazene em refrigeração (2-8°C) após reconstituído.</li>
                                <li>Use dentro do prazo de validade após reconstituição.</li>
                            </ol>
                        </div>

                        <!-- Calculadora Rápida Inline (em primeiro) -->
                        <div class="bg-gray-800/50 border border-cyan-500/20 rounded-lg p-6 mt-4">
                            <h4 class="text-white font-bold mb-4 flex items-center gap-2">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
                                </svg>
                                Calculadora Rápida (NAD+ 500mg)
                            </h4>
                            <form id="calculadoraNAD" class="space-y-4">
                                <div>
                                    <label for="doseNAD" class="block text-sm font-medium text-gray-300 mb-2">
                                        Dose Desejada (mg)
                                    </label>
                                    <input
                                        type="number"
                                        id="doseNAD"
                                        step="1"
                                        min="0"
                                        value="25"
                                        placeholder="Ex: 25"
                                        required
                                        class="w-full px-4 py-2 bg-black/50 border border-white/10 rounded-lg text-white placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500/50 transition-all duration-300"
                                    />
                                </div>
                                <button
                                    type="submit"
                                    class="w-full py-3 bg-gradient-to-r from-cyan-600 to-cyan-500 text-white font-bold rounded-lg hover:from-cyan-500 hover:to-cyan-400 transition-all duration-300 shadow-lg shadow-cyan-500/30 hover:shadow-xl hover:shadow-cyan-500/50 active:scale-[0.98]"
                                >
                                    CALCULAR UNIDADES
                                </button>
                            </form>
                            <div id="resultadoNAD" class="hidden mt-4 pt-4 border-t border-white/10">
                                <div class="bg-cyan-500/20 border border-cyan-500/30 rounded-lg p-4 text-center">
