---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Accordion from '../../components/Accordion.astro';

const produtoNome = 'Semax 11mg (Cognitive Enhancer)';
const concentracao = '11mg Liofilizado';
const imagemCatalogo = '/image/catalogo/mots-c.png';
const imagemProduto = '/image/produtos/semax-11mg.png';
const imagemAlt = 'Frasco de Semax 11mg Orion Peptides para pesquisa cognitiva e regeneração neural.';
const subtitulo = 'O Peptídeo Nootrópico de Referência para Foco Extremo, Memória e Neuroproteção.';
const descricao =
	'O Semax é um análogo sintético do ACTH (hormônio adrenocorticotrópico), desenvolvido para otimizar as funções cognitivas superiores. Ele é amplamente reconhecido por sua capacidade de aumentar a expressão do BDNF (Fator Neurotrófico Derivado do Cérebro), promovendo clareza mental, resistência ao estresse intelectual e acelerando a recuperação após lesões neurais.';
const diferencialOrion = 'Pureza laboratorial superior a 99% (HPLC), garantindo a máxima biodisponibilidade para protocolos de biohacking e neurociência.';

const tamanhoFrascoMg = 11;
const quantidadeAguaMl = 2;

const layoutTitle = `${produtoNome} | Guia Técnico | Orion Peptides`;
const layoutDescription = 'Semax 11mg Orion: Potencialize sua memória, foco e saúde cerebral com o nootrópico de pureza máxima.';
const layoutOgImage = '/image/produtos/semax-11mg.png';
---

<Layout title={layoutTitle} description={layoutDescription} ogImage={layoutOgImage}>
	<Header />
	<main class="container mx-auto px-4 py-12 md:py-16">
		<section class="mb-16">
			<div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12 items-start">
				<div class="space-y-6">
					<div class="md:hidden flex items-center justify-center gap-3 mb-3">
						<div class="w-10 h-10 rounded-full bg-white/5 border border-cyan-500/20 flex items-center justify-center flex-shrink-0 shadow-[0_0_8px_rgba(6,182,212,0.15)]">
							<img src={imagemCatalogo} alt={`Ícone ${produtoNome}`} class="w-8 h-8 object-contain" />
						</div>
						<h1 class="text-2xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-white via-cyan-200 to-cyan-400">
							{produtoNome}
						</h1>
					</div>

					<figure class="w-full max-w-md bg-gray-900/50 border border-white/10 rounded-2xl overflow-hidden">
						<div class="px-4 py-2.5 border-b border-white/10 bg-black/20">
							<figcaption class="text-xs text-gray-400 uppercase tracking-wider font-medium">{produtoNome} — Imagem do produto</figcaption>
						</div>
						<div class="relative p-6 flex items-center justify-center">
							<a
								href="/contato"
								data-wa-product={produtoNome}
								data-wa-phone="5511911387063"
								class="absolute top-4 left-4 z-30 inline-flex flex-col items-center justify-center px-2.5 py-1.5 rounded bg-gradient-to-br from-amber-400 via-yellow-500 to-amber-600 hover:from-amber-300 hover:via-yellow-400 hover:to-amber-500 text-amber-950 text-[10px] font-bold uppercase tracking-wide shadow-md shadow-amber-500/30 hover:shadow-amber-400/50 border border-amber-300/50 hover:scale-105 active:scale-95 transition-all duration-300 leading-tight text-center"
							>
								<span>Encontrar</span><span>fornecedor</span>
							</a>
							<div class="w-full h-[300px] rounded-lg border border-dashed border-cyan-500/40 bg-black/30 flex items-center justify-center text-center px-4">
								<p class="text-sm text-cyan-300 font-semibold">Imagem do produto pendente</p>
							</div>
						</div>
					</figure>

					<!-- Mobile: subtítulo e descrição abaixo da imagem -->
					<div class="md:hidden">
						<p class="text-xl text-gray-400 font-medium mb-3">{subtitulo}</p>
						<p class="text-gray-500 text-sm leading-relaxed mb-6">{descricao}</p>
					</div>



					<div class="flex flex-col gap-4">
						<div class="bg-gray-900/50 backdrop-blur-md border border-cyan-500/20 rounded-xl p-4 hover:border-cyan-500/40 transition-all duration-300">
							<div class="flex flex-col items-center text-center space-y-2">
								<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
								</svg>
								<p class="text-xs text-gray-400 uppercase tracking-wider">Potência Total</p>
								<p class="text-sm text-white font-semibold">{concentracao}</p>
							</div>
						</div>

						<div class="bg-gray-900/50 backdrop-blur-md border border-cyan-500/20 rounded-xl p-4 hover:border-cyan-500/40 transition-all duration-300">
							<div class="flex flex-col items-center text-center space-y-2">
								<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-cyan-400" fill="currentColor" viewBox="0 0 24 24">
									<path d="M12 2.69c-3.5 0-6.31 2.81-6.31 6.31 0 3.5 6.31 10.31 6.31 10.31S18.31 12.5 18.31 9c0-3.5-2.81-6.31-6.31-6.31z"/>
								</svg>
								<p class="text-xs text-gray-400 uppercase tracking-wider">Inclui</p>
								<p class="text-sm text-white font-semibold">🎁 Kit Orion: Água Bacteriostática + 4 Seringas de Aplicação + 1 Seringa de Diluição + Frete Grátis.</p>
							</div>
						</div>

						<div class="bg-gray-900/50 backdrop-blur-md border border-cyan-500/20 rounded-xl p-4 hover:border-cyan-500/40 transition-all duration-300">
							<div class="flex flex-col items-center text-center space-y-2">
								<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
								</svg>
								<p class="text-xs text-gray-400 uppercase tracking-wider">Temperatura</p>
								<p class="text-sm text-white font-semibold">2°C a 8°C (Geladeira)</p>
							</div>
						</div>

						<div class="bg-gray-900/50 backdrop-blur-md border border-cyan-500/20 rounded-xl p-4 hover:border-cyan-500/40 transition-all duration-300">
							<div class="flex flex-col items-center text-center space-y-2">
								<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
								</svg>
								<p class="text-xs text-gray-400 uppercase tracking-wider">Diluição Recomendada</p>
								<p class="text-sm text-white font-semibold">Requer 2ml de Água Bacteriostática (Inclusa no Kit).</p>
							</div>
						</div>
					</div>
				</div>

				<div class="space-y-6">
					<div>
						<div class="hidden md:flex items-center gap-4 mb-2">
							<div class="w-14 h-14 rounded-full bg-white/5 border border-cyan-500/20 flex items-center justify-center flex-shrink-0 shadow-[0_0_12px_rgba(6,182,212,0.25)]">
								<img src={imagemCatalogo} alt="" class="w-10 h-10 object-contain" />
							</div>
							<h1 class="text-3xl md:text-5xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-white via-cyan-200 to-cyan-400">
								{produtoNome}
							</h1>
						</div>
						<p class="text-xl text-gray-400 font-medium mb-3 hidden md:block">{subtitulo}</p>
						<p class="text-gray-500 text-sm leading-relaxed mb-6 hidden md:block">{descricao}</p>
						<div class="bg-cyan-900/20 border border-cyan-500/30 rounded-lg p-3 mb-4">
							<p class="text-sm text-cyan-200"><strong class="text-cyan-300">Diferencial Orion:</strong> {diferencialOrion}</p>
						</div>
					</div>

					<div class="mb-8">
						<h3 class="text-2xl md:text-3xl font-bold mb-6 text-white">Benefícios Pesquisados</h3>
						<div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6">
							<div class="flex flex-col items-center text-center space-y-3 p-4 hover:-translate-y-2 transition-all duration-300 cursor-default">
								<svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 md:w-10 md:h-10 text-cyan-400 drop-shadow-[0_0_8px_rgba(6,182,212,0.5)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
								</svg>
								<h4 class="text-white font-bold text-sm md:text-base">Aumento do Foco e Atenção</h4>
								<p class="text-gray-400 text-xs md:text-sm">Melhora significativamente a concentração e a velocidade de processamento de informações.</p>
							</div>

							<div class="flex flex-col items-center text-center space-y-3 p-4 hover:-translate-y-2 transition-all duration-300 cursor-default">
								<svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 md:w-10 md:h-10 text-cyan-400 drop-shadow-[0_0_8px_rgba(6,182,212,0.5)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7h5l2-3h4l2 3h5v11H3V7z" />
								</svg>
								<h4 class="text-white font-bold text-sm md:text-base">Neurogenese e Plasticidade</h4>
								<p class="text-gray-400 text-xs md:text-sm">Estimula o crescimento de novos neurônios e fortalece as conexões sinápticas existentes.</p>
							</div>

							<div class="flex flex-col items-center text-center space-y-3 p-4 hover:-translate-y-2 transition-all duration-300 cursor-default">
								<svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 md:w-10 md:h-10 text-cyan-400 drop-shadow-[0_0_8px_rgba(6,182,212,0.5)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-3.314 0-6 2.239-6 5s2.686 5 6 5 6-2.239 6-5-2.686-5-6-5zm0 0V4m0 14v2" />
								</svg>
								<h4 class="text-white font-bold text-sm md:text-base">Resistência à Fadiga Mental</h4>
								<p class="text-gray-400 text-xs md:text-sm">Permite períodos prolongados de esforço intelectual sem o esgotamento cognitivo comum.</p>
							</div>

							<div class="flex flex-col items-center text-center space-y-3 p-4 hover:-translate-y-2 transition-all duration-300 cursor-default">
								<svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 md:w-10 md:h-10 text-cyan-400 drop-shadow-[0_0_8px_rgba(6,182,212,0.5)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-3-3v6m8-3a9 9 0 11-18 0 9 9 0 0118 0z" />
								</svg>
								<h4 class="text-white font-bold text-sm md:text-base">Recuperação Nervosa</h4>
								<p class="text-gray-400 text-xs md:text-sm">Estudado por seu potencial em auxiliar a regeneração do sistema nervoso após eventos isquêmicos ou traumáticos.</p>
							</div>
						</div>
					</div>

					<div class="space-y-4">
						<div class="mt-8 border-t border-white/10 pt-6">
							<h4 class="text-white font-bold mb-4 flex items-center gap-2">
								<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-cyan-400" viewBox="0 0 20 20" fill="currentColor">
									<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd" />
								</svg>
								Protocolo de Pesquisa Sugerido
							</h4>

							<div class="overflow-hidden rounded-xl border border-white/10 shadow-lg">
								<div class="overflow-x-auto">
									<table class="w-full text-left text-sm">
										<thead class="bg-cyan-900/20 text-cyan-200 uppercase text-xs font-bold tracking-wider">
											<tr>
												<th class="px-4 py-3">Protocolo</th>
												<th class="px-4 py-3">Dose Diária</th>
												<th class="px-4 py-3 text-white bg-cyan-600/20 border-l border-cyan-500/30">Volume na Seringa (Ref: {quantidadeAguaMl}ml água)</th>
												<th class="px-4 py-3">Frequência</th>
											</tr>
										</thead>
										<tbody class="divide-y divide-white/5 bg-gray-900/40">
											<tr class="hover:bg-white/5 transition-colors">
												<td class="px-4 py-3 font-medium text-white">Foco e Performance</td>
												<td class="px-4 py-3 text-gray-300">0,3mg</td>
												<td class="px-4 py-3 font-bold text-cyan-400 border-l border-white/5">5,5 unidades (0,05 ml)</td>
												<td class="px-4 py-3 text-gray-300">1x ao dia (pela manhã)</td>
											</tr>
											<tr class="hover:bg-white/5 transition-colors">
												<td class="px-4 py-3 font-medium text-white">Protocolo Intensivo</td>
												<td class="px-4 py-3 text-gray-300">0,6mg</td>
												<td class="px-4 py-3 font-bold text-cyan-400 border-l border-white/5">11 unidades (0,11 ml)</td>
												<td class="px-4 py-3 text-gray-300">2x ao dia (Manhã e início da tarde)</td>
											</tr>
										</tbody>
									</table>
									<div class="bg-cyan-900/10 p-3 text-xs text-cyan-300 flex items-start gap-2 border-t border-white/5">
										<span class="text-cyan-500 font-bold">💡</span>
										<p>
											<strong>Nota:</strong> Evitar administração no final da noite, pois o aumento do estado de alerta pode interferir no início do sono.
										</p>
									</div>
								</div>
							</div>
						</div>

						<div class="bg-gray-900/50 border border-white/10 rounded-lg p-4">
							<p class="text-sm text-gray-400 mb-1">Pureza Certificada</p>
							<p class="text-cyan-400 font-bold text-2xl">&gt;99.4% (HPLC) - High Purity</p>
						</div>
						<div class="bg-gray-900/50 border border-white/10 rounded-lg p-4">
							<p class="text-sm text-gray-400 mb-1">Aplicação</p>
							<p class="text-white">Pesquisa em foco, memória, resistência mental e neuroproteção</p>
						</div>
					</div>

					<a
						href="/contato"
						data-wa-product={produtoNome}
						data-wa-phone="5511911387063"
						class="block w-full md:w-auto px-8 py-4 bg-gradient-to-r from-cyan-600 to-cyan-500 text-white font-bold rounded-lg hover:from-cyan-500 hover:to-cyan-400 transition-all duration-300 text-center shadow-lg shadow-cyan-500/30 hover:shadow-xl hover:shadow-cyan-500/50 active:scale-[0.98] border border-cyan-400/30 hover:border-cyan-400/50"
					>
						Encontrar Fornecedor
					</a>
				</div>
			</div>
		</section>

		<section class="max-w-4xl mx-auto">
			<h2 class="text-3xl md:text-4xl font-bold mb-8 text-center bg-clip-text text-transparent bg-gradient-to-r from-cyan-400 to-cyan-600">
				Informações Técnicas
			</h2>

			<div class="space-y-4">
				<Accordion title="O que é Semax?">
					<div class="prose prose-invert max-w-none">
						<p class="text-gray-300 mb-4">
							Desenvolvido originalmente na Rússia, o Semax é um heptapeptídeo que atua de forma única no sistema nervoso. Ao contrário de estimulantes tradicionais, ele não causa agitação psicomotora ou "crash", mas sim um estado de vigília calma e foco direcionado, sendo um dos nootrópicos mais respeitados no mundo.
						</p>
						<div class="bg-cyan-900/20 border border-cyan-500/30 rounded-lg p-3 mb-4">
							<p class="text-sm text-cyan-200"><strong class="text-cyan-300">Diferencial Orion:</strong> {diferencialOrion}</p>
						</div>
						<div class="bg-red-900/20 border border-red-500/30 p-4 rounded text-sm text-red-200">
							<strong>Nota de Pesquisa:</strong> Este composto é destinado exclusivamente para fins de pesquisa científica e não deve ser utilizado para consumo humano ou veterinário sem aprovação regulatória adequada.
						</div>
					</div>
				</Accordion>

				<Accordion title="Mecanismo de Ação">
					<div class="prose prose-invert max-w-none">
						<ul class="space-y-4 list-none">
							<li class="flex gap-3">
								<span class="text-cyan-500 font-bold">BDNF e NGF:</span>
								<span class="text-gray-400">Aumenta rapidamente os níveis de BDNF e NGF (Fator de Crescimento Nervoso) no cérebro.</span>
							</li>
							<li class="flex gap-3">
								<span class="text-cyan-500 font-bold">Proteção neuronal:</span>
								<span class="text-gray-400">Protege os neurônios contra a oxidação e a hipóxia (falta de oxigênio).</span>
							</li>
							<li class="flex gap-3">
								<span class="text-cyan-500 font-bold">Neurotransmissores:</span>
								<span class="text-gray-400">Modula o sistema de neurotransmissores, especificamente a dopamina e a serotonina.</span>
							</li>
							<li class="flex gap-3">
								<span class="text-cyan-500 font-bold">Circulação cerebral:</span>
								<span class="text-gray-400">Melhora a circulação sanguínea cerebral e o metabolismo de glicose nos neurônios.</span>
							</li>
						</ul>
					</div>
				</Accordion>

				<Accordion title="Reconstituição">
					<div class="prose prose-invert max-w-none">
						<div class="mb-8">
							<h4 class="text-white font-bold mb-4">Guia de Mistura (Frasco 11mg)</h4>
							<ol class="list-decimal list-inside space-y-3 text-gray-300">
								<li>Limpe o lacre de borracha com álcool 70%.</li>
								<li>Introduza 2ml de Água Bacteriostática cuidadosamente.</li>
								<li>Misture com movimentos circulares lentos até a solução estar límpida e homogênea.</li>
								<li>Não agite. A molécula de Semax é sensível e pode perder eficácia se houver quebra das cadeias proteicas.</li>
							</ol>
							<div class="bg-gray-800/50 border border-cyan-500/20 rounded-lg p-4 mt-6 text-sm text-gray-300">
								<strong class="text-white">Observação:</strong> Deve ser mantido estritamente sob refrigeração após a reconstituição.
							</div>
						</div>

						<div class="bg-gray-800/50 border border-cyan-500/20 rounded-lg p-6 mt-4">
							<h4 class="text-white font-bold mb-4 flex items-center gap-2">
								<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
								</svg>
								Calculadora Rápida ({produtoNome})
							</h4>
							<form id="calculadoraProduto" class="space-y-4">
								<div>
									<label for="doseProduto" class="block text-sm font-medium text-gray-300 mb-2">Dose Desejada (mg)</label>
									<input
										type="number"
										id="doseProduto"
										step="0.05"
										min="0"
										value="0.3"
										placeholder="Ex: 0.3"
										required
										class="w-full px-4 py-2 bg-black/50 border border-white/10 rounded-lg text-white placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500/50 transition-all duration-300"
									/>
								</div>
								<button type="submit" class="w-full md:w-auto py-3 bg-gradient-to-r from-cyan-600 to-cyan-500 text-white font-bold rounded-lg hover:from-cyan-500 hover:to-cyan-400 transition-all duration-300 shadow-lg shadow-cyan-500/30 hover:shadow-xl hover:shadow-cyan-500/50 active:scale-[0.98]">
									CALCULAR UNIDADES
								</button>
							</form>
							<div id="resultadoProduto" class="hidden mt-4 pt-4 border-t border-white/10">
								<div class="bg-cyan-500/20 border border-cyan-500/30 rounded-lg p-4 text-center">
									<p class="text-gray-400 text-xs mb-1">Unidades da Seringa (UI)</p>
									<p id="resultadoUIProduto" class="text-3xl font-bold text-cyan-400">0</p>
									<p class="text-gray-400 text-xs mt-1">Volume: <span id="resultadoVolumeProduto" class="text-cyan-300">0 ml</span></p>
								</div>
							</div>
						</div>

						<div class="bg-cyan-500/10 border border-cyan-500/30 rounded-lg p-4 mt-6">
							<p class="text-sm text-cyan-300 mb-3"><strong>Dica:</strong> Use a calculadora completa para outros frascos e diluições.</p>
