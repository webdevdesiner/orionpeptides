---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Accordion from '../../components/Accordion.astro';
---

<Layout title="Tirzepatide 40mg (High Concentration) | Guia Técnico | Orion Peptides">
    <Header />
    
    <main class="container mx-auto px-4 py-12 md:py-16">
        <!-- Topo - Resumo do Produto -->
        <section class="mb-16">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12 items-start">
                <!-- Coluna 1: Imagem do Produto -->
                <div class="space-y-6">
                    <div class="w-full max-w-md bg-gray-900/50 border border-white/10 rounded-2xl overflow-hidden">
                        <div class="px-4 py-2.5 border-b border-white/10 bg-black/20">
                            <p class="text-xs text-gray-400 uppercase tracking-wider font-medium">Imagem do produto</p>
                        </div>
                        <div class="relative p-6 flex items-center justify-center">
                            <a
                                href="/contato"
                                class="absolute top-4 left-4 z-30 inline-flex flex-col items-center justify-center px-2.5 py-1.5 rounded bg-gradient-to-br from-amber-400 via-yellow-500 to-amber-600 hover:from-amber-300 hover:via-yellow-400 hover:to-amber-500 text-amber-950 text-[10px] font-bold uppercase tracking-wide shadow-md shadow-amber-500/30 hover:shadow-amber-400/50 border border-amber-300/50 hover:scale-105 active:scale-95 transition-all duration-300 leading-tight text-center"
                            >
                                <span>Encontrar</span>
                                <span>fornecedor</span>
                            </a>
                            <img 
                                src="/image/produtos/TIRZEPATIDE40.png" 
                                alt="Tirzepatide 40mg - Agonista Dual GLP-1/GIP" 
                                class="w-full h-auto object-contain rounded-lg"
                            />
                        </div>
                    </div>

                    <!-- Especificações Técnicas Rápidas -->
                    <div class="flex flex-col gap-4">
                        <!-- Card 1: Potência -->
                        <div class="bg-gray-900/50 backdrop-blur-md border border-amber-500/20 rounded-xl p-4 hover:border-amber-500/40 transition-all duration-300">
                            <div class="flex flex-col items-center text-center space-y-2">
                                <!-- Ícone Frasco -->
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
                                </svg>
                                <p class="text-xs text-gray-400 uppercase tracking-wider">Potência</p>
                                <p class="text-sm text-white font-semibold">40mg Liofilizado</p>
                            </div>
                        </div>

                        <!-- Card 2: Diluente -->
                        <div class="bg-gray-900/50 backdrop-blur-md border border-amber-500/20 rounded-xl p-4 hover:border-amber-500/40 transition-all duration-300">
                            <div class="flex flex-col items-center text-center space-y-2">
                                <!-- Ícone Gota -->
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-amber-400" fill="currentColor" viewBox="0 0 24 24">
                                    <path d="M12 2.69c-3.5 0-6.31 2.81-6.31 6.31 0 3.5 6.31 10.31 6.31 10.31S18.31 12.5 18.31 9c0-3.5-2.81-6.31-6.31-6.31z"/>
                                </svg>
                                <p class="text-xs text-gray-400 uppercase tracking-wider">Requer</p>
                                <p class="text-sm text-white font-semibold">Água Bac. (Não incluso)</p>
                            </div>
                        </div>

                        <!-- Card 3: Armazenamento -->
                        <div class="bg-gray-900/50 backdrop-blur-md border border-amber-500/20 rounded-xl p-4 hover:border-amber-500/40 transition-all duration-300">
                            <div class="flex flex-col items-center text-center space-y-2">
                                <!-- Ícone Floco de Neve -->
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
                                </svg>
                                <p class="text-xs text-gray-400 uppercase tracking-wider">Temperatura</p>
                                <p class="text-sm text-white font-semibold">2°C a 8°C (Geladeira)</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Coluna 2: Informações -->
                <div class="space-y-6">
                    <div>
                        <div class="flex items-center gap-4 mb-2">
                            <div class="w-14 h-14 rounded-full bg-white/5 border border-amber-500/20 flex items-center justify-center flex-shrink-0 shadow-[0_0_12px_rgba(245,158,11,0.25)]">
                                <img src="/image/catalogo/tirzepatide.png" alt="" class="w-10 h-10 object-contain" />
                            </div>
                            <h1 class="text-4xl md:text-5xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-white via-amber-200 to-amber-400">
                                Tirzepatide 40mg (High Concentration)
                            </h1>
                        </div>
                        <p class="text-xl text-gray-400 font-medium mb-3">Agente Duplo GLP-1/GIP Agonist</p>
                        <p class="text-gray-500 text-sm leading-relaxed mb-6">
                            O primeiro agonista duplo dos receptores de GLP-1 e GIP. Ao ativar esses dois receptores simultaneamente, promove controle glicêmico superior e perda de peso significativamente maior que monoterapias convencionais.
                        </p>
                        <div class="bg-amber-900/20 border border-amber-500/30 rounded-lg p-3 mb-4">
                            <p class="text-sm text-amber-200">
                                <strong class="text-amber-300">Diferencial Orion:</strong> Frasco com <strong>40mg</strong> de alta concentração, ideal para usuários avançados ou doses de manutenção mais altas.
                            </p>
                        </div>
                    </div>

                    <!-- Seção Benefícios Pesquisados -->
                    <div class="mb-8">
                        <h3 class="text-2xl md:text-3xl font-bold mb-6 text-white">
                            Benefícios Pesquisados
                        </h3>
                        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6">
                            <!-- (idem ao original - mantido) -->
                            <div class="flex flex-col items-center text-center space-y-3 p-4 hover:-translate-y-2 transition-all duration-300 cursor-default">
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 md:w-10 md:h-10 text-amber-400 drop-shadow-[0_0_8px_rgba(245,158,11,0.5)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                                </svg>
                                <h4 class="text-white font-bold text-sm md:text-base">Controle Glicêmico</h4>
                                <p class="text-gray-400 text-xs md:text-sm">Regulação superior de açúcar no sangue</p>
                            </div>
                            <div class="flex flex-col items-center text-center space-y-3 p-4 hover:-translate-y-2 transition-all duration-300 cursor-default">
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 md:w-10 md:h-10 text-amber-400 drop-shadow-[0_0_8px_rgba(245,158,11,0.5)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3" />
                                </svg>
                                <h4 class="text-white font-bold text-sm md:text-base">Perda de Peso</h4>
                                <p class="text-gray-400 text-xs md:text-sm">Redução significativa de massa corporal</p>
                            </div>
                            <div class="flex flex-col items-center text-center space-y-3 p-4 hover:-translate-y-2 transition-all duration-300 cursor-default">
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 md:w-10 md:h-10 text-amber-400 drop-shadow-[0_0_8px_rgba(245,158,11,0.5)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 4h8M8 4c0 1.1.9 2 2 2h4c1.1 0 2-.9 2-2M8 4c0-1.1.9-2 2-2h4c1.1 0 2 .9 2 2m0 0v10c0 1.1-.9 2-2 2h-4c-1.1 0-2-.9-2-2V4m8 2H8m8 4H8m0 4h8" />
                                </svg>
                                <h4 class="text-white font-bold text-sm md:text-base">Saciedade</h4>
                                <p class="text-gray-400 text-xs md:text-sm">Aumento da sensação de plenitude</p>
                            </div>
                            <div class="flex flex-col items-center text-center space-y-3 p-4 hover:-translate-y-2 transition-all duration-300 cursor-default">
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 md:w-10 md:h-10 text-amber-400 drop-shadow-[0_0_8px_rgba(245,158,11,0.5)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                                </svg>
                                <h4 class="text-white font-bold text-sm md:text-base">Metabolismo</h4>
                                <p class="text-gray-400 text-xs md:text-sm">Otimização do metabolismo energético</p>
                            </div>
                        </div>
                    </div>

                    <div class="space-y-4">
                        <!-- Protocolo de Pesquisa Sugerido -->
                        <div class="mt-8 border-t border-white/10 pt-6">
                            <h4 class="text-white font-bold mb-4 flex items-center gap-2">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-amber-400" viewBox="0 0 20 20" fill="currentColor">
                                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd" />
                                </svg>
                                Protocolo de Pesquisa Sugerido (Titulação Semanal)
                            </h4>

                            <div class="overflow-hidden rounded-xl border border-white/10 shadow-lg">
                                <table class="w-full text-left text-sm">
                                    <thead class="bg-amber-900/20 text-amber-200 uppercase text-xs font-bold tracking-wider">
                                        <tr>
                                            <th class="px-4 py-3">Fase</th>
                                            <th class="px-4 py-3">Dose Semanal</th>
                                            <th class="px-4 py-3 text-white bg-amber-600/20 border-l border-amber-500/30">
                                                Volume na Seringa (Ref: 2ml água)
                                            </th>
                                            <th class="px-4 py-3">Frequência</th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-white/5 bg-gray-900/40">
                                        <tr class="hover:bg-white/5 transition-colors">
                                            <td class="px-4 py-3 font-medium text-white">Mês 1</td>
                                            <td class="px-4 py-3 text-gray-300">2.5 mg</td>
                                            <td class="px-4 py-3 font-bold text-amber-400 border-l border-white/5">
                                                12-13 unidades (≈0.13 ml)
                                            </td>
                                            <td class="px-4 py-3 text-gray-300">1x Semana</td>
                                        </tr>
                                        <tr class="hover:bg-white/5 transition-colors">
                                            <td class="px-4 py-3 font-medium text-white">Mês 2</td>
                                            <td class="px-4 py-3 text-gray-300">5.0 mg</td>
                                            <td class="px-4 py-3 font-bold text-amber-400 border-l border-white/5">
                                                25 unidades (≈0.25 ml)
                                            </td>
                                            <td class="px-4 py-3 text-gray-300">1x Semana</td>
                                        </tr>
                                        <tr class="hover:bg-white/5 transition-colors">
                                            <td class="px-4 py-3 font-medium text-white">Mês 3</td>
                                            <td class="px-4 py-3 text-gray-300">7.5 mg</td>
                                            <td class="px-4 py-3 font-bold text-amber-400 border-l border-white/5">
                                                37-38 unidades (≈0.38 ml)
                                            </td>
                                            <td class="px-4 py-3 text-gray-300">1x Semana</td>
                                        </tr>
                                        <tr class="hover:bg-white/5 transition-colors">
                                            <td class="px-4 py-3 font-medium text-white">Mês 4</td>
                                            <td class="px-4 py-3 text-gray-300">10.0 mg</td>
                                            <td class="px-4 py-3 font-bold text-amber-400 border-l border-white/5">
                                                50 unidades (≈0.50 ml)
                                            </td>
                                            <td class="px-4 py-3 text-gray-300">1x Semana</td>
                                        </tr>
                                        <tr class="hover:bg-white/5 transition-colors">
                                            <td class="px-4 py-3 font-medium text-white">Mês 5+</td>
                                            <td class="px-4 py-3 text-gray-300">12.5 - 15 mg</td>
                                            <td class="px-4 py-3 font-bold text-amber-400 border-l border-white/5">
                                                Consultar especialista
                                            </td>
                                            <td class="px-4 py-3 text-gray-300">1x Semana</td>
                                        </tr>
                                    </tbody>
                                </table>
                                
                                <div class="bg-amber-900/10 p-3 text-xs text-amber-300 flex items-start gap-2 border-t border-white/5">
                                    <span class="text-amber-500 font-bold">💡</span>
                                    <p><strong>Nota Econômica:</strong> Frasco Orion (40mg) oferece rendimento elevado para protocolos estendidos.</p>
                                </div>
                            </div>
                        </div>

                        <div class="bg-gray-900/50 border border-white/10 rounded-lg p-4">
                            <p class="text-sm text-gray-400 mb-1">Pureza Certificada</p>
                            <p class="text-amber-400 font-bold text-2xl">>99.8% (HPLC) - Gold Standard</p>
                        </div>

                        <div class="bg-gray-900/50 border border-white/10 rounded-lg p-4">
                            <p class="text-sm text-gray-400 mb-1">Aplicação</p>
                            <p class="text-white">Pesquisa em controle glicêmico e perda de peso</p>
                        </div>
                    </div>

                    <a
                        href="#"
                        class="block w-full md:w-auto px-8 py-4 bg-gradient-to-r from-yellow-500 to-amber-500 text-black font-bold rounded-lg hover:from-yellow-400 hover:to-amber-400 transition-all duration-300 text-center shadow-lg shadow-yellow-500/30 hover:shadow-xl hover:shadow-yellow-500/50 active:scale-[0.98] border border-yellow-400/30 hover:border-yellow-400/50"
                    >
                        Encontrar Fornecedor
                    </a>
                </div>
            </div>
        </section>

        <!-- Área Técnica - Accordions -->
        <section class="max-w-4xl mx-auto">
            <h2 class="text-3xl md:text-4xl font-bold mb-8 text-center bg-clip-text text-transparent bg-gradient-to-r from-amber-400 to-amber-600">
                Informações Técnicas
            </h2>

            <div class="space-y-4">
                <!-- Accordion 1: O que é Tirzepatide? -->
                <Accordion title="O que é Tirzepatide?">
                    <div class="prose prose-invert max-w-none">
                        <p class="text-gray-300 mb-4">
                            O <strong class="text-white">Tirzepatide</strong> é o primeiro agonista duplo dos receptores de GLP-1 e GIP. Ao ativar esses dois receptores simultaneamente, promove controle glicêmico superior e perda de peso significativamente maior que monoterapias convencionais.
                        </p>
                        <p class="text-gray-300 mb-4">
                            Desenvolvido para pesquisa científica, o Tirzepatide demonstra potencial em estudos relacionados ao controle metabólico, regulação glicêmica e gestão de peso corporal. Sua ação dual permite interações sinérgicas com sistemas biológicos relacionados ao metabolismo energético.
                        </p>
                        <div class="bg-amber-900/20 border border-amber-500/30 rounded-lg p-3 mb-4">
                            <p class="text-sm text-amber-200">
                                <strong class="text-amber-300">Diferencial Orion:</strong> Frasco com <strong>40mg</strong> de alta concentração, ideal para usuários avançados ou doses de manutenção mais altas.
                            </p>
                        </div>
                        <div class="bg-red-900/20 border border-red-500/30 p-4 rounded text-sm text-red-200">
                            <strong>Nota de Pesquisa:</strong> Este composto é destinado exclusivamente para fins de pesquisa científica e não deve ser utilizado para consumo humano ou veterinário sem aprovação regulatória adequada.
                        </div>
                    </div>
                </Accordion>

                <!-- Accordion 2: Mecanismo de Ação -->
                <Accordion title="Mecanismo de Ação (Ciência)">
                    <div class="prose prose-invert max-w-none">
                        <p class="text-gray-300 mb-6">O mecanismo de ação demonstra uma atividade dual sinérgica em modelos de pesquisa:</p>
                        
                        <ul class="space-y-4 list-none">
                            <li class="flex gap-3">
                                <span class="text-amber-500 font-bold">Ativação GLP-1:</span>
                                <span class="text-gray-400">Estimula a secreção de insulina dependente de glicose, reduz a secreção de glucagon e retarda o esvaziamento gástrico, promovendo saciedade.</span>
                            </li>
                            <li class="flex gap-3">
                                <span class="text-amber-500 font-bold">Ativação GIP:</span>
                                <span class="text-gray-400">Potencializa a ação da insulina, melhora a sensibilidade à insulina e promove efeitos metabólicos adicionais que complementam a ação do GLP-1.</span>
                            </li>
                            <li class="flex gap-3">
                                <span class="text-amber-500 font-bold">Sinergia Dual:</span>
                                <span class="text-gray-400">A ativação simultânea de ambos os receptores resulta em efeitos superiores ao uso isolado de cada agonista, proporcionando controle glicêmico e perda de peso mais eficazes.</span>
                            </li>
                        </ul>

                        <p class="text-xs text-gray-600 mt-6 italic">Referência: Os mecanismos descritos são baseados em estudos pré-clínicos e clínicos (in vivo/in vitro).</p>
                    </div>
                </Accordion>

                <!-- Accordion 3: Protocolo de Reconstituição -->
                <Accordion title="Protocolo de Reconstituição">
                    <div class="prose prose-invert max-w-none">
                        <div class="mb-8">
                            <h4 class="text-white font-bold mb-4">Guia de Mistura (Para Frasco 40mg)</h4>
                            <p class="text-gray-300 mb-4">Para precisão ideal com a alta concentração Orion:</p>
                            <ol class="list-decimal list-inside space-y-3 text-gray-300">
                                <li><strong class="text-white">Diluente:</strong> Utilize <strong>2ml</strong> (200 unidades) de Água Bacteriostática.</li>
                                <li><strong class="text-white">Processo:</strong> Injete a água lentamente pela parede do frasco. <strong>NÃO agite;</strong> faça movimentos circulares suaves (swirl) até dissolver completamente.</li>
                                <li><strong class="text-white">Matemática da Dose:</strong>
                                    <ul class="list-disc list-inside ml-4 mt-2 space-y-1">
                                        <li>40mg em 2ml = <strong>20mg por ml</strong></li>
                                        <li>Cada <strong>5 unidades</strong> na seringa de insulina = <strong>1mg</strong> de produto</li>
                                    </ul>
                                </li>
                                <li>Armazene em refrigeração (2-8°C) após reconstituído.</li>
                                <li>Use dentro do prazo de validade após reconstituição.</li>
                            </ol>
                        </div>

                        <!-- Calculadora Rápida Inline (em primeiro) -->
                        <div class="bg-gray-800/50 border border-amber-500/20 rounded-lg p-6 mt-4">
                            <h4 class="text-white font-bold mb-4 flex items-center gap-2">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
                                </svg>
                                Calculadora Rápida (Tirzepatide 40mg)
                            </h4>
                            <form id="calculadoraTirzepatide40" class="space-y-4">
                                <div>
                                    <label for="doseTirzepatide40" class="block text-sm font-medium text-gray-300 mb-2">
                                        Dose Desejada (mg)
                                    </label>
                                    <input
                                        type="number"
                                        id="doseTirzepatide40"
                                        step="0.1"
                                        min="0"
                                        value="2.5"
                                        placeholder="Ex: 2.5"
                                        required
                                        class="w-full px-4 py-2 bg-black/50 border border-white/10 rounded-lg text-white placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-amber-500/50 transition-all duration-300"
                                    />
                                </div>
                                <button
                                    type="submit"
                                    class="w-full py-3 bg-gradient-to-r from-amber-600 to-amber-500 text-white font-bold rounded-lg hover:from-amber-500 hover:to-amber-400 transition-all duration-300 shadow-lg shadow-amber-500/30 hover:shadow-xl hover:shadow-amber-500/50 active:scale-[0.98]"
                                >
                                    CALCULAR UNIDADES
                                </button>
                            </form>
                            <div id="resultadoTirzepatide40" class="hidden mt-4 pt-4 border-t border-white/10">
                                <div class="bg-amber-500/20 border border-amber-500/30 rounded-lg p-4 text-center">
                                    <p class="text-gray-400 text-xs mb-1">Unidades da Seringa (UI)</p>
                                    <p id="resultadoUITirzepatide40" class="text-3xl font-bold text-amber-400">0</p>
                                    <p class="text-gray-400 text-xs mt-1">Volume: <span id="resultadoVolumeTirzepatide40" class="text-amber-300">0 ml</span></p>
                                </div>
                            </div>
                        </div>

                        <div class="bg-amber-500/10 border border-amber-500/30 rounded-lg p-4 mt-6">
                            <p class="text-sm text-amber-300 mb-3">
                                <strong>Dica:</strong> Use a calculadora completa para outros frascos e diluições.
                            </p>
