<script>
    // Calculadora Rápida para Tirzepatide 40mg (40mg em 2ml)
    document.addEventListener('DOMContentLoaded', () => {
        const form = document.getElementById('calculadoraTirzepatide40') as HTMLFormElement | null;
        const resultado = document.getElementById('resultadoTirzepatide40');
        const resultadoUI = document.getElementById('resultadoUITirzepatide40');
        const resultadoVolume = document.getElementById('resultadoVolumeTirzepatide40');

        if (!form || !resultado || !resultadoUI || !resultadoVolume) {
            return;
        }

        form.addEventListener('submit', (e) => {
            e.preventDefault();

            const inputDose = document.getElementById('doseTirzepatide40') as HTMLInputElement | null;
            if (!inputDose) return;

            // Valores fixos para Tirzepatide Orion (40mg em 2ml)
            const tamanhoFrasco = 40; // mg
            const quantidadeAgua = 2; // ml
            const doseDesejada = parseFloat(inputDose.value); // mg

            // Validação
            if (isNaN(doseDesejada) || doseDesejada <= 0 || doseDesejada > tamanhoFrasco) {
                alert('Por favor, insira uma dose válida entre 0 e 40mg.');
                return;
            }

            // Cálculo: 40mg em 2ml = 20mg/ml
            // Cada 5 unidades = 1mg
            const unidadesPorMg = 5; // 100 unidades/ml ÷ 20 mg/ml = 5 unidades por mg
            const unidadesUI = Math.round(doseDesejada * unidadesPorMg);
            const volumeMl = doseDesejada / 20; // ml

            // Exibir resultados
            resultadoUI.textContent = unidadesUI.toFixed(0);
            resultadoVolume.textContent = `${volumeMl.toFixed(3)} ml`;

            // Mostrar área de resultado
            resultado.classList.remove('hidden');
        });
    });
</script>

