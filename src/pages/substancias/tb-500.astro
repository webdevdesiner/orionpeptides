---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Accordion from '../../components/Accordion.astro';
---

<Layout title="TB-500 | Guia Técnico | Orion Peptides" description="TB-500 (timosina beta-4) para pesquisa. Recuperação muscular e reparo. Pureza certificada, liofilizado. Guia técnico Orion Peptides." ogImage="/image/produtos/TB500.png">
    <Header />
    
    <main class="container mx-auto px-4 py-12 md:py-16">
        <!-- Topo - Resumo do Produto -->
        <section class="mb-16">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12 items-start">
                <!-- Coluna 1: Imagem do Produto -->
                <div class="space-y-6">
                    <!-- Mobile-only: título acima da imagem com ícone -->
                    <div class="md:hidden flex items-center justify-center gap-3 mb-3">
                        <div class="w-10 h-10 rounded-full bg-white/5 border border-emerald-500/20 flex items-center justify-center flex-shrink-0 shadow-[0_0_8px_rgba(16,185,129,0.12)]">
                            <img src="/image/catalogo/tb-500.png" alt="Ícone TB-500" class="w-8 h-8 object-contain" />
                        </div>
                        <h1 class="text-2xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-white via-emerald-200 to-emerald-400">
                            TB-500
                        </h1>
                    </div>
                    <figure class="w-full max-w-md bg-gray-900/50 border border-white/10 rounded-2xl overflow-hidden">
                        <div class="px-4 py-2.5 border-b border-white/10 bg-black/20">
                            <figcaption class="text-xs text-gray-400 uppercase tracking-wider font-medium">TB-500 — Imagem do produto</figcaption>
                        </div>
                        <div class="relative p-6 flex items-center justify-center">
                            <a
                                href="/contato"
                                data-wa-product="TB-500"
                                data-wa-phone="5511911387063"
                                class="absolute top-4 left-4 z-30 inline-flex flex-col items-center justify-center px-2.5 py-1.5 rounded bg-gradient-to-br from-amber-400 via-yellow-500 to-amber-600 hover:from-amber-300 hover:via-yellow-400 hover:to-amber-500 text-amber-950 text-[10px] font-bold uppercase tracking-wide shadow-md shadow-amber-500/30 hover:shadow-amber-400/50 border border-amber-300/50 hover:scale-105 active:scale-95 transition-all duration-300 leading-tight text-center"
                            >
                                <span>Encontrar</span>
                                <span>fornecedor</span>
                            </a>
                            <img 
                                src="/image/produtos/TB500.png" 
                                alt="TB-500 - Thymosin Beta-4 Fragment" 
                                class="w-full h-auto object-contain rounded-lg"
                            />
                        </div>
                    </figure>

                    <!-- Especificações Técnicas Rápidas -->
                    <div class="flex flex-col gap-4">
                        <!-- Card 1: Potência -->
                        <div class="bg-gray-900/50 backdrop-blur-md border border-emerald-500/20 rounded-xl p-4 hover:border-emerald-500/40 transition-all duration-300">
                            <div class="flex flex-col items-center text-center space-y-2">
                                <!-- Ícone Frasco -->
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
                                </svg>
                                <p class="text-xs text-gray-400 uppercase tracking-wider">Potência</p>
                                <p class="text-sm text-white font-semibold">10mg Liofilizado</p>
                            </div>
                        </div>

                        <!-- Card 2: Diluente -->
                        <div class="bg-gray-900/50 backdrop-blur-md border border-emerald-500/20 rounded-xl p-4 hover:border-emerald-500/40 transition-all duration-300">
                            <div class="flex flex-col items-center text-center space-y-2">
                                <!-- Ícone Gota -->
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-emerald-400" fill="currentColor" viewBox="0 0 24 24">
                                    <path d="M12 2.69c-3.5 0-6.31 2.81-6.31 6.31 0 3.5 6.31 10.31 6.31 10.31S18.31 12.5 18.31 9c0-3.5-2.81-6.31-6.31-6.31z"/>
                                </svg>
                                <p class="text-xs text-gray-400 uppercase tracking-wider">Inclui</p>
                                <p class="text-sm text-white font-semibold">🎁 Água Bacteriostática</p>
                            </div>
                        </div>

                        <!-- Card 3: Armazenamento -->
                        <div class="bg-gray-900/50 backdrop-blur-md border border-emerald-500/20 rounded-xl p-4 hover:border-emerald-500/40 transition-all duration-300">
                            <div class="flex flex-col items-center text-center space-y-2">
                                <!-- Ícone Floco de Neve -->
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
                                </svg>
                                <p class="text-xs text-gray-400 uppercase tracking-wider">Temperatura</p>
                                <p class="text-sm text-white font-semibold">2°C a 8°C (Geladeira)</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Coluna 2: Informações -->
                <div class="space-y-6">
                    <div>
                        <div class="hidden md:flex items-center gap-4 mb-2">
                            <div class="w-14 h-14 rounded-full bg-white/5 border border-emerald-500/20 flex items-center justify-center flex-shrink-0 shadow-[0_0_12px_rgba(16,185,129,0.25)]">
                                <img src="/image/catalogo/tb-500.png" alt="" class="w-10 h-10 object-contain" />
                            </div>
                            <h1 class="text-3xl md:text-5xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-white via-emerald-200 to-emerald-400">
                                TB-500
                            </h1>
                        </div>
                        <p class="text-xl text-gray-400 font-medium mb-3">Thymosin Beta-4 Fragment (Sistêmico)</p>
                        <p class="text-gray-500 text-sm leading-relaxed mb-6">
                            O TB-500 é a versão sintética da proteína Timosina Beta-4. Diferente do BPC-157 (focado em cura local), o TB-500 atua de forma <strong class="text-emerald-400">sistêmica</strong> (no corpo todo). Ele regula a proteína actina, essencial para a estrutura celular, promovendo flexibilidade extrema, redução de inflamação nas articulações e recuperação muscular rápida.
                        </p>
                        <div class="bg-emerald-900/20 border border-emerald-500/30 rounded-lg p-3 mb-4">
                            <p class="text-sm text-emerald-200">
                                <strong class="text-emerald-300">Diferencial Orion:</strong> Frasco de <strong>10mg</strong> ideal para cobrir a fase de saturação (loading phase) sem precisar de múltiplos frascos pequenos.
                            </p>
                        </div>
                    </div>

                    <!-- Seção Benefícios Pesquisados -->
                    <div class="mb-8">
                        <h3 class="text-2xl md:text-3xl font-bold mb-6 text-white">
                            Benefícios Pesquisados
                        </h3>
                        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6">
                            <!-- Benefício 1: Flexibilidade -->
                            <div class="flex flex-col items-center text-center space-y-3 p-4 hover:-translate-y-2 transition-all duration-300 cursor-default">
                                <!-- Ícone Flexibilidade -->
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 md:w-10 md:h-10 text-emerald-400 drop-shadow-[0_0_8px_rgba(16,185,129,0.5)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                                </svg>
                                <h4 class="text-white font-bold text-sm md:text-base">Flexibilidade</h4>
                                <p class="text-gray-400 text-xs md:text-sm">Melhora extrema da mobilidade</p>
                            </div>

                            <!-- Benefício 2: Recuperação Muscular -->
                            <div class="flex flex-col items-center text-center space-y-3 p-4 hover:-translate-y-2 transition-all duration-300 cursor-default">
                                <!-- Ícone Músculo -->
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 md:w-10 md:h-10 text-emerald-400 drop-shadow-[0_0_8px_rgba(16,185,129,0.5)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                                </svg>
                                <h4 class="text-white font-bold text-sm md:text-base">Recuperação</h4>
                                <p class="text-gray-400 text-xs md:text-sm">Recuperação muscular rápida</p>
                            </div>

                            <!-- Benefício 3: Anti-Inflamatório -->
                            <div class="flex flex-col items-center text-center space-y-3 p-4 hover:-translate-y-2 transition-all duration-300 cursor-default">
                                <!-- Ícone Escudo -->
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 md:w-10 md:h-10 text-emerald-400 drop-shadow-[0_0_8px_rgba(16,185,129,0.5)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                                </svg>
                                <h4 class="text-white font-bold text-sm md:text-base">Anti-Inflamatório</h4>
                                <p class="text-gray-400 text-xs md:text-sm">Redução de inflamação articular</p>
                            </div>

                            <!-- Benefício 4: Sistêmico -->
                            <div class="flex flex-col items-center text-center space-y-3 p-4 hover:-translate-y-2 transition-all duration-300 cursor-default">
                                <!-- Ícone Sistema -->
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 md:w-10 md:h-10 text-emerald-400 drop-shadow-[0_0_8px_rgba(16,185,129,0.5)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
                                </svg>
                                <h4 class="text-white font-bold text-sm md:text-base">Ação Sistêmica</h4>
                                <p class="text-gray-400 text-xs md:text-sm">Efeito em todo o corpo</p>
                            </div>
                        </div>
                    </div>

                    <div class="space-y-4">
                        <!-- Protocolo de Pesquisa Sugerido -->
                        <div class="mt-8 border-t border-white/10 pt-6">
                            <h4 class="text-white font-bold mb-4 flex items-center gap-2">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-emerald-400" viewBox="0 0 20 20" fill="currentColor">
                                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd" />
                                </svg>
                                Estratégia de Uso: Carga vs. Manutenção
                            </h4>

                            <div class="overflow-hidden rounded-xl border border-white/10 shadow-lg mb-4">
                                <div class="overflow-x-auto">
                                    <table class="w-full text-left text-sm">
                                    <thead class="bg-emerald-900/20 text-emerald-200 uppercase text-xs font-bold tracking-wider">
                                        <tr>
                                            <th class="px-4 py-3">Fase</th>
                                            <th class="px-4 py-3">Dose Semanal</th>
                                            <th class="px-4 py-3 text-white bg-emerald-600/20 border-l border-emerald-500/30">
                                                Volume na Seringa (Ref: 2ml água)
                                            </th>
                                            <th class="px-4 py-3">Frequência</th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-white/5 bg-gray-900/40">
                                        <tr class="hover:bg-white/5 transition-colors">
                                            <td class="px-4 py-3 font-medium text-white">Semanas 1-6<br/><span class="text-xs text-emerald-300">(Saturação)</span></td>
                                            <td class="px-4 py-3 text-gray-300">5.0 mg</td>
                                            <td class="px-4 py-3 font-bold text-emerald-400 border-l border-white/5">
                                                100 unidades (1.0 ml)<br/><span class="text-xs text-gray-400">ou 2x de 50 UI</span>
                                            </td>
                                            <td class="px-4 py-3 text-gray-300">1x Semana<br/><span class="text-xs">ou 2x (Seg/Qui)</span></td>
                                        </tr>
                                        <tr class="hover:bg-white/5 transition-colors">
                                            <td class="px-4 py-3 font-medium text-white">Semana 7+<br/><span class="text-xs text-emerald-300">(Manutenção)</span></td>
                                            <td class="px-4 py-3 text-gray-300">2.5 - 5.0 mg</td>
                                            <td class="px-4 py-3 font-bold text-emerald-400 border-l border-white/5">
                                                50-100 unidades<br/><span class="text-xs text-gray-400">(0.5-1.0 ml)</span>
                                            </td>
                                            <td class="px-4 py-3 text-gray-300">A cada 15 dias<br/><span class="text-xs">ou mensal</span></td>
                                        </tr>
                                    </tbody>
                                </table>
                                
                                <div class="bg-emerald-900/10 p-3 text-xs text-emerald-300 flex items-start gap-2 border-t border-white/5">
                                    <span class="text-emerald-500 font-bold">💡</span>
                                    <div>
                                        <p class="mb-1"><strong>Rendimento Fase 1:</strong> 1 Frasco Orion (10mg) dura <strong>2 semanas</strong> na fase de saturação intensa.</p>
                                        <p><strong>Rendimento Fase 2:</strong> 1 Frasco Orion dura de <strong>1 a 2 meses</strong> na fase de manutenção.</p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="bg-gray-900/50 border border-white/10 rounded-lg p-4">
                            <p class="text-sm text-gray-400 mb-1">Pureza Certificada</p>
                            <p class="text-emerald-400 font-bold text-2xl">>99.9% (HPLC) - High Purity</p>
                        </div>

                        <div class="bg-gray-900/50 border border-white/10 rounded-lg p-4">
                            <p class="text-sm text-gray-400 mb-1">Aplicação</p>
                            <p class="text-white">Pesquisa em reparação sistêmica, flexibilidade e recuperação muscular</p>
                        </div>
                    </div>

                    <a
                        href="/contato"
                        data-wa-product="TB-500"
                        data-wa-phone="5511911387063"
                        class="block w-full md:w-auto px-8 py-4 bg-gradient-to-r from-emerald-500 to-emerald-600 text-white font-bold rounded-lg hover:from-emerald-400 hover:to-emerald-500 transition-all duration-300 text-center shadow-lg shadow-emerald-500/30 hover:shadow-xl hover:shadow-emerald-500/50 active:scale-[0.98] border border-emerald-400/30 hover:border-emerald-400/50"
                    >
                        Encontrar Fornecedor
                    </a>
                </div>
            </div>
        </section>

        <!-- Área Técnica - Accordions -->
        <section class="max-w-4xl mx-auto">
            <h2 class="text-3xl md:text-4xl font-bold mb-8 text-center bg-clip-text text-transparent bg-gradient-to-r from-emerald-400 to-emerald-600">
                Informações Técnicas
            </h2>

            <div class="space-y-4">
                <!-- Accordion 1: O que é TB-500? -->
                <Accordion title="O que é TB-500?">
                    <div class="prose prose-invert max-w-none">
                        <p class="text-gray-300 mb-4">
                            O <strong class="text-white">TB-500</strong> é a versão sintética da proteína Timosina Beta-4. Diferente do BPC-157 (focado em cura local), o TB-500 atua de forma <strong class="text-emerald-400">sistêmica</strong> (no corpo todo).
                        </p>
                        <p class="text-gray-300 mb-4">
                            <strong class="text-white">Como age:</strong> Ele regula a proteína actina, essencial para a estrutura celular, promovendo flexibilidade extrema, redução de inflamação nas articulações e recuperação muscular rápida. É conhecido como o peptídeo da "flexibilidade e resistência".
                        </p>
                        <div class="bg-emerald-900/20 border border-emerald-500/30 rounded-lg p-3 mb-4">
                            <p class="text-sm text-emerald-200">
                                <strong class="text-emerald-300">Diferencial Orion:</strong> Frasco de <strong>10mg</strong> ideal para cobrir a fase de saturação (loading phase) sem precisar de múltiplos frascos pequenos.
                            </p>
                        </div>
                        <div class="bg-red-900/20 border border-red-500/30 p-4 rounded text-sm text-red-200">
                            <strong>Nota de Pesquisa:</strong> Este composto é destinado exclusivamente para fins de pesquisa científica e não deve ser utilizado para consumo humano ou veterinário sem aprovação regulatória adequada.
                        </div>
                    </div>
                </Accordion>

                <!-- Accordion 2: Mecanismo de Ação -->
                <Accordion title="Mecanismo de Ação (Ciência)">
                    <div class="prose prose-invert max-w-none">
                        <p class="text-gray-300 mb-6">O mecanismo de ação demonstra uma atividade sistêmica em modelos de pesquisa:</p>
                        
                        <ul class="space-y-4 list-none">
                            <li class="flex gap-3">
                                <span class="text-emerald-500 font-bold">Regulação da Actina:</span>
                                <span class="text-gray-400">Modula a proteína actina, essencial para a estrutura e movimento celular, promovendo flexibilidade e integridade tecidual.</span>
                            </li>
                            <li class="flex gap-3">
                                <span class="text-emerald-500 font-bold">Ação Anti-Inflamatória:</span>
                                <span class="text-gray-400">Reduz marcadores inflamatórios sistemicamente, melhorando a saúde articular e reduzindo dor relacionada a inflamação.</span>
                            </li>
                            <li class="flex gap-3">
                                <span class="text-emerald-500 font-bold">Recuperação Muscular:</span>
                                <span class="text-gray-400">Acelera a regeneração de tecido muscular através da promoção de migração celular e angiogênese em áreas danificadas.</span>
                            </li>
                            <li class="flex gap-3">
                                <span class="text-emerald-500 font-bold">Efeito Sistêmico:</span>
                                <span class="text-gray-400">Diferente de peptídeos locais, o TB-500 circula pelo corpo inteiro, permitindo reparo simultâneo em múltiplas áreas.</span>
                            </li>
                        </ul>

                        <p class="text-xs text-gray-600 mt-6 italic">Referência: Os mecanismos descritos são baseados em estudos pré-clínicos (in vivo/in vitro).</p>
                    </div>
                </Accordion>

                <!-- Accordion 3: Protocolo de Reconstituição -->
                <Accordion title="Protocolo de Reconstituição">
                    <div class="prose prose-invert max-w-none">
                        <div class="mb-8">
                            <h4 class="text-white font-bold mb-4">Guia de Mistura (Para Frasco 10mg)</h4>
                            <ol class="list-decimal list-inside space-y-3 text-gray-300">
                                <li><strong class="text-white">Diluente:</strong> Utilize <strong>2ml</strong> (200 unidades) de Água Bacteriostática.</li>
                                <li><strong class="text-white">Processo:</strong> Injete a água suavemente. O TB-500 dissolve muito rápido.</li>
                                <li><strong class="text-white">Matemática da Dose:</strong>
                                    <ul class="list-disc list-inside ml-4 mt-2 space-y-1">
                                        <li>10mg em 2ml = <strong>5mg por ml</strong></li>
                                        <li>Cada <strong>10 unidades</strong> na seringa de insulina = <strong>0.5mg</strong> (500mcg) de produto</li>
                                        <li><em class="text-gray-400">Nota: Doses de TB-500 são maiores (em mg) do que BPC (em mcg).</em></li>
                                    </ul>
                                </li>
                                <li>Armazene em refrigeração (2-8°C) após reconstituído.</li>
                                <li>Use dentro do prazo de validade após reconstituição.</li>
                            </ol>
                        </div>

                        <!-- Calculadora Rápida Inline (em primeiro) -->
                        <div class="bg-gray-800/50 border border-emerald-500/20 rounded-lg p-6 mt-4">
                            <h4 class="text-white font-bold mb-4 flex items-center gap-2">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
                                </svg>
                                Calculadora Rápida (TB-500 10mg)
                            </h4>
                            <form id="calculadoraTB500" class="space-y-4">
                                <div>
                                    <label for="doseTB500" class="block text-sm font-medium text-gray-300 mb-2">
                                        Dose Desejada (mg)
                                    </label>
                                    <input
                                        type="number"
                                        id="doseTB500"
                                        step="0.1"
                                        min="0"
                                        value="2.5"
                                        placeholder="Ex: 2.5"
                                        required
                                        class="w-full px-4 py-2 bg-black/50 border border-white/10 rounded-lg text-white placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500/50 transition-all duration-300"
                                    />
                                </div>
                                <button
                                    type="submit"
                                    class="w-full py-3 bg-gradient-to-r from-emerald-600 to-emerald-500 text-white font-bold rounded-lg hover:from-emerald-500 hover:to-emerald-400 transition-all duration-300 shadow-lg shadow-emerald-500/30 hover:shadow-xl hover:shadow-emerald-500/50 active:scale-[0.98]"
                                >
                                    CALCULAR UNIDADES
                                </button>
                            </form>
                            <div id="resultadoTB500" class="hidden mt-4 pt-4 border-t border-white/10">
