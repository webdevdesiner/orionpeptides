<script>
    // Calculadora Rápida para TB-500 (10mg em 2ml)
    document.addEventListener('DOMContentLoaded', () => {
        const formTB500 = document.getElementById('calculadoraTB500') as HTMLFormElement | null;
        const resultadoTB500 = document.getElementById('resultadoTB500');
        const resultadoUITB500 = document.getElementById('resultadoUITB500');
        const resultadoVolumeTB500 = document.getElementById('resultadoVolumeTB500');

        if (!formTB500 || !resultadoTB500 || !resultadoUITB500 || !resultadoVolumeTB500) {
            return;
        }

        formTB500.addEventListener('submit', (e) => {
            e.preventDefault();

            const inputDose = document.getElementById('doseTB500') as HTMLInputElement | null;
            if (!inputDose) return;

            // Valores fixos para TB-500 Orion (10mg em 2ml)
            const tamanhoFrasco = 10; // mg
            const quantidadeAgua = 2; // ml
            const doseDesejada = parseFloat(inputDose.value); // mg

            // Validação
            if (isNaN(doseDesejada) || doseDesejada <= 0 || doseDesejada > tamanhoFrasco) {
                alert('Por favor, insira uma dose válida entre 0 e 10mg.');
                return;
            }

            // Cálculo: 10mg em 2ml = 5mg/ml
            // Cada 10 unidades = 0.5mg (500mcg)
            // Para calcular unidades: doseDesejada (mg) / 0.5mg por 10 unidades * 10
            // Simplificando: doseDesejada * 20 unidades por mg
            const unidadesUI = doseDesejada * 20;
            const volumeMl = doseDesejada / 5; // 1mg = 0.2ml (5mg/ml)

            // Exibir resultados
            resultadoUITB500.textContent = unidadesUI.toFixed(0);
            resultadoVolumeTB500.textContent = `${volumeMl.toFixed(2)} ml`;

            // Mostrar área de resultado
            resultadoTB500.classList.remove('hidden');
        });
    });
</script>
