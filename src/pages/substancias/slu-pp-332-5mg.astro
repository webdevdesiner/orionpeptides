---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Accordion from '../../components/Accordion.astro';

const produtoNome = 'SLU-PP-332 5mg';
const concentracao = '5mg Liofilizado';

// Ícone de categoria (performance/metabolismo): reaproveitar MOTS-C até existir um ícone dedicado
const imagemCatalogo = '/image/catalogo/mots-c.png';

// Imagem do produto (já criada por você)
const imagemProduto = '/image/produtos/SLU-PP-332.png';
const imagemAlt = 'Frasco de SLU-PP-332 5mg Orion Peptides para pesquisa de metabolismo, endurance e função mitocondrial.';

const subtitulo = 'O "Mimético de Exercício" para Resistência, Metabolismo e Biogênese Mitocondrial.';
const descricao =
	'O SLU-PP-332 é um agonista sintético inovador dos Receptores Relacionados ao Estrogênio (ERRs), atuando como um poderoso "mimético de exercício". Ele ativa vias metabólicas normalmente estimuladas apenas por treinos intensos de resistência, promovendo a biogênese mitocondrial (criação de novas mitocôndrias), a oxidação acelerada de ácidos graxos e o aumento drástico da capacidade de endurance. É a fronteira da pesquisa em biohacking para otimização metabólica e preservação muscular sem a necessidade primária de estímulo físico exaustivo.';
const diferencialOrion =
	'Sintetizado com pureza laboratorial superior a 99%, assegurando máxima afinidade com os receptores ERR e resultados consistentes e reprodutíveis em protocolos de performance e longevidade celular.';

const tamanhoFrascoMg = 5;
const quantidadeAguaMl = 2;

const layoutTitle = `${produtoNome} | Guia Técnico | Orion Peptides`;
const layoutDescription =
	'SLU-PP-332 5mg Orion Peptides. O inovador agonista ERR e mimético de exercício para aumento de resistência, queima de gordura e biogênese mitocondrial.';
const layoutOgImage = '/image/produtos/SLU-PP-332.png';
---

<Layout title={layoutTitle} description={layoutDescription} ogImage={layoutOgImage}>
	<Header />
	<main class="container mx-auto px-4 py-12 md:py-16">
		<section class="mb-16">
			<div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12 items-start">
				<div class="space-y-6">
					<div class="md:hidden flex items-center justify-center gap-3 mb-3">
						<div
							class="w-10 h-10 rounded-full bg-white/5 border border-cyan-500/20 flex items-center justify-center flex-shrink-0 shadow-[0_0_8px_rgba(6,182,212,0.14)]"
						>
							<img src={imagemCatalogo} alt={`Ícone ${produtoNome}`} class="w-8 h-8 object-contain" />
						</div>
						<h1 class="text-2xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-white via-cyan-200 to-cyan-400">{produtoNome}</h1>
					</div>

					<figure class="w-full max-w-md bg-gray-900/50 border border-white/10 rounded-2xl overflow-hidden">
						<div class="px-4 py-2.5 border-b border-white/10 bg-black/20">
							<figcaption class="text-xs text-gray-400 uppercase tracking-wider font-medium">{produtoNome} — Imagem do produto</figcaption>
						</div>
						<div class="relative p-6 flex items-center justify-center">
							<a
								href="/contato"
								data-wa-product={produtoNome}
								data-wa-phone="5511911387063"
								class="absolute top-4 left-4 z-30 inline-flex flex-col items-center justify-center px-2.5 py-1.5 rounded bg-gradient-to-br from-amber-400 via-yellow-500 to-amber-600 hover:from-amber-300 hover:via-yellow-400 hover:to-amber-500 text-amber-950 text-[10px] font-bold uppercase tracking-wide shadow-md shadow-amber-500/30 hover:shadow-amber-400/50 border border-amber-300/50 hover:scale-105 active:scale-95 transition-all duration-300 leading-tight text-center"
							>
								<span>Encontrar</span><span>fornecedor</span>
							</a>
							<img src={imagemProduto} alt={imagemAlt} class="w-full h-auto object-contain rounded-lg" />
						</div>
					</figure>

					<div class="flex flex-col gap-4">
						<div class="bg-gray-900/50 backdrop-blur-md border border-cyan-500/20 rounded-xl p-4 hover:border-cyan-500/40 transition-all duration-300">
							<div class="flex flex-col items-center text-center space-y-2">
								<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
								</svg>
								<p class="text-xs text-gray-400 uppercase tracking-wider">Potência Total</p>
								<p class="text-sm text-white font-semibold">{concentracao}</p>
							</div>
						</div>

						<div class="bg-gray-900/50 backdrop-blur-md border border-cyan-500/20 rounded-xl p-4 hover:border-cyan-500/40 transition-all duration-300">
							<div class="flex flex-col items-center text-center space-y-2">
								<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-cyan-400" fill="currentColor" viewBox="0 0 24 24">
									<path d="M12 2.69c-3.5 0-6.31 2.81-6.31 6.31 0 3.5 6.31 10.31 6.31 10.31S18.31 12.5 18.31 9c0-3.5-2.81-6.31-6.31-6.31z" />
								</svg>
								<p class="text-xs text-gray-400 uppercase tracking-wider">Inclui</p>
								<p class="text-sm text-white font-semibold">🎁 Inclui 10ml de Água Estéril</p>
							</div>
						</div>

						<div class="bg-gray-900/50 backdrop-blur-md border border-cyan-500/20 rounded-xl p-4 hover:border-cyan-500/40 transition-all duration-300">
							<div class="flex flex-col items-center text-center space-y-2">
								<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
								</svg>
								<p class="text-xs text-gray-400 uppercase tracking-wider">Temperatura</p>
								<p class="text-sm text-white font-semibold">2°C a 8°C (Geladeira) após a reconstituição</p>
							</div>
						</div>

						<div class="bg-gray-900/50 backdrop-blur-md border border-cyan-500/20 rounded-xl p-4 hover:border-cyan-500/40 transition-all duration-300">
							<div class="flex flex-col items-center text-center space-y-2">
								<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
								</svg>
								<p class="text-xs text-gray-400 uppercase tracking-wider">Diluição Recomendada</p>
								<p class="text-sm text-white font-semibold">Requer {quantidadeAguaMl}ml de Água Estéril (10 UI = 250mcg)</p>
							</div>
						</div>
					</div>
				</div>

				<div class="space-y-6">
					<div>
						<div class="hidden md:flex items-center gap-4 mb-2">
							<div class="w-14 h-14 rounded-full bg-white/5 border border-cyan-500/20 flex items-center justify-center flex-shrink-0 shadow-[0_0_12px_rgba(6,182,212,0.24)]">
								<img src={imagemCatalogo} alt="" class="w-10 h-10 object-contain" />
							</div>
							<h1 class="text-3xl md:text-5xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-white via-cyan-200 to-cyan-400">{produtoNome}</h1>
						</div>
						<p class="text-xl text-gray-400 font-medium mb-3 hidden md:block">{subtitulo}</p>
						<p class="text-gray-500 text-sm leading-relaxed mb-6 hidden md:block">{descricao}</p>
						<div class="bg-cyan-900/20 border border-cyan-500/30 rounded-lg p-3 mb-4">
							<p class="text-sm text-cyan-100"><strong class="text-cyan-300">Diferencial Orion:</strong> {diferencialOrion}</p>
						</div>
					</div>

					<div class="mb-8">
						<h3 class="text-2xl md:text-3xl font-bold mb-6 text-white">Benefícios Pesquisados</h3>
						<div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6">
							<div class="flex flex-col items-center text-center space-y-3 p-4 hover:-translate-y-2 transition-all duration-300 cursor-default">
								<svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 md:w-10 md:h-10 text-cyan-400 drop-shadow-[0_0_8px_rgba(6,182,212,0.5)]" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
								<h4 class="text-white font-bold text-sm md:text-base">Biogênese Mitocondrial</h4>
								<p class="text-gray-400 text-xs md:text-sm">Mais mitocôndrias e eficiência energética (ATP) sustentada</p>
							</div>
							<div class="flex flex-col items-center text-center space-y-3 p-4 hover:-translate-y-2 transition-all duration-300 cursor-default">
								<svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 md:w-10 md:h-10 text-cyan-400 drop-shadow-[0_0_8px_rgba(6,182,212,0.5)]" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V5s-1 1-4 1-5-2-8-2-4 1-4 1v10z" /></svg>
								<h4 class="text-white font-bold text-sm md:text-base">Mimético de Resistência</h4>
								<p class="text-gray-400 text-xs md:text-sm">Simula efeitos metabólicos do cardio, sem treino excessivo</p>
							</div>
							<div class="flex flex-col items-center text-center space-y-3 p-4 hover:-translate-y-2 transition-all duration-300 cursor-default">
								<svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 md:w-10 md:h-10 text-cyan-400 drop-shadow-[0_0_8px_rgba(6,182,212,0.5)]" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3v18h18M7 15l3-3 3 3 7-7" /></svg>
								<h4 class="text-white font-bold text-sm md:text-base">Oxidação de Gordura</h4>
								<p class="text-gray-400 text-xs md:text-sm">Reprograma o metabolismo para usar gordura como combustível</p>
							</div>
							<div class="flex flex-col items-center text-center space-y-3 p-4 hover:-translate-y-2 transition-all duration-300 cursor-default">
								<svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 md:w-10 md:h-10 text-cyan-400 drop-shadow-[0_0_8px_rgba(6,182,212,0.5)]" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>
								<h4 class="text-white font-bold text-sm md:text-base">Preservação Muscular</h4>
								<p class="text-gray-400 text-xs md:text-sm">Protege fibras tipo I e reduz fadiga precoce</p>
							</div>
						</div>
					</div>

					<div class="space-y-4">
						<div class="mt-8 border-t border-white/10 pt-6">
							<h4 class="text-white font-bold mb-4 flex items-center gap-2">
								<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-cyan-400" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd" /></svg>
								Protocolo de Pesquisa Sugerido
							</h4>
							<div class="overflow-hidden rounded-xl border border-white/10 shadow-lg">
								<div class="overflow-x-auto">
									<table class="w-full text-left text-sm">
										<thead class="bg-cyan-900/20 text-cyan-200 uppercase text-xs font-bold tracking-wider">
											<tr>
												<th class="px-4 py-3">Fase de Estudo</th>
												<th class="px-4 py-3">Dose Diária</th>
												<th class="px-4 py-3 text-white bg-cyan-600/20 border-l border-cyan-500/30">Volume na Seringa (Ref: {quantidadeAguaMl}ml água)</th>
												<th class="px-4 py-3">Frequência</th>
											</tr>
										</thead>
										<tbody class="divide-y divide-white/5 bg-gray-900/40">
											<tr class="hover:bg-white/5 transition-colors">
												<td class="px-4 py-3 font-medium text-white">Uso Diário Contínuo (Semanas 1 a 8)</td>
												<td class="px-4 py-3 text-gray-300">0,25mg (250mcg)</td>
												<td class="px-4 py-3 font-bold text-cyan-300 border-l border-white/5">10 unidades (0,10 ml)</td>
												<td class="px-4 py-3 text-gray-300">1x ao dia (preferencialmente pela manhã)</td>
											</tr>
											<tr class="hover:bg-white/5 transition-colors">
												<td class="px-4 py-3 font-medium text-white">Alta Performance/Adaptação (Semanas 1 a 8)</td>
												<td class="px-4 py-3 text-gray-300">0,5mg (500mcg)</td>
												<td class="px-4 py-3 font-bold text-cyan-300 border-l border-white/5">20 unidades (0,20 ml)</td>
												<td class="px-4 py-3 text-gray-300">2x ao dia (manhã / pré-atividade)</td>
											</tr>
										</tbody>
									</table>
									<div class="bg-cyan-900/10 p-3 text-xs text-cyan-200 flex items-start gap-2 border-t border-white/5">
										<span class="text-cyan-400 font-bold">💡</span>
										<p><strong>Nota:</strong> embora atue independentemente do exercício, efeitos lipolíticos e de resistência podem ser amplificados com aeróbico leve/moderado.</p>
									</div>
								</div>
							</div>
						</div>

						<div class="bg-gray-900/50 border border-white/10 rounded-lg p-4">
							<p class="text-sm text-gray-400 mb-1">Pureza Certificada</p>
							<p class="text-cyan-300 font-bold text-2xl">&gt;99.0% (HPLC) - High Purity</p>
						</div>
						<div class="bg-gray-900/50 border border-white/10 rounded-lg p-4">
							<p class="text-sm text-gray-400 mb-1">Aplicação</p>
							<p class="text-white">Pesquisa em metabolismo energético, endurance e função mitocondrial</p>
						</div>
					</div>

					<a href="/contato" data-wa-product={produtoNome} data-wa-phone="5511911387063" class="block w-full md:w-auto px-8 py-4 bg-gradient-to-r from-cyan-500 to-cyan-600 text-black font-bold rounded-lg hover:from-cyan-400 hover:to-cyan-500 transition-all duration-300 text-center shadow-lg shadow-cyan-500/30 hover:shadow-xl hover:shadow-cyan-500/50 active:scale-[0.98] border border-cyan-300/30 hover:border-cyan-300/50">Encontrar Fornecedor</a>
				</div>
			</div>
		</section>

		<section class="max-w-4xl mx-auto">
			<h2 class="text-3xl md:text-4xl font-bold mb-8 text-center bg-clip-text text-transparent bg-gradient-to-r from-cyan-300 to-cyan-500">Informações Técnicas</h2>
			<div class="space-y-4">
				<Accordion title="O que é o SLU-PP-332?">
					<div class="prose prose-invert max-w-none">
						<p class="text-gray-300 mb-4">
							O SLU-PP-332 é uma pequena molécula (frequentemente agrupada em pesquisas com peptídeos metabólicos) projetada para ativar especificamente os Receptores Relacionados ao Estrogênio (ERRα, ERRβ, ERRγ). Apesar do nome, esses receptores não têm relação com os hormônios sexuais femininos; eles são reguladores centrais do metabolismo energético celular.
						</p>
						<p class="text-gray-300 mb-4">
							Ao se ligar a esses receptores, o SLU-PP-332 sinaliza vias associadas a um “estado de treino de resistência”, promovendo queima de gordura e adaptação mitocondrial em modelos de pesquisa.
						</p>
						<div class="bg-cyan-900/20 border border-cyan-500/30 rounded-lg p-3 mb-4">
							<p class="text-sm text-cyan-100"><strong class="text-cyan-300">Diferencial Orion:</strong> {diferencialOrion}</p>
						</div>
						<div class="bg-red-900/20 border border-red-500/30 p-4 rounded text-sm text-red-200">
							<strong>Nota de Pesquisa:</strong> Este composto é destinado exclusivamente para fins de pesquisa científica e não deve ser utilizado para consumo humano ou veterinário sem aprovação regulatória adequada.
						</div>
					</div>
				</Accordion>

				<Accordion title="Mecanismo de Ação (ERRs e PGC-1α)">
					<div class="prose prose-invert max-w-none">
						<ul class="space-y-4 list-none">
							<li class="flex gap-3"><span class="text-cyan-400 font-bold">ERRα/ERRγ:</span><span class="text-gray-400">Ativação direta dos receptores ERR com ênfase em subtipos ligados ao metabolismo lipídico no músculo.</span></li>
							<li class="flex gap-3"><span class="text-cyan-400 font-bold">PGC-1α:</span><span class="text-gray-400">Aumenta a atividade de PGC-1α, associado à biogênese mitocondrial.</span></li>
							<li class="flex gap-3"><span class="text-cyan-400 font-bold">Oxidação:</span><span class="text-gray-400">Estimula transcrição de genes de cadeia respiratória e oxidação de lipídios.</span></li>
							<li class="flex gap-3"><span class="text-cyan-400 font-bold">Perfil oxidativo:</span><span class="text-gray-400">Favorece adaptação para um perfil muscular mais oxidativo (resistência).</span></li>
						</ul>
					</div>
				</Accordion>

				<Accordion title="Protocolo de Reconstituição (SLU-PP-332 5mg)">
					<div class="prose prose-invert max-w-none">
						<div class="mb-8">
							<h4 class="text-white font-bold mb-4">Guia de Mistura (Frasco 5mg)</h4>
							<ol class="list-decimal list-inside space-y-3 text-gray-300">
								<li><strong class="text-white">Higienização:</strong> Limpe o septo com álcool 70%.</li>
								<li><strong class="text-white">Diluente:</strong> Extraia <strong>{quantidadeAguaMl}ml</strong> de água estéril/bacteriostática.</li>
								<li><strong class="text-white">Processo:</strong> Injete lentamente pela parede do frasco.</li>
								<li><strong class="text-white">Dissolução:</strong> Role delicadamente entre os dedos. Por ser um composto mais denso, pode levar 5–10 min para dissolver completamente.</li>
								<li><strong class="text-white">Armazenamento:</strong> Refrigere (2–8°C) após reconstituído.</li>
							</ol>
						</div>

						<div class="bg-gray-800/50 border border-cyan-500/20 rounded-lg p-6 mt-4">
							<h4 class="text-white font-bold mb-4 flex items-center gap-2">
								<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z" /></svg>
								Calculadora Rápida ({produtoNome})
							</h4>
							<form id="calculadoraProduto" class="space-y-4">
								<div>
									<label for="doseProduto" class="block text-sm font-medium text-gray-300 mb-2">Dose Desejada (mg)</label>
									<input type="number" id="doseProduto" step="0.05" min="0" value="0.25" placeholder="Ex: 0.25" required class="w-full px-4 py-2 bg-black/50 border border-white/10 rounded-lg text-white placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500/50 transition-all duration-300" />
								</div>
								<button type="submit" class="w-full md:w-auto py-3 bg-gradient-to-r from-cyan-600 to-cyan-500 text-black font-bold rounded-lg hover:from-cyan-500 hover:to-cyan-400 transition-all duration-300 shadow-lg shadow-cyan-500/30 hover:shadow-xl hover:shadow-cyan-500/50 active:scale-[0.98]">CALCULAR UNIDADES</button>
							</form>
							<div id="resultadoProduto" class="hidden mt-4 pt-4 border-t border-white/10">
								<div class="bg-cyan-500/15 border border-cyan-500/30 rounded-lg p-4 text-center">
									<p class="text-gray-400 text-xs mb-1">Unidades da Seringa (UI)</p>
									<p id="resultadoUIProduto" class="text-3xl font-bold text-cyan-300">0</p>
									<p class="text-gray-400 text-xs mt-1">Volume: <span id="resultadoVolumeProduto" class="text-cyan-200">0 ml</span></p>
								</div>
							</div>
						</div>

						<div class="bg-cyan-500/10 border border-cyan-500/30 rounded-lg p-4 mt-6">
