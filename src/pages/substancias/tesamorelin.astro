<script>
    // Calculadora Rápida para Tesamorelin (10mg em 2ml)
    document.addEventListener('DOMContentLoaded', () => {
        const formTesamorelin = document.getElementById('calculadoraTesamorelin') as HTMLFormElement | null;
        const resultadoTesamorelin = document.getElementById('resultadoTesamorelin');
        const resultadoUITesamorelin = document.getElementById('resultadoUITesamorelin');
        const resultadoVolumeTesamorelin = document.getElementById('resultadoVolumeTesamorelin');

        if (!formTesamorelin || !resultadoTesamorelin || !resultadoUITesamorelin || !resultadoVolumeTesamorelin) {
            return;
        }

        formTesamorelin.addEventListener('submit', (e) => {
            e.preventDefault();

            const inputDose = document.getElementById('doseTesamorelin') as HTMLInputElement | null;
            if (!inputDose) return;

            // Valores fixos para Tesamorelin Orion (10mg em 2ml)
            const tamanhoFrasco = 10; // mg
            const quantidadeAgua = 2; // ml
            const doseDesejada = parseFloat(inputDose.value); // mg

            // Validação
            if (isNaN(doseDesejada) || doseDesejada <= 0 || doseDesejada > tamanhoFrasco) {
                alert('Por favor, insira uma dose válida entre 0 e 10mg.');
                return;
            }

            // Cálculo: 10mg em 2ml = 5mg/ml
            // Para obter 1mg, precisa de 0.20ml = 20 unidades
            // Para calcular unidades: doseDesejada (mg) / 5mg por ml * 100 unidades por ml
            // Simplificando: doseDesejada * 20 unidades por mg
            const unidadesUI = doseDesejada * 20;
            const volumeMl = doseDesejada / 5; // 1mg = 0.2ml (5mg/ml)

            // Exibir resultados
            resultadoUITesamorelin.textContent = unidadesUI.toFixed(0);
            resultadoVolumeTesamorelin.textContent = `${volumeMl.toFixed(2)} ml`;

            // Mostrar área de resultado
            resultadoTesamorelin.classList.remove('hidden');
        });
    });
</script>
