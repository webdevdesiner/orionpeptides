---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Accordion from '../../components/Accordion.astro';
---

<Layout title="Tesamorelin | Guia Técnico | Orion Peptides">
    <Header />
    
    <main class="container mx-auto px-4 py-12 md:py-16">
        <!-- Topo - Resumo do Produto -->
        <section class="mb-16">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12 items-start">
                <!-- Coluna 1: Imagem do Produto -->
                <div class="space-y-6">
                    <div class="w-full max-w-md bg-gray-900/50 border border-white/10 rounded-2xl overflow-hidden">
                        <div class="px-4 py-2.5 border-b border-white/10 bg-black/20">
                            <p class="text-xs text-gray-400 uppercase tracking-wider font-medium">Imagem do produto</p>
                        </div>
                        <div class="relative p-6 flex items-center justify-center">
                            <a
                                href="/contato"
                                class="absolute top-4 left-4 z-30 inline-flex flex-col items-center justify-center px-2.5 py-1.5 rounded bg-gradient-to-br from-amber-400 via-yellow-500 to-amber-600 hover:from-amber-300 hover:via-yellow-400 hover:to-amber-500 text-amber-950 text-[10px] font-bold uppercase tracking-wide shadow-md shadow-amber-500/30 hover:shadow-amber-400/50 border border-amber-300/50 hover:scale-105 active:scale-95 transition-all duration-300 leading-tight text-center"
                            >
                                <span>Encontrar</span>
                                <span>fornecedor</span>
                            </a>
                            <img 
                                src="/image/produtos/TESAMORELIN.png" 
                                alt="Tesamorelin - GHRH Analog" 
                                class="w-full h-auto object-contain rounded-lg"
                            />
                        </div>
                    </div>

                    <!-- Especificações Técnicas Rápidas -->
                    <div class="flex flex-col gap-4">
                        <!-- Card 1: Potência -->
                        <div class="bg-gray-900/50 backdrop-blur-md border border-red-500/20 rounded-xl p-4 hover:border-red-500/40 transition-all duration-300">
                            <div class="flex flex-col items-center text-center space-y-2">
                                <!-- Ícone Frasco -->
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-red-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
                                </svg>
                                <p class="text-xs text-gray-400 uppercase tracking-wider">Potência</p>
                                <p class="text-sm text-white font-semibold">10mg Liofilizado</p>
                            </div>
                        </div>

                        <!-- Card 2: Diluente -->
                        <div class="bg-gray-900/50 backdrop-blur-md border border-red-500/20 rounded-xl p-4 hover:border-red-500/40 transition-all duration-300">
                            <div class="flex flex-col items-center text-center space-y-2">
                                <!-- Ícone Gota -->
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-red-400" fill="currentColor" viewBox="0 0 24 24">
                                    <path d="M12 2.69c-3.5 0-6.31 2.81-6.31 6.31 0 3.5 6.31 10.31 6.31 10.31S18.31 12.5 18.31 9c0-3.5-2.81-6.31-6.31-6.31z"/>
                                </svg>
                                <p class="text-xs text-gray-400 uppercase tracking-wider">Requer</p>
                                <p class="text-sm text-white font-semibold">Água Bac. (Não incluso)</p>
                            </div>
                        </div>

                        <!-- Card 3: Armazenamento -->
                        <div class="bg-gray-900/50 backdrop-blur-md border border-red-500/20 rounded-xl p-4 hover:border-red-500/40 transition-all duration-300">
                            <div class="flex flex-col items-center text-center space-y-2">
                                <!-- Ícone Floco de Neve -->
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-red-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
                                </svg>
                                <p class="text-xs text-gray-400 uppercase tracking-wider">Temperatura</p>
                                <p class="text-sm text-white font-semibold">2°C a 8°C (Geladeira)</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Coluna 2: Informações -->
                <div class="space-y-6">
                    <div>
                        <div class="flex items-center gap-4 mb-2">
                            <div class="w-14 h-14 rounded-full bg-white/5 border border-red-500/20 flex items-center justify-center flex-shrink-0 shadow-[0_0_12px_rgba(239,68,68,0.25)]">
                                <img src="/image/catalogo/tesamorelin.png" alt="" class="w-10 h-10 object-contain" />
                            </div>
                            <h1 class="text-4xl md:text-5xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-white via-red-200 to-red-400">
                                Tesamorelin
                            </h1>
                        </div>
                        <p class="text-xl text-gray-400 font-medium mb-3">GHRH Analog (Visceral Fat Specialist)</p>
                        <p class="text-gray-500 text-sm leading-relaxed mb-6">
                            É o peptídeo mais potente do mundo para a queima de <strong class="text-red-400">gordura visceral</strong> (a gordura profunda que cobre os órgãos e estufa o abdômen). Estimula a hipófise a liberar Hormônio do Crescimento (GH) de forma pulsátil e natural. Diferente do GH sintético, não altera a glicemia drasticamente.
                        </p>
                        <div class="bg-red-900/20 border border-red-500/30 rounded-lg p-3 mb-4">
                            <p class="text-sm text-red-200">
                                <strong class="text-red-300">Aprovação:</strong> É o único peptídeo <strong>aprovado pelo FDA</strong> (como <em>Egrifta</em>) especificamente para redução de gordura abdominal.
                            </p>
                        </div>
                    </div>

                    <!-- Seção Benefícios Pesquisados -->
                    <div class="mb-8">
                        <h3 class="text-2xl md:text-3xl font-bold mb-6 text-white">
                            Benefícios Pesquisados
                        </h3>
                        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6">
                            <!-- Benefício 1: Gordura Visceral -->
                            <div class="flex flex-col items-center text-center space-y-3 p-4 hover:-translate-y-2 transition-all duration-300 cursor-default">
                                <!-- Ícone Abdômen -->
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 md:w-10 md:h-10 text-red-400 drop-shadow-[0_0_8px_rgba(239,68,68,0.5)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                                </svg>
                                <h4 class="text-white font-bold text-sm md:text-base">Gordura Visceral</h4>
                                <p class="text-gray-400 text-xs md:text-sm">Redução específica abdominal</p>
                            </div>

                            <!-- Benefício 2: Hormônio do Crescimento -->
                            <div class="flex flex-col items-center text-center space-y-3 p-4 hover:-translate-y-2 transition-all duration-300 cursor-default">
                                <!-- Ícone Crescimento -->
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 md:w-10 md:h-10 text-red-400 drop-shadow-[0_0_8px_rgba(239,68,68,0.5)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
                                </svg>
                                <h4 class="text-white font-bold text-sm md:text-base">GH Natural</h4>
                                <p class="text-gray-400 text-xs md:text-sm">Liberação pulsátil de GH</p>
                            </div>

                            <!-- Benefício 3: Definição -->
                            <div class="flex flex-col items-center text-center space-y-3 p-4 hover:-translate-y-2 transition-all duration-300 cursor-default">
                                <!-- Ícone Definição -->
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 md:w-10 md:h-10 text-red-400 drop-shadow-[0_0_8px_rgba(239,68,68,0.5)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                                </svg>
                                <h4 class="text-white font-bold text-sm md:text-base">Definição</h4>
                                <p class="text-gray-400 text-xs md:text-sm">Definição abdominal</p>
                            </div>

                            <!-- Benefício 4: Performance -->
                            <div class="flex flex-col items-center text-center space-y-3 p-4 hover:-translate-y-2 transition-all duration-300 cursor-default">
                                <!-- Ícone Performance -->
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 md:w-10 md:h-10 text-red-400 drop-shadow-[0_0_8px_rgba(239,68,68,0.5)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                                </svg>
                                <h4 class="text-white font-bold text-sm md:text-base">Performance</h4>
                                <p class="text-gray-400 text-xs md:text-sm">Melhora da performance física</p>
                            </div>
                        </div>
                    </div>

                    <div class="space-y-4">
                        <!-- Protocolo de Pesquisa Sugerido -->
                        <div class="mt-8 border-t border-white/10 pt-6">
                            <h4 class="text-white font-bold mb-4 flex items-center gap-2">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor">
                                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd" />
                                </svg>
                                Estratégia de Uso (Protocolo 5/2)
                            </h4>

                            <div class="space-y-4">
                                <!-- Protocolo Padrão -->
                                <div class="overflow-hidden rounded-xl border border-white/10 shadow-lg">
                                    <div class="bg-red-900/20 px-4 py-3 border-b border-white/10">
                                        <h5 class="text-red-200 font-bold text-sm uppercase">Protocolo "Abdominal Definition"</h5>
                                    </div>
                                    <div class="bg-gray-900/40 p-4">
                                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm">
                                            <div>
                                                <p class="text-gray-400 mb-1">Dose Diária</p>
                                                <p class="text-red-400 font-bold text-lg">1mg</p>
                                                <p class="text-gray-500 text-xs mt-1">(20 unidades)</p>
                                            </div>
                                            <div>
                                                <p class="text-gray-400 mb-1">Frequência</p>
                                                <p class="text-white font-semibold">5 dias ON / 2 dias OFF</p>
                                                <p class="text-gray-500 text-xs mt-1">(Seg a Sex ON, Sab/Dom OFF)</p>
                                            </div>
                                            <div>
                                                <p class="text-gray-400 mb-1">Horário</p>
                                                <p class="text-white">Antes de dormir (jejum 2h) OU ao acordar antes do cardio</p>
                                            </div>
                                            <div>
                                                <p class="text-gray-400 mb-1">Rendimento</p>
                                                <p class="text-white">O frasco de 10mg dura <strong class="text-red-400">2 semanas</strong> completas (10 aplicações)</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Protocolo Clínico -->
                                <div class="overflow-hidden rounded-xl border border-red-500/30 shadow-lg">
                                    <div class="bg-red-900/30 px-4 py-3 border-b border-red-500/20">
                                        <h5 class="text-red-200 font-bold text-sm uppercase">Protocolo Clínico (Intenso)</h5>
                                    </div>
                                    <div class="bg-gray-900/40 p-4">
                                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm">
                                            <div>
                                                <p class="text-gray-400 mb-1">Dose Diária</p>
                                                <p class="text-red-400 font-bold text-lg">2mg</p>
                                                <p class="text-gray-500 text-xs mt-1">(40 unidades)</p>
                                            </div>
                                            <div>
                                                <p class="text-gray-400 mb-1">Indicado para</p>
                                                <p class="text-white font-semibold">Gordura visceral severa ou fisiculturistas em pré-contest</p>
                                            </div>
                                            <div class="md:col-span-2">
                                                <p class="text-gray-400 mb-1">Rendimento</p>
                                                <p class="text-white">O frasco dura <strong class="text-red-400">1 semana</strong>.</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="bg-red-900/10 p-3 text-xs text-red-300 flex items-start gap-2 border-t border-white/5 mt-4 rounded-b-xl">
                                <span class="text-red-500 font-bold">💡</span>
                                <p><strong>Por que 5/2?</strong> Para evitar que o corpo se "acostume" (dessensibilização), usamos pausas semanais que mantêm a eficácia do peptídeo.</p>
                            </div>
                        </div>

                        <div class="bg-gray-900/50 border border-white/10 rounded-lg p-4">
                            <p class="text-sm text-gray-400 mb-1">Pureza Certificada</p>
                            <p class="text-red-400 font-bold text-2xl">>99.7% (HPLC) - High Purity</p>
                        </div>

                        <div class="bg-gray-900/50 border border-white/10 rounded-lg p-4">
                            <p class="text-sm text-gray-400 mb-1">Aplicação</p>
                            <p class="text-white">Pesquisa em redução de gordura visceral, definição abdominal e performance física</p>
                        </div>
                    </div>

                    <a
                        href="#"
                        class="block w-full md:w-auto px-8 py-4 bg-gradient-to-r from-red-500 to-red-600 text-white font-bold rounded-lg hover:from-red-400 hover:to-red-500 transition-all duration-300 text-center shadow-lg shadow-red-500/30 hover:shadow-xl hover:shadow-red-500/50 active:scale-[0.98] border border-red-400/30 hover:border-red-400/50"
                    >
                        Encontrar Fornecedor
                    </a>
                </div>
            </div>
        </section>

        <!-- Área Técnica - Accordions -->
        <section class="max-w-4xl mx-auto">
            <h2 class="text-3xl md:text-4xl font-bold mb-8 text-center bg-clip-text text-transparent bg-gradient-to-r from-red-400 to-red-600">
                Informações Técnicas
            </h2>

            <div class="space-y-4">
                <!-- Accordion 1: O que é Tesamorelin? -->
                <Accordion title="O que é Tesamorelin?">
                    <div class="prose prose-invert max-w-none">
                        <p class="text-gray-300 mb-4">
                            É o peptídeo mais potente do mundo para a queima de <strong class="text-white">gordura visceral</strong> (a gordura profunda que cobre os órgãos e estufa o abdômen).
                        </p>
                        <p class="text-gray-300 mb-4">
                            <strong class="text-white">Como age:</strong> Estimula a hipófise a liberar Hormônio do Crescimento (GH) de forma pulsátil e natural. Diferente do GH sintético, não altera a glicemia drasticamente.
                        </p>
                        <div class="bg-red-900/20 border border-red-500/30 rounded-lg p-3 mb-4">
                            <p class="text-sm text-red-200">
                                <strong class="text-red-300">Aprovação:</strong> É o único peptídeo <strong>aprovado pelo FDA</strong> (como <em>Egrifta</em>) especificamente para redução de gordura abdominal.
                            </p>
                        </div>
                        <div class="bg-red-900/20 border border-red-500/30 p-4 rounded text-sm text-red-200">
                            <strong>Nota de Pesquisa:</strong> Este composto é destinado exclusivamente para fins de pesquisa científica e não deve ser utilizado para consumo humano ou veterinário sem aprovação regulatória adequada.
                        </div>
                    </div>
                </Accordion>

                <!-- Accordion 2: Mecanismo de Ação -->
                <Accordion title="Mecanismo de Ação (Ciência)">
                    <div class="prose prose-invert max-w-none">
                        <p class="text-gray-300 mb-6">O mecanismo de ação demonstra uma atividade específica em gordura visceral em modelos de pesquisa:</p>
                        
                        <ul class="space-y-4 list-none">
                            <li class="flex gap-3">
                                <span class="text-red-500 font-bold">Liberação de GH:</span>
                                <span class="text-gray-400">Estimula a hipófise a liberar Hormônio do Crescimento de forma pulsátil e fisiológica, mimetizando os pulsos naturais do corpo.</span>
                            </li>
                            <li class="flex gap-3">
                                <span class="text-red-500 font-bold">Redução de Gordura Visceral:</span>
                                <span class="text-gray-400">O GH liberado promove lipólise seletiva na gordura visceral (abdominal profunda), enquanto preserva gordura subcutânea em menor grau.</span>
                            </li>
                            <li class="flex gap-3">
                                <span class="text-red-500 font-bold">Metabolismo de Lipídios:</span>
                                <span class="text-gray-400">Aumenta a oxidação de ácidos graxos e reduz o acúmulo de gordura visceral através da ativação de enzimas lipolíticas.</span>
                            </li>
                            <li class="flex gap-3">
                                <span class="text-red-500 font-bold">Vantagem sobre GH Sintético:</span>
                                <span class="text-gray-400">Diferente do GH sintético injetado diretamente, o Tesamorelin mantém a regulação natural do corpo, evitando picos glicêmicos e mantendo sensibilidade à insulina.</span>
                            </li>
                        </ul>

                        <p class="text-xs text-gray-600 mt-6 italic">Referência: Os mecanismos descritos são baseados em estudos clínicos aprovados pelo FDA (Egrifta).</p>
                    </div>
                </Accordion>

                <!-- Accordion 3: Protocolo de Reconstituição -->
                <Accordion title="Protocolo de Reconstituição">
                    <div class="prose prose-invert max-w-none">
                        <div class="mb-8">
                            <h4 class="text-white font-bold mb-4">Guia de Mistura (Frasco 10mg)</h4>
                            <ol class="list-decimal list-inside space-y-3 text-gray-300">
                                <li><strong class="text-white">Diluente:</strong> Utilize <strong>2ml</strong> (200 unidades) de Água Bacteriostática.</li>
                                <li><strong class="text-white">Processo:</strong> Injete a água suavemente. O Tesamorelin pode formar uma solução levemente turva no início, mas deve ficar transparente após alguns minutos. <strong>NÃO agite</strong>.</li>
                                <li><strong class="text-white">Matemática da Dose:</strong>
                                    <ul class="list-disc list-inside ml-4 mt-2 space-y-1">
                                        <li>10mg em 2ml = <strong>5mg por ml</strong></li>
                                        <li>A dose padrão de eficácia é <strong>1mg</strong></li>
                                        <li>Para obter <strong>1mg</strong>, você precisa de <strong>0.20ml</strong> (<strong>20 unidades</strong> na seringa)</li>
                                    </ul>
                                </li>
                                <li>Armazene em refrigeração (2-8°C) após reconstituído.</li>
                                <li>Use dentro do prazo de validade após reconstituição.</li>
                            </ol>
                        </div>

                        <!-- Calculadora Rápida Inline (em primeiro) -->
                        <div class="bg-gray-800/50 border border-red-500/20 rounded-lg p-6 mt-4">
                            <h4 class="text-white font-bold mb-4 flex items-center gap-2">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-red-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
                                </svg>
                                Calculadora Rápida (Tesamorelin 10mg)
                            </h4>
                            <form id="calculadoraTesamorelin" class="space-y-4">
                                <div>
                                    <label for="doseTesamorelin" class="block text-sm font-medium text-gray-300 mb-2">
                                        Dose Desejada (mg)
                                    </label>
                                    <input
                                        type="number"
                                        id="doseTesamorelin"
                                        step="0.1"
                                        min="0"
                                        value="1"
                                        placeholder="Ex: 1"
                                        required
                                        class="w-full px-4 py-2 bg-black/50 border border-white/10 rounded-lg text-white placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-red-500/50 transition-all duration-300"
                                    />
                                </div>
                                <button
                                    type="submit"
                                    class="w-full py-3 bg-gradient-to-r from-red-600 to-red-500 text-white font-bold rounded-lg hover:from-red-500 hover:to-red-400 transition-all duration-300 shadow-lg shadow-red-500/30 hover:shadow-xl hover:shadow-red-500/50 active:scale-[0.98]"
                                >
                                    CALCULAR UNIDADES
                                </button>
                            </form>
                            <div id="resultadoTesamorelin" class="hidden mt-4 pt-4 border-t border-white/10">
                                <div class="bg-red-500/20 border border-red-500/30 rounded-lg p-4 text-center">
                                    <p class="text-gray-400 text-xs mb-1">Unidades da Seringa (UI)</p>
                                    <p id="resultadoUITesamorelin" class="text-3xl font-bold text-red-400">0</p>
                                    <p class="text-gray-400 text-xs mt-1">Volume: <span id="resultadoVolumeTesamorelin" class="text-red-300">0 ml</span></p>
                                </div>
                            </div>
                        </div>

                        <div class="bg-red-500/10 border border-red-500/30 rounded-lg p-4 mt-6">
                            <p class="text-sm text-red-300 mb-3">
                                <strong>Dica:</strong> Use a calculadora completa para outros frascos e diluições.
                            </p>
                            <a
                                href="/calculadora"
                                class="inline-flex items-center gap-2 px-4 py-2 bg-red-500/20 hover:bg-red-500/30 border border-red-500/50 text-red-300 rounded-lg transition-colors text-sm font-semibold"
                            >
                                Acessar Calculadora Completa
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
