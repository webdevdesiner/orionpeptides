<script>
    // Calculadora Rápida para BPC-157 (10mg em 2ml)
    document.addEventListener('DOMContentLoaded', () => {
        const formBPC = document.getElementById('calculadoraBPC') as HTMLFormElement | null;
        const resultadoBPC = document.getElementById('resultadoBPC');
        const resultadoUIBPC = document.getElementById('resultadoUIBPC');
        const resultadoVolumeBPC = document.getElementById('resultadoVolumeBPC');

        if (!formBPC || !resultadoBPC || !resultadoUIBPC || !resultadoVolumeBPC) {
            return;
        }

        formBPC.addEventListener('submit', (e) => {
            e.preventDefault();

            const inputDose = document.getElementById('doseBPC') as HTMLInputElement | null;
            if (!inputDose) return;

            // Valores fixos para BPC-157 Orion (10mg em 2ml)
            const tamanhoFrasco = 10; // mg
            const quantidadeAgua = 2; // ml
            const doseDesejada = parseFloat(inputDose.value); // mcg

            // Validação
            if (isNaN(doseDesejada) || doseDesejada <= 0 || doseDesejada > 10000) {
                alert('Por favor, insira uma dose válida entre 0 e 10000mcg.');
                return;
            }

            // Cálculo: 10mg em 2ml = 5mg/ml = 5000mcg/ml
            // Cada 10 unidades = 500mcg
            // Para calcular unidades: doseDesejada (mcg) / 500mcg por 10 unidades * 10
            // Simplificando: (doseDesejada / 500) * 10 = doseDesejada / 50
            const unidadesUI = doseDesejada / 50;
            const volumeMl = doseDesejada / 5000; // mcg para ml (5000mcg/ml)

            // Exibir resultados
            resultadoUIBPC.textContent = unidadesUI.toFixed(1);
            resultadoVolumeBPC.textContent = `${volumeMl.toFixed(3)} ml`;

            // Mostrar área de resultado
            resultadoBPC.classList.remove('hidden');
        });
    });
</script>

