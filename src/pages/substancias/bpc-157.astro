---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Accordion from '../../components/Accordion.astro';
---

<Layout title="BPC-157 | Guia Técnico | Orion Peptides">
    <Header />
    
    <main class="container mx-auto px-4 py-12 md:py-16">
        <!-- Topo - Resumo do Produto -->
        <section class="mb-16">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12 items-start">
                <!-- Coluna 1: Imagem do Produto -->
                <div class="space-y-6">
                    <div class="flex items-center justify-center">
                        <div class="w-full max-w-md bg-gray-900/50 border border-white/10 rounded-2xl p-6 flex items-center justify-center">
                            <img 
                                src="/image/BCP157.png" 
                                alt="BPC-157 - Peptídeo de Reparação Tecidual" 
                                class="w-full h-auto object-contain rounded-lg"
                            />
                        </div>
                    </div>

                    <!-- Especificações Técnicas Rápidas -->
                    <div class="flex flex-col gap-4">
                        <!-- Card 1: Potência -->
                        <div class="bg-gray-900/50 backdrop-blur-md border border-green-500/20 rounded-xl p-4 hover:border-green-500/40 transition-all duration-300">
                            <div class="flex flex-col items-center text-center space-y-2">
                                <!-- Ícone Frasco -->
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-green-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
                                </svg>
                                <p class="text-xs text-gray-400 uppercase tracking-wider">Potência</p>
                                <p class="text-sm text-white font-semibold">5mg Liofilizado</p>
                            </div>
                        </div>

                        <!-- Card 2: Diluente -->
                        <div class="bg-gray-900/50 backdrop-blur-md border border-green-500/20 rounded-xl p-4 hover:border-green-500/40 transition-all duration-300">
                            <div class="flex flex-col items-center text-center space-y-2">
                                <!-- Ícone Gota -->
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-green-400" fill="currentColor" viewBox="0 0 24 24">
                                    <path d="M12 2.69c-3.5 0-6.31 2.81-6.31 6.31 0 3.5 6.31 10.31 6.31 10.31S18.31 12.5 18.31 9c0-3.5-2.81-6.31-6.31-6.31z"/>
                                </svg>
                                <p class="text-xs text-gray-400 uppercase tracking-wider">Requer</p>
                                <p class="text-sm text-white font-semibold">Água Bac. (Não incluso)</p>
                            </div>
                        </div>

                        <!-- Card 3: Armazenamento -->
                        <div class="bg-gray-900/50 backdrop-blur-md border border-green-500/20 rounded-xl p-4 hover:border-green-500/40 transition-all duration-300">
                            <div class="flex flex-col items-center text-center space-y-2">
                                <!-- Ícone Floco de Neve -->
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-green-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
                                </svg>
                                <p class="text-xs text-gray-400 uppercase tracking-wider">Temperatura</p>
                                <p class="text-sm text-white font-semibold">2°C a 8°C (Geladeira)</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Coluna 2: Informações -->
                <div class="space-y-6">
                    <div>
                        <h1 class="text-4xl md:text-5xl font-bold mb-2 bg-clip-text text-transparent bg-gradient-to-r from-white to-gray-300">
                            BPC-157
                        </h1>
                        <p class="text-xl text-gray-400 font-medium mb-3">Pentadecapeptídeo Sintético de Reparação Tecidual</p>
                        <p class="text-gray-500 text-sm leading-relaxed mb-6">
                            Composto de 15 aminoácidos derivado de proteína gástrica, estudado por suas propriedades pleiotrópicas na regeneração celular e angiogênese.
                        </p>
                    </div>

                    <!-- Seção Benefícios Pesquisados -->
                    <div class="mb-8">
                        <h3 class="text-2xl md:text-3xl font-bold mb-6 text-white">
                            Benefícios Pesquisados
                        </h3>
                        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6">
                            <!-- Benefício 1: Aceleração -->
                            <div class="flex flex-col items-center text-center space-y-3 p-4 hover:-translate-y-2 transition-all duration-300 cursor-default">
                                <!-- Ícone Raio -->
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 md:w-10 md:h-10 text-green-400 drop-shadow-[0_0_8px_rgba(74,222,128,0.5)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                                </svg>
                                <h4 class="text-white font-bold text-sm md:text-base">Aceleração</h4>
                                <p class="text-gray-400 text-xs md:text-sm">Recuperação rápida de tecidos</p>
                            </div>

                            <!-- Benefício 2: Proteção -->
                            <div class="flex flex-col items-center text-center space-y-3 p-4 hover:-translate-y-2 transition-all duration-300 cursor-default">
                                <!-- Ícone Escudo -->
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 md:w-10 md:h-10 text-green-400 drop-shadow-[0_0_8px_rgba(74,222,128,0.5)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                                </svg>
                                <h4 class="text-white font-bold text-sm md:text-base">Proteção</h4>
                                <p class="text-gray-400 text-xs md:text-sm">Ação anti-inflamatória potente</p>
                            </div>

                            <!-- Benefício 3: Gastrointestinal -->
                            <div class="flex flex-col items-center text-center space-y-3 p-4 hover:-translate-y-2 transition-all duration-300 cursor-default">
                                <!-- Ícone Estômago Anatômico -->
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 md:w-10 md:h-10 text-green-400 drop-shadow-[0_0_8px_rgba(74,222,128,0.5)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 4h8M8 4c0 1.1.9 2 2 2h4c1.1 0 2-.9 2-2M8 4c0-1.1.9-2 2-2h4c1.1 0 2 .9 2 2m0 0v10c0 1.1-.9 2-2 2h-4c-1.1 0-2-.9-2-2V4m8 2H8m8 4H8m0 4h8" />
                                </svg>
                                <h4 class="text-white font-bold text-sm md:text-base">Gastrointestinal</h4>
                                <p class="text-gray-400 text-xs md:text-sm">Reparação da parede gástrica</p>
                            </div>

                            <!-- Benefício 4: Neurogênese -->
                            <div class="flex flex-col items-center text-center space-y-3 p-4 hover:-translate-y-2 transition-all duration-300 cursor-default">
                                <!-- Ícone Cérebro Anatômico -->
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 md:w-10 md:h-10 text-green-400 drop-shadow-[0_0_8px_rgba(74,222,128,0.5)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 3.5c-2.5 0-4.5 1.5-4.5 3.5 0 1.5 1 2.5 2 3M9.75 3.5c2.5 0 4.5 1.5 4.5 3.5 0 1.5-1 2.5-2 3M9.75 3.5v17m-4-13c-1 0-2 1-2 2.5 0 2 1.5 3.5 3.5 3.5m9-6c1 0 2 1 2 2.5 0 2-1.5 3.5-3.5 3.5" />
                                </svg>
                                <h4 class="text-white font-bold text-sm md:text-base">Neurogênese</h4>
                                <p class="text-gray-400 text-xs md:text-sm">Proteção do sistema nervoso</p>
                            </div>
                        </div>
                    </div>

                    <div class="space-y-4">
                        <div class="mt-8 border-t border-white/10 pt-6">
    <h4 class="text-white font-bold mb-4 flex items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-green-400" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd" />
        </svg>
        Protocolo de Pesquisa Sugerido (Ciclo de Reparação)
    </h4>

    <div class="overflow-hidden rounded-xl border border-white/10 shadow-lg">
        <table class="w-full text-left text-sm">
            <thead class="bg-blue-900/20 text-blue-200 uppercase text-xs font-bold tracking-wider">
                <tr>
                    <th class="px-4 py-3">Fase</th>
                    <th class="px-4 py-3">Dosagem Diária</th>
                    <th class="px-4 py-3 text-white bg-blue-600/20 border-l border-blue-500/30">
                        Na Seringa (UI)*
                    </th>
                </tr>
            </thead>
            <tbody class="divide-y divide-white/5 bg-gray-900/40">
                <tr class="hover:bg-white/5 transition-colors">
                    <td class="px-4 py-3 font-medium text-white">Semana 1-2</td>
                    <td class="px-4 py-3 text-gray-300">250 mcg (2x ao dia)</td>
                    <td class="px-4 py-3 font-bold text-green-400 border-l border-white/5">
                        5 UI (Manhã) + 5 UI (Noite)
                    </td>
                </tr>
                <tr class="hover:bg-white/5 transition-colors">
                    <td class="px-4 py-3 font-medium text-white">Semana 3-4</td>
                    <td class="px-4 py-3 text-gray-300">500 mcg (1x ao dia)</td>
                    <td class="px-4 py-3 font-bold text-green-400 border-l border-white/5">
                        10 UI (Total)
                    </td>
                </tr>
            </tbody>
        </table>
        
        <div class="bg-blue-900/10 p-3 text-xs text-blue-300 flex items-start gap-2 border-t border-white/5">
            <span class="text-blue-500 font-bold">*</span>
            <p>Valores baseados em reconstituição padrão com <strong>3ml de água</strong> em frasco de 5mg.</p>
        </div>
    </div>
</div>

                        <div class="bg-gray-900/50 border border-white/10 rounded-lg p-4">
                            <p class="text-sm text-gray-400 mb-1">Pureza Certificada</p>
                            <p class="text-green-400 font-bold text-2xl">>99% (HPLC)</p>
                        </div>

                        <div class="bg-gray-900/50 border border-white/10 rounded-lg p-4">
                            <p class="text-sm text-gray-400 mb-1">Aplicação</p>
                            <p class="text-white">Pesquisa em regeneração tecidual e propriedades protetoras</p>
                        </div>
                    </div>

                    <a
                        href="#"
                        class="block w-full md:w-auto px-8 py-4 bg-gradient-to-r from-yellow-500 to-amber-500 text-black font-bold rounded-lg hover:from-yellow-400 hover:to-amber-400 transition-all duration-300 text-center shadow-lg shadow-yellow-500/30 hover:shadow-xl hover:shadow-yellow-500/50 active:scale-[0.98] border border-yellow-400/30 hover:border-yellow-400/50"
                    >
                        Encontrar Fornecedor
                    </a>
                </div>
            </div>
        </section>

        <!-- Área Técnica - Accordions -->
        <section class="max-w-4xl mx-auto">
            <h2 class="text-3xl md:text-4xl font-bold mb-8 text-center bg-clip-text text-transparent bg-gradient-to-r from-blue-400 to-blue-600">
                Informações Técnicas
            </h2>

            <div class="space-y-4">
                <!-- Accordion 1: O que é BPC-157? -->
                <Accordion title="O que é BPC-157?">
                    <div class="prose prose-invert max-w-none">
                        <p class="text-gray-300 mb-4">
                            O <strong class="text-white">BPC-157 (Body Protection Compound-157)</strong> é um pentadecapeptídeo sintético composto por 15 aminoácidos, derivado de uma proteína gástrica natural. Este composto tem sido extensivamente estudado em modelos de pesquisa por suas propriedades regenerativas e protetoras.
                        </p>
                        <p class="text-gray-300 mb-4">
                            Desenvolvido para pesquisa científica, o BPC-157 demonstra potencial em estudos relacionados à cicatrização de tecidos, proteção gástrica e regeneração de diversos tipos de células. Sua estrutura molecular única permite interações específicas com sistemas biológicos.
                        </p>
                        <div class="bg-red-900/20 border border-red-500/30 p-4 rounded text-sm text-red-200">
                            <strong>Nota de Pesquisa:</strong> Este composto é destinado exclusivamente para fins de pesquisa científica e não deve ser utilizado para consumo humano ou veterinário sem aprovação regulatória adequada.
                        </div>
                    </div>
                </Accordion>

                <!-- Accordion 2: Mecanismo de Ação -->
                <Accordion title="Mecanismo de Ação (Ciência)">
                    <div class="prose prose-invert max-w-none">
                        <p class="text-gray-300 mb-6">O mecanismo de ação demonstra uma atividade pleiotrópica em modelos de pesquisa:</p>
                        
                        <ul class="space-y-4 list-none">
                            <li class="flex gap-3">
                                <span class="text-blue-500 font-bold">Angiogênese:</span>
                                <span class="text-gray-400">Promove a formação de novos vasos sanguíneos, facilitando o fornecimento de nutrientes e oxigênio para áreas danificadas.</span>
                            </li>
                            <li class="flex gap-3">
                                <span class="text-blue-500 font-bold">Síntese de Colágeno:</span>
                                <span class="text-gray-400">Aumento na produção de colágeno tipo I, essencial para a integridade estrutural de tendões e ligamentos.</span>
                            </li>
                            <li class="flex gap-3">
                                <span class="text-blue-500 font-bold">Proteção Gástrica:</span>
                                <span class="text-gray-400">Atividade protetora em modelos de lesão gástrica através da modulação de fatores da mucosa.</span>
                            </li>
                        </ul>

                        <p class="text-xs text-gray-600 mt-6 italic">Referência: Os mecanismos descritos são baseados em estudos pré-clínicos (in vivo/in vitro).</p>
                    </div>
                </Accordion>

                <!-- Accordion 3: Protocolo de Reconstituição -->
                <Accordion title="Protocolo de Reconstituição">
                    <div class="prose prose-invert max-w-none">
                        <div class="mb-8">
                            <h4 class="text-white font-bold mb-4">Guia de Mistura</h4>
                            <ol class="list-decimal list-inside space-y-3 text-gray-300">
                                <li>Remova o frasco da refrigeração e deixe atingir temperatura ambiente (20-25°C).</li>
                                <li>Prepare água bacteriostática estéril (0.9% benzyl alcohol).</li>
                                <li>Adicione lentamente a água pela parede interna do frasco (sem jato direto no pó).</li>
                                <li><strong class="text-white">Gire suavemente</strong> até dissolver. NÃO agite vigorosamente (peptídeos são frágeis).</li>
                                <li>Armazene em refrigeração (2-8°C).</li>
                            </ol>
                        <div class="bg-blue-500/10 border border-blue-500/30 rounded-lg p-4 mt-4">
                            <p class="text-sm text-blue-300 mb-3">
                                <strong>Dica:</strong> Use nossa calculadora de reconstituição para determinar as concentrações precisas para seus protocolos de pesquisa.
                            </p>
                            <a
                                href="/calculadora"
                                class="inline-flex items-center gap-2 px-4 py-2 bg-blue-500/20 hover:bg-blue-500/30 border border-blue-500/50 text-blue-300 rounded-lg transition-colors text-sm font-semibold"
                            >
                                Acessar Calculadora
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                                </svg>
                            </a>
                        </div>
                        </div>

                        <div class="border-t border-white/10 pt-6">
                            <h4 class="text-white font-bold mb-4">Protocolos de Pesquisa Sugeridos</h4>
                            <div class="bg-gray-800 p-4 rounded border-l-4 border-blue-500 mb-4">
                                <h5 class="text-white font-bold">Padrão (Frasco 5mg)</h5>
                                <p class="text-sm text-gray-400">500mcg/dia (Semanas 1-4)</p>
                            </div>
                            <div class="bg-gray-800 p-4 rounded border-l-4 border-green-500">
                                <h5 class="text-white font-bold">Gradual (Frasco 10mg)</h5>
                                <p class="text-sm text-gray-400">300mcg/dia (Semanas 1-4) -> 500mcg/dia (Semanas 5-8)</p>
                            </div>
                        </div>
                    </div>
                </Accordion>

                <!-- Accordion 4: Laudo Técnico -->
                <Accordion title="Laudo Técnico (HPLC)">
                    <div class="prose prose-invert max-w-none">
                        <div class="grid grid-cols-2 gap-4 mb-6 text-center">
                            <div class="bg-gray-800 p-3 rounded">
                                <p class="text-xs text-gray-500">Pureza Certificada</p>
                                <p class="text-xl font-bold text-green-400">99.8%</p>
                            </div>
                            <div class="bg-gray-800 p-3 rounded">
                                <p class="text-xs text-gray-500">Lote</p>
                                <p class="text-xl font-bold text-white">#OR-2026-015</p>
                            </div>
                        </div>
                        <ul class="text-sm text-gray-400 space-y-2 mb-6 list-none">
                            <li class="flex items-start gap-2">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-green-400 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                                </svg>
                                <span>Análise de pureza por HPLC com detecção UV</span>
                            </li>
                            <li class="flex items-start gap-2">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-green-400 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                                </svg>
                                <span>Identificação de impurezas e contaminantes</span>
                            </li>
                            <li class="flex items-start gap-2">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-green-400 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                                </svg>
                                <span>Verificação de estrutura molecular</span>
                            </li>
                        </ul>

                        <a
                            href="#"
                            class="inline-flex items-center gap-2 px-6 py-3 bg-white text-black font-bold rounded-lg hover:bg-gray-200 transition-all duration-300 mt-4"
                        >
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                            </svg>
                            Baixar Laudo Original (PDF)
                        </a>
                    </div>
                </Accordion>
            </div>
        </section>

        <!-- Botão Voltar ao Catálogo -->
        <section class="max-w-4xl mx-auto mt-12">
            <div class="bg-gradient-to-r from-gray-900/20 to-gray-800/20 border border-white/10 rounded-xl p-6 md:p-8 text-center">
                <h3 class="text-xl font-bold text-white mb-4">Explore Nossos Peptídeos</h3>
                <p class="text-gray-400 text-sm mb-6">
                    Volte ao catálogo completo para conhecer todos os nossos produtos de pesquisa.
                </p>
                <a
                    href="/catalogo"
                    class="inline-flex items-center gap-2 px-8 py-4 bg-gradient-to-r from-blue-500 to-blue-600 hover:from-blue-400 hover:to-blue-500 text-white font-semibold rounded-lg transition-all duration-300 shadow-lg shadow-blue-500/30 hover:shadow-xl hover:shadow-blue-500/50"
                >
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                    </svg>
                    Voltar para o Catálogo de Peptídeos
                </a>
            </div>
        </section>
    </main>

    <!-- Footer -->
    <footer class="bg-black border-t border-white/10 py-8">
        <div class="container mx-auto px-4">
            <div class="text-center">
                <p class="text-gray-400 text-sm">
                    © 2015 <span class="text-white font-semibold">Orion Peptides</span>. Todos os direitos reservados.
                </p>
            </div>
        </div>
    </footer>
</Layout>

