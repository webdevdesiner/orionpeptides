---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Accordion from '../../components/Accordion.astro';
---

<Layout title="BPC-157 | Guia Técnico | Orion Peptides">
    <Header />
    
    <main class="container mx-auto px-4 py-12 md:py-16">
        <!-- Topo - Resumo do Produto -->
        <section class="mb-16">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12 items-start">
                <!-- Coluna 1: Imagem do Produto -->
                <div class="space-y-6">
                    <!-- Mobile-only: título acima da imagem com ícone -->
                    <div class="md:hidden flex items-center justify-center gap-3 mb-3">
                        <div class="w-10 h-10 rounded-full bg-white/5 border border-emerald-500/20 flex items-center justify-center flex-shrink-0 shadow-[0_0_8px_rgba(16,185,129,0.12)]">
                            <img src="/image/catalogo/bpc-157.png" alt="Ícone BPC-157" class="w-8 h-8 object-contain" />
                        </div>
                        <h1 class="text-2xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-white via-emerald-200 to-emerald-400">
                            BPC-157
                        </h1>
                    </div>
                    <figure class="w-full max-w-md bg-gray-900/50 border border-white/10 rounded-2xl overflow-hidden">
                        <div class="px-4 py-2.5 border-b border-white/10 bg-black/20">
                            <figcaption class="text-xs text-gray-400 uppercase tracking-wider font-medium">BPC-157 — Imagem do produto</figcaption>
                        </div>
                        <div class="relative p-6 flex items-center justify-center">
                            <a
                                href="/contato"
                                data-wa-product="BPC-157"
                                data-wa-phone="5518981522804"
                                class="absolute top-4 left-4 z-30 inline-flex flex-col items-center justify-center px-2.5 py-1.5 rounded bg-gradient-to-br from-amber-400 via-yellow-500 to-amber-600 hover:from-amber-300 hover:via-yellow-400 hover:to-amber-500 text-amber-950 text-[10px] font-bold uppercase tracking-wide shadow-md shadow-amber-500/30 hover:shadow-amber-400/50 border border-amber-300/50 hover:scale-105 active:scale-95 transition-all duration-300 leading-tight text-center"
                            >
                                <span>Encontrar</span>
                                <span>fornecedor</span>
                            </a>
                            <img 
                                src="/image/produtos/BPC-157.png" 
                                alt="BPC-157 - Peptídeo de Reparação Tecidual" 
                                class="w-full h-auto object-contain rounded-lg"
                            />
                        </div>
                    </figure>

                    <!-- Especificações Técnicas Rápidas -->
                    <div class="flex flex-col gap-4">
                        <!-- Card 1: Potência -->
                        <div class="bg-gray-900/50 backdrop-blur-md border border-emerald-500/20 rounded-xl p-4 hover:border-emerald-500/40 transition-all duration-300">
                            <div class="flex flex-col items-center text-center space-y-2">
                                <!-- Ícone Frasco -->
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
                                </svg>
                                <p class="text-xs text-gray-400 uppercase tracking-wider">Potência</p>
                                <p class="text-sm text-white font-semibold">10mg Liofilizado</p>
                            </div>
                        </div>

                        <!-- Card 2: Diluente -->
                        <div class="bg-gray-900/50 backdrop-blur-md border border-emerald-500/20 rounded-xl p-4 hover:border-emerald-500/40 transition-all duration-300">
                            <div class="flex flex-col items-center text-center space-y-2">
                                <!-- Ícone Gota -->
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-emerald-400" fill="currentColor" viewBox="0 0 24 24">
                                    <path d="M12 2.69c-3.5 0-6.31 2.81-6.31 6.31 0 3.5 6.31 10.31 6.31 10.31S18.31 12.5 18.31 9c0-3.5-2.81-6.31-6.31-6.31z"/>
                                </svg>
                                <p class="text-xs text-gray-400 uppercase tracking-wider">Requer</p>
                                <p class="text-sm text-white font-semibold">Água Bac. (Não incluso)</p>
                            </div>
                        </div>

                        <!-- Card 3: Armazenamento -->
                        <div class="bg-gray-900/50 backdrop-blur-md border border-emerald-500/20 rounded-xl p-4 hover:border-emerald-500/40 transition-all duration-300">
                            <div class="flex flex-col items-center text-center space-y-2">
                                <!-- Ícone Floco de Neve -->
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
                                </svg>
                                <p class="text-xs text-gray-400 uppercase tracking-wider">Temperatura</p>
                                <p class="text-sm text-white font-semibold">2°C a 8°C (Geladeira)</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Coluna 2: Informações -->
                <div class="space-y-6">
                    <div>
                        <div class="hidden md:flex items-center gap-4 mb-2">
                            <div class="w-14 h-14 rounded-full bg-white/5 border border-emerald-500/20 flex items-center justify-center flex-shrink-0 shadow-[0_0_12px_rgba(16,185,129,0.25)]">
                                <img src="/image/catalogo/bpc-157.png" alt="" class="w-10 h-10 object-contain" />
                            </div>
                            <h1 class="text-3xl md:text-5xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-white via-emerald-200 to-emerald-400">
                                BPC-157
                            </h1>
                        </div>
                        <p class="text-xl text-gray-400 font-medium mb-3">Pentadecapeptídeo Sintético de Reparação Tecidual</p>
                        <p class="text-gray-500 text-sm leading-relaxed mb-6">
                            Composto de 15 aminoácidos derivado de proteína gástrica, estudado por suas propriedades pleiotrópicas na regeneração celular e angiogênese. Diferente do TB-500 (focado em ação sistêmica), o BPC-157 atua de forma <strong class="text-emerald-400">localizada</strong> no local da aplicação.
                        </p>
                        <div class="bg-emerald-900/20 border border-emerald-500/30 rounded-lg p-3 mb-4">
                            <p class="text-sm text-emerald-200">
                                <strong class="text-emerald-300">Diferencial Orion:</strong> Frasco de <strong>10mg</strong> ideal para protocolos de reparação tecidual localizada.
                            </p>
                        </div>
                    </div>

                    <!-- Seção Benefícios Pesquisados -->
                    <div class="mb-8">
                        <h3 class="text-2xl md:text-3xl font-bold mb-6 text-white">
                            Benefícios Pesquisados
                        </h3>
                        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6">
                            <!-- Benefício 1: Aceleração -->
                            <div class="flex flex-col items-center text-center space-y-3 p-4 hover:-translate-y-2 transition-all duration-300 cursor-default">
                                <!-- Ícone Raio -->
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 md:w-10 md:h-10 text-emerald-400 drop-shadow-[0_0_8px_rgba(16,185,129,0.5)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                                </svg>
                                <h4 class="text-white font-bold text-sm md:text-base">Aceleração</h4>
                                <p class="text-gray-400 text-xs md:text-sm">Recuperação rápida de tecidos</p>
                            </div>

                            <!-- Benefício 2: Proteção -->
                            <div class="flex flex-col items-center text-center space-y-3 p-4 hover:-translate-y-2 transition-all duration-300 cursor-default">
                                <!-- Ícone Escudo -->
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 md:w-10 md:h-10 text-emerald-400 drop-shadow-[0_0_8px_rgba(16,185,129,0.5)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                                </svg>
                                <h4 class="text-white font-bold text-sm md:text-base">Proteção</h4>
                                <p class="text-gray-400 text-xs md:text-sm">Ação anti-inflamatória potente</p>
                            </div>

                            <!-- Benefício 3: Gastrointestinal -->
                            <div class="flex flex-col items-center text-center space-y-3 p-4 hover:-translate-y-2 transition-all duration-300 cursor-default">
                                <!-- Ícone Estômago Anatômico -->
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 md:w-10 md:h-10 text-emerald-400 drop-shadow-[0_0_8px_rgba(16,185,129,0.5)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 4h8M8 4c0 1.1.9 2 2 2h4c1.1 0 2-.9 2-2M8 4c0-1.1.9-2 2-2h4c1.1 0 2 .9 2 2m0 0v10c0 1.1-.9 2-2 2h-4c-1.1 0-2-.9-2-2V4m8 2H8m8 4H8m0 4h8" />
                                </svg>
                                <h4 class="text-white font-bold text-sm md:text-base">Gastrointestinal</h4>
                                <p class="text-gray-400 text-xs md:text-sm">Reparação da parede gástrica</p>
                            </div>

                            <!-- Benefício 4: Neurogênese -->
                            <div class="flex flex-col items-center text-center space-y-3 p-4 hover:-translate-y-2 transition-all duration-300 cursor-default">
                                <!-- Ícone Cérebro Anatômico -->
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 md:w-10 md:h-10 text-emerald-400 drop-shadow-[0_0_8px_rgba(16,185,129,0.5)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 3.5c-2.5 0-4.5 1.5-4.5 3.5 0 1.5 1 2.5 2 3M9.75 3.5c2.5 0 4.5 1.5 4.5 3.5 0 1.5-1 2.5-2 3M9.75 3.5v17m-4-13c-1 0-2 1-2 2.5 0 2 1.5 3.5 3.5 3.5m9-6c1 0 2 1 2 2.5 0 2-1.5 3.5-3.5 3.5" />
                                </svg>
                                <h4 class="text-white font-bold text-sm md:text-base">Neurogênese</h4>
                                <p class="text-gray-400 text-xs md:text-sm">Proteção do sistema nervoso</p>
                            </div>
                        </div>
                    </div>

                    <div class="space-y-4">
                        <!-- Protocolo de Pesquisa Sugerido -->
                        <div class="mt-8 border-t border-white/10 pt-6">
                            <h4 class="text-white font-bold mb-4 flex items-center gap-2">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-emerald-400" viewBox="0 0 20 20" fill="currentColor">
                                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd" />
                                </svg>
                                Protocolo de Pesquisa Sugerido (Ciclo de Reparação Local)
                            </h4>

                            <div class="overflow-hidden rounded-xl border border-white/10 shadow-lg">
                                <div class="overflow-x-auto">
                                    <table class="w-full text-left text-sm">
                                    <thead class="bg-emerald-900/20 text-emerald-200 uppercase text-xs font-bold tracking-wider">
                                        <tr>
                                            <th class="px-4 py-3">Fase</th>
                                            <th class="px-4 py-3">Dosagem Diária</th>
                                            <th class="px-4 py-3 text-white bg-emerald-600/20 border-l border-emerald-500/30">
                                                Volume na Seringa (Ref: 2ml água)
                                            </th>
                                            <th class="px-4 py-3">Frequência</th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-white/5 bg-gray-900/40">
                                        <tr class="hover:bg-white/5 transition-colors">
                                            <td class="px-4 py-3 font-medium text-white">Semana 1-2</td>
                                            <td class="px-4 py-3 text-gray-300">250 mcg (2x ao dia)</td>
                                            <td class="px-4 py-3 font-bold text-emerald-400 border-l border-white/5">
                                                5 UI (Manhã) + 5 UI (Noite)
                                            </td>
                                            <td class="px-4 py-3 text-gray-300">Diário</td>
                                        </tr>
                                        <tr class="hover:bg-white/5 transition-colors">
                                            <td class="px-4 py-3 font-medium text-white">Semana 3-4</td>
                                            <td class="px-4 py-3 text-gray-300">500 mcg (1x ao dia)</td>
                                            <td class="px-4 py-3 font-bold text-emerald-400 border-l border-white/5">
                                                10 UI (Total)
                                            </td>
                                            <td class="px-4 py-3 text-gray-300">Diário</td>
                                        </tr>
                                    </tbody>
                                </table>
                                
                                <div class="bg-emerald-900/10 p-3 text-xs text-emerald-300 flex items-start gap-2 border-t border-white/5">
                                    <span class="text-emerald-500 font-bold">💡</span>
                                    <p><strong>Nota:</strong> Valores baseados em reconstituição padrão com <strong>2ml de água</strong> em frasco de 10mg. Aplicar próximo ao local da lesão para ação localizada.</p>
                                </div>
                            </div>
                        </div>

                        <div class="bg-gray-900/50 border border-white/10 rounded-lg p-4">
                            <p class="text-sm text-gray-400 mb-1">Pureza Certificada</p>
                            <p class="text-emerald-400 font-bold text-2xl">>99.8% (HPLC)</p>
                        </div>

                        <div class="bg-gray-900/50 border border-white/10 rounded-lg p-4">
                            <p class="text-sm text-gray-400 mb-1">Aplicação</p>
                            <p class="text-white">Pesquisa em regeneração tecidual e propriedades protetoras</p>
                        </div>
                    </div>

                    <a
                        href="#"
                        class="block w-full md:w-auto px-8 py-4 bg-gradient-to-r from-emerald-500 to-emerald-600 text-white font-bold rounded-lg hover:from-emerald-400 hover:to-emerald-500 transition-all duration-300 text-center shadow-lg shadow-emerald-500/30 hover:shadow-xl hover:shadow-emerald-500/50 active:scale-[0.98] border border-emerald-400/30 hover:border-emerald-400/50"
                    >
                        Encontrar Fornecedor
                    </a>
                </div>
            </div>
        </section>

        <!-- Área Técnica - Accordions -->
        <section class="max-w-4xl mx-auto">
            <h2 class="text-3xl md:text-4xl font-bold mb-8 text-center bg-clip-text text-transparent bg-gradient-to-r from-emerald-400 to-emerald-600">
                Informações Técnicas
            </h2>

            <div class="space-y-4">
                <!-- Accordion 1: O que é BPC-157? -->
                <Accordion title="O que é BPC-157?">
                    <div class="prose prose-invert max-w-none">
                        <p class="text-gray-300 mb-4">
                            O <strong class="text-white">BPC-157 (Body Protection Compound-157)</strong> é um pentadecapeptídeo sintético composto por 15 aminoácidos, derivado de uma proteína gástrica natural. Este composto tem sido extensivamente estudado em modelos de pesquisa por suas propriedades regenerativas e protetoras.
                        </p>
                        <p class="text-gray-300 mb-4">
                            Desenvolvido para pesquisa científica, o BPC-157 demonstra potencial em estudos relacionados à cicatrização de tecidos, proteção gástrica e regeneração de diversos tipos de células. Sua estrutura molecular única permite interações específicas com sistemas biológicos.
                        </p>
                        <div class="bg-red-900/20 border border-red-500/30 p-4 rounded text-sm text-red-200">
                            <strong>Nota de Pesquisa:</strong> Este composto é destinado exclusivamente para fins de pesquisa científica e não deve ser utilizado para consumo humano ou veterinário sem aprovação regulatória adequada.
                        </div>
                    </div>
                </Accordion>

                <!-- Accordion 2: Mecanismo de Ação -->
                <Accordion title="Mecanismo de Ação (Ciência)">
                    <div class="prose prose-invert max-w-none">
                        <p class="text-gray-300 mb-6">O mecanismo de ação demonstra uma atividade pleiotrópica em modelos de pesquisa:</p>
                        
                        <ul class="space-y-4 list-none">
                            <li class="flex gap-3">
                                <span class="text-emerald-500 font-bold">Angiogênese:</span>
                                <span class="text-gray-400">Promove a formação de novos vasos sanguíneos, facilitando o fornecimento de nutrientes e oxigênio para áreas danificadas.</span>
                            </li>
                            <li class="flex gap-3">
                                <span class="text-emerald-500 font-bold">Síntese de Colágeno:</span>
                                <span class="text-gray-400">Aumento na produção de colágeno tipo I, essencial para a integridade estrutural de tendões e ligamentos.</span>
                            </li>
                            <li class="flex gap-3">
                                <span class="text-emerald-500 font-bold">Proteção Gástrica:</span>
                                <span class="text-gray-400">Atividade protetora em modelos de lesão gástrica através da modulação de fatores da mucosa.</span>
                            </li>
                            <li class="flex gap-3">
                                <span class="text-emerald-500 font-bold">Ação Localizada:</span>
                                <span class="text-gray-400">Diferente do TB-500 (sistêmico), o BPC-157 atua principalmente no local da aplicação, promovendo reparo tecidual direto.</span>
                            </li>
                        </ul>

                        <p class="text-xs text-gray-600 mt-6 italic">Referência: Os mecanismos descritos são baseados em estudos pré-clínicos (in vivo/in vitro).</p>
                    </div>
                </Accordion>

                <!-- Accordion 3: Protocolo de Reconstituição -->
                <Accordion title="Protocolo de Reconstituição">
                    <div class="prose prose-invert max-w-none">
                        <div class="mb-8">
                            <h4 class="text-white font-bold mb-4">Guia de Mistura (Para Frasco 10mg)</h4>
                            <p class="text-gray-300 mb-4">Para precisão ideal com a concentração Orion:</p>
                            <ol class="list-decimal list-inside space-y-3 text-gray-300">
                                <li><strong class="text-white">Diluente:</strong> Utilize <strong>2ml</strong> (200 unidades) de Água Bacteriostática.</li>
                                <li><strong class="text-white">Processo:</strong> Injete a água lentamente pela parede do frasco. <strong>NÃO agite;</strong> faça movimentos circulares suaves (swirl) até dissolver completamente.</li>
                                <li><strong class="text-white">Matemática da Dose:</strong>
                                    <ul class="list-disc list-inside ml-4 mt-2 space-y-1">
                                        <li>10mg em 2ml = <strong>5mg por ml</strong></li>
                                        <li>Cada <strong>10 unidades</strong> na seringa de insulina = <strong>500mcg</strong> (0.5mg) de produto</li>
                                        <li>Cada <strong>5 unidades</strong> na seringa de insulina = <strong>250mcg</strong> (0.25mg) de produto</li>
                                    </ul>
                                </li>
                                <li>Armazene em refrigeração (2-8°C) após reconstituído.</li>
                                <li>Use dentro do prazo de validade após reconstituição.</li>
                            </ol>
                        </div>

                        <!-- Calculadora Rápida Inline (em primeiro) -->
                        <div class="bg-gray-800/50 border border-emerald-500/20 rounded-lg p-6 mt-4">
                            <h4 class="text-white font-bold mb-4 flex items-center gap-2">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
                                </svg>
                                Calculadora Rápida (BPC-157 10mg)
                            </h4>
                            <form id="calculadoraBPC" class="space-y-4">
                                <div>
                                    <label for="doseBPC" class="block text-sm font-medium text-gray-300 mb-2">
                                        Dose Desejada (mcg)
                                    </label>
                                    <input
                                        type="number"
                                        id="doseBPC"
                                        step="50"
                                        min="0"
                                        value="250"
                                        placeholder="Ex: 250"
                                        required
                                        class="w-full px-4 py-2 bg-black/50 border border-white/10 rounded-lg text-white placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500/50 transition-all duration-300"
                                    />
                                </div>
                                <button
                                    type="submit"
                                    class="w-full md:w-auto py-3 bg-gradient-to-r from-emerald-600 to-emerald-500 text-white font-bold rounded-lg hover:from-emerald-500 hover:to-emerald-400 transition-all duration-300 shadow-lg shadow-emerald-500/30 hover:shadow-xl hover:shadow-emerald-500/50 active:scale-[0.98]"
                                >
                                    CALCULAR UNIDADES
                                </button>
                            </form>
                            <div id="resultadoBPC" class="hidden mt-4 pt-4 border-t border-white/10">
                                <div class="bg-emerald-500/20 border border-emerald-500/30 rounded-lg p-4 text-center">
                                    <p class="text-gray-400 text-xs mb-1">Unidades da Seringa (UI)</p>
                                    <p id="resultadoUIBPC" class="text-3xl font-bold text-emerald-400">0</p>
                                    <p class="text-gray-400 text-xs mt-1">Volume: <span id="resultadoVolumeBPC" class="text-emerald-300">0 ml</span></p>
                                </div>
                            </div>
                        </div>

                        <div class="bg-emerald-500/10 border border-emerald-500/30 rounded-lg p-4 mt-6">
                            <p class="text-sm text-emerald-300 mb-3">
                                <strong>Dica:</strong> Use a calculadora completa para outros frascos e diluições.
                            </p>
                            <a
                                href="/calculadora"
