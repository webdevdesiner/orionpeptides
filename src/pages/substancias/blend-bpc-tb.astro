---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Accordion from '../../components/Accordion.astro';
---

<Layout title="BPC-157 + TB-500 (Wolverine Stack) | Guia Técnico | Orion Peptides">
    <Header />
    
    <main class="container mx-auto px-4 py-12 md:py-16">
        <!-- Topo - Resumo do Produto -->
        <section class="mb-16">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12 items-start">
                <!-- Coluna 1: Imagem do Produto -->
                <div class="space-y-6">
                    <div class="w-full max-w-md bg-gray-900/50 border border-white/10 rounded-2xl overflow-hidden">
                        <div class="px-4 py-2.5 border-b border-white/10 bg-black/20">
                            <p class="text-xs text-gray-400 uppercase tracking-wider font-medium">Imagem do produto</p>
                        </div>
                        <div class="relative p-6 flex items-center justify-center">
                            <a
                                href="/contato"
                                class="absolute top-4 left-4 z-30 inline-flex flex-col items-center justify-center px-2.5 py-1.5 rounded bg-gradient-to-br from-amber-400 via-yellow-500 to-amber-600 hover:from-amber-300 hover:via-yellow-400 hover:to-amber-500 text-amber-950 text-[10px] font-bold uppercase tracking-wide shadow-md shadow-amber-500/30 hover:shadow-amber-400/50 border border-amber-300/50 hover:scale-105 active:scale-95 transition-all duration-300 leading-tight text-center"
                            >
                                <span>Encontrar</span>
                                <span>fornecedor</span>
                            </a>
                            <img 
                                src="/image/produtos/bpc-157-tb-500.png" 
                                alt="BPC-157 + TB-500 - Wolverine Stack" 
                                class="w-full h-auto object-contain rounded-lg"
                            />
                        </div>
                    </div>

                    <!-- Especificações Técnicas Rápidas -->
                    <div class="flex flex-col gap-4">
                        <!-- Card 1: Potência -->
                        <div class="bg-gray-900/50 backdrop-blur-md border border-emerald-500/20 rounded-xl p-4 hover:border-emerald-500/40 transition-all duration-300">
                            <div class="flex flex-col items-center text-center space-y-2">
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
                                </svg>
                                <p class="text-xs text-gray-400 uppercase tracking-wider">Potência</p>
                                <p class="text-sm text-white font-semibold">10mg Total (5mg + 5mg)</p>
                            </div>
                        </div>

                        <!-- Card 2: Diluente -->
                        <div class="bg-gray-900/50 backdrop-blur-md border border-emerald-500/20 rounded-xl p-4 hover:border-emerald-500/40 transition-all duration-300">
                            <div class="flex flex-col items-center text-center space-y-2">
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-emerald-400" fill="currentColor" viewBox="0 0 24 24">
                                    <path d="M12 2.69c-3.5 0-6.31 2.81-6.31 6.31 0 3.5 6.31 10.31 6.31 10.31S18.31 12.5 18.31 9c0-3.5-2.81-6.31-6.31-6.31z"/>
                                </svg>
                                <p class="text-xs text-gray-400 uppercase tracking-wider">Requer</p>
                                <p class="text-sm text-white font-semibold">Água Bac. (2ml — Não incluso)</p>
                            </div>
                        </div>

                        <!-- Card 3: Armazenamento -->
                        <div class="bg-gray-900/50 backdrop-blur-md border border-emerald-500/20 rounded-xl p-4 hover:border-emerald-500/40 transition-all duration-300">
                            <div class="flex flex-col items-center text-center space-y-2">
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
                                </svg>
                                <p class="text-xs text-gray-400 uppercase tracking-wider">Temperatura</p>
                                <p class="text-sm text-white font-semibold">2°C a 8°C (Geladeira)</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Coluna 2: Informações -->
                <div class="space-y-6">
                    <div>
                        <div class="flex items-center gap-4 mb-2">
                            <div class="w-14 h-14 rounded-full bg-white/5 border border-emerald-500/20 flex items-center justify-center flex-shrink-0 shadow-[0_0_12px_rgba(16,185,129,0.18)]">
                                <img src="/image/catalogo/bpc-157-tb-500.png" alt="" class="w-10 h-10 object-contain" />
                            </div>
                            <div>
                                <h1 class="text-4xl md:text-5xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-white via-emerald-200 to-emerald-400">
                                    BPC-157 + TB-500 (Wolverine Stack)
                                </h1>
                                <div class="flex gap-2 mt-2">
                                    <span class="px-2 py-1 bg-emerald-700/20 border border-emerald-500/30 rounded-full text-xs font-semibold text-emerald-300">Injury Repair</span>
                                    <span class="px-2 py-1 bg-emerald-700/20 border border-emerald-500/30 rounded-full text-xs font-semibold text-emerald-300">Joint Health</span>
                                    <span class="px-2 py-1 bg-emerald-700/20 border border-emerald-500/30 rounded-full text-xs font-semibold text-emerald-300">Anti-Inflammatory</span>
                                </div>
                            </div>
                        </div>
                        <p class="text-xl text-gray-400 font-medium mb-3">A fusão mais poderosa do mundo para recuperação de lesões, articulações e tecidos.</p>
                        <p class="text-gray-500 text-sm leading-relaxed mb-6">
                            Blend otimizado para suporte de reparo tecidual: 5mg BPC-157 + 5mg TB-500 em frasco único de 10mg.
                        </p>
                        <div class="bg-emerald-900/20 border border-emerald-500/30 rounded-lg p-3 mb-4">
                            <p class="text-sm text-emerald-200">
                                <strong class="text-emerald-300">Apresentação Orion:</strong> Frasco de <strong>10mg totais</strong> (5mg BPC + 5mg TB-500). Diluente padrão: <strong>2ml</strong>.
                            </p>
                        </div>
                    </div>

                    <!-- Seção Benefícios Pesquisados -->
                    <div class="mb-8">
                        <h3 class="text-2xl md:text-3xl font-bold mb-6 text-white">
                            Benefícios Pesquisados
                        </h3>
                        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6">
                            <div class="flex flex-col items-center text-center space-y-3 p-4 hover:-translate-y-2 transition-all duration-300 cursor-default">
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 md:w-10 md:h-10 text-emerald-400 drop-shadow-[0_0_8px_rgba(16,185,129,0.5)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7l10 10M17 7L7 17" />
                                </svg>
                                <h4 class="text-white font-bold text-sm md:text-base">Injury Repair</h4>
                                <p class="text-gray-400 text-xs md:text-sm">Recuperação acelerada de lesões</p>
                            </div>
                            <div class="flex flex-col items-center text-center space-y-3 p-4 hover:-translate-y-2 transition-all duration-300 cursor-default">
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 md:w-10 md:h-10 text-emerald-400 drop-shadow-[0_0_8px_rgba(16,185,129,0.5)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                                </svg>
                                <h4 class="text-white font-bold text-sm md:text-base">Joint Health</h4>
                                <p class="text-gray-400 text-xs md:text-sm">Suporte a articulações e tendões</p>
                            </div>
                            <div class="flex flex-col items-center text-center space-y-3 p-4 hover:-translate-y-2 transition-all duration-300 cursor-default">
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 md:w-10 md:h-10 text-emerald-400 drop-shadow-[0_0_8px_rgba(16,185,129,0.5)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                                </svg>
                                <h4 class="text-white font-bold text-sm md:text-base">Anti-Inflammatory</h4>
                                <p class="text-gray-400 text-xs md:text-sm">Redução de inflamação local e sistêmica</p>
                            </div>
                            <div class="flex flex-col items-center text-center space-y-3 p-4 hover:-translate-y-2 transition-all duration-300 cursor-default">
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 md:w-10 md:h-10 text-emerald-400 drop-shadow-[0_0_8px_rgba(16,185,129,0.5)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 2l3 7H9l3-7z" />
                                </svg>
                                <h4 class="text-white font-bold text-sm md:text-base">Tissue Remodeling</h4>
                                <p class="text-gray-400 text-xs md:text-sm">Melhora da arquitetura tecidual</p>
                            </div>
                        </div>
                    </div>

                    <div class="space-y-4">
                        <!-- Protocolo de Dosagem -->
                        <div class="mt-8 border-t border-white/10 pt-6">
                            <h4 class="text-white font-bold mb-4 flex items-center gap-2">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-emerald-400" viewBox="0 0 20 20" fill="currentColor">
                                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd" />
                                </svg>
                                Tabela de Dosagem (Seringa U-100)
                            </h4>

                            <div class="overflow-hidden rounded-xl border border-white/10 shadow-lg">
                                <table class="w-full text-left text-sm">
                                    <thead class="bg-emerald-900/20 text-emerald-200 uppercase text-xs font-bold tracking-wider">
                                        <tr>
                                            <th class="px-4 py-3">Protocolo</th>
                                            <th class="px-4 py-3">Dose (cada composto)</th>
                                            <th class="px-4 py-3">Unidades (U-100)</th>
                                            <th class="px-4 py-3">Frequência</th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-white/5 bg-gray-900/40">
                                        <tr class="hover:bg-white/5 transition-colors">
                                            <td class="px-4 py-3 font-medium text-white">Recuperação Leve / Manutenção</td>
                                            <td class="px-4 py-3 text-gray-300">250 mcg</td>
                                            <td class="px-4 py-3 font-bold text-emerald-400">10 Unidades</td>
                                            <td class="px-4 py-3 text-gray-300">1x ao dia</td>
                                        </tr>
                                        <tr class="hover:bg-white/5 transition-colors">
                                            <td class="px-4 py-3 font-medium text-white">Wolverine (Lesão Aguda)</td>
                                            <td class="px-4 py-3 text-gray-300">500 mcg</td>
                                            <td class="px-4 py-3 font-bold text-emerald-400">20 Unidades</td>
                                            <td class="px-4 py-3 text-gray-300">1x ao dia</td>
                                        </tr>
                                        <tr class="hover:bg-white/5 transition-colors">
                                            <td class="px-4 py-3 font-medium text-white">Atletas (Alta Performance)</td>
                                            <td class="px-4 py-3 text-gray-300">750 mcg</td>
                                            <td class="px-4 py-3 font-bold text-emerald-400">30 Unidades</td>
                                            <td class="px-4 py-3 text-gray-300">1x ao dia (2-4 semanas)</td>
                                        </tr>
                                    </tbody>
                                </table>
                                <div class="bg-emerald-900/10 p-3 text-xs text-emerald-300 flex items-start gap-2 border-t border-white/5">
                                    <span class="text-emerald-500 font-bold">💡</span>
                                    <p><strong>Nota:</strong> 20 UI/dia fornece ~3.5mg de TB-500/semana, adequado para protocolos clínicos intensivos.</p>
                                </div>
                            </div>
                        </div>

                        <div class="bg-gray-900/50 border border-white/10 rounded-lg p-4">
                            <p class="text-sm text-gray-400 mb-1">Pureza Certificada</p>
                            <p class="text-emerald-400 font-bold text-2xl">>99.6% (Blend Analysis)</p>
                        </div>

                        <div class="bg-gray-900/50 border border-white/10 rounded-lg p-4">
                            <p class="text-sm text-gray-400 mb-1">Aplicação</p>
                            <p class="text-white">Recuperação de lesões, suporte articulações e protocolos anti-inflamatórios</p>
                        </div>
                    </div>

                    <a
                        href="#"
                        class="block w-full md:w-auto px-8 py-4 bg-gradient-to-r from-emerald-500 to-emerald-600 text-white font-bold rounded-lg hover:from-emerald-400 hover:to-emerald-500 transition-all duration-300 text-center shadow-lg shadow-emerald-500/30 hover:shadow-xl hover:shadow-emerald-500/50 active:scale-[0.98] border border-emerald-400/30 hover:border-emerald-400/50"
                    >
                        Encontrar Fornecedor
                    </a>
                </div>
            </div>
        </section>

        <!-- Área Técnica - Accordions -->
        <section class="max-w-4xl mx-auto">
            <h2 class="text-3xl md:text-4xl font-bold mb-8 text-center bg-clip-text text-transparent bg-gradient-to-r from-emerald-400 to-emerald-600">
                Informações Técnicas
            </h2>

            <div class="space-y-4">
                <!-- Accordion 1: O que é este Blend? -->
                <Accordion title="O que é este Blend?">
                    <div class="prose prose-invert max-w-none">
                        <p class="text-gray-300 mb-4">
                            O <strong class="text-white">Blend BPC-157 + TB-500</strong> reúne dois compostos de reparo tecidual em um único frasco (5mg + 5mg). Ideal para protocolos de cicatrização, regeneração e suporte articular.
                        </p>
                        <div class="bg-emerald-900/20 border border-emerald-500/30 rounded-lg p-3 mb-4">
                            <p class="text-sm text-emerald-200">
                                <strong class="text-emerald-300">Diferencial Orion:</strong> Blend balanceado 5mg + 5mg em frasco único de 10mg.
                            </p>
                        </div>
                        <div class="bg-red-900/20 border border-red-500/30 p-4 rounded text-sm text-red-200">
                            <strong>Nota de Pesquisa:</strong> Este composto é destinado exclusivamente para fins de pesquisa científica e não deve ser utilizado para consumo humano ou veterinário sem aprovação regulatória adequada.
                        </div>
                    </div>
                </Accordion>

                <!-- Accordion 2: Mecanismo de Ação -->
                <Accordion title="Mecanismo de Ação (Ciência)">
                    <div class="prose prose-invert max-w-none">
                        <ul class="space-y-4 list-none">
                            <li class="flex gap-3">
                                <span class="text-emerald-500 font-bold">BPC-157:</span>
                                <span class="text-gray-400">Promove angiogênese e reparo tecidual, estabiliza membranas celulares e reduz inflamação.</span>
                            </li>
                            <li class="flex gap-3">
                                <span class="text-emerald-500 font-bold">TB-500:</span>
                                <span class="text-gray-400">Regula actina, facilita migração celular e acelera remodelagem do tecido.</span>
                            </li>
                        </ul>
                    </div>
                </Accordion>

                <!-- Accordion 3: Protocolo de Reconstituição -->
                <Accordion title="Protocolo de Reconstituição">
                    <div class="prose prose-invert max-w-none">
                        <div class="mb-8">
                            <h4 class="text-white font-bold mb-4">Guia de Mistura (Frasco 10mg Total)</h4>
                            <p class="text-gray-300 mb-4">Este frasco contém as duas substâncias misturadas. Adicione 2ml de água bacteriostática:</p>
                            <ol class="list-decimal list-inside space-y-3 text-gray-300">
                                <li><strong class="text-white">Diluente:</strong> Utilize <strong>2ml</strong> (200 unidades) de Água Bacteriostática.</li>
                                <li><strong class="text-white">Processo:</strong> Injete a água lentamente pela parede do frasco. <strong>NÃO agite;</strong> swirl suave até dissolver.</li>
                                <li><strong class="text-white">Matemática da Mistura:</strong>
                                    <ul class="list-disc list-inside ml-4 mt-2 space-y-1">
                                        <li>Total no frasco: <strong>10mg</strong> (5mg BPC + 5mg TB). Volume: <strong>2ml</strong>.</li>
                                        <li>Concentração Final: <strong>5mg totais por ml</strong> (2.5mg de cada composto por ml).</li>
                                        <li>Cada <strong>10 unidades</strong> na seringa contém: <strong>250mcg de BPC</strong> + <strong>250mcg de TB-500</strong>.</li>
                                    </ul>
                                </li>
                                <li>Armazene em refrigeração (2-8°C) após reconstituído.</li>
                                <li>Use dentro do prazo de validade após reconstituição.</li>
                            </ol>
                        </div>

                        <!-- Calculadora Rápida Inline -->
                        <div class="bg-gray-800/50 border border-emerald-500/20 rounded-lg p-6 mt-4">
                            <h4 class="text-white font-bold mb-4 flex items-center gap-2">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
                                </svg>
                                Calculadora Rápida (Dose por composto em mcg)
                            </h4>
                            <form id="calculadoraBlendBT" class="space-y-4">
                                <div>
                                    <label for="doseEachMcgBT" class="block text-sm font-medium text-gray-300 mb-2">
                                        Dose Desejada por composto (mcg)
                                    </label>
                                    <input
                                        type="number"
                                        id="doseEachMcgBT"
                                        step="1"
                                        min="0"
                                        value="250"
                                        placeholder="Ex: 250"
                                        required
                                        class="w-full px-4 py-2 bg-black/50 border border-white/10 rounded-lg text-white placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500/50 transition-all duration-300"
                                    />
                                    <p class="text-xs text-gray-500 mt-1">Ex: 250 mcg por composto = 10 unidades (U-100).</p>
                                </div>
                                <button
                                    type="submit"
                                    class="w-full py-3 bg-gradient-to-r from-emerald-600 to-emerald-500 text-white font-bold rounded-lg hover:from-emerald-500 hover:to-emerald-400 transition-all duration-300 shadow-lg shadow-emerald-500/30 hover:shadow-xl hover:shadow-emerald-500/50 active:scale-[0.98]"
                                >
                                    CALCULAR UNIDADES
                                </button>
                            </form>
                            <div id="resultadoBlendBT" class="hidden mt-4 pt-4 border-t border-white/10">
                                <div class="bg-emerald-500/20 border border-emerald-500/30 rounded-lg p-4 text-center">
                                    <p class="text-gray-400 text-xs mb-1">Unidades da Seringa (UI)</p>
                                    <p id="resultadoUIBlendBT" class="text-3xl font-bold text-emerald-400">0</p>
                                    <p class="text-gray-400 text-xs mt-1">
                                        Volume por aplicação: <span id="resultadoVolumeBlendBT" class="text-emerald-300">0 ml</span>
                                        <br/>
                                        Contém: <span id="resultadoBPC" class="text-emerald-300">0</span> mcg BPC + <span id="resultadoTBb" class="text-emerald-300">0</span> mcg TB-500
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </Accordion>
            </div>
        </section>

        <!-- Botão Voltar ao Catálogo -->
        <section class="max-w-4xl mx-auto mt-12">
            <div class="bg-gradient-to-r from-gray-900/20 to-gray-800/20 border border-white/10 rounded-xl p-6 md:p-8 text-center">
                <h3 class="text-xl font-bold text-white mb-4">Explore Nossos Peptídeos</h3>
                <p class="text-gray-400 text-sm mb-6">
                    Volte ao catálogo completo para conhecer todos os nossos produtos de pesquisa.
                </p>
                <a
                    href="/catalogo"
                    class="inline-flex items-center gap-2 px-8 py-4 bg-gradient-to-r from-emerald-500 to-emerald-600 hover:from-emerald-400 hover:to-emerald-500 text-white font-semibold rounded-lg transition-all duration-300 shadow-lg shadow-emerald-500/30 hover:shadow-xl hover:shadow-emerald-500/50"
                >
                    Voltar para o Catálogo de Peptídeos
                </a>
            </div>
        </section>
    </main>

    <!-- Footer -->
    <footer class="bg-black border-t border-white/10 py-8">
        <div class="container mx-auto px-4">
            <div class="text-center">
                <p class="text-gray-400 text-sm">
                    © 2015 <span class="text-white font-semibold">Orion Peptides</span>. Todos os direitos reservados.
                </p>
            </div>
        </div>
    </footer>
</Layout>

<script>
    // Calculadora Rápida para Blend BPC-157 + TB-500 (5mg each in 2ml)
    document.addEventListener('DOMContentLoaded', () => {
        const form = document.getElementById('calculadoraBlendBT') as HTMLFormElement | null;
        const resultado = document.getElementById('resultadoBlendBT');
        const resultadoUI = document.getElementById('resultadoUIBlendBT');
        const resultadoVolume = document.getElementById('resultadoVolumeBlendBT');
        const resultadoBPC = document.getElementById('resultadoBPC');
        const resultadoTBb = document.getElementById('resultadoTBb');

        if (!form || !resultado || !resultadoUI || !resultadoVolume || !resultadoBPC || !resultadoTBb) {
            return;
        }

        form.addEventListener('submit', (e) => {
            e.preventDefault();
            const input = document.getElementById('doseEachMcgBT') as HTMLInputElement | null;
            if (!input) return;

            // Valores fixos: 5mg each compound in 2ml => 2.5mg/ml each => 2500 mcg/ml each
            const maxEachMcg = 5000; // 5mg = 5000 mcg
            const doseEachMcg = parseFloat(input.value);
            if (isNaN(doseEachMcg) || doseEachMcg <= 0 || doseEachMcg > maxEachMcg) {
                alert('Por favor, insira uma dose válida em mcg para cada composto (até 5000 mcg).');
                return;
            }

            // 1 unit = 0.01 ml -> contains 25 mcg of each compound (2500 mcg/ml * 0.01)
            // units = doseEachMcg / 25
            const unidades = Math.round(doseEachMcg / 25);
            const volumeMl = doseEachMcg / 2500;

            resultadoUI.textContent = unidades.toFixed(0);
            resultadoVolume.textContent = `${volumeMl.toFixed(3)} ml`;
            resultadoBPC.textContent = doseEachMcg.toFixed(0);
            resultadoTBb.textContent = doseEachMcg.toFixed(0);

            resultado.classList.remove('hidden');
        });
    });
</script>

