<script>
    // Calculadora Rápida para Blend CJC-1295 + TB-500 (10mg total em 2ml)
    document.addEventListener('DOMContentLoaded', () => {
        const formBlend = document.getElementById('calculadoraBlend') as HTMLFormElement | null;
        const resultadoBlend = document.getElementById('resultadoBlend');
        const resultadoUIBlend = document.getElementById('resultadoUIBlend');
        const resultadoVolumeBlend = document.getElementById('resultadoVolumeBlend');
        const resultadoCJC = document.getElementById('resultadoCJC');
        const resultadoTB = document.getElementById('resultadoTB');

        if (!formBlend || !resultadoBlend || !resultadoUIBlend || !resultadoVolumeBlend || !resultadoCJC || !resultadoTB) {
            return;
        }

        formBlend.addEventListener('submit', (e) => {
            e.preventDefault();

            const inputDose = document.getElementById('doseBlend') as HTMLInputElement | null;
            if (!inputDose) return;

            // Valores fixos para Blend Orion (10mg total em 2ml = 5mg/ml)
            // Cada ml contém 2.5mg CJC + 2.5mg TB-500
            // Cada 10 unidades = 0.5mg total (250mcg CJC + 250mcg TB-500)
            const tamanhoFrasco = 10; // mg total
            const quantidadeAgua = 2; // ml
            const doseDesejada = parseFloat(inputDose.value); // mg total do blend

            // Validação
            if (isNaN(doseDesejada) || doseDesejada <= 0 || doseDesejada > tamanhoFrasco) {
                alert('Por favor, insira uma dose válida entre 0 e 10mg.');
                return;
            }

            // Cálculo: 10mg total em 2ml = 5mg/ml
            // Cada 10 unidades = 0.5mg total
            // Para calcular unidades: doseDesejada (mg) / 0.5mg por 10 unidades * 10
            // Simplificando: doseDesejada * 20 unidades por mg
            const unidadesUI = doseDesejada * 20;
            const volumeMl = doseDesejada / 5; // 1mg = 0.2ml (5mg/ml)
            
            // Cada 0.5mg total = 250mcg de cada composto
            // doseDesejada em mg * 1000 para mcg, depois dividir por 2 para cada composto
            const mcgCJC = (doseDesejada * 1000) / 2;
            const mcgTB = (doseDesejada * 1000) / 2;

            // Exibir resultados
            resultadoUIBlend.textContent = unidadesUI.toFixed(0);
            resultadoVolumeBlend.textContent = `${volumeMl.toFixed(2)} ml`;
            resultadoCJC.textContent = mcgCJC.toFixed(0);
            resultadoTB.textContent = mcgTB.toFixed(0);

            // Mostrar área de resultado
            resultadoBlend.classList.remove('hidden');
        });
    });
</script>
