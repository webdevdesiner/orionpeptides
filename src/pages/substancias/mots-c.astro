<script>
    // Calculadora Rápida para MOTS-C (40mg em 2ml)
    document.addEventListener('DOMContentLoaded', () => {
        const formMOTSC = document.getElementById('calculadoraMOTSC') as HTMLFormElement | null;
        const resultadoMOTSC = document.getElementById('resultadoMOTSC');
        const resultadoUIMOTSC = document.getElementById('resultadoUIMOTSC');
        const resultadoVolumeMOTSC = document.getElementById('resultadoVolumeMOTSC');

        if (!formMOTSC || !resultadoMOTSC || !resultadoUIMOTSC || !resultadoVolumeMOTSC) {
            return;
        }

        formMOTSC.addEventListener('submit', (e) => {
            e.preventDefault();

            const inputDose = document.getElementById('doseMOTSC') as HTMLInputElement | null;
            if (!inputDose) return;

            // Valores fixos para MOTS-C Orion (40mg em 2ml)
            const tamanhoFrasco = 40; // mg
            const quantidadeAgua = 2; // ml
            const doseDesejada = parseFloat(inputDose.value); // mg

            // Validação
            if (isNaN(doseDesejada) || doseDesejada <= 0 || doseDesejada > tamanhoFrasco) {
                alert('Por favor, insira uma dose válida entre 0 e 40mg.');
                return;
            }

            // Cálculo: 40mg em 2ml = 20mg/ml
            // Para obter 5mg, precisa de 0.25ml = 25 unidades
            // Para calcular unidades: doseDesejada (mg) / 20mg por ml * 100 unidades por ml
            // Simplificando: doseDesejada * 5 unidades por mg
            const unidadesUI = doseDesejada * 5;
            const volumeMl = doseDesejada / 20; // 1mg = 0.05ml (20mg/ml)

            // Exibir resultados
            resultadoUIMOTSC.textContent = unidadesUI.toFixed(0);
            resultadoVolumeMOTSC.textContent = `${volumeMl.toFixed(2)} ml`;

            // Mostrar área de resultado
            resultadoMOTSC.classList.remove('hidden');
        });
    });
</script>
