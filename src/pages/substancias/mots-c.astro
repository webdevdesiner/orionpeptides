---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Accordion from '../../components/Accordion.astro';
---

<Layout title="MOTS-C | Guia Técnico | Orion Peptides">
    <Header />
    
    <main class="container mx-auto px-4 py-12 md:py-16">
        <!-- Topo - Resumo do Produto -->
        <section class="mb-16">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12 items-start">
                <!-- Coluna 1: Imagem do Produto -->
                <div class="space-y-6">
                    <div class="w-full max-w-md bg-gray-900/50 border border-white/10 rounded-2xl overflow-hidden">
                        <div class="px-4 py-2.5 border-b border-white/10 bg-black/20">
                            <p class="text-xs text-gray-400 uppercase tracking-wider font-medium">Imagem do produto</p>
                        </div>
                        <div class="relative p-6 flex items-center justify-center">
                            <a
                                href="/contato"
                                class="absolute top-4 left-4 z-30 inline-flex flex-col items-center justify-center px-2.5 py-1.5 rounded bg-gradient-to-br from-amber-400 via-yellow-500 to-amber-600 hover:from-amber-300 hover:via-yellow-400 hover:to-amber-500 text-amber-950 text-[10px] font-bold uppercase tracking-wide shadow-md shadow-amber-500/30 hover:shadow-amber-400/50 border border-amber-300/50 hover:scale-105 active:scale-95 transition-all duration-300 leading-tight text-center"
                            >
                                <span>Encontrar</span>
                                <span>fornecedor</span>
                            </a>
                            <img 
                                src="/image/glass2.png" 
                                alt="MOTS-C - Mitochondrial-Derived Peptide" 
                                class="w-full h-auto object-contain rounded-lg"
                            />
                        </div>
                    </div>

                    <!-- Especificações Técnicas Rápidas -->
                    <div class="flex flex-col gap-4">
                        <!-- Card 1: Potência -->
                        <div class="bg-gray-900/50 backdrop-blur-md border border-cyan-500/20 rounded-xl p-4 hover:border-cyan-500/40 transition-all duration-300">
                            <div class="flex flex-col items-center text-center space-y-2">
                                <!-- Ícone Frasco -->
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
                                </svg>
                                <p class="text-xs text-gray-400 uppercase tracking-wider">Potência</p>
                                <p class="text-sm text-white font-semibold">40mg Liofilizado</p>
                            </div>
                        </div>

                        <!-- Card 2: Diluente -->
                        <div class="bg-gray-900/50 backdrop-blur-md border border-cyan-500/20 rounded-xl p-4 hover:border-cyan-500/40 transition-all duration-300">
                            <div class="flex flex-col items-center text-center space-y-2">
                                <!-- Ícone Gota -->
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-cyan-400" fill="currentColor" viewBox="0 0 24 24">
                                    <path d="M12 2.69c-3.5 0-6.31 2.81-6.31 6.31 0 3.5 6.31 10.31 6.31 10.31S18.31 12.5 18.31 9c0-3.5-2.81-6.31-6.31-6.31z"/>
                                </svg>
                                <p class="text-xs text-gray-400 uppercase tracking-wider">Requer</p>
                                <p class="text-sm text-white font-semibold">Água Bac. (Não incluso)</p>
                            </div>
                        </div>

                        <!-- Card 3: Armazenamento -->
                        <div class="bg-gray-900/50 backdrop-blur-md border border-cyan-500/20 rounded-xl p-4 hover:border-cyan-500/40 transition-all duration-300">
                            <div class="flex flex-col items-center text-center space-y-2">
                                <!-- Ícone Floco de Neve -->
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
                                </svg>
                                <p class="text-xs text-gray-400 uppercase tracking-wider">Temperatura</p>
                                <p class="text-sm text-white font-semibold">2°C a 8°C (Geladeira)</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Coluna 2: Informações -->
                <div class="space-y-6">
                    <div>
                        <div class="flex items-center gap-4 mb-2">
                            <div class="w-14 h-14 rounded-full bg-white/5 border border-cyan-500/20 flex items-center justify-center flex-shrink-0 shadow-[0_0_12px_rgba(6,182,212,0.25)]">
                                <img src="/image/catalogo/mots-c.png" alt="" class="w-10 h-10 object-contain" />
                            </div>
                            <h1 class="text-4xl md:text-5xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-white via-cyan-200 to-cyan-400">
                                MOTS-C
                            </h1>
                        </div>
                        <p class="text-xl text-gray-400 font-medium mb-3">Mitochondrial-Derived Peptide (MDP)</p>
                        <p class="text-gray-500 text-sm leading-relaxed mb-6">
                            Conhecido cientificamente como <strong class="text-cyan-400">"mimético de exercício"</strong>, o MOTS-C atua diretamente na mitocôndria, regulando funções metabólicas. Ele ativa a via AMPK (a mesma ativada pelo exercício intenso), promovendo a queima de gordura visceral, melhora na sensibilidade à insulina e aumento da resistência física.
                        </p>
                        <div class="bg-cyan-900/20 border border-cyan-500/30 rounded-lg p-3 mb-4">
                            <p class="text-sm text-cyan-200">
                                <strong class="text-cyan-300">Diferencial Orion:</strong> Frasco de <strong>40mg</strong>. Enquanto o mercado vende 10mg (dose única), nosso frasco fornece um ciclo completo de tratamento.
                            </p>
                        </div>
                    </div>

                    <!-- Seção Benefícios Pesquisados -->
                    <div class="mb-8">
                        <h3 class="text-2xl md:text-3xl font-bold mb-6 text-white">
                            Benefícios Pesquisados
                        </h3>
                        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6">
                            <!-- Benefício 1: Metabolismo -->
                            <div class="flex flex-col items-center text-center space-y-3 p-4 hover:-translate-y-2 transition-all duration-300 cursor-default">
                                <!-- Ícone Metabolismo -->
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 md:w-10 md:h-10 text-cyan-400 drop-shadow-[0_0_8px_rgba(6,182,212,0.5)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                                </svg>
                                <h4 class="text-white font-bold text-sm md:text-base">Metabolismo</h4>
                                <p class="text-gray-400 text-xs md:text-sm">Ativação da via AMPK</p>
                            </div>

                            <!-- Benefício 2: Queima de Gordura -->
                            <div class="flex flex-col items-center text-center space-y-3 p-4 hover:-translate-y-2 transition-all duration-300 cursor-default">
                                <!-- Ícone Fogo -->
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 md:w-10 md:h-10 text-cyan-400 drop-shadow-[0_0_8px_rgba(6,182,212,0.5)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 18.657A8 8 0 016.343 7.343S7 9 9 10c0-2 .5-5 2.986-7C14 5 16.09 5.777 17.656 7.343A7.975 7.975 0 0120 13a7.975 7.975 0 01-2.343 5.657z" />
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.879 16.121A3 3 0 1012.015 11L11 14H9c0 .768.293 1.536.879 2.121z" />
                                </svg>
                                <h4 class="text-white font-bold text-sm md:text-base">Queima de Gordura</h4>
                                <p class="text-gray-400 text-xs md:text-sm">Redução de gordura visceral</p>
                            </div>

                            <!-- Benefício 3: Sensibilidade Insulina -->
                            <div class="flex flex-col items-center text-center space-y-3 p-4 hover:-translate-y-2 transition-all duration-300 cursor-default">
                                <!-- Ícone Glicose -->
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 md:w-10 md:h-10 text-cyan-400 drop-shadow-[0_0_8px_rgba(6,182,212,0.5)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                                </svg>
                                <h4 class="text-white font-bold text-sm md:text-base">Sensibilidade</h4>
                                <p class="text-gray-400 text-xs md:text-sm">Melhora na sensibilidade à insulina</p>
                            </div>

                            <!-- Benefício 4: Resistência -->
                            <div class="flex flex-col items-center text-center space-y-3 p-4 hover:-translate-y-2 transition-all duration-300 cursor-default">
                                <!-- Ícone Coração -->
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 md:w-10 md:h-10 text-cyan-400 drop-shadow-[0_0_8px_rgba(6,182,212,0.5)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
                                </svg>
                                <h4 class="text-white font-bold text-sm md:text-base">Resistência</h4>
                                <p class="text-gray-400 text-xs md:text-sm">Aumento da resistência física</p>
                            </div>
                        </div>
                    </div>

                    <div class="space-y-4">
                        <!-- Protocolo de Pesquisa Sugerido -->
                        <div class="mt-8 border-t border-white/10 pt-6">
                            <h4 class="text-white font-bold mb-4 flex items-center gap-2">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-cyan-400" viewBox="0 0 20 20" fill="currentColor">
                                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd" />
                                </svg>
                                Estratégia de Uso (Ciclo Metabólico)
                            </h4>

                            <div class="space-y-4">
                                <!-- Protocolo Padrão -->
                                <div class="overflow-hidden rounded-xl border border-white/10 shadow-lg">
                                    <div class="bg-cyan-900/20 px-4 py-3 border-b border-white/10">
                                        <h5 class="text-cyan-200 font-bold text-sm uppercase">Protocolo Padrão (Metabolismo & Endurance)</h5>
                                    </div>
                                    <div class="bg-gray-900/40 p-4">
                                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm">
                                            <div>
                                                <p class="text-gray-400 mb-1">Dose</p>
                                                <p class="text-white font-semibold">5mg por aplicação</p>
                                            </div>
                                            <div>
                                                <p class="text-gray-400 mb-1">Volume na Seringa</p>
                                                <p class="text-cyan-400 font-bold text-lg">25 unidades (0.25 ml)</p>
                                            </div>
                                            <div>
                                                <p class="text-gray-400 mb-1">Frequência</p>
                                                <p class="text-white font-semibold">3x na semana</p>
                                                <p class="text-gray-500 text-xs mt-1">(Ex: Seg/Qua/Sex)</p>
                                            </div>
                                            <div>
                                                <p class="text-gray-400 mb-1">Momento Ideal</p>
                                                <p class="text-white">30 min antes do cardio/treino</p>
                                            </div>
                                            <div class="md:col-span-2">
                                                <p class="text-gray-400 mb-1">Rendimento</p>
                                                <p class="text-white">O frasco de 40mg dura quase <strong class="text-cyan-400">3 semanas</strong> neste ritmo intenso (8 doses totais).</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Protocolo Manutenção -->
                                <div class="overflow-hidden rounded-xl border border-cyan-500/30 shadow-lg">
                                    <div class="bg-cyan-900/30 px-4 py-3 border-b border-cyan-500/20">
                                        <h5 class="text-cyan-200 font-bold text-sm uppercase">Protocolo de Manutenção (Longevidade)</h5>
                                    </div>
                                    <div class="bg-gray-900/40 p-4">
                                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm">
                                            <div>
                                                <p class="text-gray-400 mb-1">Dose</p>
                                                <p class="text-white font-semibold">5mg a 10mg</p>
                                            </div>
                                            <div>
                                                <p class="text-gray-400 mb-1">Frequência</p>
                                                <p class="text-white font-semibold">1 vez na semana</p>
                                            </div>
                                            <div class="md:col-span-2">
                                                <p class="text-gray-400 mb-1">Rendimento</p>
                                                <p class="text-white">O frasco dura <strong class="text-cyan-400">1 a 2 meses</strong>.</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="bg-cyan-900/10 p-3 text-xs text-cyan-300 flex items-start gap-2 border-t border-white/5 mt-4 rounded-b-xl">
                                <span class="text-cyan-500 font-bold">⚠️</span>
                                <div>
                                    <p class="mb-1"><strong>Aviso de Conforto (O "MOTS-C Sting"):</strong> É normal sentir uma ardência ou coceira no local da aplicação por alguns minutos.</p>
                                    <p><strong>Dica:</strong> Retire da geladeira 15 min antes e injete lentamente para minimizar o desconforto.</p>
                                </div>
                            </div>
                        </div>

                        <div class="bg-gray-900/50 border border-white/10 rounded-lg p-4">
                            <p class="text-sm text-gray-400 mb-1">Pureza Certificada</p>
                            <p class="text-cyan-400 font-bold text-2xl">>99.6% (HPLC) - High Purity</p>
                        </div>

                        <div class="bg-gray-900/50 border border-white/10 rounded-lg p-4">
                            <p class="text-sm text-gray-400 mb-1">Aplicação</p>
                            <p class="text-white">Pesquisa em metabolismo mitocondrial, longevidade e performance física</p>
                        </div>
                    </div>

                    <a
                        href="#"
                        class="block w-full md:w-auto px-8 py-4 bg-gradient-to-r from-cyan-500 to-cyan-600 text-white font-bold rounded-lg hover:from-cyan-400 hover:to-cyan-500 transition-all duration-300 text-center shadow-lg shadow-cyan-500/30 hover:shadow-xl hover:shadow-cyan-500/50 active:scale-[0.98] border border-cyan-400/30 hover:border-cyan-400/50"
                    >
                        Encontrar Fornecedor
                    </a>
                </div>
            </div>
        </section>

        <!-- Área Técnica - Accordions -->
        <section class="max-w-4xl mx-auto">
            <h2 class="text-3xl md:text-4xl font-bold mb-8 text-center bg-clip-text text-transparent bg-gradient-to-r from-cyan-400 to-cyan-600">
                Informações Técnicas
            </h2>

            <div class="space-y-4">
                <!-- Accordion 1: O que é MOTS-C? -->
                <Accordion title="O que é MOTS-C?">
                    <div class="prose prose-invert max-w-none">
                        <p class="text-gray-300 mb-4">
                            Conhecido cientificamente como <strong class="text-white">"mimético de exercício"</strong>, o <strong class="text-white">MOTS-C (Mitochondrial-Derived Peptide)</strong> atua diretamente na mitocôndria, regulando funções metabólicas.
                        </p>
                        <p class="text-gray-300 mb-4">
                            <strong class="text-white">Ação:</strong> Ele ativa a via AMPK (a mesma ativada pelo exercício intenso), promovendo a queima de gordura visceral, melhora na sensibilidade à insulina e aumento da resistência física.
                        </p>
                        <div class="bg-cyan-900/20 border border-cyan-500/30 rounded-lg p-3 mb-4">
                            <p class="text-sm text-cyan-200">
                                <strong class="text-cyan-300">Diferencial Orion:</strong> Frasco de <strong>40mg</strong>. Enquanto o mercado vende 10mg (dose única), nosso frasco fornece um ciclo completo de tratamento.
                            </p>
                        </div>
                        <div class="bg-red-900/20 border border-red-500/30 p-4 rounded text-sm text-red-200">
                            <strong>Nota de Pesquisa:</strong> Este composto é destinado exclusivamente para fins de pesquisa científica e não deve ser utilizado para consumo humano ou veterinário sem aprovação regulatória adequada.
                        </div>
                    </div>
                </Accordion>

                <!-- Accordion 2: Mecanismo de Ação -->
                <Accordion title="Mecanismo de Ação (Ciência)">
                    <div class="prose prose-invert max-w-none">
                        <p class="text-gray-300 mb-6">O mecanismo de ação demonstra uma atividade metabólica mitocondrial em modelos de pesquisa:</p>
                        
                        <ul class="space-y-4 list-none">
                            <li class="flex gap-3">
                                <span class="text-cyan-500 font-bold">Ativação AMPK:</span>
                                <span class="text-gray-400">O MOTS-C ativa a proteína quinase ativada por AMP (AMPK), a mesma via metabólica ativada durante exercício intenso, promovendo catabolismo de gordura e síntese de energia.</span>
                            </li>
                            <li class="flex gap-3">
                                <span class="text-cyan-500 font-bold">Função Mitocondrial:</span>
                                <span class="text-gray-400">Melhora a eficiência mitocondrial, aumentando a produção de ATP e reduzindo o estresse oxidativo nas células.</span>
                            </li>
                            <li class="flex gap-3">
                                <span class="text-cyan-500 font-bold">Sensibilidade à Insulina:</span>
                                <span class="text-gray-400">Aumenta a captação de glicose pelos tecidos musculares, melhorando a sensibilidade à insulina e reduzindo a resistência insulínica.</span>
                            </li>
                            <li class="flex gap-3">
                                <span class="text-cyan-500 font-bold">Mimético de Exercício:</span>
                                <span class="text-gray-400">Reproduz os efeitos metabólicos do exercício físico, incluindo aumento da capacidade oxidativa e melhora na função cardiovascular, mesmo sem atividade física.</span>
                            </li>
                        </ul>

                        <p class="text-xs text-gray-600 mt-6 italic">Referência: Os mecanismos descritos são baseados em estudos pré-clínicos e clínicos (in vivo/in vitro).</p>
                    </div>
                </Accordion>

                <!-- Accordion 3: Protocolo de Reconstituição -->
                <Accordion title="Protocolo de Reconstituição">
                    <div class="prose prose-invert max-w-none">
                        <div class="mb-8">
                            <h4 class="text-white font-bold mb-4">Guia de Mistura (Frasco 40mg)</h4>
                            <p class="text-gray-300 mb-4 text-cyan-300"><strong>Atenção: Alta Concentração.</strong></p>
                            <ol class="list-decimal list-inside space-y-3 text-gray-300">
                                <li><strong class="text-white">Diluente:</strong> Utilize <strong>2ml</strong> (200 unidades) de Água Bacteriostática.</li>
                                <li><strong class="text-white">Processo:</strong> Injete a água e faça movimentos circulares (swirl). <strong>NÃO agite vigorosamente</strong>, peptídeos mitocondriais são frágeis.</li>
                                <li><strong class="text-white">Matemática da Dose:</strong>
                                    <ul class="list-disc list-inside ml-4 mt-2 space-y-1">
                                        <li>40mg em 2ml = <strong>20mg por ml</strong></li>
                                        <li>A dose padrão de MOTS-C é alta (<strong>5mg</strong>)</li>
                                        <li>Para obter <strong>5mg</strong>, você precisa de <strong>0.25ml</strong> (<strong>25 unidades</strong> na seringa)</li>
                                    </ul>
                                </li>
                                <li>Armazene em refrigeração (2-8°C) após reconstituído.</li>
                                <li>Use dentro do prazo de validade após reconstituição.</li>
                            </ol>
                        </div>

                        <div class="bg-cyan-500/10 border border-cyan-500/30 rounded-lg p-4 mt-4">
                            <p class="text-sm text-cyan-300 mb-3">
                                <strong>Dica:</strong> Use nossa calculadora de reconstituição para determinar as concentrações precisas para seus protocolos de pesquisa.
                            </p>
                            <a
                                href="/calculadora"
                                class="inline-flex items-center gap-2 px-4 py-2 bg-cyan-500/20 hover:bg-cyan-500/30 border border-cyan-500/50 text-cyan-300 rounded-lg transition-colors text-sm font-semibold"
                            >
                                Acessar Calculadora Completa
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                                </svg>
                            </a>
                        </div>

                        <!-- Calculadora Rápida Inline -->
                        <div class="bg-gray-800/50 border border-cyan-500/20 rounded-lg p-6 mt-6">
                            <h4 class="text-white font-bold mb-4 flex items-center gap-2">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
                                </svg>
                                Calculadora Rápida (MOTS-C 40mg)
                            </h4>
                            <form id="calculadoraMOTSC" class="space-y-4">
                                <div>
                                    <label for="doseMOTSC" class="block text-sm font-medium text-gray-300 mb-2">
                                        Dose Desejada (mg)
                                    </label>
                                    <input
                                        type="number"
                                        id="doseMOTSC"
                                        step="0.5"
                                        min="0"
                                        value="5"
                                        placeholder="Ex: 5"
