---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Accordion from '../../components/Accordion.astro';

const produtoNome = 'SS-31 10mg (Elamipretide)';
const concentracao = '10mg Liofilizado';

// Ícone de categoria (mitocondrial/cognitivo): reaproveitar MOTS-C até existir ícone dedicado
const imagemCatalogo = '/image/catalogo/mots-c.png';

// Imagem do produto (já salva por você)
const imagemProduto = '/image/produtos/SS-31.png';
const imagemAlt = 'Frasco de SS-31 10mg Orion Peptides para pesquisa em bioenergética mitocondrial e longevidade.';

const subtitulo = 'O Peptídeo Mitocondrial Definitivo para Energia Celular e Longevidade.';
const descricao =
	'O SS-31 (Elamipretide) é um peptídeo revolucionário projetado especificamente para penetrar na membrana mitocondrial interna e se ligar à cardiolipina. Diferente de antioxidantes comuns que apenas neutralizam radicais livres de forma superficial, ele repara a "usina de energia" da célula diretamente na fonte. Ao restaurar a estrutura mitocondrial, o SS-31 reverte a disfunção celular ligada ao envelhecimento, fadiga crônica e degeneração neurológica, reestabelecendo níveis de energia (ATP) da juventude.';
const diferencialOrion =
	'Sintetizado com pureza >99.5%, garantindo a exatidão estrutural necessária (incluindo o aminoácido raro Dmt) para penetrar nas membranas celulares e atingir o alvo mitocondrial com precisão absoluta.';

const tamanhoFrascoMg = 10;
const quantidadeAguaMl = 2;

const layoutTitle = `${produtoNome} | Guia Técnico | Orion Peptides`;
const layoutDescription =
	'SS-31 (Elamipretide) 10mg Orion Peptides. O peptídeo mitocondrial definitivo para bioenergética celular, proteção cognitiva e longevidade avançada.';
const layoutOgImage = '/image/produtos/SS-31.png';
---

<Layout title={layoutTitle} description={layoutDescription} ogImage={layoutOgImage}>
	<Header />
	<main class="container mx-auto px-4 py-12 md:py-16">
		<section class="mb-16">
			<div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12 items-start">
				<div class="space-y-6">
					<div class="md:hidden flex items-center justify-center gap-3 mb-3">
						<div class="w-10 h-10 rounded-full bg-white/5 border border-teal-500/20 flex items-center justify-center flex-shrink-0 shadow-[0_0_8px_rgba(20,184,166,0.14)]">
							<img src={imagemCatalogo} alt={`Ícone ${produtoNome}`} class="w-8 h-8 object-contain" />
						</div>
						<h1 class="text-2xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-white via-teal-200 to-teal-400">{produtoNome}</h1>
					</div>

					<figure class="w-full max-w-md bg-gray-900/50 border border-white/10 rounded-2xl overflow-hidden">
						<div class="px-4 py-2.5 border-b border-white/10 bg-black/20">
							<figcaption class="text-xs text-gray-400 uppercase tracking-wider font-medium">{produtoNome} — Imagem do produto</figcaption>
						</div>
						<div class="relative p-6 flex items-center justify-center">
							<a href="/contato" data-wa-product={produtoNome} data-wa-phone="5511911387063" class="absolute top-4 left-4 z-30 inline-flex flex-col items-center justify-center px-2.5 py-1.5 rounded bg-gradient-to-br from-amber-400 via-yellow-500 to-amber-600 hover:from-amber-300 hover:via-yellow-400 hover:to-amber-500 text-amber-950 text-[10px] font-bold uppercase tracking-wide shadow-md shadow-amber-500/30 hover:shadow-amber-400/50 border border-amber-300/50 hover:scale-105 active:scale-95 transition-all duration-300 leading-tight text-center">
								<span>Encontrar</span><span>fornecedor</span>
							</a>
							<img src={imagemProduto} alt={imagemAlt} class="w-full h-auto object-contain rounded-lg" />
						</div>
					</figure>

					<div class="flex flex-col gap-4">
						<div class="bg-gray-900/50 backdrop-blur-md border border-teal-500/20 rounded-xl p-4 hover:border-teal-500/40 transition-all duration-300">
							<div class="flex flex-col items-center text-center space-y-2">
								<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-teal-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" /></svg>
								<p class="text-xs text-gray-400 uppercase tracking-wider">Potência Total</p>
								<p class="text-sm text-white font-semibold">{concentracao}</p>
							</div>
						</div>
						<div class="bg-gray-900/50 backdrop-blur-md border border-teal-500/20 rounded-xl p-4 hover:border-teal-500/40 transition-all duration-300">
							<div class="flex flex-col items-center text-center space-y-2">
								<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-teal-400" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.69c-3.5 0-6.31 2.81-6.31 6.31 0 3.5 6.31 10.31 6.31 10.31S18.31 12.5 18.31 9c0-3.5-2.81-6.31-6.31-6.31z" /></svg>
								<p class="text-xs text-gray-400 uppercase tracking-wider">Inclui</p>
								<p class="text-sm text-white font-semibold">🎁 Inclui 10ml de Água Estéril</p>
							</div>
						</div>
						<div class="bg-gray-900/50 backdrop-blur-md border border-teal-500/20 rounded-xl p-4 hover:border-teal-500/40 transition-all duration-300">
							<div class="flex flex-col items-center text-center space-y-2">
								<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-teal-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" /></svg>
								<p class="text-xs text-gray-400 uppercase tracking-wider">Temperatura</p>
								<p class="text-sm text-white font-semibold">2°C a 8°C (Geladeira) após a reconstituição</p>
							</div>
						</div>
						<div class="bg-gray-900/50 backdrop-blur-md border border-teal-500/20 rounded-xl p-4 hover:border-teal-500/40 transition-all duration-300">
							<div class="flex flex-col items-center text-center space-y-2">
								<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-teal-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z" /></svg>
								<p class="text-xs text-gray-400 uppercase tracking-wider">Diluição Recomendada</p>
								<p class="text-sm text-white font-semibold">Requer {quantidadeAguaMl}ml de Água Estéril (20 UI = 1mg)</p>
							</div>
						</div>
					</div>
				</div>

				<div class="space-y-6">
					<div>
						<div class="hidden md:flex items-center gap-4 mb-2">
							<div class="w-14 h-14 rounded-full bg-white/5 border border-teal-500/20 flex items-center justify-center flex-shrink-0 shadow-[0_0_12px_rgba(20,184,166,0.24)]">
								<img src={imagemCatalogo} alt="" class="w-10 h-10 object-contain" />
							</div>
							<h1 class="text-3xl md:text-5xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-white via-teal-200 to-teal-400">{produtoNome}</h1>
						</div>
						<p class="text-xl text-gray-400 font-medium mb-3 hidden md:block">{subtitulo}</p>
						<p class="text-gray-500 text-sm leading-relaxed mb-6 hidden md:block">{descricao}</p>
						<div class="bg-teal-900/20 border border-teal-500/30 rounded-lg p-3 mb-4">
							<p class="text-sm text-teal-100"><strong class="text-teal-300">Diferencial Orion:</strong> {diferencialOrion}</p>
						</div>
					</div>

					<div class="mb-8">
						<h3 class="text-2xl md:text-3xl font-bold mb-6 text-white">Benefícios Pesquisados</h3>
						<div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6">
							<div class="flex flex-col items-center text-center space-y-3 p-4 hover:-translate-y-2 transition-all duration-300 cursor-default">
								<svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 md:w-10 md:h-10 text-teal-400 drop-shadow-[0_0_8px_rgba(20,184,166,0.5)]" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
								<h4 class="text-white font-bold text-sm md:text-base">Restauração da Energia (ATP)</h4>
								<p class="text-gray-400 text-xs md:text-sm">Reduz vazamento de elétrons e aumenta produção de energia celular</p>
							</div>
							<div class="flex flex-col items-center text-center space-y-3 p-4 hover:-translate-y-2 transition-all duration-300 cursor-default">
								<svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 md:w-10 md:h-10 text-teal-400 drop-shadow-[0_0_8px_rgba(20,184,166,0.5)]" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" /></svg>
								<h4 class="text-white font-bold text-sm md:text-base">Proteção Cognitiva e Foco</h4>
								<p class="text-gray-400 text-xs md:text-sm">Protege redes neurais contra estresse oxidativo e névoa mental</p>
							</div>
							<div class="flex flex-col items-center text-center space-y-3 p-4 hover:-translate-y-2 transition-all duration-300 cursor-default">
								<svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 md:w-10 md:h-10 text-teal-400 drop-shadow-[0_0_8px_rgba(20,184,166,0.5)]" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>
								<h4 class="text-white font-bold text-sm md:text-base">Redução da Fadiga Muscular</h4>
								<p class="text-gray-400 text-xs md:text-sm">Melhora tolerância ao exercício e recuperação celular</p>
							</div>
							<div class="flex flex-col items-center text-center space-y-3 p-4 hover:-translate-y-2 transition-all duration-300 cursor-default">
								<svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 md:w-10 md:h-10 text-teal-400 drop-shadow-[0_0_8px_rgba(20,184,166,0.5)]" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
								<h4 class="text-white font-bold text-sm md:text-base">Ação Anti-Aging Direta</h4>
								<p class="text-gray-400 text-xs md:text-sm">Retarda envelhecimento ao proteger mitocôndrias e reduzir apoptose</p>
							</div>
						</div>
					</div>

					<div class="space-y-4">
						<div class="mt-8 border-t border-white/10 pt-6">
							<h4 class="text-white font-bold mb-4 flex items-center gap-2">
								<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-teal-400" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd" /></svg>
								Protocolo de Pesquisa Sugerido
							</h4>
							<div class="overflow-hidden rounded-xl border border-white/10 shadow-lg">
								<div class="overflow-x-auto">
									<table class="w-full text-left text-sm">
										<thead class="bg-teal-900/20 text-teal-200 uppercase text-xs font-bold tracking-wider">
											<tr>
												<th class="px-4 py-3">Fase de Estudo</th>
												<th class="px-4 py-3">Dose Diária</th>
												<th class="px-4 py-3 text-white bg-teal-600/20 border-l border-teal-500/30">Volume na Seringa (Ref: {quantidadeAguaMl}ml água)</th>
												<th class="px-4 py-3">Frequência</th>
											</tr>
										</thead>
										<tbody class="divide-y divide-white/5 bg-gray-900/40">
											<tr class="hover:bg-white/5 transition-colors">
												<td class="px-4 py-3 font-medium text-white">Uso Diário Contínuo (Semanas 1 a 4)</td>
												<td class="px-4 py-3 text-gray-300">1,0mg a 2,0mg</td>
												<td class="px-4 py-3 font-bold text-teal-300 border-l border-white/5">20 a 40 unidades (0,20 a 0,40 ml)</td>
												<td class="px-4 py-3 text-gray-300">1x ao dia (subcutânea)</td>
											</tr>
											<tr class="hover:bg-white/5 transition-colors">
												<td class="px-4 py-3 font-medium text-white">Manutenção Longevidade (Semanas 5 a 12)</td>
												<td class="px-4 py-3 text-gray-300">1,0mg</td>
												<td class="px-4 py-3 font-bold text-teal-300 border-l border-white/5">20 unidades (0,20 ml)</td>
												<td class="px-4 py-3 text-gray-300">1x ao dia ou em dias alternados</td>
											</tr>
										</tbody>
									</table>
									<div class="bg-teal-900/10 p-3 text-xs text-teal-200 flex items-start gap-2 border-t border-white/5">
										<span class="text-teal-400 font-bold">💡</span>
										<p><strong>Nota:</strong> por atuar na reparação mitocondrial, os benefícios do SS-31 tendem a ser cumulativos; ciclos mais longos são preferidos para consolidação.</p>
									</div>
								</div>
							</div>
						</div>
						<div class="bg-gray-900/50 border border-white/10 rounded-lg p-4">
							<p class="text-sm text-gray-400 mb-1">Pureza Certificada</p>
							<p class="text-teal-300 font-bold text-2xl">&gt;99.5% (HPLC) - High Purity</p>
						</div>
						<div class="bg-gray-900/50 border border-white/10 rounded-lg p-4">
							<p class="text-sm text-gray-400 mb-1">Aplicação</p>
							<p class="text-white">Pesquisa em bioenergética mitocondrial, proteção cognitiva e longevidade</p>
						</div>
					</div>
					<a href="/contato" data-wa-product={produtoNome} data-wa-phone="5511911387063" class="block w-full md:w-auto px-8 py-4 bg-gradient-to-r from-teal-500 to-teal-600 text-black font-bold rounded-lg hover:from-teal-400 hover:to-teal-500 transition-all duration-300 text-center shadow-lg shadow-teal-500/30 hover:shadow-xl hover:shadow-teal-500/50 active:scale-[0.98] border border-teal-300/30 hover:border-teal-300/50">Encontrar Fornecedor</a>
				</div>
			</div>
		</section>

		<section class="max-w-4xl mx-auto">
			<h2 class="text-3xl md:text-4xl font-bold mb-8 text-center bg-clip-text text-transparent bg-gradient-to-r from-teal-300 to-teal-500">Informações Técnicas</h2>
			<div class="space-y-4">
				<Accordion title="O que é o SS-31?">
					<div class="prose prose-invert max-w-none">
						<p class="text-gray-300 mb-4">O SS-31 (Elamipretide) faz parte de uma pequena classe de compostos conhecidos como "peptídeos direcionados à mitocôndria". Foi desenvolvido para ter propriedades de penetração celular que permitem atravessar a membrana celular e atingir a membrana mitocondrial interna.</p>
						<p class="text-gray-300 mb-4">Em vez de atuar no sangue ou em receptores hormonais, ele age na reparação da "usina" celular, ajudando a reverter defeitos que causam declínio de energia e protegendo órgãos que exigem muita energia, como coração, cérebro e músculos, em modelos de pesquisa.</p>
						<div class="bg-teal-900/20 border border-teal-500/30 rounded-lg p-3 mb-4">
							<p class="text-sm text-teal-100"><strong class="text-teal-300">Diferencial Orion:</strong> {diferencialOrion}</p>
						</div>
						<div class="bg-red-900/20 border border-red-500/30 p-4 rounded text-sm text-red-200">
							<strong>Nota de Pesquisa:</strong> Este composto é destinado exclusivamente para fins de pesquisa científica e não deve ser utilizado para consumo humano ou veterinário sem aprovação regulatória adequada.
						</div>
					</div>
				</Accordion>

				<Accordion title="Mecanismo de Ação (Cardiolipina e ATP)">
					<div class="prose prose-invert max-w-none">
						<ul class="space-y-4 list-none">
							<li class="flex gap-3"><span class="text-teal-400 font-bold">Cardiolipina:</span><span class="text-gray-400">Ligação seletiva à cardiolipina na membrana mitocondrial interna.</span></li>
							<li class="flex gap-3"><span class="text-teal-400 font-bold">Estrutura:</span><span class="text-gray-400">Estabiliza a mitocôndria e reduz vazamento de elétrons na conversão de nutrientes em energia.</span></li>
							<li class="flex gap-3"><span class="text-teal-400 font-bold">ATP:</span><span class="text-gray-400">Restaura a produção de ATP em células danificadas ou envelhecidas.</span></li>
							<li class="flex gap-3"><span class="text-teal-400 font-bold">ROS:</span><span class="text-gray-400">Reduz espécies reativas de oxigênio (ROS) e estresse oxidativo na origem.</span></li>
						</ul>
					</div>
				</Accordion>

				<Accordion title="Protocolo de Reconstituição (SS-31 10mg)">
					<div class="prose prose-invert max-w-none">
						<div class="mb-8">
							<h4 class="text-white font-bold mb-4">Guia de Mistura (Frasco 10mg)</h4>
							<ol class="list-decimal list-inside space-y-3 text-gray-300">
								<li><strong class="text-white">Higienização:</strong> Limpe o septo com álcool 70%.</li>
								<li><strong class="text-white">Diluente:</strong> Extraia <strong>{quantidadeAguaMl}ml</strong> de água estéril/bacteriostática.</li>
								<li><strong class="text-white">Processo:</strong> Injete lentamente pela parede do frasco.</li>
								<li><strong class="text-white">Dissolução:</strong> Gire delicadamente entre os dedos até dissolver por completo.</li>
								<li><strong class="text-white">Armazenamento:</strong> Refrigere (2–8°C) após reconstituído.</li>
							</ol>
						</div>
						<div class="bg-gray-800/50 border border-teal-500/20 rounded-lg p-6 mt-4">
							<h4 class="text-white font-bold mb-4 flex items-center gap-2">
								<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-teal-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z" /></svg>
								Calculadora Rápida ({produtoNome})
							</h4>
							<form id="calculadoraProduto" class="space-y-4">
								<div>
									<label for="doseProduto" class="block text-sm font-medium text-gray-300 mb-2">Dose Desejada (mg)</label>
									<input type="number" id="doseProduto" step="0.25" min="0" value="1" placeholder="Ex: 1" required class="w-full px-4 py-2 bg-black/50 border border-white/10 rounded-lg text-white placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-teal-500/50 transition-all duration-300" />
								</div>
								<button type="submit" class="w-full md:w-auto py-3 bg-gradient-to-r from-teal-600 to-teal-500 text-black font-bold rounded-lg hover:from-teal-500 hover:to-teal-400 transition-all duration-300 shadow-lg shadow-teal-500/30 hover:shadow-xl hover:shadow-teal-500/50 active:scale-[0.98]">CALCULAR UNIDADES</button>
							</form>
							<div id="resultadoProduto" class="hidden mt-4 pt-4 border-t border-white/10">
								<div class="bg-teal-500/15 border border-teal-500/30 rounded-lg p-4 text-center">
									<p class="text-gray-400 text-xs mb-1">Unidades da Seringa (UI)</p>
									<p id="resultadoUIProduto" class="text-3xl font-bold text-teal-300">0</p>
									<p class="text-gray-400 text-xs mt-1">Volume: <span id="resultadoVolumeProduto" class="text-teal-200">0 ml</span></p>
								</div>
							</div>
						</div>
						<div class="bg-teal-500/10 border border-teal-500/30 rounded-lg p-4 mt-6">
							<p class="text-sm text-teal-200 mb-3"><strong>Dica:</strong> Use a calculadora completa para outros frascos e diluições.</p>
