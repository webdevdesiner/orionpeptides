---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Accordion from '../../components/Accordion.astro';
---

<Layout title="CJC-1295 + Ipamorelin (10mg Blend) | Guia Técnico | Orion Peptides">
    <Header />
    
    <main class="container mx-auto px-4 py-12 md:py-16">
        <!-- Topo - Resumo do Produto -->
        <section class="mb-16">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12 items-start">
                <!-- Coluna 1: Imagem do Produto -->
                <div class="space-y-6">
                    <!-- Mobile-only: título acima da imagem com ícone -->
                    <div class="md:hidden flex items-center justify-center gap-3 mb-3">
                        <div class="w-10 h-10 rounded-full bg-white/5 border border-rose-500/20 flex items-center justify-center flex-shrink-0 shadow-[0_0_8px_rgba(244,63,94,0.12)]">
                            <img src="/image/catalogo/cjc-tb-500.png" alt="Ícone Blend CJC" class="w-8 h-8 object-contain" />
                        </div>
                        <h1 class="text-2xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-white via-rose-200 to-rose-400">
                            CJC-1295 + Ipamorelin (10mg Blend)
                        </h1>
                    </div>
                    <div class="w-full max-w-md bg-gray-900/50 border border-white/10 rounded-2xl overflow-hidden">
                        <div class="px-4 py-2.5 border-b border-white/10 bg-black/20">
                            <p class="text-xs text-gray-400 uppercase tracking-wider font-medium">Imagem do produto</p>
                        </div>
                        <div class="relative p-6 flex items-center justify-center">
                            <a
                                href="/contato"
                                class="absolute top-4 left-4 z-30 inline-flex flex-col items-center justify-center px-2.5 py-1.5 rounded bg-gradient-to-br from-amber-400 via-yellow-500 to-amber-600 hover:from-amber-300 hover:via-yellow-400 hover:to-amber-500 text-amber-950 text-[10px] font-bold uppercase tracking-wide shadow-md shadow-amber-500/30 hover:shadow-amber-400/50 border border-amber-300/50 hover:scale-105 active:scale-95 transition-all duration-300 leading-tight text-center"
                            >
                                <span>Encontrar</span>
                                <span>fornecedor</span>
                            </a>
                            <img 
                                src="/image/produtos/BLENDCJC-1295+TB-500.png" 
                                alt="CJC-1295 + Ipamorelin - Blend Anti-Aging" 
                                class="w-full h-auto object-contain rounded-lg"
                            />
                        </div>
                    </div>

                    <!-- Especificações Técnicas Rápidas -->
                    <div class="flex flex-col gap-4">
                        <!-- Card 1: Potência -->
                        <div class="bg-gray-900/50 backdrop-blur-md border border-rose-500/20 rounded-xl p-4 hover:border-rose-500/40 transition-all duration-300">
                            <div class="flex flex-col items-center text-center space-y-2">
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-rose-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
                                </svg>
                                <p class="text-xs text-gray-400 uppercase tracking-wider">Potência</p>
                                <p class="text-sm text-white font-semibold">10mg Total (5mg + 5mg)</p>
                            </div>
                        </div>

                        <!-- Card 2: Diluente -->
                        <div class="bg-gray-900/50 backdrop-blur-md border border-rose-500/20 rounded-xl p-4 hover:border-rose-500/40 transition-all duration-300">
                            <div class="flex flex-col items-center text-center space-y-2">
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-rose-400" fill="currentColor" viewBox="0 0 24 24">
                                    <path d="M12 2.69c-3.5 0-6.31 2.81-6.31 6.31 0 3.5 6.31 10.31 6.31 10.31S18.31 12.5 18.31 9c0-3.5-2.81-6.31-6.31-6.31z"/>
                                </svg>
                                <p class="text-xs text-gray-400 uppercase tracking-wider">Requer</p>
                                <p class="text-sm text-white font-semibold">Água Bac. (2ml — Não incluso)</p>
                            </div>
                        </div>

                        <!-- Card 3: Armazenamento -->
                        <div class="bg-gray-900/50 backdrop-blur-md border border-rose-500/20 rounded-xl p-4 hover:border-rose-500/40 transition-all duration-300">
                            <div class="flex flex-col items-center text-center space-y-2">
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-rose-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
                                </svg>
                                <p class="text-xs text-gray-400 uppercase tracking-wider">Temperatura</p>
                                <p class="text-sm text-white font-semibold">2°C a 8°C (Geladeira)</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Coluna 2: Informações -->
                <div class="space-y-6">
                    <div>
                        <div class="hidden md:flex items-center gap-4 mb-2">
                            <div class="w-14 h-14 rounded-full bg-white/5 border border-rose-500/20 flex items-center justify-center flex-shrink-0 shadow-[0_0_12px_rgba(244,63,94,0.18)]">
                                <img src="/image/catalogo/cjc-tb-500.png" alt="" class="w-10 h-10 object-contain" />
                            </div>
                            <div>
                                <h1 class="text-3xl md:text-5xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-white via-rose-200 to-rose-400">
                                    CJC-1295 + Ipamorelin (10mg Blend)
                                </h1>
                                <div class="flex gap-2 mt-2">
                                    <span class="px-2 py-1 bg-rose-700/20 border border-rose-500/30 rounded-full text-xs font-semibold text-rose-300">Anti-Aging</span>
                                    <span class="px-2 py-1 bg-rose-700/20 border border-rose-500/30 rounded-full text-xs font-semibold text-rose-300">Fat Loss</span>
                                    <span class="px-2 py-1 bg-rose-700/20 border border-rose-500/30 rounded-full text-xs font-semibold text-rose-300">Deep Sleep</span>
                                </div>
                            </div>
                        </div>
                        <p class="text-xl text-gray-400 font-medium mb-3 hidden md:block">O padrão ouro do Anti-Aging. Estimula o GH natural sem aumentar a fome ou cortisol.</p>
                        <p class="text-gray-500 text-sm leading-relaxed mb-6 hidden md:block">
                            Blend blendado para maximizar a secreção pulsátil de GH: 5mg de CJC-1295 (No DAC) + 5mg de Ipamorelin em um único frasco de 10mg.
                        </p>
                        <div class="bg-rose-900/20 border border-rose-500/30 rounded-lg p-3 mb-4">
                            <p class="text-sm text-rose-200">
                                <strong class="text-rose-300">Apresentação Orion:</strong> Frasco de <strong>10mg totais</strong> (5mg CJC-1295 No DAC + 5mg Ipamorelin). Diluente padrão: <strong>2ml</strong>.
                            </p>
                        </div>
                    </div>

                    <!-- Seção Benefícios Pesquisados -->
                    <div class="mb-8">
                        <h3 class="text-2xl md:text-3xl font-bold mb-6 text-white">
                            Benefícios Pesquisados
                        </h3>
                        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6">
                            <div class="flex flex-col items-center text-center space-y-3 p-4 hover:-translate-y-2 transition-all duration-300 cursor-default">
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 md:w-10 md:h-10 text-rose-400 drop-shadow-[0_0_8px_rgba(244,63,94,0.5)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 118.646 3.646 7 7 0 0020.354 15.354z" />
                                </svg>
                                <h4 class="text-white font-bold text-sm md:text-base">Sono Profundo</h4>
                                <p class="text-gray-400 text-xs md:text-sm">Melhora da arquitetura do sono (REM)</p>
                            </div>
                            <div class="flex flex-col items-center text-center space-y-3 p-4 hover:-translate-y-2 transition-all duration-300 cursor-default">
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 md:w-10 md:h-10 text-rose-400 drop-shadow-[0_0_8px_rgba(244,63,94,0.5)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                                </svg>
                                <h4 class="text-white font-bold text-sm md:text-base">Melhora da Pele</h4>
                                <p class="text-gray-400 text-xs md:text-sm">Aumento de colágeno e elasticidade</p>
                            </div>
                            <div class="flex flex-col items-center text-center space-y-3 p-4 hover:-translate-y-2 transition-all duration-300 cursor-default">
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 md:w-10 md:h-10 text-rose-400 drop-shadow-[0_0_8px_rgba(244,63,94,0.5)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                                </svg>
                                <h4 class="text-white font-bold text-sm md:text-base">Queima de Gordura</h4>
                                <p class="text-gray-400 text-xs md:text-sm">Redução de gordura visceral</p>
                            </div>
                            <div class="flex flex-col items-center text-center space-y-3 p-4 hover:-translate-y-2 transition-all duration-300 cursor-default">
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 md:w-10 md:h-10 text-rose-400 drop-shadow-[0_0_8px_rgba(244,63,94,0.5)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 4h8M8 4c0 1.1.9 2 2 2h4c1.1 0 2-.9 2-2M8 4c0-1.1.9-2 2-2h4c1.1 0 2 .9 2 2m0 0v10c0 1.1-.9 2-2 2h-4c-1.1 0-2-.9-2-2V4m8 2H8m8 4H8m0 4h8" />
                                </svg>
                                <h4 class="text-white font-bold text-sm md:text-base">Sem Fome Exacerbada</h4>
                                <p class="text-gray-400 text-xs md:text-sm">Não aumenta cortisol/fome (vs GHRP-6)</p>
                            </div>
                        </div>
                    </div>

                    <div class="space-y-4">
                        <!-- Protocolo de Dosagem -->
                        <div class="mt-8 border-t border-white/10 pt-6">
                            <h4 class="text-white font-bold mb-4 flex items-center gap-2">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-rose-400" viewBox="0 0 20 20" fill="currentColor">
                                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd" />
                                </svg>
                                Tabela de Dosagem (Seringa U-100)
                            </h4>

                            <div class="overflow-hidden rounded-xl border border-white/10 shadow-lg">
                                <div class="overflow-x-auto">
                                    <table class="w-full text-left text-sm">
                                    <thead class="bg-rose-900/20 text-rose-200 uppercase text-xs font-bold tracking-wider">
                                        <tr>
                                            <th class="px-4 py-3">Nível</th>
                                            <th class="px-4 py-3">Dose (cada composto)</th>
                                            <th class="px-4 py-3">Unidades (U-100)</th>
                                            <th class="px-4 py-3">Frequência</th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-white/5 bg-gray-900/40">
                                        <tr class="hover:bg-white/5 transition-colors">
                                            <td class="px-4 py-3 font-medium text-white">Nível 1 – Iniciante</td>
                                            <td class="px-4 py-3 text-gray-300">100 mcg</td>
                                            <td class="px-4 py-3 font-bold text-rose-400">4 Unidades</td>
                                            <td class="px-4 py-3 text-gray-300">1x ao dia (antes de dormir)</td>
                                        </tr>
                                        <tr class="hover:bg-white/5 transition-colors">
                                            <td class="px-4 py-3 font-medium text-white">Nível 2 – Glow</td>
                                            <td class="px-4 py-3 text-gray-300">150 mcg</td>
                                            <td class="px-4 py-3 font-bold text-rose-400">6 Unidades</td>
                                            <td class="px-4 py-3 text-gray-300">1x ao dia</td>
                                        </tr>
                                        <tr class="hover:bg-white/5 transition-colors">
                                            <td class="px-4 py-3 font-medium text-white">Nível 3 – Sports</td>
                                            <td class="px-4 py-3 text-gray-300">250 mcg</td>
                                            <td class="px-4 py-3 font-bold text-rose-400">10 Unidades</td>
                                            <td class="px-4 py-3 text-gray-300">Dividir em 2x ao dia (5 UI + 5 UI)</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <div class="bg-gray-900/50 border border-white/10 rounded-lg p-4">
                            <p class="text-sm text-gray-400 mb-1">Pureza Certificada</p>
                            <p class="text-rose-400 font-bold text-2xl">>99.7% (Blend Analysis)</p>
                        </div>

                        <div class="bg-gray-900/50 border border-white/10 rounded-lg p-4">
                            <p class="text-sm text-gray-400 mb-1">Aplicação</p>
                            <p class="text-white">Anti-aging, estética, perda de gordura e melhora do sono</p>
                        </div>
                    </div>

                    <a
                        href="#"
                        class="block w-full md:w-auto px-8 py-4 bg-gradient-to-r from-rose-500 to-rose-600 text-white font-bold rounded-lg hover:from-rose-400 hover:to-rose-500 transition-all duration-300 text-center shadow-lg shadow-rose-500/30 hover:shadow-xl hover:shadow-rose-500/50 active:scale-[0.98] border border-rose-400/30 hover:border-rose-400/50"
                    >
                        Encontrar Fornecedor
                    </a>
                </div>
            </div>
        </section>

        <!-- Área Técnica - Accordions -->
        <section class="max-w-4xl mx-auto">
            <h2 class="text-3xl md:text-4xl font-bold mb-8 text-center bg-clip-text text-transparent bg-gradient-to-r from-rose-400 to-rose-600">
                Informações Técnicas
            </h2>

            <div class="space-y-4">
                <!-- Accordion 1: O que é este Blend? -->
                <Accordion title="O que é este Blend?">
                    <div class="prose prose-invert max-w-none">
                        <p class="text-gray-300 mb-4">
                            Este blend contém <strong class="text-white">CJC-1295 (No DAC)</strong> combinado com <strong class="text-white">Ipamorelin</strong> em proporção 1:1 (5mg + 5mg). O uso do CJC No DAC (Mod GRF 1-29) facilita uma liberação pulsátil de GH que mimetiza a fisiologia natural.
                        </p>
                        <p class="text-gray-300 mb-4">
                            Ideal para protocolos de anti-aging, melhora da qualidade do sono e otimização da composição corporal sem aumentar a fome ou cortisol típicos de alguns GHRPs.
                        </p>
                        <div class="bg-rose-900/20 border border-rose-500/30 rounded-lg p-3 mb-4">
                            <p class="text-sm text-rose-200">
                                <strong class="text-rose-300">Diferencial Orion:</strong> Blend balanceado 5mg + 5mg em frasco único de 10mg.
                            </p>
                        </div>
                        <div class="bg-red-900/20 border border-red-500/30 p-4 rounded text-sm text-red-200">
                            <strong>Nota de Pesquisa:</strong> Este composto é destinado exclusivamente para fins de pesquisa científica e não deve ser utilizado para consumo humano ou veterinário sem aprovação regulatória adequada.
                        </div>
                        <div class="border-t border-white/10 pt-6 mt-6">
                            <h4 class="text-white font-bold mb-4">💉 Administração</h4>
                            <ul class="space-y-2 text-gray-300">
                                <li class="flex items-start gap-2">
                                    <span class="text-rose-400 font-bold">•</span>
                                    <span><strong class="text-white">Via:</strong> Subcutânea profunda.</span>
                                </li>
                                <li class="flex items-start gap-2">
                                    <span class="text-rose-400 font-bold">•</span>
                                    <span><strong class="text-white">Locais:</strong> Abdômen (5cm do umbigo), Coxa externa ou Braço posterior.</span>
                                </li>
                                <li class="flex items-start gap-2">
                                    <span class="text-rose-400 font-bold">•</span>
                                    <span><strong class="text-white">Frequência:</strong> Conforme protocolo (normalmente 1x ao dia antes de dormir).</span>
                                </li>
                                <li class="flex items-start gap-2">
                                    <span class="text-rose-400 font-bold">•</span>
                                    <span><strong class="text-white">Armazenamento:</strong> Geladeira (2°C a 8°C) após reconstituído.</span>
                                </li>
                                <li class="flex items-start gap-2">
                                    <span class="text-rose-400 font-bold">•</span>
                                    <span><strong class="text-white">Precauções:</strong> Injete lentamente; evitar misturas incompatíveis; consulte especialista se necessário.</span>
                                </li>
                            </ul>
                        </div>
                    </div>
                </Accordion>

                <!-- Accordion 2: Mecanismo de Ação -->
                <Accordion title="Mecanismo de Ação (Ciência)">
                    <div class="prose prose-invert max-w-none">
                        <p class="text-gray-300 mb-6">A combinação atua de forma sinérgica:</p>
                        <ul class="space-y-4 list-none">
                            <li class="flex gap-3">
                                <span class="text-rose-500 font-bold">CJC-1295 (No DAC):</span>
                                <span class="text-gray-400">Estimula picos pulsáteis de GH via GHRH, promovendo anabolismo e reparo sem saturação prolongada.</span>
                            </li>
                            <li class="flex gap-3">
                                <span class="text-rose-500 font-bold">Ipamorelin:</span>
                                <span class="text-gray-400">Potencia a liberação de GH via receptor de ghrelinomimético, com baixo impacto na fome e cortisol.</span>
                            </li>
                            <li class="flex gap-3">
                                <span class="text-rose-500 font-bold">Benefícios Combinados:</span>
                                <span class="text-gray-400">Melhora do sono REM, maior produção de colágeno e redução de gordura visceral.</span>
                            </li>
                        </ul>
                    </div>
                </Accordion>

                <!-- Accordion 3: Protocolo de Reconstituição -->
                <Accordion title="Protocolo de Reconstituição">
                    <div class="prose prose-invert max-w-none">
                        <div class="mb-8">
                            <h4 class="text-white font-bold mb-4">Guia de Mistura (Frasco 10mg Total)</h4>
                            <p class="text-gray-300 mb-4">Ao misturar 2ml de água no frasco de 10mg (5mg + 5mg):</p>
                            <ol class="list-decimal list-inside space-y-3 text-gray-300">
                                <li><strong class="text-white">Diluente:</strong> Utilize <strong>2ml</strong> (200 unidades) de Água Bacteriostática.</li>
                                <li><strong class="text-white">Processo:</strong> Injete a água lentamente pela parede do frasco. <strong>NÃO agite;</strong> swirl suave até dissolver.</li>
                                <li><strong class="text-white">Matemática da Mistura:</strong>
                                    <ul class="list-disc list-inside ml-4 mt-2 space-y-1">
                                        <li>5mg / 2ml = <strong>2.5mg por ml</strong> de cada composto (CJC e Ipamorelin).</li>
                                        <li>Cada <strong>10 unidades</strong> na seringa contém: <strong>250mcg de CJC</strong> + <strong>250mcg de Ipamorelin</strong>.</li>
                                    </ul>
                                </li>
                                <li>Armazene em refrigeração (2-8°C) após reconstituído.</li>
                                <li>Use dentro do prazo de validade após reconstituição.</li>
                            </ol>
                        </div>

                        <!-- Calculadora Rápida Inline -->
                        <div class="bg-gray-800/50 border border-rose-500/20 rounded-lg p-6 mt-4">
                            <h4 class="text-white font-bold mb-4 flex items-center gap-2">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-rose-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
                                </svg>
                                Calculadora Rápida (Dose por composto em mcg)
                            </h4>
                            <form id="calculadoraBlendCI" class="space-y-4">
                                <div>
                                    <label for="doseEachMcg" class="block text-sm font-medium text-gray-300 mb-2">
                                        Dose Desejada por composto (mcg)
                                    </label>
                                    <input
                                        type="number"
                                        id="doseEachMcg"
                                        step="1"
                                        min="0"
                                        value="100"
                                        placeholder="Ex: 100"
                                        required
                                        class="w-full px-4 py-2 bg-black/50 border border-white/10 rounded-lg text-white placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-rose-500 focus:border-rose-500/50 transition-all duration-300"
                                    />
                                    <p class="text-xs text-gray-500 mt-1">Ex: 100 mcg por composto = 4 unidades (U-100).</p>
                                </div>
                                <button
                                    type="submit"
                                    class="w-full md:w-auto py-3 bg-gradient-to-r from-rose-600 to-rose-500 text-white font-bold rounded-lg hover:from-rose-500 hover:to-rose-400 transition-all duration-300 shadow-lg shadow-rose-500/30 hover:shadow-xl hover:shadow-rose-500/50 active:scale-[0.98]"
                                >
                                    CALCULAR UNIDADES
                                </button>
                            </form>
                            <div id="resultadoBlendCI" class="hidden mt-4 pt-4 border-t border-white/10 relative z-50">
                                <div class="bg-rose-500/20 border border-rose-500/30 rounded-lg p-4 text-center">
                                    <p class="text-gray-400 text-xs mb-1">Unidades da Seringa (UI)</p>
                                    <p id="resultadoUIBlendCI" class="text-3xl font-bold text-rose-400">0</p>
                                    <p class="text-gray-400 text-xs mt-1">
                                        Volume por aplicação: <span id="resultadoVolumeBlendCI" class="text-rose-300">0 ml</span>
                                        <br/>
                                        Contém: <span id="resultadoCJCci" class="text-rose-300">0</span> mcg CJC + <span id="resultadoIpam" class="text-rose-300">0</span> mcg Ipamorelin
