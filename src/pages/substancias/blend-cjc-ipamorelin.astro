<script>
    // Calculadora Rápida para Blend CJC-1295 (No DAC) + Ipamorelin
    document.addEventListener('DOMContentLoaded', () => {
        const form = document.getElementById('calculadoraBlendCI') as HTMLFormElement | null;
        const resultado = document.getElementById('resultadoBlendCI');
        const resultadoUI = document.getElementById('resultadoUIBlendCI');
        const resultadoVolume = document.getElementById('resultadoVolumeBlendCI');
        const resultadoCJCci = document.getElementById('resultadoCJCci');
        const resultadoIpam = document.getElementById('resultadoIpam');

        if (!form || !resultado || !resultadoUI || !resultadoVolume || !resultadoCJCci || !resultadoIpam) {
            return;
        }

        form.addEventListener('submit', (e) => {
            e.preventDefault();

            const input = document.getElementById('doseEachMcg') as HTMLInputElement | null;
            if (!input) return;

            // Valores fixos para Blend Orion (5mg de cada em 2ml => 2.5mg/ml cada => 2500 mcg/ml)
            const frascoEachMg = 5; // mg of each compound
            const frascoEachMcg = frascoEachMg * 1000; // mcg
            const aguaMl = 2; // ml

            const doseEachMcg = parseFloat(input.value); // mcg per compound
            if (isNaN(doseEachMcg) || doseEachMcg <= 0 || doseEachMcg > frascoEachMcg) {
                alert('Por favor, insira uma dose válida em mcg para cada composto.');
                return;
            }

            // Regra: Cada 10 unidades = 250 mcg de cada composto
            // unidades = doseEachMcg / 250 * 10  => unidades = doseEachMcg / 25
            const unidades = Math.round(doseEachMcg / 25);

            // Volume (ml) por composto: doseEachMcg (mcg) / 2500 (mcg/ml)
            const volumeMl = doseEachMcg / 2500;

            resultadoUI.textContent = unidades.toFixed(0);
            resultadoVolume.textContent = `${volumeMl.toFixed(3)} ml`;
            resultadoCJCci.textContent = doseEachMcg.toFixed(0);
            resultadoIpam.textContent = doseEachMcg.toFixed(0);

            resultado.classList.remove('hidden');
            // garantir que o resultado fique visível na viewport e acima de outros elementos
            setTimeout(() => {
                try {
                    (resultado as HTMLElement).scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                } catch (err) {}
            }, 50);
        });
    });
</script>

