<style>
    /* Animação de flutuação para os ícones */
    @keyframes float {
        0%, 100% {
            transform: translateY(0px);
        }
        50% {
            transform: translateY(-8px);
        }
    }

    .animate-float {
        animation: float 3s ease-in-out infinite;
    }

    /* Transição suave para cards */
    .produto-card {
        transition: opacity 0.3s ease-in-out, transform 0.3s ease-in-out;
    }

    .produto-card.hidden {
        display: none;
    }
</style>

<script>
    // Estado da filtragem
    let categoriaAtiva = 'Todos';
    let termoBusca = '';

    // Cores por categoria (mesmo tema dos cards)
    const categoriaCores: Record<string, string[]> = {
        'Todos': ['bg-gray-600', 'border-gray-500', 'text-white', 'shadow-[0_0_15px_rgba(107,114,128,0.5)]'],
        'Emagrecimento': ['bg-amber-600', 'border-amber-500', 'text-white', 'shadow-[0_0_15px_rgba(245,158,11,0.5)]'],
        'Reparação': ['bg-emerald-600', 'border-emerald-500', 'text-white', 'shadow-[0_0_15px_rgba(16,185,129,0.5)]'],
        'Cognitivo/Nootrópicos': ['bg-cyan-600', 'border-cyan-500', 'text-white', 'shadow-[0_0_15px_rgba(6,182,212,0.5)]'],
        'Ganho Muscular': ['bg-red-600', 'border-red-500', 'text-white', 'shadow-[0_0_15px_rgba(239,68,68,0.5)]']
    };
    const classesInativas = ['bg-white/5', 'border-white/10', 'text-gray-300', 'hover:bg-white/10', 'hover:border-white/20', 'hover:text-white'];
    const todasClassesAtivas = [...new Set(Object.values(categoriaCores).flat())];

    // Selecionar elementos
    const cards = document.querySelectorAll('.produto-card');
    const botoesFiltro = document.querySelectorAll('.filtro-categoria');
    const inputBusca = document.getElementById('buscaInput') as HTMLInputElement | null;
    const mensagemSemResultados = document.getElementById('sem-resultados');

    // Função para atualizar estilo dos botões (tema de cor da categoria)
    function atualizarBotoesFiltro() {
        botoesFiltro.forEach((botao) => {
            const cat = botao.getAttribute('data-categoria');
            if (!cat) return;
            botao.classList.remove(...todasClassesAtivas, ...classesInativas);
            if (cat === categoriaAtiva) {
                botao.classList.add(...(categoriaCores[cat] || categoriaCores['Todos']));
            } else {
                botao.classList.add(...classesInativas);
            }
        });
    }

    // Função para normalizar texto (remover acentos)
    function normalizarTexto(texto: string): string {
        return texto
            .normalize('NFD')
            .replace(/[\u0300-\u036f]/g, '')
            .toLowerCase();
    }

    // Função principal de filtragem
    function filtrar() {
        let cardsVisiveis = 0;
        const termoBuscaNormalizado = normalizarTexto(termoBusca);

        cards.forEach((card) => {
            const categoriaCard = card.getAttribute('data-categoria');
            const nomeCard = card.getAttribute('data-nome') || '';
            const nomeCardNormalizado = normalizarTexto(nomeCard);
            
            // Verificar filtro de categoria
            const categoriaMatch = categoriaAtiva === 'Todos' || categoriaCard === categoriaAtiva;
            
            // Verificar filtro de busca (case-insensitive e sem acentos)
            const buscaMatch = termoBusca === '' || nomeCardNormalizado.includes(termoBuscaNormalizado);
            
            // Mostrar ou ocultar card com transição suave
            if (categoriaMatch && buscaMatch) {
                card.classList.remove('hidden');
                cardsVisiveis++;
            } else {
                card.classList.add('hidden');
            }
        });

        // Mostrar/ocultar mensagem de sem resultados
        if (mensagemSemResultados) {
            if (cardsVisiveis === 0) {
                mensagemSemResultados.classList.remove('hidden');
            } else {
                mensagemSemResultados.classList.add('hidden');
            }
        }
    }

    // Event Listeners para botões de filtro
    botoesFiltro.forEach((botao) => {
        botao.addEventListener('click', () => {
            const categoria = botao.getAttribute('data-categoria');
            if (categoria) {
                categoriaAtiva = categoria;
                atualizarBotoesFiltro();
                filtrar();
            }
        });
    });

    // Event Listener para input de busca
    if (inputBusca) {
        inputBusca.addEventListener('input', (e) => {
            const target = e.target as HTMLInputElement;
            termoBusca = target.value.trim();
            filtrar();
        });
    }

    // Inicializar no carregamento da página
    document.addEventListener('DOMContentLoaded', () => {
        atualizarBotoesFiltro();
        filtrar();
    });
</script>
