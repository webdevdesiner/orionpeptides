---

<Layout title="Catálogo | Orion Peptides">
    <Header />
    
    <main class="bg-black">
        <!-- Hero Section -->
        <section class="relative border-b border-white/10 bg-gradient-to-b from-black to-gray-900 py-16 md:py-20 overflow-hidden">
            <!-- Background Image/Media -->
            
            <!-- Imagem de Fundo -->
            <div class="absolute inset-0 z-0">
                <img 
                    src="/image/backgroundimageCatalogo.png" 
                    alt="" 
                    class="w-full h-full object-cover opacity-40"
                />
                <!-- Gradiente: mais claro nas extremidades, mais escuro no meio -->
                <div 
                    class="absolute inset-0"
                    style="background: linear-gradient(to left, rgba(255, 255, 255, 0) 0%, rgb(0, 0, 0) 50%, rgba(0, 0, 0, 0) 100%);"
                ></div>
            </div>
            
            <!-- Overlay Escuro para Legibilidade do Texto (não cobre a imagem) -->
            <div class="absolute inset-0 z-0 pointer-events-none"></div>
            
            <div class="container mx-auto px-4 relative z-10">
                <div class="text-center max-w-4xl mx-auto">
                    <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-4 tracking-tight bg-clip-text text-transparent bg-gradient-to-r from-white via-blue-200 to-gray-400">
                        Catálogo
                    </h1>
                    <p class="text-xl md:text-2xl text-gray-400 max-w-3xl mx-auto leading-relaxed">
                        Explore nossa linha completa de peptídeos de alta pureza para pesquisa.
                    </p>
                </div>
            </div>
        </section>

        <!-- Barra de Controle (Filtros e Busca) -->
        <section class="border-b border-white/10 bg-gray-900/30 backdrop-blur-sm py-6 sticky top-0 z-20">
            <div class="container mx-auto px-4">
                <div class="flex flex-col md:flex-row gap-4 items-center">
                    <!-- Input de Busca -->
                    <div class="flex-1 w-full md:w-auto">
                        <div class="relative">
                            <svg xmlns="http://www.w3.org/2000/svg" class="absolute left-4 top-1/2 -translate-y-1/2 h-5 w-5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                            </svg>
                            <input
                                type="text"
                                id="buscaInput"
                                placeholder="Buscar composto (ex: BPC-157)..."
                                class="w-full pl-12 pr-4 py-3 bg-black/50 border border-white/10 rounded-lg text-white placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500/50 transition-all duration-300"
                            />
                        </div>
                    </div>

                    <!-- Tags de Categoria -->
                    <div class="flex flex-wrap gap-2 justify-center md:justify-start">
                        {categorias.map((categoria) => (
                            <button
                                class="px-4 py-2 bg-white/5 border border-white/10 rounded-full text-sm text-gray-300 hover:bg-white/10 hover:border-white/20 hover:text-white transition-all duration-300 cursor-pointer"
                                data-categoria={categoria}
                            >
                                {categoria}
                            </button>
                        ))}
                    </div>
                </div>
            </div>
        </section>

        <!-- Grid de Laudos -->
        <section class="container mx-auto px-4 py-12 md:py-16">
            <div class="mb-12 text-center group">
                <h2 class="text-3xl md:text-4xl font-bold mb-4 bg-clip-text text-transparent bg-gradient-to-r from-white via-blue-200 to-gray-400 group-hover:from-blue-300 group-hover:via-blue-400 group-hover:to-blue-500 transition-all duration-500 drop-shadow-[0_0_20px_rgba(59,130,246,0.3)] group-hover:drop-shadow-[0_0_30px_rgba(59,130,246,0.5)]">Laudos de Controle de Qualidade</h2>
                <p class="text-gray-400 text-lg group-hover:text-gray-300 transition-colors duration-500">Documentação completa de cada lote produzido</p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                {laudos.map((laudo) => {
                    // Determinar cor da badge de categoria
                    const categoriaColors = {
                        'Peptídeo': 'bg-blue-500/20 border-blue-500/30 text-blue-300',
                        'Blend': 'bg-purple-500/20 border-purple-500/30 text-purple-300',
                        'Suprimento': 'bg-gray-500/20 border-gray-500/30 text-gray-300'
                    };
                    const categoriaColor = categoriaColors[laudo.categoria] || categoriaColors['Peptídeo'];

                    // Determinar cor do destaque
                    const destaqueColors = {
                        'Gold Standard': 'bg-gradient-to-r from-yellow-500/30 to-amber-500/30 border-yellow-500/50 text-yellow-200',
                        'Lançamento': 'bg-gradient-to-r from-green-500/30 to-emerald-500/30 border-green-500/50 text-green-200',
                        'Essencial': 'bg-gradient-to-r from-blue-500/30 to-cyan-500/30 border-blue-500/50 text-blue-200'
                    };
                    const destaqueColor = laudo.destaque ? destaqueColors[laudo.destaque] : '';

                    return (
                        <div class="bg-gray-900/50 backdrop-blur-sm border border-white/10 rounded-xl p-6 hover:border-blue-500/30 transition-all duration-300 hover:shadow-xl hover:shadow-blue-500/10 group relative">
                            <!-- Badge de Destaque (se houver) -->
                            {laudo.destaque && (
                                <div class={`absolute top-4 right-4 ${destaqueColor} border px-3 py-1 rounded-full z-10`}>
                                    <span class="text-xs font-bold uppercase tracking-wider flex items-center gap-1">
                                        {laudo.destaque === 'Gold Standard' && (
                                            <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="currentColor" viewBox="0 0 24 24">
                                                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                                            </svg>
                                        )}
                                        {laudo.destaque}
                                    </span>
                                </div>
                            )}

                            <!-- Ícone e Header -->
                            <div class="flex items-start justify-between mb-4">
                                <div class="bg-blue-500/20 p-3 rounded-lg group-hover:bg-blue-500/30 transition-colors">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                                    </svg>
                                </div>
                                <span class="text-xs text-gray-500 font-mono bg-black/30 px-2 py-1 rounded">
                                    {laudo.lote}
                                </span>
                            </div>

                            <!-- Badge de Categoria -->
                            <div class="mb-3">
                                <span class={`inline-block px-2 py-1 rounded text-xs font-semibold border ${categoriaColor}`}>
                                    {laudo.categoria}
                                </span>
                            </div>

                            <!-- Nome do Produto e Variação -->
                            <h3 class="text-xl font-bold mb-1 text-white group-hover:text-blue-400 transition-colors">
                                {laudo.nome}
                            </h3>
                            {laudo.variacao && (
                                <p class="text-sm text-gray-500 mb-2 font-medium">
                                    {laudo.variacao}
                                </p>
                            )}
                            
                            <!-- Descrição -->
                            <p class="text-sm text-gray-400 mb-4 line-clamp-2">
                                {laudo.descricao}
                            </p>

                            <!-- Pureza em Destaque -->
                            <div class="mb-4 p-4 bg-gradient-to-br from-green-500/20 to-blue-500/20 border border-green-500/30 rounded-lg relative">
                                {laudo.highPurity && (
                                    <div class="absolute top-2 right-2 flex items-center gap-1">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-yellow-400" fill="currentColor" viewBox="0 0 24 24">
                                            <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                                        </svg>
                                        <span class="text-xs text-yellow-400 font-bold">>99.8%</span>
                                    </div>
                                )}
                                <p class="text-xs text-gray-400 mb-1 uppercase tracking-wider">Pureza Certificada</p>
                                <p class="text-4xl font-bold text-green-400">
                                    {laudo.pureza}%
                                </p>
                            </div>

                            <!-- Data do Teste -->
                            <div class="flex items-center gap-2 mb-4 text-sm text-gray-400">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                </svg>
                                <span>Teste realizado em {laudo.dataTeste}</span>
                            </div>

                            <!-- Botão Ver Laudo / Guia Técnico -->
                            <a
                                href={getProductUrl(laudo.nome)}
                                class="block w-full py-3 px-4 bg-white/10 hover:bg-white/20 border border-white/20 hover:border-blue-500/50 text-white font-semibold rounded-lg transition-all duration-300 text-center group/btn"
                            >
                                <span class="flex items-center justify-center gap-2">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 group-hover/btn:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                                    </svg>
                                    Ver Guia Técnico
                                </span>
                            </a>
                        </div>
                    );
                })}
            </div>
        </section>
    </main>

    <!-- Footer -->
    <footer class="bg-black border-t border-white/10 py-8">
        <div class="container mx-auto px-4">
            <div class="text-center">
                <p class="text-gray-400 text-sm">
                    © 2026 <span class="text-white font-semibold">Orion Peptides</span>. Todos os direitos reservados.
                </p>
            </div>
        </div>
    </footer>
</Layout>

