---

<Layout title="Acervo de Moléculas | Orion Peptides">
    <Header />
    
    <main class="bg-black">
        <!-- Hero Section -->
        <section class="relative border-b border-white/10 bg-gradient-to-b from-black to-gray-900 py-16 md:py-20 overflow-x-hidden">
            <!-- Background Image/Media -->
            <div class="absolute inset-0 z-0">
                <img 
                    src="/image/backgroundimageCatalogo.png" 
                    alt="" 
                    class="w-full h-full object-cover opacity-90"
                />
                <div 
                    class="absolute inset-0"
                    style="background: linear-gradient(to left, rgba(11, 0, 31, 0.603) 0%, rgb(0, 0, 0) 50%, rgba(0, 0, 0, 0) 100%);"
                ></div>
            </div>
            
            <div class="container mx-auto px-4 relative z-10">
                <div class="text-center max-w-4xl mx-auto">
                    <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-4 tracking-tight bg-clip-text text-transparent bg-gradient-to-r from-white via-blue-200 to-gray-400 leading-tight pb-2" style="-webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">
                        Acervo de Moléculas
                    </h1>
                    <p class="text-xl md:text-2xl text-gray-400 max-w-3xl mx-auto leading-relaxed">
                        Index de compostos de alta pureza para pesquisa.
                    </p>
                </div>
            </div>
        </section>

        <!-- Barra de Controle (Filtros e Busca) -->
        <section class="border-b border-white/10 bg-gray-900/30 backdrop-blur-sm py-6 sticky top-0 z-20">
            <div class="container mx-auto px-4">
                <div class="flex flex-col md:flex-row gap-4 items-center">
                    <!-- Input de Busca -->
                    <div class="flex-1 w-full md:w-auto">
                        <div class="relative">
                            <svg xmlns="http://www.w3.org/2000/svg" class="absolute left-4 top-1/2 -translate-y-1/2 h-5 w-5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                            </svg>
                            <input
                                type="text"
                                id="buscaInput"
                                placeholder="Buscar composto (ex: BPC-157)..."
                                class="w-full pl-12 pr-4 py-3 bg-black/50 border border-white/10 rounded-lg text-white placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500/50 transition-all duration-300"
                            />
                        </div>
                    </div>

                    <!-- Tags de Categoria -->
                    <div class="flex flex-wrap gap-2 justify-center md:justify-start">
                        {categorias.map((categoria) => (
                            <button
                                class="px-4 py-2 bg-white/5 border border-white/10 rounded-full text-sm text-gray-300 hover:bg-white/10 hover:border-white/20 hover:text-white transition-all duration-300 cursor-pointer"
                                data-categoria={categoria}
                            >
                                {categoria}
                            </button>
                        ))}
                    </div>
                </div>
            </div>
        </section>

        <!-- Grid de Laudos -->
        <section class="container mx-auto px-4 py-12 md:py-16">
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                {laudos.map((laudo, index) => {
                    // Usar imagem e corGlow do laudo, ou valores padrão
                    const imagem = laudo.imagem || '/image/catalogo/default.png';
                    const corGlow = laudo.corGlow || getDefaultGlowColor(laudo.categoria);
                    
                    // Determinar cor do destaque com os mesmos efeitos da página inicial
                    const destaqueStyles: { [key: string]: { corGradiente: string; borderCor: string; borderHover: string; shadow: string; shadowHover: string; textShadow: string } } = {
                        'Gold Standard': {
                            corGradiente: 'from-yellow-900/20 to-black',
                            borderCor: 'border-yellow-500/30',
                            borderHover: 'group-hover:border-yellow-500/50',
                            shadow: 'shadow-[0_0_15px_-3px_rgba(234,179,8,0.1)]',
                            shadowHover: 'group-hover:shadow-[0_0_20px_-5px_rgba(234,179,8,0.4)]',
                            textShadow: 'drop-shadow-[0_0_4px_rgba(250,204,21,0.5)]'
                        },
                        'Lançamento': {
                            corGradiente: 'from-green-900/20 to-black',
                            borderCor: 'border-green-500/30',
                            borderHover: 'group-hover:border-green-500/50',
                            shadow: 'shadow-[0_0_15px_-3px_rgba(34,197,94,0.1)]',
                            shadowHover: 'group-hover:shadow-[0_0_20px_-5px_rgba(34,197,94,0.4)]',
                            textShadow: 'drop-shadow-[0_0_4px_rgba(74,222,128,0.5)]'
                        },
                        'Essencial': {
                            corGradiente: 'from-blue-900/20 to-black',
                            borderCor: 'border-blue-500/30',
                            borderHover: 'group-hover:border-blue-500/50',
                            shadow: 'shadow-[0_0_15px_-3px_rgba(59,130,246,0.1)]',
                            shadowHover: 'group-hover:shadow-[0_0_20px_-5px_rgba(59,130,246,0.4)]',
                            textShadow: 'drop-shadow-[0_0_4px_rgba(96,165,250,0.5)]'
                        }
                    };
                    const destaqueStyle = laudo.destaque ? destaqueStyles[laudo.destaque] : null;

                    // Determinar cor do hover baseado na cor do glow
                    const getGlowColor = (corGlow: string) => {
                        if (corGlow.includes('amber')) return 'hover:shadow-amber-500/20';
                        if (corGlow.includes('emerald')) return 'hover:shadow-emerald-500/20';
                        if (corGlow.includes('red')) return 'hover:shadow-red-500/20';
                        if (corGlow.includes('cyan')) return 'hover:shadow-cyan-500/20';
                        if (corGlow.includes('blue')) return 'hover:shadow-blue-500/20';
                        return 'hover:shadow-gray-500/20';
                    };

                    const hoverShadowColor = getGlowColor(corGlow);
                    
                    // Determinar gradiente baseado na cor
                    const getGradientColor = (corGlow: string) => {
                        if (corGlow.includes('amber')) return 'before:bg-gradient-to-b from-amber-500/5 via-transparent to-transparent';
                        if (corGlow.includes('emerald')) return 'before:bg-gradient-to-b from-emerald-500/5 via-transparent to-transparent';
                        if (corGlow.includes('red')) return 'before:bg-gradient-to-b from-red-500/5 via-transparent to-transparent';
                        if (corGlow.includes('cyan')) return 'before:bg-gradient-to-b from-cyan-500/5 via-transparent to-transparent';
                        if (corGlow.includes('blue')) return 'before:bg-gradient-to-b from-blue-500/5 via-transparent to-transparent';
                        return 'before:bg-gradient-to-b from-gray-500/5 via-transparent to-transparent';
                    };

                    const hoverGradientColor = getGradientColor(corGlow);

                    // Determinar drop-shadow baseado na cor (retorna style inline)
                    const getDropShadow = (corGlow: string) => {
                        if (corGlow.includes('amber')) return '0 0 15px rgba(245,158,11,0.5)';
                        if (corGlow.includes('emerald')) return '0 0 15px rgba(16,185,129,0.5)';
                        if (corGlow.includes('red')) return '0 0 15px rgba(239,68,68,0.5)';
                        if (corGlow.includes('cyan')) return '0 0 15px rgba(6,182,212,0.5)';
                        if (corGlow.includes('blue')) return '0 0 15px rgba(59,130,246,0.5)';
                        return '0 0 15px rgba(107,114,128,0.5)';
                    };

                    return (
                        <div 
                            class={`bg-gray-900/50 backdrop-blur-sm border border-white/10 rounded-xl p-6 hover:border-opacity-80 transition-all duration-500 hover:shadow-2xl ${hoverShadowColor} hover:-translate-y-3 group block relative overflow-visible animate-on-scroll before:absolute before:inset-0 before:rounded-xl before:opacity-0 hover:before:opacity-100 before:transition-opacity before:duration-500 ${hoverGradientColor} before:pointer-events-none`}
                            style={`animation-delay: ${index * 0.1}s;`}
                        >
                            <!-- Badge de Destaque (se houver) -->
                            {laudo.destaque && destaqueStyle && (
                                <div class={`absolute top-4 right-4 p-3 rounded-2xl bg-gradient-to-br ${destaqueStyle.corGradiente} border ${destaqueStyle.borderCor.replace('/30', '/20')} ${destaqueStyle.borderHover} ${destaqueStyle.shadow} ${destaqueStyle.shadowHover} transition-all duration-500 z-30`}>
                                    <span class={`text-xs font-bold text-white uppercase tracking-widest ${destaqueStyle.textShadow} flex items-center gap-1`}>
                                        {laudo.destaque === 'Gold Standard' && (
                                            <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="currentColor" viewBox="0 0 24 24">
                                                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                                            </svg>
                                        )}
                                        {laudo.destaque}
                                    </span>
                                </div>
                            )}

                            <!-- Ícone Bio-Futurista -->
                            <div class="flex items-center justify-center mb-6">
                                <div class="relative">
                                    <div class="absolute inset-0 bg-white/5 rounded-full blur-xl animate-pulse"></div>
                                    <div class="relative bg-white/5 rounded-full p-4 group-hover:bg-white/10 transition-colors">
                                        <img 
                                            src={imagem} 
                                            alt={laudo.nome}
                                            class="w-16 h-16 object-contain animate-float"
                                            style={`filter: drop-shadow(${getDropShadow(corGlow)});`}
                                        />
                                    </div>
                                </div>
                            </div>

                            <!-- Lote -->
                            <div class="text-center mb-4">
                                <span class="text-xs text-gray-500 font-mono bg-black/30 px-3 py-1 rounded">
                                    {laudo.lote}
                                </span>
                            </div>

                            <!-- Nome do Produto e Variação -->
                            <div class="text-center mb-3">
                                <h3 class="text-xl font-bold mb-1 text-white group-hover:text-blue-400 transition-colors">
                                    {laudo.nome}
                                </h3>
                                {laudo.variacao && (
                                    <p class="text-sm text-gray-500 font-medium">
                                        {laudo.variacao}
                                    </p>
                                )}
                            </div>
                            
                            <!-- Descrição -->
                            <p class="text-sm text-gray-400 mb-4 line-clamp-2 text-center">
                                {laudo.descricao}
                            </p>

                            <!-- Pureza em Destaque -->
                            <div class="mb-4 p-4 bg-gradient-to-br from-green-500/10 to-blue-500/10 border border-green-500/20 rounded-lg relative text-center">
                                <p class="text-xs text-gray-400 mb-1 uppercase tracking-wider">Pureza Certificada</p>
                                <p class="text-4xl font-bold text-green-400">
                                    {laudo.pureza}%
                                </p>
                                {laudo.highPurity && (
                                    <div class="absolute top-2 right-2 flex items-center gap-1">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-yellow-400" fill="currentColor" viewBox="0 0 24 24">
                                            <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                                        </svg>
                                        <span class="text-xs text-yellow-400 font-bold">>99.8%</span>
                                    </div>
                                )}
                            </div>

                            <!-- Data do Teste -->
                            <div class="flex items-center justify-center gap-2 mb-4 text-sm text-gray-400">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                </svg>
                                <span>Teste: {laudo.dataTeste}</span>
                            </div>

                            <!-- Link para Ficha Técnica -->
                            <a
                                href={getProductUrl(laudo.nome)}
                                class="block w-full py-2.5 px-4 bg-white/5 hover:bg-white/10 border border-white/10 hover:border-blue-500/30 text-white text-sm font-medium rounded-lg transition-all duration-300 text-center group/btn"
                            >
                                <span class="flex items-center justify-center gap-2">
                                    Acessar Ficha Técnica
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 group-hover/btn:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                                    </svg>
                                </span>
                            </a>
                        </div>
                    );
                })}
            </div>
        </section>
    </main>

    <!-- Footer -->
    <footer class="bg-black border-t border-white/10 py-8">
        <div class="container mx-auto px-4">
            <div class="text-center">
                <!-- USA Technology Badge -->
                <div class="flex items-center justify-center gap-2 mb-4">
                    <span class="flag-icon-footer">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" class="svg-flag-footer">
                            <g fill="none">
                                <path fill="#B22234" d="M0 0h512v512H0z"/>
                                <path fill="#FFF" d="M0 45.9h512v45.9H0zM0 137.6h512v45.9H0zM0 229.3h512v45.9H0zM0 321h512v45.9H0zM0 412.7h512v45.9H0z"/>
                                <path fill="#3C3B6E" d="M0 0h233v275.2H0z"/>
                                <g fill="#FFF">
                                    <circle cx="25" cy="25" r="10"/><circle cx="71" cy="25" r="10"/><circle cx="117" cy="25" r="10"/><circle cx="163" cy="25" r="10"/><circle cx="209" cy="25" r="10"/>
                                    <circle cx="48" cy="63" r="10"/><circle cx="94" cy="63" r="10"/><circle cx="140" cy="63" r="10"/><circle cx="186" cy="63" r="10"/>
                                    <circle cx="25" cy="101" r="10"/><circle cx="71" cy="101" r="10"/><circle cx="117" cy="101" r="10"/><circle cx="163" cy="101" r="10"/><circle cx="209" cy="101" r="10"/>
                                    <circle cx="48" cy="139" r="10"/><circle cx="94" cy="139" r="10"/><circle cx="140" cy="139" r="10"/><circle cx="186" cy="139" r="10"/>
                                    <circle cx="25" cy="177" r="10"/><circle cx="71" cy="177" r="10"/><circle cx="117" cy="177" r="10"/><circle cx="163" cy="177" r="10"/><circle cx="209" cy="177" r="10"/>
                                    <circle cx="48" cy="215" r="10"/><circle cx="94" cy="215" r="10"/><circle cx="140" cy="215" r="10"/><circle cx="186" cy="215" r="10"/>
                                    <circle cx="25" cy="253" r="10"/><circle cx="71" cy="253" r="10"/><circle cx="117" cy="253" r="10"/><circle cx="163" cy="253" r="10"/><circle cx="209" cy="253" r="10"/>
                                </g>
                            </g>
