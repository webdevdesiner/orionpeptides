---

<Layout title="Acervo de Moléculas | Orion Peptides">
    <Header />
    
    <main class="bg-black">
        <!-- Hero Section -->
        <section class="relative border-b border-white/10 bg-gradient-to-b from-black to-gray-900 py-16 md:py-20 overflow-x-hidden">
            <!-- Background Image/Media -->
            <div class="absolute inset-0 z-0">
                <img 
                    src="/image/backgroundimageCatalogo.png" 
                    alt="" 
                    class="w-full h-full object-cover opacity-90"
                />
                <div 
                    class="absolute inset-0"
                    style="background: linear-gradient(to left, rgba(11, 0, 31, 0.603) 0%, rgb(0, 0, 0) 50%, rgba(0, 0, 0, 0) 100%);"
                ></div>
            </div>
            
            <div class="container mx-auto px-4 relative z-10">
                <div class="text-center max-w-4xl mx-auto">
                    <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-4 tracking-tight bg-clip-text text-transparent bg-gradient-to-r from-white via-blue-200 to-gray-400 leading-tight pb-2" style="-webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">
                        Acervo de Moléculas
                    </h1>
                    <p class="text-xl md:text-2xl text-gray-400 max-w-3xl mx-auto leading-relaxed">
                        Index de compostos de alta pureza para pesquisa.
                    </p>
                </div>
            </div>
        </section>

        <!-- Barra de Controle (Filtros e Busca) -->
        <section class="border-b border-white/10 bg-gray-900/30 backdrop-blur-sm py-6 sticky top-0 z-20">
            <div class="container mx-auto px-4">
                <div class="flex flex-col md:flex-row gap-4 items-center">
                    <!-- Input de Busca -->
                    <div class="flex-1 w-full md:w-auto">
                        <div class="relative">
                            <svg xmlns="http://www.w3.org/2000/svg" class="absolute left-4 top-1/2 -translate-y-1/2 h-5 w-5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                            </svg>
                            <input
                                type="text"
                                id="buscaInput"
                                placeholder="Buscar composto (ex: BPC-157)..."
                                class="w-full pl-12 pr-4 py-3 bg-black/50 border border-white/10 rounded-lg text-white placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500/50 transition-all duration-300"
                            />
                        </div>
                    </div>

                    <!-- Tags de Categoria (cores por tema dos cards) -->
                    <div class="flex flex-wrap gap-2 justify-center md:justify-start">
                        {categorias.map((categoria) => (
                            <button
                                class="filtro-categoria px-4 py-2 border rounded-full text-sm transition-all duration-300 cursor-pointer bg-white/5 border-white/10 text-gray-300 hover:bg-white/10 hover:border-white/20 hover:text-white"
                                data-categoria={categoria}
                                type="button"
                            >
                                {categoria}
                            </button>
                        ))}
                    </div>
                </div>
            </div>
        </section>

        <!-- Grid de Laudos -->
        <section class="container mx-auto px-4 py-12 md:py-16">
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                {laudos.map((laudo, index) => {
                    // Usar imagem e glowColor do laudo, ou valores padrão
                    const imagem = laudo.imagem || '/image/catalogo/default.png';
                    const glowColor = laudo.glowColor || getDefaultGlowColor(laudo.categoria);
                    
                    // Determinar cor do destaque com os mesmos efeitos da página inicial
                    const destaqueStyles: { [key: string]: { corGradiente: string; borderCor: string; borderHover: string; shadow: string; shadowHover: string; textShadow: string } } = {
                        'Gold Standard': {
                            corGradiente: 'from-yellow-900/20 to-black',
                            borderCor: 'border-yellow-500/30',
                            borderHover: 'group-hover:border-yellow-500/50',
                            shadow: 'shadow-[0_0_15px_-3px_rgba(234,179,8,0.1)]',
                            shadowHover: 'group-hover:shadow-[0_0_20px_-5px_rgba(234,179,8,0.4)]',
                            textShadow: 'drop-shadow-[0_0_4px_rgba(250,204,21,0.5)]'
                        },
                        'Lançamento': {
                            corGradiente: 'from-orange-900/20 to-black',
                            borderCor: 'border-orange-500/30',
                            borderHover: 'group-hover:border-orange-500/50',
                            shadow: 'shadow-[0_0_15px_-3px_rgba(249,115,22,0.1)]',
                            shadowHover: 'group-hover:shadow-[0_0_20px_-5px_rgba(249,115,22,0.4)]',
                            textShadow: 'drop-shadow-[0_0_4px_rgba(251,146,60,0.5)]'
                        },
                        'Essencial': {
                            corGradiente: 'from-blue-900/20 to-black',
                            borderCor: 'border-blue-500/30',
                            borderHover: 'group-hover:border-blue-500/50',
                            shadow: 'shadow-[0_0_15px_-3px_rgba(59,130,246,0.1)]',
                            shadowHover: 'group-hover:shadow-[0_0_20px_-5px_rgba(59,130,246,0.4)]',
                            textShadow: 'drop-shadow-[0_0_4px_rgba(96,165,250,0.5)]'
                        }
                    };
                    const destaqueStyle = laudo.destaque ? destaqueStyles[laudo.destaque] : null;

                    // Determinar cor do hover baseado na cor do glow
                    const getGlowColor = (glowColor: string) => {
                        if (glowColor.includes('amber')) return 'hover:shadow-amber-500/20';
                        if (glowColor.includes('orange')) return 'hover:shadow-orange-500/20';
                        if (glowColor.includes('emerald')) return 'hover:shadow-emerald-500/20';
                        if (glowColor.includes('teal')) return 'hover:shadow-teal-500/20';
                        if (glowColor.includes('red')) return 'hover:shadow-red-500/20';
                        if (glowColor.includes('cyan')) return 'hover:shadow-cyan-500/20';
                        if (glowColor.includes('blue')) return 'hover:shadow-blue-300/20';
                        return 'hover:shadow-gray-500/20';
                    };

                    const hoverShadowColor = getGlowColor(glowColor);
                    
                    // Determinar gradiente baseado na cor
                    const getGradientColor = (glowColor: string) => {
                        if (glowColor.includes('amber')) return 'before:bg-gradient-to-b from-amber-500/5 via-transparent to-transparent';
                        if (glowColor.includes('orange')) return 'before:bg-gradient-to-b from-orange-500/5 via-transparent to-transparent';
                        if (glowColor.includes('emerald')) return 'before:bg-gradient-to-b from-emerald-500/5 via-transparent to-transparent';
                        if (glowColor.includes('teal')) return 'before:bg-gradient-to-b from-teal-500/5 via-transparent to-transparent';
                        if (glowColor.includes('red')) return 'before:bg-gradient-to-b from-red-500/5 via-transparent to-transparent';
                        if (glowColor.includes('cyan')) return 'before:bg-gradient-to-b from-cyan-500/5 via-transparent to-transparent';
                        if (glowColor.includes('blue')) return 'before:bg-gradient-to-b from-blue-500/5 via-transparent to-transparent';
                        return 'before:bg-gradient-to-b from-gray-500/5 via-transparent to-transparent';
                    };

                    const hoverGradientColor = getGradientColor(glowColor);

                    // Determinar drop-shadow baseado na cor (retorna style inline)
                    const getDropShadow = (glowColor: string) => {
                        if (glowColor.includes('amber')) return '0 0 15px rgba(245,158,11,0.5)';
                        if (glowColor.includes('orange')) return '0 0 15px rgba(249,115,22,0.5)';
                        if (glowColor.includes('emerald')) return '0 0 15px rgba(16,185,129,0.5)';
                        if (glowColor.includes('teal')) return '0 0 15px rgba(20,184,166,0.5)';
                        if (glowColor.includes('red')) return '0 0 15px rgba(239,68,68,0.5)';
                        if (glowColor.includes('cyan')) return '0 0 15px rgba(6,182,212,0.5)';
                        if (glowColor.includes('blue')) return '0 0 15px rgba(147,197,253,0.5)';
                        return '0 0 15px rgba(107,114,128,0.5)';
                    };

                    // Obter cores dinâmicas do produto
                    const borderColor = laudo.borderColor || 'group-hover:border-white/20';
                    const textColor = laudo.textColor || 'text-white';
                    
                    // Determinar gradiente de pureza baseado na cor do texto
                    const getPurityGradient = (textColor: string) => {
                        if (textColor.includes('amber')) return 'from-amber-500/10 to-transparent border-amber-500/20';
                        if (textColor.includes('orange')) return 'from-orange-500/10 to-transparent border-orange-500/20';
                        if (textColor.includes('emerald')) return 'from-emerald-500/10 to-transparent border-emerald-500/20';
                        if (textColor.includes('teal')) return 'from-teal-500/10 to-transparent border-teal-500/20';
                        if (textColor.includes('red')) return 'from-red-500/10 to-transparent border-red-500/20';
                        if (textColor.includes('cyan')) return 'from-cyan-500/10 to-transparent border-cyan-500/20';
                        if (textColor.includes('blue')) return 'from-blue-300/10 to-transparent border-blue-300/20';
                        return 'from-green-500/10 to-transparent border-green-500/20';
                    };
                    
                    const purityGradient = getPurityGradient(textColor);
                    
                    // Título a exibir: evita repetir a variação se já estiver no nome
                    const displayTitle = laudo.variacao && !laudo.nome.includes(laudo.variacao) ? `${laudo.nome} ${laudo.variacao}` : laudo.nome;

                    return (
                        <div 
                            class={`produto-card bg-gray-900/50 backdrop-blur-sm border border-white/10 ${borderColor} rounded-xl p-6 transition-all duration-500 hover:shadow-2xl ${hoverShadowColor} hover:-translate-y-3 group block relative overflow-visible animate-on-scroll before:absolute before:inset-0 before:rounded-xl before:opacity-0 hover:before:opacity-100 before:transition-opacity before:duration-500 ${hoverGradientColor} before:pointer-events-none`}
                            data-categoria={laudo.categoria}
                            data-nome={laudo.nome.toLowerCase()}
                            style={`animation-delay: ${index * 0.1}s;`}
                        >
                            <!-- CTA Comercial: Encontrar fornecedor (superior esquerdo) - dourado metal -->
                            <a
                                href="/contato"
                                class="absolute top-4 left-4 z-30 inline-flex flex-col items-center justify-center px-2.5 py-1.5 rounded bg-gradient-to-br from-amber-400 via-yellow-500 to-amber-600 hover:from-amber-300 hover:via-yellow-400 hover:to-amber-500 text-amber-950 text-[10px] font-bold uppercase tracking-wide shadow-md shadow-amber-500/30 hover:shadow-amber-400/50 border border-amber-300/50 hover:scale-105 active:scale-95 transition-all duration-300 leading-tight text-center"
                            >
                                <span>Encontrar</span>
                                <span>fornecedor</span>
                            </a>
                            <!-- Badge de Destaque (se houver) -->
                            {laudo.destaque && destaqueStyle && (
                                <div class={`absolute top-4 right-4 p-2 rounded-2xl bg-gradient-to-br ${destaqueStyle.corGradiente} border ${destaqueStyle.borderCor.replace('/30', '/20')} ${destaqueStyle.borderHover} ${destaqueStyle.shadow} ${destaqueStyle.shadowHover} transition-all duration-500 z-30`}>
                                    <span class={`text-[10px] font-bold text-white uppercase tracking-widest ${destaqueStyle.textShadow} flex flex-col items-center gap-0 whitespace-normal text-center leading-tight px-1 max-w-[68px]`}>
                                        {laudo.destaque === 'Gold Standard' && (
                                            <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 mb-1" fill="currentColor" viewBox="0 0 24 24">
                                                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                                            </svg>
                                        )}
                                        {laudo.destaque}
                                    </span>
                                </div>
                            )}

                            <!-- Imagem Bio-Futurista -->
                            <div class="relative w-20 h-20 rounded-full bg-white/5 flex items-center justify-center mb-4 group-hover:scale-110 transition-transform duration-500 mx-auto">
                                <img 
                                    src={imagem} 
                                    alt={laudo.nome}
                                    class="w-16 h-16 object-contain animate-float"
                                    style={`filter: drop-shadow(${getDropShadow(glowColor)});`}
                                />
                            </div>

                            <!-- Lote -->
                            <div class="text-center mb-4">
                                <span class="text-xs text-gray-500 font-mono bg-black/30 px-3 py-1 rounded">
                                    {laudo.lote}
                                </span>
                            </div>

                            <!-- Nome do Produto e Variação -->
                            <div class="text-center mb-3">
                                <h3 class={`text-xl font-bold mb-1 ${textColor} group-hover:scale-105 transition-all duration-300`}>
                                    {displayTitle}
                                </h3>
                                {/*
                                    Mantemos a exibição da variação menor caso seja necessária em futuros estilos,
                                    mas o título agora inclui automaticamente a variação (ex: "Tirzepatide 20mg").
                                */}
                                {laudo.variacao && (
                                    <p class="text-sm text-gray-500 font-medium">
                                        {laudo.variacao}
                                    </p>
                                )}
                            </div>
                            
                            <!-- Categoria Badge -->
                            <div class="text-center mb-3">
                                <span class={`text-xs font-semibold ${textColor} bg-black/40 px-3 py-1 rounded-full border ${borderColor.replace('group-hover:', '')} border-opacity-30`}>
                                    {laudo.categoria}
                                </span>
                            </div>

                            <!-- Pureza em Destaque -->
                            <div class={`mb-4 p-4 bg-gradient-to-br ${purityGradient} rounded-lg relative text-center`}>
                                <p class="text-xs text-gray-400 mb-1 uppercase tracking-wider">Pureza Certificada</p>
                                <p class={`text-4xl font-bold ${textColor}`}>
                                    {laudo.pureza}%
                                </p>
                                {laudo.highPurity && (
                                    <div class="absolute top-2 right-2 flex items-center gap-1">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-yellow-400" fill="currentColor" viewBox="0 0 24 24">
                                            <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                                        </svg>
                                        <span class="text-xs text-yellow-400 font-bold">>99.8%</span>
                                    </div>
                                )}
                            </div>

                            <!-- Data do Teste -->
                            <div class="flex items-center justify-center gap-2 mb-4 text-sm text-gray-400">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                </svg>
                                <span>Teste: {laudo.dataTeste}</span>
                            </div>

                            <!-- Link para Ficha Técnica -->
                            <a
                                href={getProductUrl(laudo.nome)}
                                class={`block w-full py-2.5 px-4 bg-white/5 hover:bg-white/10 border border-white/10 ${borderColor.replace('group-hover:', 'hover:')} ${textColor} hover:opacity-90 text-sm font-medium rounded-lg transition-all duration-300 text-center group/btn`}
                            >
                                <span class="flex items-center justify-center gap-2">
                                    Acessar Ficha Técnica
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 group-hover/btn:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                                    </svg>
                                </span>
                            </a>
                        </div>
                    );
                })}
            </div>
            
            <!-- Mensagem de Sem Resultados -->
            <div id="sem-resultados" class="hidden text-center py-16">
