// Função helper para mapear nome do produto para URL
function getProductUrl(nome: string): string {
	const urlMap: Record<string, string> = {
		'Tirzepatide': '/substancias/tirzepatide',
		'Retatrutide': '/substancias/retatrutide',
		'Semaglutide': '/substancias/semaglutide',
		'BPC-157': '/substancias/bpc-157',
		'TB-500': '/substancias/tb-500',
		'CJC-1295 + TB-500': '/substancias/blend-cjc-tb',
		'NAD+': '/substancias/nad-plus',
		'MOTS-C': '/substancias/mots-c',
		'GHK-Cu': '/substancias/ghk-cu',
		'Tesamorelin': '/substancias/tesamorelin',
		'Água Estéril': '/substancias/agua-esteril'
	};
	return urlMap[nome] || '#';
}

// Função para determinar cor de glow baseado na categoria (usado quando não especificado)
function getDefaultGlowColor(categoria: string): string {
	const glowMap: { [key: string]: string } = {
		'Peptídeo': 'shadow-blue-500/50',
		'Blend': 'shadow-purple-500/50',
		'Suprimento': 'shadow-gray-500/50'
	};
	return glowMap[categoria] || 'shadow-gray-500/50';
}

