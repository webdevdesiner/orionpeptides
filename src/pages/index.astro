---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';

// Dados dos Produtos em Destaque
const produtos = [
	{
		nome: 'Tirzepatide',
		descricao: 'Agente GLP-1/GIP de última geração.',
		link: '/substancias/tirzepatide',
		destaque: 'Ouro do momento',
		cor: 'from-yellow-500/20 to-amber-500/20',
		borderCor: 'border-yellow-500/30',
		imagem: '/produtos/tirzepatide-vial.png'
	},
	{
		nome: 'BPC-157',
		descricao: 'Pentadecapeptídeo gástrico estável.',
		link: '/substancias/bpc-157',
		destaque: 'Recuperação',
		cor: 'from-blue-500/20 to-cyan-500/20',
		borderCor: 'border-blue-500/30',
		imagem: '/produtos/bpc157-vial.png'
	},
	{
		nome: 'Retatrutide',
		descricao: 'Triplo agonista (GLP-1/GIP/Glucagon).',
		link: '/substancias/retatrutide',
		destaque: 'Inovação',
		cor: 'from-purple-500/20 to-pink-500/20',
		borderCor: 'border-purple-500/30',
		imagem: '/produtos/retatrutide-vial.png'
	}
];

// Lista de outros produtos disponíveis
const outrosProdutos = ['NAD+', 'MOTS-C', 'TB-500', 'GHK-Cu', 'Água Estéril'];

// Função helper para mapear nome do produto para URL
function getProductUrl(nome: string): string {
	const urlMap: Record<string, string> = {
		'NAD+': '/substancias/nad-plus',
		'MOTS-C': '/substancias/mots-c',
		'TB-500': '/substancias/tb-500',
		'GHK-Cu': '/substancias/ghk-cu',
		'Água Estéril': '/substancias/agua-esteril'
	};
	return urlMap[nome] || '#';
}
---

<Layout title="Orion Peptides | Biotecnologia Premium">
    <Header />
    
    <main>
        <!-- Hero Section com Vídeo de Fundo -->
        <section class="relative min-h-[85vh] flex items-center justify-center overflow-hidden">
            <!-- Vídeo de Fundo -->
            <video
                autoplay
                loop
                muted
                playsinline
                class="absolute inset-0 w-full h-full object-cover"
            >
                <source src="/video/plexus.mp4" type="video/mp4" />
            </video>
            
            <!-- Overlay Escuro -->
            <div class="absolute inset-0 bg-black/70"></div>
            
            <!-- Conteúdo Centralizado -->
            <div class="relative z-10 text-center px-4 max-w-5xl mx-auto">
                <h1 class="text-5xl md:text-7xl lg:text-8xl font-bold mb-6 tracking-tight font-['Inter']">
                    Redefinindo o <span class="bg-clip-text text-transparent bg-gradient-to-r from-blue-400 to-blue-600">Potencial Humano</span>
                </h1>
                <p class="text-xl md:text-2xl text-gray-300 max-w-3xl mx-auto mb-12 leading-relaxed">
                    Peptídeos de precisão: Tirzepatide, Retatrutide e Protocolos de Longevidade.
                </p>
                
                <!-- Botões CTA -->
                <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
                    <a
                        href="/calculadora"
                        class="px-8 py-4 bg-white text-black font-bold rounded-lg hover:bg-gray-200 transition-all duration-300 shadow-lg hover:shadow-xl active:scale-[0.98] text-lg"
                    >
                        Calcular Protocolo
                    </a>
                    <a
                        href="/ciencia"
                        class="px-8 py-4 border-2 border-white/30 text-white font-bold rounded-lg hover:bg-white/10 hover:border-white/50 transition-all duration-300 text-lg"
                    >
                        Ver Catálogo Completo
                    </a>
                </div>
            </div>
        </section>

        <!-- Trust Bar (Barra de Confiança) -->
        <section class="bg-black border-b border-white/10 py-8">
            <div class="container mx-auto px-4">
                <div class="flex flex-wrap justify-center items-center gap-8 md:gap-12 lg:gap-16">
                    <!-- Pureza HPLC >99% -->
                    <div class="flex items-center gap-3">
                        <div class="bg-green-500/20 p-2 rounded-lg">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-green-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                        </div>
                        <div>
                            <p class="text-sm text-gray-400 uppercase tracking-wider">Pureza HPLC</p>
                            <p class="text-lg font-bold text-white">>99%</p>
                        </div>
                    </div>

                    <!-- Tecnologia USA -->
                    <div class="flex items-center gap-3">
                        <div class="bg-blue-500/20 p-2 rounded-lg">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
                            </svg>
                        </div>
                        <div>
                            <p class="text-sm text-gray-400 uppercase tracking-wider">Tecnologia</p>
                            <p class="text-lg font-bold text-white">USA</p>
                        </div>
                    </div>

                    <!-- Liofilização Estéril -->
                    <div class="flex items-center gap-3">
                        <div class="bg-purple-500/20 p-2 rounded-lg">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-purple-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                            </svg>
                        </div>
                        <div>
                            <p class="text-sm text-gray-400 uppercase tracking-wider">Liofilização</p>
                            <p class="text-lg font-bold text-white">Estéril</p>
                        </div>
                    </div>

                    <!-- Suporte Técnico -->
                    <div class="flex items-center gap-3">
                        <div class="bg-yellow-500/20 p-2 rounded-lg">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-yellow-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z" />
                            </svg>
                        </div>
                        <div>
                            <p class="text-sm text-gray-400 uppercase tracking-wider">Suporte</p>
                            <p class="text-lg font-bold text-white">Técnico</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Seção Pesquisa Avançada -->
        <section id="produtos" class="container mx-auto px-4 py-16 md:py-24 scroll-mt-20 animate-on-scroll">
            <div class="text-center mb-12">
                <h2 class="text-4xl md:text-5xl font-bold mb-4 bg-clip-text text-transparent bg-gradient-to-r from-white to-gray-400">
                    Substâncias em Evidência
                </h2>
                <p class="text-gray-400 text-lg max-w-2xl mx-auto">
                    Produtos de ponta para pesquisa avançada em longevidade e performance
                </p>
            </div>

            <!-- Grid de Cards -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8">
                {produtos.map((produto, index) => (
                    <a
                        href={produto.link}
                        class={`bg-gray-900 border ${produto.borderCor} rounded-xl p-6 pt-20 hover:border-opacity-60 transition-all duration-500 hover:shadow-xl hover:shadow-blue-500/10 hover:-translate-y-2 group block relative overflow-visible animate-on-scroll`}
                        style={`animation-delay: ${index * 0.1}s;`}
                    >
                        <!-- Badge de Destaque -->
                        <div class={`absolute top-4 right-4 bg-gradient-to-r ${produto.cor} border ${produto.borderCor} px-3 py-1 rounded-full z-20`}>
                            <span class="text-xs font-bold text-white uppercase tracking-wider">
                                {produto.destaque}
                            </span>
                        </div>

                        <!-- Conteúdo do Card -->
                        <div class="relative z-10">
                            <!-- Nome do Produto -->
                            <h3 class="text-3xl md:text-4xl font-bold mb-2 text-white group-hover:text-blue-400 transition-colors">
                                {produto.nome}
                            </h3>
                            <p class="text-lg text-gray-300 mb-4">
                                {produto.descricao}
                            </p>
                        </div>

                        <!-- Botão -->
                        <div class="w-full py-3 px-4 bg-white/10 hover:bg-white/20 border border-white/20 hover:border-blue-500/50 text-white font-semibold rounded-lg transition-all duration-300 text-center group/btn">
                            <span class="flex items-center justify-center gap-2">
                                Ver Detalhes
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 group-hover/btn:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                                </svg>
                            </span>
                        </div>
                    </a>
                ))}
            </div>

            <!-- Lista Rápida de Outros Produtos -->
            <div class="mt-16 text-center">
                <div class="bg-gray-900/50 border border-white/10 rounded-xl p-6 md:p-8 max-w-3xl mx-auto">
                    <p class="text-gray-400 mb-4 text-sm uppercase tracking-wider">
                        Também disponíveis:
                    </p>
                    <div class="flex flex-wrap justify-center items-center gap-3 md:gap-4">
                        {outrosProdutos.map((produto) => (
                            <a
                                href={getProductUrl(produto)}
                                class="px-4 py-2 bg-black/50 border border-white/10 rounded-lg text-white text-sm font-medium hover:border-blue-500/50 hover:bg-blue-500/10 transition-all duration-300 cursor-pointer"
                            >
                                {produto}
                            </a>
                        ))}
                    </div>
                </div>
            </div>
        </section>
    </main>

    <!-- Footer -->
    <footer class="bg-black border-t border-white/10 py-8">
        <div class="container mx-auto px-4">
            <div class="text-center">
                <p class="text-gray-400 text-sm">
                    © 2026 <span class="text-white font-semibold">Orion Peptides</span>. Todos os direitos reservados.
                </p>
            </div>
        </div>
    </footer>
</Layout>