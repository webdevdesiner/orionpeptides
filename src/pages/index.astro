---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';

// Dados dos Produtos em Destaque
const produtos = [
	{
		nome: 'Tirzepatide',
		descricao: 'Agente GLP-1/GIP de última geração.',
		link: '/substancias/tirzepatide',
		destaque: 'Ouro do momento',
		cor: 'from-yellow-500/20 to-amber-500/20',
		corGradiente: 'from-yellow-900/20 to-black',
		borderCor: 'border-yellow-500/30',
		borderHover: 'group-hover:border-yellow-500/50',
		shadow: 'shadow-[0_0_15px_-3px_rgba(234,179,8,0.1)]',
		shadowHover: 'group-hover:shadow-[0_0_20px_-5px_rgba(234,179,8,0.4)]',
		textShadow: 'drop-shadow-[0_0_4px_rgba(250,204,21,0.5)]',
		imagem: '/produtos/tirzepatide-vial.png'
	},
	{
		nome: 'BPC-157',
		descricao: 'Pentadecapeptídeo gástrico estável.',
		link: '/substancias/bpc-157',
		destaque: 'Recuperação',
		cor: 'from-blue-500/20 to-cyan-500/20',
		corGradiente: 'from-blue-900/20 to-black',
		borderCor: 'border-blue-500/30',
		borderHover: 'group-hover:border-blue-500/50',
		shadow: 'shadow-[0_0_15px_-3px_rgba(59,130,246,0.1)]',
		shadowHover: 'group-hover:shadow-[0_0_20px_-5px_rgba(59,130,246,0.4)]',
		textShadow: 'drop-shadow-[0_0_4px_rgba(96,165,250,0.5)]',
		imagem: '/produtos/bpc157-vial.png'
	},
	{
		nome: 'Retatrutide',
		descricao: 'Triplo agonista (GLP-1/GIP/Glucagon).',
		link: '/substancias/retatrutide',
		destaque: 'Inovação',
		cor: 'from-purple-500/20 to-pink-500/20',
		corGradiente: 'from-purple-900/20 to-black',
		borderCor: 'border-purple-500/30',
		borderHover: 'group-hover:border-purple-500/50',
		shadow: 'shadow-[0_0_15px_-3px_rgba(168,85,247,0.1)]',
		shadowHover: 'group-hover:shadow-[0_0_20px_-5px_rgba(168,85,247,0.4)]',
		textShadow: 'drop-shadow-[0_0_4px_rgba(192,132,252,0.5)]',
		imagem: '/produtos/retatrutide-vial.png'
	}
];

// Lista de outros produtos disponíveis
const outrosProdutos = ['NAD+', 'MOTS-C', 'TB-500', 'GHK-Cu', 'Água Estéril'];

// Função helper para mapear nome do produto para URL
function getProductUrl(nome: string): string {
	const urlMap: Record<string, string> = {
		'NAD+': '/substancias/nad-plus',
		'MOTS-C': '/substancias/mots-c',
		'TB-500': '/substancias/tb-500',
		'GHK-Cu': '/substancias/ghk-cu',
		'Água Estéril': '/substancias/agua-esteril'
	};
	return urlMap[nome] || '#';
}
---

<Layout title="Orion Peptides | Biotecnologia Premium">
    <Header />
    
    <main>
        <!-- Hero Section com Vídeo de Fundo -->
        <section class="relative min-h-[85vh] flex items-center justify-center overflow-hidden">
            <!-- Vídeo de Fundo -->
            <video
                autoplay
                loop
                muted
                playsinline
                class="absolute inset-0 w-full h-full object-cover"
            >
                <source src="/video/plexus.mp4" type="video/mp4" />
            </video>
            
            <!-- Conteúdo Centralizado com Card Glass Clean -->
            <div class="relative z-10 text-center px-4 max-w-5xl mx-auto">
                <div class="backdrop-blur-sm bg-black/40 rounded-3xl p-8 md:p-12 border border-white/10 shadow-2xl">
                    <!-- Logo com efeito de brilho -->
                    <img src="/logo.png" alt="Logo Orion" class="hero-logo" />
                    
                    <h1 class="text-5xl md:text-7xl lg:text-8xl font-bold mb-6 tracking-tight font-['Inter']">
                        Redefinindo o <span class="bg-clip-text text-transparent bg-gradient-to-r from-[#a77c33] via-[#e4a231] to-[#e4a52f]">Potencial Humano</span>
                    </h1>
                    <p class="text-xl md:text-2xl text-white max-w-3xl mx-auto mb-12 leading-relaxed drop-shadow-lg">
                        Peptídeos de precisão: Tirzepatide, Retatrutide e Protocolos de Longevidade.
                    </p>
                    
                    <!-- Botões CTA -->
                    <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
                        <a
                            href="/calculadora"
                            class="px-8 py-4 bg-white text-black font-bold rounded-lg hover:bg-gray-200 transition-all duration-300 shadow-lg hover:shadow-xl active:scale-[0.98] text-lg"
                        >
                            Calcular Protocolo
                        </a>
                        <a
                            href="/ciencia"
                            class="px-8 py-4 border-2 border-white/30 text-white font-bold rounded-lg hover:bg-white/10 hover:border-white/50 transition-all duration-300 text-lg backdrop-blur-sm"
                        >
                            Ver Catálogo Completo
                        </a>
                    </div>
                </div>
            </div>
        </section>

        <!-- Trust Bar (Barra de Confiança) -->
        <section class="relative bg-black border-b border-white/5 py-10 z-20 overflow-hidden">
            <div class="absolute inset-0 bg-gradient-to-r from-blue-900/5 via-transparent to-blue-900/5 pointer-events-none"></div>
            
            <div class="container mx-auto px-4 relative z-10">
                <div class="grid grid-cols-2 md:grid-cols-4 gap-6 md:gap-12">
                    <!-- Pureza HPLC >99% -->
                    <div class="flex flex-col md:flex-row items-center md:items-start gap-4 text-center md:text-left group cursor-default">
                        <div class="relative p-3 rounded-2xl bg-gradient-to-br from-green-900/20 to-black border border-green-500/20 group-hover:border-green-500/50 shadow-[0_0_15px_-3px_rgba(34,197,94,0.1)] group-hover:shadow-[0_0_20px_-5px_rgba(34,197,94,0.4)] transition-all duration-500">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-green-400 drop-shadow-[0_0_8px_rgba(74,222,128,0.5)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                        </div>
                        <div class="flex flex-col justify-center">
                            <p class="text-[10px] md:text-xs text-green-400/80 font-bold uppercase tracking-widest mb-1">Pureza HPLC</p>
                            <p class="text-xl md:text-2xl font-bold text-white tracking-tight group-hover:text-green-100 transition-colors">>99%</p>
                        </div>
                    </div>

                    <!-- Tecnologia USA -->
                    <div class="flex flex-col md:flex-row items-center md:items-start gap-4 text-center md:text-left group cursor-default">
                        <div class="relative p-3 rounded-2xl bg-gradient-to-br from-blue-900/20 to-black border border-blue-500/20 group-hover:border-blue-500/50 shadow-[0_0_15px_-3px_rgba(59,130,246,0.1)] group-hover:shadow-[0_0_20px_-5px_rgba(59,130,246,0.4)] transition-all duration-500">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-blue-400 drop-shadow-[0_0_8px_rgba(96,165,250,0.5)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
                            </svg>
                        </div>
                        <div class="flex flex-col justify-center">
                            <p class="text-[10px] md:text-xs text-blue-400/80 font-bold uppercase tracking-widest mb-1">Tecnologia</p>
                            <p class="text-xl md:text-2xl font-bold text-white tracking-tight group-hover:text-blue-100 transition-colors">USA</p>
                        </div>
                    </div>

                    <!-- Liofilização Estéril -->
                    <div class="flex flex-col md:flex-row items-center md:items-start gap-4 text-center md:text-left group cursor-default">
                        <div class="relative p-3 rounded-2xl bg-gradient-to-br from-purple-900/20 to-black border border-purple-500/20 group-hover:border-purple-500/50 shadow-[0_0_15px_-3px_rgba(168,85,247,0.1)] group-hover:shadow-[0_0_20px_-5px_rgba(168,85,247,0.4)] transition-all duration-500">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-purple-400 drop-shadow-[0_0_8px_rgba(192,132,252,0.5)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                            </svg>
                        </div>
                        <div class="flex flex-col justify-center">
                            <p class="text-[10px] md:text-xs text-purple-400/80 font-bold uppercase tracking-widest mb-1">Liofilização</p>
                            <p class="text-xl md:text-2xl font-bold text-white tracking-tight group-hover:text-purple-100 transition-colors">Estéril</p>
                        </div>
                    </div>

                    <!-- Suporte Técnico -->
                    <div class="flex flex-col md:flex-row items-center md:items-start gap-4 text-center md:text-left group cursor-default">
                        <div class="relative p-3 rounded-2xl bg-gradient-to-br from-yellow-900/20 to-black border border-yellow-500/20 group-hover:border-yellow-500/50 shadow-[0_0_15px_-3px_rgba(234,179,8,0.1)] group-hover:shadow-[0_0_20px_-5px_rgba(234,179,8,0.4)] transition-all duration-500">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-yellow-400 drop-shadow-[0_0_8px_rgba(250,204,21,0.5)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z" />
                            </svg>
                        </div>
                        <div class="flex flex-col justify-center">
                            <p class="text-[10px] md:text-xs text-yellow-400/80 font-bold uppercase tracking-widest mb-1">Suporte</p>
                            <p class="text-xl md:text-2xl font-bold text-white tracking-tight group-hover:text-yellow-100 transition-colors">Técnico</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Seção Pesquisa Avançada -->
        <section id="produtos" class="container mx-auto px-4 py-16 md:py-24 scroll-mt-20 animate-on-scroll">
            <div class="text-center mb-16 md:mb-20 group">
                <h2 class="text-4xl md:text-5xl font-bold mb-4 bg-clip-text text-transparent bg-gradient-to-r from-white via-blue-200 to-gray-400 group-hover:from-blue-300 group-hover:via-blue-400 group-hover:to-blue-500 transition-all duration-500 drop-shadow-[0_0_20px_rgba(59,130,246,0.3)] group-hover:drop-shadow-[0_0_30px_rgba(59,130,246,0.5)]">
                    Substâncias em Evidência
                </h2>
                <p class="text-gray-400 text-lg max-w-2xl mx-auto group-hover:text-gray-300 transition-colors duration-500">
                    Produtos de ponta para pesquisa avançada em longevidade e performance
                </p>
            </div>

            <!-- Grid de Cards -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8">
                {produtos.map((produto, index) => (
                    <a
                        href={produto.link}
                        class={`bg-gray-900 border ${produto.borderCor} rounded-xl p-6 pt-20 md:pt-24 hover:border-opacity-80 transition-all duration-500 hover:shadow-2xl ${index === 0 ? 'hover:shadow-yellow-500/20' : index === 1 ? 'hover:shadow-blue-500/20' : 'hover:shadow-purple-500/20'} hover:-translate-y-3 group block relative overflow-visible animate-on-scroll before:absolute before:inset-0 before:rounded-xl before:opacity-0 hover:before:opacity-100 before:transition-opacity before:duration-500 ${index === 0 ? 'before:bg-gradient-to-b from-yellow-500/5 via-transparent to-transparent' : index === 1 ? 'before:bg-gradient-to-b from-blue-500/5 via-transparent to-transparent' : 'before:bg-gradient-to-b from-purple-500/5 via-transparent to-transparent'} before:pointer-events-none`}
                        style={`animation-delay: ${index * 0.1}s;`}
                    >
                        <!-- Imagem do Produto (Glass) -->
                        <img
                            src="/image/glass.png"
                            alt={produto.nome}
                            class="absolute -top-8 md:-top-12 left-4 bottom-0 h-[280px] w-auto md:h-[320px] z-[5] object-contain"
                        />

                        <!-- Badge de Destaque -->
                        <div class={`absolute top-4 right-4 p-3 rounded-2xl bg-gradient-to-br ${produto.corGradiente} border ${produto.borderCor.replace('/30', '/20')} ${produto.borderHover} ${produto.shadow} ${produto.shadowHover} transition-all duration-500 z-30`}>
                            <span class={`text-xs font-bold text-white uppercase tracking-widest ${produto.textShadow}`}>
                                {produto.destaque}
                            </span>
                        </div>

                        <!-- Conteúdo do Card -->
                        <div class="relative z-10 ml-28 md:ml-36 text-right">
                            <!-- Nome do Produto -->
                            <h3 class="text-3xl md:text-4xl font-bold mb-2 text-white group-hover:text-blue-400 transition-colors">
                                {produto.nome}
                            </h3>
                            <p class="text-lg text-gray-300 mb-4">
                                {produto.descricao}
                            </p>
                        </div>

                        <!-- Botão -->
                        <div class="relative z-20 w-full py-3 px-4 bg-white/10 hover:bg-white/20 border border-white/20 hover:border-blue-500/50 text-white font-semibold rounded-lg transition-all duration-300 text-center group/btn mt-4">
                            <span class="flex items-center justify-center gap-2">
                                Ver Detalhes
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 group-hover/btn:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                                </svg>
                            </span>
                        </div>
                    </a>
                ))}
            </div>

            <!-- Lista Rápida de Outros Produtos -->
            <div class="mt-16 text-center">
                <div class="bg-gray-900/50 border border-white/10 rounded-xl p-6 md:p-8 max-w-3xl mx-auto">
                    <p class="text-gray-400 mb-4 text-sm uppercase tracking-wider">
                        Também disponíveis:
                    </p>
                    <div class="flex flex-wrap justify-center items-center gap-3 md:gap-4">
                        {outrosProdutos.map((produto) => (
                            <a
                                href={getProductUrl(produto)}
                                class="px-4 py-2 bg-black/50 border border-white/10 rounded-lg text-white text-sm font-medium hover:border-blue-500/50 hover:bg-blue-500/10 transition-all duration-300 cursor-pointer"
                            >
                                {produto}
                            </a>
                        ))}
                    </div>
                </div>
            </div>
        </section>
    </main>

    <!-- Footer -->
    <footer class="bg-black border-t border-white/10 py-8">
        <div class="container mx-auto px-4">
            <div class="text-center">
                <!-- USA Technology Badge -->
                <div class="flex items-center justify-center gap-2 mb-4">
                    <span class="flag-icon-footer">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" class="svg-flag-footer">
                            <g fill="none">
                                <path fill="#B22234" d="M0 0h512v512H0z"/>
                                <path fill="#FFF" d="M0 45.9h512v45.9H0zM0 137.6h512v45.9H0zM0 229.3h512v45.9H0zM0 321h512v45.9H0zM0 412.7h512v45.9H0z"/>
                                <path fill="#3C3B6E" d="M0 0h233v275.2H0z"/>
                                <g fill="#FFF">
                                    <circle cx="25" cy="25" r="10"/><circle cx="71" cy="25" r="10"/><circle cx="117" cy="25" r="10"/><circle cx="163" cy="25" r="10"/><circle cx="209" cy="25" r="10"/>
                                    <circle cx="48" cy="63" r="10"/><circle cx="94" cy="63" r="10"/><circle cx="140" cy="63" r="10"/><circle cx="186" cy="63" r="10"/>
                                    <circle cx="25" cy="101" r="10"/><circle cx="71" cy="101" r="10"/><circle cx="117" cy="101" r="10"/><circle cx="163" cy="101" r="10"/><circle cx="209" cy="101" r="10"/>
                                    <circle cx="48" cy="139" r="10"/><circle cx="94" cy="139" r="10"/><circle cx="140" cy="139" r="10"/><circle cx="186" cy="139" r="10"/>
                                    <circle cx="25" cy="177" r="10"/><circle cx="71" cy="177" r="10"/><circle cx="117" cy="177" r="10"/><circle cx="163" cy="177" r="10"/><circle cx="209" cy="177" r="10"/>
                                    <circle cx="48" cy="215" r="10"/><circle cx="94" cy="215" r="10"/><circle cx="140" cy="215" r="10"/><circle cx="186" cy="215" r="10"/>
                                    <circle cx="25" cy="253" r="10"/><circle cx="71" cy="253" r="10"/><circle cx="117" cy="253" r="10"/><circle cx="163" cy="253" r="10"/><circle cx="209" cy="253" r="10"/>
                                </g>
                            </g>
                        </svg>
                    </span>
                    <span class="text-white font-medium text-sm md:text-base">USA Technology</span>
                </div>
                
                <p class="text-gray-400 text-sm">
                    © 2015 <span class="text-white font-semibold">Orion Peptides</span>. Todos os direitos reservados.
                </p>
            </div>
        </div>
    </footer>
</Layout>

<style>
    /* Logo com efeito de brilho animado */
    .hero-logo {
        max-width: clamp(120px, 15vw, 200px);
        width: 100%;
        height: auto;
        margin: 0 auto clamp(1rem, 3vh, 2rem);
        display: block;
        filter: brightness(1.1) drop-shadow(0 0 10px rgba(255, 255, 255, 0.3)) drop-shadow(0 0 20px rgba(255, 255, 255, 0.2));
        transition: transform 0.3s ease, filter 0.3s ease;
        animation: logoGlow 3s ease-in-out infinite;
        position: relative;
    }

    @keyframes logoGlow {
        0%, 100% {
            filter: brightness(1.1) drop-shadow(0 0 10px rgba(255, 255, 255, 0.3)) drop-shadow(0 0 20px rgba(255, 255, 255, 0.2));
        }
        50% {
            filter: brightness(1.2) drop-shadow(0 0 15px rgba(255, 255, 255, 0.5)) drop-shadow(0 0 30px rgba(255, 255, 255, 0.4)) drop-shadow(0 0 40px rgba(255, 255, 255, 0.2));
        }
    }

    .hero-logo:hover {
        transform: scale(1.05);
        filter: brightness(1.3) drop-shadow(0 0 20px rgba(255, 255, 255, 0.6)) drop-shadow(0 0 40px rgba(255, 255, 255, 0.5)) drop-shadow(0 0 60px rgba(255, 255, 255, 0.3));
    }

    /* Footer USA Technology Badge */
    .flag-icon-footer {
        display: inline-block;
        vertical-align: middle;
        width: 1.5rem;
        height: auto;
    }

    .flag-icon-footer .svg-flag-footer {
        width: 100%;
        height: auto;
        display: block;
    }
</style>