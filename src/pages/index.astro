---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';

// Dados dos Produtos em Destaque (cores e neo iguais ao catálogo)
const produtos = [
	{
		nome: 'Tirzepatide',
		descricao: 'Agente GLP-1/GIP de última geração.',
		link: '/substancias/tirzepatide',
		destaque: 'Gold Standard',
		corGradiente: 'from-yellow-900/20 to-black',
		borderCor: 'border-yellow-500/30',
		borderHover: 'group-hover:border-amber-500/50',
		shadow: 'shadow-[0_0_15px_-3px_rgba(234,179,8,0.1)]',
		shadowHover: 'group-hover:shadow-[0_0_20px_-5px_rgba(234,179,8,0.4)]',
		textShadow: 'drop-shadow-[0_0_4px_rgba(250,204,21,0.5)]',
		imagem: '/image/catalogo/tirzepatide.png',
		imagemCard: '/image/produtos/TIRZEPATIDE-card.png',
		glowColor: 'amber',
		dropShadow: '0 0 15px rgba(245,158,11,0.5)',
		hoverShadow: 'hover:shadow-amber-500/20',
		gradientOverlay: 'before:bg-gradient-to-b from-amber-500/5 via-transparent to-transparent',
		textColor: 'text-amber-400'
	},
	{
		nome: 'BPC-157 + TB-500',
		descricao: 'Blend Wolverine para recuperação de lesões e suporte articular.',
		link: '/substancias/blend-bpc-tb',
		destaque: 'Wolverine',
		corGradiente: 'from-emerald-900/20 to-black',
		borderCor: 'border-emerald-500/30',
		borderHover: 'group-hover:border-emerald-500/50',
		shadow: 'shadow-[0_0_15px_-3px_rgba(16,185,129,0.1)]',
		shadowHover: 'group-hover:shadow-[0_0_20px_-5px_rgba(16,185,129,0.4)]',
		textShadow: 'drop-shadow-[0_0_4px_rgba(16,185,129,0.5)]',
		imagem: '/image/catalogo/bpc-157.png',
		imagemCard: '/image/produtos/iniciobpc-157-tb-500.png',
		glowColor: 'emerald',
		dropShadow: '0 0 15px rgba(16,185,129,0.5)',
		hoverShadow: 'hover:shadow-emerald-500/20',
		gradientOverlay: 'before:bg-gradient-to-b from-emerald-500/5 via-transparent to-transparent',
		textColor: 'text-emerald-400'
	},
	{
		nome: 'Retatrutide',
		descricao: 'Triplo agonista (GLP-1/GIP/Glucagon).',
		link: '/substancias/retatrutide',
		destaque: 'Lançamento',
		corGradiente: 'from-orange-900/20 to-black',
		borderCor: 'border-orange-500/30',
		borderHover: 'group-hover:border-orange-500/50',
		shadow: 'shadow-[0_0_15px_-3px_rgba(249,115,22,0.1)]',
		shadowHover: 'group-hover:shadow-[0_0_20px_-5px_rgba(249,115,22,0.4)]',
		textShadow: 'drop-shadow-[0_0_4px_rgba(251,146,60,0.5)]',
		imagem: '/image/catalogo/retatrutide.png',
		imagemCard: '/image/produtos/RETRATUTIDE-card.png',
		glowColor: 'orange',
		dropShadow: '0 0 15px rgba(249,115,22,0.5)',
		hoverShadow: 'hover:shadow-orange-500/20',
		gradientOverlay: 'before:bg-gradient-to-b from-orange-500/5 via-transparent to-transparent',
		textColor: 'text-orange-400'
	}
];

// Lista de outros produtos disponíveis
const outrosProdutos = ['NAD+', 'MOTS-C', 'TB-500', 'GHK-Cu', 'Água Estéril'];

// Função helper para mapear nome do produto para URL
function getProductUrl(nome: string): string {
	const urlMap: Record<string, string> = {
		'NAD+': '/substancias/nad-plus',
		'MOTS-C': '/substancias/mots-c',
		'TB-500': '/substancias/tb-500',
		'GHK-Cu': '/substancias/ghk-cu',
		'Água Estéril': '/substancias/agua-esteril',
		'BPC-157 + TB-500': '/substancias/blend-bpc-tb',
		'CJC-1295 + Ipamorelin': '/substancias/blend-cjc-ipamorelin'
	};
	return urlMap[nome] || '#';
}
---

<Layout title="Orion Peptides | Biotecnologia Premium">
    <Header />
    
    <main class="bg-black">
        <!-- Hero Section com Vídeo de Fundo (efeitos iguais ao catálogo) -->
        <section class="relative min-h-[85vh] flex items-center justify-center overflow-hidden border-b border-white/10">
            <!-- Vídeo de Fundo -->
            <video
                autoplay
                loop
                muted
                playsinline
                class="absolute inset-0 w-full h-full object-cover"
            >
                <source src="/video/plexus.mp4" type="video/mp4" />
            </video>
            <!-- Overlay estilo catálogo -->
            <div class="absolute inset-0 z-0 bg-gradient-to-b from-black/60 via-black/40 to-black/70" aria-hidden="true"></div>
            
            <!-- Conteúdo Centralizado com Card Glass (neo/glow catálogo) -->
            <div class="relative z-10 text-center px-8 md:px-12 lg:px-16 max-w-4xl mx-auto">
                <div class="backdrop-blur-sm rounded-3xl p-6 md:p-8 lg:p-10 border border-white/10 hover:shadow-[0_0_50px_rgba(59,130,246,0.2)] hover:border-blue-500/20 transition-all duration-500"
                     style="background-color: rgba(0,0,0,0.171); box-shadow: 0 8px 32px rgba(0,0,0,0.5); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px);">
                    <!-- Logo com efeito de brilho -->
                    <img src="/logo.png" alt="Logo Orion" class="hero-logo" />
                    
                    <h1 class="text-3xl md:text-5xl lg:text-6xl font-bold mb-5 tracking-tight font-['Inter'] drop-shadow-[0_0_24px_rgba(59,130,246,0.3)]">
                        <span class="bg-clip-text text-transparent bg-gradient-to-r from-white via-blue-200 to-gray-400" style="-webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">Redefinindo o </span>
                        <span class="bg-clip-text text-transparent bg-gradient-to-r from-[#a77c33] via-[#e4a231] to-[#e4a52f]" style="-webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">Potencial Humano</span>
                    </h1>
                    <p class="text-lg md:text-xl text-gray-300 max-w-2xl mx-auto mb-10 leading-relaxed">
                        Peptídeos de precisão: Tirzepatide, Retatrutide e Protocolos de Longevidade.
                    </p>
                    
                    <!-- Botões CTA (focus ring estilo catálogo) -->
                    <div class="flex flex-col sm:flex-row gap-3 justify-center items-center">
                        <a
                            href="/calculadora"
                            class="px-6 py-3 bg-white text-black font-bold rounded-lg hover:bg-gray-200 transition-all duration-300 shadow-lg hover:shadow-xl hover:shadow-blue-500/20 active:scale-[0.98] text-base focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 focus:ring-offset-black"
                        >
                            Calcular Protocolo
                        </a>
                        <a
                            href="/catalogo"
                            class="px-6 py-3 border-2 border-white/30 text-white font-bold rounded-lg hover:bg-white/10 hover:border-blue-500/50 transition-all duration-300 text-base backdrop-blur-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 focus:ring-offset-black"
                        >
                            Ver Catálogo Completo
                        </a>
                    </div>
                </div>
            </div>
        </section>

        <!-- Trust Bar (Barra de Confiança - bordas e neon iguais ao catálogo) -->
        <section class="relative bg-black border-b border-white/10 py-8 z-20 overflow-hidden bg-gradient-to-b from-black to-gray-900/30">
            <div class="absolute inset-0 bg-gradient-to-r from-blue-900/5 via-transparent to-blue-900/5 pointer-events-none"></div>
            
            <div class="container mx-auto px-4 md:px-12 lg:px-16 relative z-10">
                <div class="flex flex-row items-center justify-center gap-4 md:gap-12 lg:gap-16 flex-nowrap">
                    <!-- Pureza HPLC >99% -->
                    <div class="flex flex-col md:flex-row items-center gap-3 text-center group cursor-default min-w-0">
                        <div class="relative p-2.5 rounded-2xl bg-gradient-to-br from-green-900/20 to-black border border-green-500/30 group-hover:border-green-500/50 shadow-[0_0_15px_-3px_rgba(34,197,94,0.15)] group-hover:shadow-[0_0_20px_-5px_rgba(34,197,94,0.4)] transition-all duration-500">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 md:h-8 md:w-8 text-green-400 drop-shadow-[0_0_8px_rgba(74,222,128,0.5)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                        </div>
                        <div class="flex flex-col justify-center min-w-0">
                            <p class="text-[8px] md:text-[10px] text-green-400/80 font-bold uppercase tracking-widest mb-1 truncate">Pureza HPLC</p>
                            <p class="text-base md:text-lg lg:text-xl font-bold text-white tracking-tight group-hover:text-green-100 transition-colors truncate">>99%</p>
                        </div>
                    </div>

                    <!-- Tecnologia USA -->
                    <div class="flex flex-col md:flex-row items-center gap-3 text-center group cursor-default min-w-0">
                        <div class="relative p-2.5 rounded-2xl bg-gradient-to-br from-blue-900/20 to-black border border-blue-500/30 group-hover:border-blue-500/50 shadow-[0_0_15px_-3px_rgba(59,130,246,0.15)] group-hover:shadow-[0_0_20px_-5px_rgba(59,130,246,0.4)] transition-all duration-500">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 md:h-8 md:w-8 text-blue-400 drop-shadow-[0_0_8px_rgba(96,165,250,0.5)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
                            </svg>
                        </div>
                        <div class="flex flex-col justify-center min-w-0">
                            <p class="text-[8px] md:text-[10px] text-blue-400/80 font-bold uppercase tracking-widest mb-1 truncate">Tecnologia</p>
                            <p class="text-base md:text-lg lg:text-xl font-bold text-white tracking-tight group-hover:text-blue-100 transition-colors truncate">USA</p>
                        </div>
                    </div>

                    <!-- Liofilização Estéril -->
                    <div class="flex flex-col md:flex-row items-center md:items-start gap-3 text-center md:text-left group cursor-default min-w-0">
                        <div class="relative p-2.5 rounded-2xl bg-gradient-to-br from-purple-900/20 to-black border border-purple-500/30 group-hover:border-purple-500/50 shadow-[0_0_15px_-3px_rgba(168,85,247,0.15)] group-hover:shadow-[0_0_20px_-5px_rgba(168,85,247,0.4)] transition-all duration-500">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 md:h-8 md:w-8 text-purple-400 drop-shadow-[0_0_8px_rgba(192,132,252,0.5)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                            </svg>
                        </div>
                        <div class="flex flex-col justify-center min-w-0">
                            <p class="text-[8px] md:text-[10px] text-purple-400/80 font-bold uppercase tracking-widest mb-1 truncate">Liofilização</p>
                            <p class="text-base md:text-lg lg:text-xl font-bold text-white tracking-tight group-hover:text-purple-100 transition-colors truncate">Estéril</p>
                        </div>
                    </div>

                    <!-- Suporte Técnico -->
                    <div class="flex flex-col md:flex-row items-center gap-3 text-center group cursor-default min-w-0">
                        <div class="relative p-2.5 rounded-2xl bg-gradient-to-br from-yellow-900/20 to-black border border-yellow-500/30 group-hover:border-yellow-500/50 shadow-[0_0_15px_-3px_rgba(234,179,8,0.15)] group-hover:shadow-[0_0_20px_-5px_rgba(234,179,8,0.4)] transition-all duration-500">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 md:h-8 md:w-8 text-yellow-400 drop-shadow-[0_0_8px_rgba(250,204,21,0.5)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z" />
                            </svg>
                        </div>
                        <div class="flex flex-col justify-center min-w-0">
                            <p class="text-[8px] md:text-[10px] text-yellow-400/80 font-bold uppercase tracking-widest mb-1 truncate">Suporte</p>
                            <p class="text-base md:text-lg lg:text-xl font-bold text-white tracking-tight group-hover:text-yellow-100 transition-colors truncate">Técnico</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Seção Pesquisa Avançada (efeitos cores e neo iguais ao catálogo) -->
        <section id="produtos" class="container mx-auto px-4 py-16 md:py-24 scroll-mt-20 animate-on-scroll">
            <div class="text-center mb-16 md:mb-20 group">
                <h2 class="text-4xl md:text-5xl font-bold mb-4 bg-clip-text text-transparent bg-gradient-to-r from-white via-blue-200 to-gray-400 group-hover:from-blue-300 group-hover:via-blue-400 group-hover:to-blue-500 transition-all duration-500 drop-shadow-[0_0_20px_rgba(59,130,246,0.3)] group-hover:drop-shadow-[0_0_30px_rgba(59,130,246,0.5)]" style="-webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">
                    Substâncias em Evidência
                </h2>
                <p class="text-gray-400 text-lg max-w-2xl mx-auto group-hover:text-gray-300 transition-colors duration-500">
                    Produtos de ponta para pesquisa avançada em longevidade e performance
                </p>
            </div>

            <!-- Grid de Cards (estilo catálogo: glow, gradient overlay, drop-shadow) -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8">
                {produtos.map((produto, index) => (
                    <a
                        href={produto.link}
                        class={`bg-gray-900/50 backdrop-blur-sm border border-white/10 ${produto.borderCor} ${produto.borderHover} rounded-xl p-5 pt-16 md:pt-20 transition-all duration-500 hover:shadow-2xl ${produto.hoverShadow} hover:-translate-y-3 group block relative overflow-visible animate-on-scroll before:absolute before:inset-0 before:rounded-xl before:opacity-0 hover:before:opacity-100 before:transition-opacity before:duration-500 ${produto.gradientOverlay} before:pointer-events-none flex flex-col justify-between h-full`}
                        style={`animation-delay: ${index * 0.1}s;`}
                    >
                        <!-- Imagem do Produto (cards da inicial) -->
                        <img
                            src={produto.imagemCard}
                            alt={produto.nome}
                            class="absolute -top-6 md:-top-8 left-4 bottom-0 h-[220px] md:h-[260px] w-auto object-contain z-[5] transition-transform duration-500 group-hover:scale-105"
                        />

                        <!-- Badge de Destaque (estilo catálogo) -->
                        <div class={`absolute top-4 right-4 p-3 rounded-2xl bg-gradient-to-br ${produto.corGradiente} border ${produto.borderCor.replace('/30', '/20')} ${produto.borderHover} ${produto.shadow} ${produto.shadowHover} transition-all duration-500 z-30`}>
                            <span class={`text-xs font-bold text-white uppercase tracking-widest ${produto.textShadow} flex items-center gap-1`}>
                                {produto.destaque === 'Gold Standard' && (
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="currentColor" viewBox="0 0 24 24">
                                        <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                                    </svg>
                                )}
                                {produto.destaque}
                            </span>
                        </div>

                        <!-- Conteúdo do Card: ícone catálogo pequeno + título -->
                        <div class="relative z-10 ml-24 md:ml-28 text-right">
                            <div class="flex items-center gap-2 justify-end mb-2">
                                <div class={`w-9 h-9 rounded-full bg-white/5 border ${produto.borderCor} flex items-center justify-center flex-shrink-0`}>
                                    <img src={produto.imagem} alt="" class="w-6 h-6 object-contain" style={`filter: drop-shadow(${produto.dropShadow});`} />
                                </div>
                                <h3 class={`text-2xl md:text-3xl font-bold ${produto.textColor} group-hover:scale-105 transition-all duration-300`}>
                                    {produto.nome}
                                </h3>
                            </div>
                            <p class="text-base md:text-lg text-gray-300 mb-4">
                                {produto.descricao}
                            </p>
                        </div>

                        <!-- Botão (estilo catálogo: borda neo no hover do card) -->
                        <div class={`relative z-20 w-full py-2.5 px-4 bg-white/5 hover:bg-white/10 border border-white/10 ${produto.borderHover} ${produto.textColor} hover:opacity-90 text-sm font-medium rounded-lg transition-all duration-300 text-center group/btn mt-4`}>
                            <span class="flex items-center justify-center gap-2">
                                Ver Detalhes
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 group-hover/btn:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                                </svg>
                            </span>
                        </div>
                    </a>
                ))}
            </div>

            <!-- Lista Rápida de Outros Produtos (estilo filtros catálogo) -->
            <div class="mt-12 text-center">
                <div class="bg-gray-900/50 backdrop-blur-sm border border-white/10 rounded-xl p-5 md:p-6 max-w-3xl mx-auto">
                    <p class="text-gray-400 mb-3 text-xs md:text-sm uppercase tracking-wider">
                        Também disponíveis:
                    </p>
                    <div class="flex flex-wrap justify-center items-center gap-2.5 md:gap-3">
                        {outrosProdutos.map((produto) => (
                            <a
                                href={getProductUrl(produto)}
                                class="px-3 py-1.5 bg-white/5 border border-white/10 rounded-full text-gray-300 text-xs md:text-sm font-medium hover:bg-white/10 hover:border-white/20 hover:text-white transition-all duration-300 cursor-pointer focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500/50"
                            >
                                {produto}
                            </a>
                        ))}
                    </div>
                </div>
            </div>
        </section>
    </main>

    <!-- Footer -->
    <footer class="bg-black border-t border-white/10 py-8">
        <div class="container mx-auto px-4">
            <div class="text-center">
                <!-- USA Technology Badge -->
                <div class="flex items-center justify-center gap-2 mb-4">
                    <span class="flag-icon-footer">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" class="svg-flag-footer">
                            <g fill="none">
                                <path fill="#B22234" d="M0 0h512v512H0z"/>
                                <path fill="#FFF" d="M0 45.9h512v45.9H0zM0 137.6h512v45.9H0zM0 229.3h512v45.9H0zM0 321h512v45.9H0zM0 412.7h512v45.9H0z"/>
                                <path fill="#3C3B6E" d="M0 0h233v275.2H0z"/>
                                <g fill="#FFF">
                                    <circle cx="25" cy="25" r="10"/><circle cx="71" cy="25" r="10"/><circle cx="117" cy="25" r="10"/><circle cx="163" cy="25" r="10"/><circle cx="209" cy="25" r="10"/>
                                    <circle cx="48" cy="63" r="10"/><circle cx="94" cy="63" r="10"/><circle cx="140" cy="63" r="10"/><circle cx="186" cy="63" r="10"/>
                                    <circle cx="25" cy="101" r="10"/><circle cx="71" cy="101" r="10"/><circle cx="117" cy="101" r="10"/><circle cx="163" cy="101" r="10"/><circle cx="209" cy="101" r="10"/>
                                    <circle cx="48" cy="139" r="10"/><circle cx="94" cy="139" r="10"/><circle cx="140" cy="139" r="10"/><circle cx="186" cy="139" r="10"/>
                                    <circle cx="25" cy="177" r="10"/><circle cx="71" cy="177" r="10"/><circle cx="117" cy="177" r="10"/><circle cx="163" cy="177" r="10"/><circle cx="209" cy="177" r="10"/>
                                    <circle cx="48" cy="215" r="10"/><circle cx="94" cy="215" r="10"/><circle cx="140" cy="215" r="10"/><circle cx="186" cy="215" r="10"/>
                                    <circle cx="25" cy="253" r="10"/><circle cx="71" cy="253" r="10"/><circle cx="117" cy="253" r="10"/><circle cx="163" cy="253" r="10"/><circle cx="209" cy="253" r="10"/>
                                </g>
                            </g>
                        </svg>
                    </span>
                    <span class="text-white font-medium text-sm md:text-base">USA Technology</span>
                </div>
                
                <p class="text-gray-400 text-sm">
                    © 2015 <span class="text-white font-semibold">Orion Peptides</span>. Todos os direitos reservados.
                </p>
            </div>
        </div>
    </footer>
</Layout>

<style>
    /* Logo com efeito de brilho animado */
    .hero-logo {
        max-width: clamp(100px, 12vw, 160px);
        width: 100%;
        height: auto;
        margin: 0 auto clamp(0.75rem, 2vh, 1.5rem);
        display: block;
        filter: brightness(1.1) drop-shadow(0 0 10px rgba(255, 255, 255, 0.3)) drop-shadow(0 0 20px rgba(255, 255, 255, 0.2));
        transition: transform 0.3s ease, filter 0.3s ease;
        animation: logoGlow 3s ease-in-out infinite;
        position: relative;
    }

    @keyframes logoGlow {
        0%, 100% {
            filter: brightness(1.1) drop-shadow(0 0 10px rgba(255, 255, 255, 0.3)) drop-shadow(0 0 20px rgba(255, 255, 255, 0.2));
        }
        50% {
            filter: brightness(1.2) drop-shadow(0 0 15px rgba(255, 255, 255, 0.5)) drop-shadow(0 0 30px rgba(255, 255, 255, 0.4)) drop-shadow(0 0 40px rgba(255, 255, 255, 0.2));
        }
