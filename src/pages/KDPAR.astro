---
import { buildWhatsAppUrl } from '../config/whatsapp';
// Redirecionamento para WhatsApp com mensagem de indicação KDPAR
const mensagem = 'Olá! Gostaria de saber mais sobre os peptídeos. Meu código de indicação é KDPAR.';
const waUrl = buildWhatsAppUrl(mensagem);
---
<!DOCTYPE html>
<html lang="pt-BR">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta http-equiv="refresh" content={`0;url=${waUrl}`} />
		<title>Redirecionando para WhatsApp...</title>
		<link rel="canonical" href={waUrl} />
	</head>
	<body>
		<p>Redirecionando para o WhatsApp... <a href={waUrl}>Clique aqui se não for redirecionado</a>.</p>
	</body>
</html>
