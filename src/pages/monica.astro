---
import { buildWhatsAppUrl } from '../config/whatsapp';

const mensagem = 'Olá! Vi a indicação da Monica e gostaria de saber mais sobre os peptídeos Orion.';
const waUrl = buildWhatsAppUrl(mensagem);
---
<!DOCTYPE html>
<html lang="pt-BR">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>Redirecionando — Orion Peptides</title>
	<meta name="description" content="Redirecionamento para o WhatsApp Orion Peptides (indicação Monica).">
	<link rel="canonical" href="https://orionpeptideos.com/monica/">
	<meta http-equiv="refresh" content={`0;url=${waUrl}`}>
	<style>
		body { font-family: system-ui, sans-serif; margin: 2rem; text-align: center; color: #333; }
		a { color: #25d366; }
	</style>
</head>
<body>
	<p>Redirecionando para o WhatsApp…</p>
	<p>Se não abrir automaticamente, <a href={waUrl}>clique aqui</a>.</p>
</body>
</html>
