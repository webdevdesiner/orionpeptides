---
import { buildWhatsAppUrl } from '../config/whatsapp';
// Redirecionamento para WhatsApp - indicação da página Emagreça Já (código EMAGRECAJA)
const mensagem = 'Olá! Tenho interesse em obter mais informações sobre os peptídeos Orion. Minha indicação veio da página Emagreça Já.';
const waUrl = buildWhatsAppUrl(mensagem);
---
<!DOCTYPE html>
<html lang="pt-BR">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta http-equiv="refresh" content={`0;url=${waUrl}`} />
		<title>Redirecionando — Emagreça Já (EMAGRECAJA)</title>
		<link rel="canonical" href={waUrl} />
		<style is:global>
			* { box-sizing: border-box; margin: 0; padding: 0; }
			body {
				min-height: 100vh;
				display: flex;
				align-items: center;
				justify-content: center;
				background: #0f0f0f;
				color: #e5e5e5;
				font-family: system-ui, -apple-system, sans-serif;
				padding: 1rem;
			}
			.message {
				text-align: center;
				font-size: 1.125rem;
				letter-spacing: 0.02em;
			}
			.message a {
				color: #25d366;
				text-decoration: underline;
			}
			.message::after {
				content: '';
				display: inline-block;
				width: 0.35em;
				height: 1em;
				background: currentColor;
				margin-left: 0.15em;
				animation: blink 0.8s step-end infinite;
			}
			@keyframes blink {
				50% { opacity: 0; }
			}
		</style>
	</head>
	<body>
		<p class="message">
			Redirecionando (Emagreça Já — EMAGRECAJA)... <a href={waUrl}>EMAGRECAJA</a>
		</p>
		<script define:vars={{ waUrl }}>
			window.location.href = waUrl;
		</script>
	</body>
</html>
