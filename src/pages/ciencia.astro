---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
---

<Layout title="Ciência e Laudos | Orion Peptides">
    <Header />
    
    <main>
        <!-- Hero Section -->
        <section class="relative border-b border-white/10 bg-gradient-to-b from-black to-gray-900 py-20 md:py-28 overflow-hidden">
            <!-- Background Image/Media -->
           
            
            <!-- Imagem de Fundo -->
            <div class="absolute inset-0 z-0">
                <img 
                    src="/image/backgroundimage.png" 
                    alt="" 
                    class="w-full h-full object-cover opacity-40"
                />
                <!-- Gradiente: mais claro nas extremidades, mais escuro no meio -->
                <div 
                    class="absolute inset-0"
                    style="background: linear-gradient(to left, rgba(255, 255, 255, 0) 0%, rgb(0, 0, 0) 50%, rgba(0, 0, 0, 0) 100%);"
                ></div>
            </div>
            
            <!-- Overlay Escuro para Legibilidade do Texto (não cobre a imagem) -->
            <div class="absolute inset-0 z-0 pointer-events-none"></div>
            
            <!-- Conteúdo (Texto) -->
            <div class="container mx-auto px-4 relative z-10">
                <div class="text-center max-w-4xl mx-auto">
                    <h1 class="text-5xl md:text-6xl lg:text-7xl font-bold mb-6 tracking-tight bg-clip-text text-transparent bg-gradient-to-r from-white via-gray-200 to-gray-400">
                        Rigor Científico & Transparência
                    </h1>
                    <p class="text-xl md:text-2xl text-gray-400 max-w-3xl mx-auto leading-relaxed">
                        Todos os nossos lotes passam por rigorosos testes de cromatografia (HPLC) para garantir pureza superior a 99%.
                    </p>
                </div>
            </div>
        </section>

        <!-- Seção Metodologia -->
        <section class="bg-white/5 border-t border-white/10 py-16 md:py-20">
            <div class="container mx-auto px-4">
                <div class="max-w-4xl mx-auto">
                    <div class="text-center mb-12">
                        <!-- Logo com efeito de brilho -->
                        <img src="/logo.png" alt="Logo Orion" class="hero-logo mb-6" />
                        
                        <h2 class="text-3xl md:text-4xl font-bold mb-4 bg-clip-text text-transparent bg-gradient-to-r from-blue-400 to-blue-600">
                            Nossa Metodologia
                        </h2>
                    </div>

                    <div class="prose prose-invert max-w-none">
                        <div class="space-y-6 text-gray-300 leading-relaxed">
                            <p class="text-lg">
                                Na <strong class="text-white">Orion Peptides</strong>, acreditamos que a transparência é fundamental para estabelecer confiança na pesquisa científica. Por isso, todos os nossos produtos são submetidos a análises rigorosas de <strong class="text-blue-400">Cromatografia Líquida de Alta Performance (HPLC)</strong>.
                            </p>

                            <div class="bg-black/30 border border-white/10 rounded-xl p-6 my-8">
                                <h3 class="text-xl font-bold text-white mb-4 flex items-center gap-2">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
                                    </svg>
                                    O que é HPLC?
                                </h3>
                                <p class="text-gray-300">
                                    A HPLC é uma técnica analítica de separação e quantificação que permite identificar e medir a pureza de compostos com precisão extrema. Através desta metodologia, conseguimos garantir que cada lote atenda aos mais altos padrões de qualidade, com pureza superior a 99%.
                                </p>
                            </div>

                            <h3 class="text-2xl font-bold text-white mt-8 mb-4">Por que isso importa?</h3>
                            
                            <ul class="space-y-4 list-none">
                                <li class="flex items-start gap-3">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-green-400 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                                    </svg>
                                    <div>
                                        <strong class="text-white">Reprodutibilidade:</strong> Resultados consistentes garantem que suas pesquisas sejam replicáveis e confiáveis.
                                    </div>
                                </li>
                                <li class="flex items-start gap-3">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-green-400 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                                    </svg>
                                    <div>
                                        <strong class="text-white">Segurança:</strong> A pureza certificada elimina riscos de contaminação que poderiam comprometer seus estudos.
                                    </div>
                                </li>
                                <li class="flex items-start gap-3">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-green-400 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                                    </svg>
                                    <div>
                                        <strong class="text-white">Conformidade:</strong> Atendemos aos mais rigorosos padrões internacionais de qualidade para pesquisa científica.
                                    </div>
                                </li>
                                <li class="flex items-start gap-3">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-green-400 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                                    </svg>
                                    <div>
                                        <strong class="text-white">Transparência:</strong> Cada laudo está disponível para download, permitindo verificação independente da qualidade.
                                    </div>
                                </li>
                            </ul>

                            <div class="mt-10 pt-8 border-t border-white/10">
                                <p class="text-center text-gray-400 italic">
                                    "A ciência avança através da transparência e do rigor metodológico. Na Orion Peptides, não apenas falamos sobre qualidade — nós a documentamos."
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <!-- Footer -->
    <footer class="bg-black border-t border-white/10 py-8">
        <div class="container mx-auto px-4">
            <div class="text-center">
                <!-- USA Technology Badge -->
                <div class="flex items-center justify-center gap-2 mb-4">
                    <span class="flag-icon-footer">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" class="svg-flag-footer">
                            <g fill="none">
                                <path fill="#B22234" d="M0 0h512v512H0z"/>
                                <path fill="#FFF" d="M0 45.9h512v45.9H0zM0 137.6h512v45.9H0zM0 229.3h512v45.9H0zM0 321h512v45.9H0zM0 412.7h512v45.9H0z"/>
                                <path fill="#3C3B6E" d="M0 0h233v275.2H0z"/>
                                <g fill="#FFF">
                                    <circle cx="25" cy="25" r="10"/><circle cx="71" cy="25" r="10"/><circle cx="117" cy="25" r="10"/><circle cx="163" cy="25" r="10"/><circle cx="209" cy="25" r="10"/>
                                    <circle cx="48" cy="63" r="10"/><circle cx="94" cy="63" r="10"/><circle cx="140" cy="63" r="10"/><circle cx="186" cy="63" r="10"/>
                                    <circle cx="25" cy="101" r="10"/><circle cx="71" cy="101" r="10"/><circle cx="117" cy="101" r="10"/><circle cx="163" cy="101" r="10"/><circle cx="209" cy="101" r="10"/>
                                    <circle cx="48" cy="139" r="10"/><circle cx="94" cy="139" r="10"/><circle cx="140" cy="139" r="10"/><circle cx="186" cy="139" r="10"/>
                                    <circle cx="25" cy="177" r="10"/><circle cx="71" cy="177" r="10"/><circle cx="117" cy="177" r="10"/><circle cx="163" cy="177" r="10"/><circle cx="209" cy="177" r="10"/>
                                    <circle cx="48" cy="215" r="10"/><circle cx="94" cy="215" r="10"/><circle cx="140" cy="215" r="10"/><circle cx="186" cy="215" r="10"/>
                                    <circle cx="25" cy="253" r="10"/><circle cx="71" cy="253" r="10"/><circle cx="117" cy="253" r="10"/><circle cx="163" cy="253" r="10"/><circle cx="209" cy="253" r="10"/>
                                </g>
                            </g>
                        </svg>
                    </span>
                    <span class="text-white font-medium text-sm md:text-base">USA Technology</span>
                </div>
                
                <p class="text-gray-400 text-sm">
                    © 2015 <span class="text-white font-semibold">Orion Peptides</span>. Todos os direitos reservados.
                </p>
            </div>
        </div>
    </footer>
</Layout>

<style>
    /* Logo com efeito de brilho animado */
    .hero-logo {
        max-width: clamp(120px, 15vw, 200px);
        width: 100%;
        height: auto;
        margin: 0 auto clamp(1rem, 3vh, 2rem);
        display: block;
        filter: brightness(1.1) drop-shadow(0 0 10px rgba(255, 255, 255, 0.3)) drop-shadow(0 0 20px rgba(255, 255, 255, 0.2));
        transition: transform 0.3s ease, filter 0.3s ease;
        animation: logoGlow 3s ease-in-out infinite;
        position: relative;
    }

    @keyframes logoGlow {
        0%, 100% {
            filter: brightness(1.1) drop-shadow(0 0 10px rgba(255, 255, 255, 0.3)) drop-shadow(0 0 20px rgba(255, 255, 255, 0.2));
        }
        50% {
            filter: brightness(1.2) drop-shadow(0 0 15px rgba(255, 255, 255, 0.5)) drop-shadow(0 0 30px rgba(255, 255, 255, 0.4)) drop-shadow(0 0 40px rgba(255, 255, 255, 0.2));
        }
    }

    .hero-logo:hover {
        transform: scale(1.05);
        filter: brightness(1.3) drop-shadow(0 0 20px rgba(255, 255, 255, 0.6)) drop-shadow(0 0 40px rgba(255, 255, 255, 0.5)) drop-shadow(0 0 60px rgba(255, 255, 255, 0.3));
    }
</style>